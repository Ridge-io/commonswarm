=== is_member ===
CREATE OR REPLACE FUNCTION swarm.is_member(p_workspace uuid, p_user uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'swarm', 'pg_catalog'
AS $function$
  SELECT EXISTS (
    SELECT 1
    FROM swarm.memberships AS m
    JOIN swarm.workspaces AS w
      ON w.workspace_id = m.workspace_id
     AND w.archived_at IS NULL
    WHERE m.workspace_id = p_workspace
      AND m.user_id = p_user
      AND m.revoked_at IS NULL
  )
$function$

=== file_versions indexes ===
CREATE UNIQUE INDEX file_versions_pkey ON swarm.file_versions USING btree (version_id)
CREATE UNIQUE INDEX file_versions_file_id_version_n_key ON swarm.file_versions USING btree (file_id, version_n)
CREATE INDEX file_versions_workspace_state ON swarm.file_versions USING btree (workspace_id, state)
CREATE INDEX file_versions_pending_created ON swarm.file_versions USING btree (created_at) WHERE (state = 'pending'::text)
CREATE UNIQUE INDEX file_versions_file_workspace_version ON swarm.file_versions USING btree (file_id, workspace_id, version_n)
CREATE INDEX file_versions_file_state_version ON swarm.file_versions USING btree (file_id, state, version_n)
