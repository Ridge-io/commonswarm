+const OWNER = "cccccccc-cccc-4ccc-8ccc-cccccccccccc";
+const OTHER = "dddddddd-dddd-4ddd-8ddd-dddddddddddd";
+const TOKEN = `swm_agt_${"A".repeat(43)}`;
+
+let root: string;
