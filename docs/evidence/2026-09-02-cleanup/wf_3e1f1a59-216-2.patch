+/**
+ * ONE absolute deadline across both attempts of an idempotent read. The retry
+ * inherits whatever the first attempt left of the budget, and a first attempt
+ * that used all of it is not retried — so a read's worst case is
+ * REQUEST_TIMEOUT_MS, not double it (the exact-review arm measured onceRetried
+ * handing its retry a fresh 30s). The caller's own signal stays authoritative:
+ * a cancelled read is not retried either.
+ */
+export async function readWithBudget<T>(
+  step: (deadline: ReadDeadline) => Promise<T>,
+  options: { budgetMs?: number; now?: () => number; signal?: AbortSignal } = {},
+): Promise<T> {
+  const now = options.now ?? Date.now;
+  const budgetMs = Math.min(REQUEST_TIMEOUT_MS, options.budgetMs ?? REQUEST_TIMEOUT_MS);
+  const deadlineMs = now() + budgetMs;
+  const deadline: ReadDeadline = { deadlineMs, now, signal: options.signal };
+  try {
+    return await step(deadline);
+  } catch (error) {
+    if (
+      error instanceof FileTransportError && error.noResponse &&
+      options.signal?.aborted !== true &&
+      deadlineMs - now() > 0
+    ) {
+      return await step(deadline);
+    }
+    throw error;
+  }
+}
