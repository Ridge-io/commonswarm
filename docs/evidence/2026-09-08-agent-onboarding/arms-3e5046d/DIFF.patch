+const CHANNEL_HEARTBEAT_MS = 5_000;
+const CHANNEL_POLL_MS = 30_000;
+
+export interface ChannelPending {
+  row: DeliveryRow;
+  receipt: string;
+  ack_command_id: string;
+  confirmed: boolean;
