# Copy to a secure shell environment or export these before running the harness.
# Do not commit the real values.
export UXTEST_REMOTE="tom@100.95.177.37"
export UXTEST_HUMAN1_UID="<github-identity-a-auth-uuid>"
export UXTEST_HUMAN2_EMAIL="<github-identity-b-email>"
export UXTEST_OAUTH_CONSENT="first"

# seeded (default) | self-serve. See HARNESS.md §2. Only seeded completes end to
# end today: create_workspace is served only where SWARM_SELF_SERVE=1, and
# production does not set it. A round's mode is fixed at reset and recorded in
# rounds/<n>/setup.json; changing this export afterwards does not change it.
export UXTEST_SETUP_MODE="seeded"

# Inject this at runtime from the approved secret manager. Never write it here.
export DATABASE_URL="<privileged-session-pooler-url>"

# SWARM_CLOUD_URL and SWARM_CLOUD_ANON_KEY may instead come from ../.env.cloud.
export SWARM_CLOUD_URL="<supabase-project-url>"
export SWARM_CLOUD_ANON_KEY="<public-anon-key>"
