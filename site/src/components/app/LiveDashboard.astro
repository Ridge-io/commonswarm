      /* BOTH ARE READ WHEN THE SEND STARTS, not when it resolves. A control that opens a
         window and then changes the hooks for the NEXT send would otherwise change the
         outcome of the one already on the wire, which is the opposite of what a window is
         for. */
      const fails = root.dataset.sampleSendFail !== undefined;
