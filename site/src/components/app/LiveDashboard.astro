      ];
      accessStatuses = [
        {
          workspaceId: "sample-design-studio",
          principalId: "sample-river",
          ownerUserId: "sample-owner",
          agentName: "River",
          model: "GPT-5",
          tokenId: "sample-token-river-8c51b6a2",
