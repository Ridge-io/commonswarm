    const boot = async (): Promise<void> => {
      const version = ++requestVersion;
      if (!client()) {
        renderSample();
        return;
      }

      sampleMode = false;
      for (const button of all<HTMLButtonElement>("[data-signout]")) button.hidden = false;
      setLoading("Checking your sign-in…");
      try {
        session = await currentSession();
        if (version !== requestVersion) return;
        renderedAuthUserId = session?.user.id ?? "";
        if (!session) {
          resetWorkspaceSessionState();
          showAuthView("choices");
          showPanel("signed-out");
          return;
        }
        const who = accountName(session);
        for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
          target.textContent = who;
        }
        workspaces = await workspaceMemberships();
        if (version !== requestVersion) return;
        if (workspaces.length === 0) {
          resetWorkspaceSessionState();
          const pending = readCreateIntent(session.user.id);
          renderCreate(session);
          if (pending) await createFromIntent(session, pending);
          return;
        }
        const pending = readCreateIntent(session.user.id);
        if (pending && workspaces.some((workspace) => workspace.id === pending.workspaceId)) {
          clearCreateIntent(session.user.id);
        }
        /* ?w= names the workspace to open. It is honoured only when it is in this
           reader's own memberships, so a stale or foreign id opens the default one rather
           than an error: the address bar is a convenience, never an authorization. */
        const requestedWorkspaceId = new URL(window.location.href).searchParams.get("w");
        const bootWorkspace =
          workspaces.find((workspace) => workspace.id === requestedWorkspaceId) ??
            workspaces[0]!;
        await openWorkspace(bootWorkspace.id);
      } catch (error) {
        if (version !== requestVersion) return;
        if (error instanceof SessionExpired) {
          session = null;
          renderedAuthUserId = "";
          resetWorkspaceSessionState();
          showAuthView("choices");
          showPanel("signed-out");
          authError(error.message);
          return;
        }
        if (session) {
          renderWorkspaceError(session, error);
        } else {
          resetWorkspaceSessionState();
          showAuthView("choices");
          showPanel("signed-out");
          authError(readableError(error));
        }
      }
    };

    const runBoot = (): void => {
      if (bootInFlight) {
        bootAgain = true;
        return;
      }
      bootInFlight = (async () => {
        do {
          bootAgain = false;
          await boot();
        } while (bootAgain);
      })().finally(() => {
        bootInFlight = null;
        if (bootAgain) runBoot();
      });
    };

    one<HTMLButtonElement>("[data-signin-github]")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      authError(null);
      try {
        await signInWithGitHub(new URL("/app", window.location.origin).href);
      } catch (error) {
        authError(readableError(error));
        button.disabled = false;
        button.removeAttribute("aria-busy");
      }
    });

    /*
     * ONE handler for every provider ProviderButtons rendered here, and it names none of
     * them: the id is read off the element the component wrote. A second provider therefore
     * needs no change on this page. signInWithProvider runs the id through authProvider(),
     * so an id AUTH_PROVIDERS does not name never reaches Supabase.
     */
    for (const button of all<HTMLButtonElement>(
      "[data-member-reauth] [data-signin-provider]",
    )) {
      button.addEventListener("click", async () => {
        const providerId = button.dataset.signinProvider ?? "";
        button.disabled = true;
        try {
          await signInWithProvider(
            providerId,
            new URL("/app", window.location.origin).href,
          );
        } catch (error) {
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent = readableError(error);
            target.hidden = false;
          }
          button.disabled = false;
        }
      });
    }
    one<HTMLButtonElement>("[data-member-reauth-email]")?.addEventListener(
      "click",
      async (event) => {
        const email = window.prompt("Email address for a fresh sign-in link:");
        if (!email?.trim()) return;
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        try {
          await signInWithEmail(
            email.trim(),
            new URL("/app", window.location.origin).href,
          );
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent =
              "Check your email. After signing in, return here and press Remove again.";
            target.hidden = false;
          }
        } catch (error) {
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent = readableError(error);
            target.hidden = false;
          }
        } finally {
          button.disabled = false;
        }
      },
    );

    for (const button of all<HTMLButtonElement>("[data-use-email]")) {
      button.addEventListener("click", () => showAuthView("choices"));
    }

    one<HTMLFormElement>(".dashboard__email")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const input = form.elements.namedItem("email") as HTMLInputElement | null;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!input?.value.trim()) return;
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
      }
      authError(null);
      try {
        await signInWithEmail(input.value.trim(), new URL("/app", window.location.origin).href);
        const email = one<HTMLElement>("[data-auth-email]");
        if (email) email.textContent = input.value.trim();
        showAuthView("email-sent");
      } catch (error) {
        authError(readableError(error));
      } finally {
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      }
    });

    one<HTMLFormElement>("[data-create-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session) return;
      if (
        activeCreate?.version === requestVersion &&
        activeCreate.userId === session.user.id
      ) return;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const name = input?.value.trim() ?? "";
      if (!name) {
        setCreateError("Name the workspace first.");
        input?.focus();
        return;
      }
      const savedIntent = readCreateIntent(session.user.id);
      const intent: CreateIntent = savedIntent?.name === name
        ? savedIntent
        : {
            workspaceId: uuid(),
            commandId: uuid(),
            name,
          };
      writeCreateIntent(session.user.id, intent);
      await createFromIntent(session, intent);
    });

    for (const button of all<HTMLButtonElement>("[data-signout]")) {
      button.addEventListener("click", async () => {
        if (keepConnectCredentialVisible()) return;
        button.disabled = true;
        if (session) clearCreateIntent(session.user.id);
        requestVersion += 1;
        renderedAuthUserId = "";
        resetWorkspaceSessionState();
        await signOut();
        session = null;
        showAuthView("choices");
        showPanel("signed-out");
        button.disabled = false;
      });
    }

    one<HTMLFormElement>("[data-invite-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session || !activeWorkspaceId) return;
      const inviteSession = session;
      const submitOwner = {
        workspaceId: activeWorkspaceId,
        version: requestVersion,
      };
      const ownsInviteSubmit = (): boolean =>
        isInviteSubmitCurrent(submitOwner, activeWorkspaceId, requestVersion);
      const emailInput = one<HTMLInputElement>("[data-invite-email]");
      const submit = one<HTMLButtonElement>("[data-invite-submit]");
      const error = one<HTMLElement>("[data-invite-error]");
      const email = emailInput?.value.trim() ?? "";
      const emailValidationMessage = inviteEmailValidationMessage(email);
      if (emailValidationMessage) {
        if (error) {
          error.textContent = emailValidationMessage;
          error.hidden = false;
        }
        emailInput?.focus();
        return;
      }
      let submittedIntent = inviteIntent;
      if (!submittedIntent || submittedIntent.email !== email) {
        submittedIntent = { email, commandId: uuid() };
        inviteIntent = submittedIntent;
      }
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Creating a private link…";
      }
      try {
        const target = deployment();
        const workspace = workspaces.find((entry) => entry.id === submitOwner.workspaceId);
        if (!target || !workspace) throw new NoDeployment();
        const created = await inviteWorkspaceMember(
          inviteSession,
          submittedIntent.commandId,
          submitOwner.workspaceId,
          email,
        );
        /* A stale success may have created a pending row in the submitted workspace,
           where it remains visible and cancellable. Its one-use token is deliberately
           discarded: rendering or persisting it in the next workspace would cross the
           credential's tenancy boundary. */
        if (!ownsInviteSubmit()) return;
        if (created.workspaceId !== submitOwner.workspaceId) {
          throw new Error(
            "CommonSwarm returned an invite for another workspace. No link was shown.",
          );
        }
