      const removeKey = target?.closest<HTMLElement>("[data-composer-to-remove]")
        ?.dataset.composerToRemove;
      const promoteKey = target?.closest<HTMLElement>("[data-composer-to-promote]")
        ?.dataset.composerToPromote;
      const key = removeKey ?? promoteKey;
      if (key === undefined) return;
      /* NOT WHILE THE MESSAGE IS ON THE WIRE. The box is already read-only during a send;
         the address has to be too. Editing it mid-flight retires the send intent, so a post
         the server had accepted could be retried under a new command id. */
      if (composerSending) return;
      const entity = composerTo.find((candidate) => recipientKey(candidate) === key);
      if (!entity) return;
      /* The address changed, so a send intent minted against the old one is retired: a
         retry must never replay a message at an address the reader has since edited. */
      composerIntent = null;
      const retryControl = one<HTMLButtonElement>("[data-composer-retry]");
      if (retryControl) retryControl.hidden = true;
      /* THE HAND EDIT GOES THROUGH THE SAME PASS as a keystroke does, so the set it makes is
         pruned, merged against the body's tags and written to storage by one call. It used to
         be its own writer, which is why an edit reached storage only on the next keystroke. */
      syncComposerAddress(
        removeKey !== undefined
          ? removeComposerRecipient(composerTo, entity)
          : promoteComposerRecipient(composerTo, entity),
      );
      one<HTMLTextAreaElement>("[data-composer-input]")?.focus({ preventScroll: true });
    });
    syncComposerControls();
    for (const button of all<HTMLButtonElement>("[data-workspace-view]")) {
      button.addEventListener("click", () => {
        const view = button.dataset.workspaceView;
        if (view === "signals" || view === "files" || view === "brain") {
          activateWorkspaceView(view);
        }
      });
    }
    /* ── Channel controls ────────────────────────────────────────────────────────────
     * Every refusal here shows the SERVER's own sentence. The rules that refuse a name —
     * its spelling, its length, the reserved list, a name already taken — are the command
     * edge's, and a second copy in the browser would be a rule nothing enforces. What the
     * browser checks first is the one thing it can know without asking: the same
     * channelSlugProblem the edge runs, imported from the edge's own module.
     */
    let channelArchiveArmed = "";

    const disarmChannelArchive = (): void => {
      channelArchiveArmed = "";
      const button = one<HTMLButtonElement>("[data-channel-archive]");
      if (button) button.textContent = "Archive";
    };

    const submitChannelCreate = async (): Promise<void> => {
      const input = one<HTMLInputElement>("[data-channel-new-slug]");
      const purposeInput = one<HTMLInputElement>("[data-channel-new-purpose]");
      const submit = one<HTMLButtonElement>("[data-channel-create-submit]");
      if (!input || !session || sampleMode || activeWorkspaceId === "") return;
      const slug = channelSubmitSlug(input.value);
      const problem = channelSubmitProblem(slug);
      setChannelDialogError("");
      if (problem !== null) {
        setChannelDialogError(problem);
        input.focus();
        return;
      }
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      const purpose = purposeInput === null ? null : purposeInput.value.trim() || null;
      if (submit) submit.disabled = true;
      setChannelDialogStatus(`Creating ${channelLabel(slug)}…`);
      try {
        const created = await createChannel(session, uuid(), workspaceId, slug, purpose);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        input.value = "";
        if (purposeInput) purposeInput.value = "";
        setChannelDialogStatus(`${channelLabel(created.slug)} is ready.`);
        await refreshChannels(workspaceId, version);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        selectChannel(created.channelId);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        setChannelDialogStatus("");
        setChannelDialogError(readableError(error));
      } finally {
        if (submit) submit.disabled = false;
      }
    };

    const submitChannelRename = async (): Promise<void> => {
      const channel = activeChannel();
      const input = one<HTMLInputElement>("[data-channel-rename-slug]");
      const submit = one<HTMLButtonElement>("[data-channel-rename-submit]");
      if (!input || !channel || !session || sampleMode || activeWorkspaceId === "") return;
      const slug = channelSubmitSlug(input.value);
      const problem = channelSubmitProblem(slug);
      setChannelDialogError("");
      if (problem !== null) {
        setChannelDialogError(problem);
        input.focus();
        return;
      }
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      if (submit) submit.disabled = true;
      setChannelDialogStatus(`Renaming ${channelLabel(channel.slug)}…`);
      try {
        const renamed = await renameChannel(
          session,
          uuid(),
          workspaceId,
          channel.channelId,
          slug,
        );
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        /* The id does not change, so every link into this channel still resolves. That is
           why the URL carries the id and not the name. */
        setChannelDialogStatus(`This channel is now ${channelLabel(renamed.slug)}.`);
        await refreshChannels(workspaceId, version);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        setChannelDialogStatus("");
        setChannelDialogError(readableError(error));
      } finally {
        if (submit) submit.disabled = false;
      }
    };

    const submitChannelArchive = async (): Promise<void> => {
      const channel = activeChannel();
      const button = one<HTMLButtonElement>("[data-channel-archive]");
      if (!channel || !session || sampleMode || activeWorkspaceId === "") return;
      setChannelDialogError("");
      /* Two presses, because there is no command that un-archives. The second press is the
         one that acts, and the button says what it is about to do to whom. */
      if (channelArchiveArmed !== channel.channelId) {
        channelArchiveArmed = channel.channelId;
        if (button) {
          button.textContent =
            `Archive ${channelLabel(channel.slug)} for everyone. Press again to confirm.`;
        }
        return;
      }
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      if (button) button.disabled = true;
      setChannelDialogStatus(`Archiving ${channelLabel(channel.slug)}…`);
      try {
        await archiveChannel(session, uuid(), workspaceId, channel.channelId);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        setChannelDialogStatus(
          `${channelLabel(channel.slug)} is archived. Its messages still read in ${
            channelLabel(ALL_SIGNALS_SLUG)
          }.`,
        );
        disarmChannelArchive();
        await refreshChannels(workspaceId, version);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        setChannelDialogStatus("");
        setChannelDialogError(readableError(error));
      } finally {
        if (button) button.disabled = false;
      }
    };

    for (const button of all<HTMLButtonElement>("[data-channel-place]")) {
      button.addEventListener("click", () => selectChannel(null));
    }
    one<HTMLButtonElement>("[data-channel-new]")?.addEventListener("click", () => {
      openChannelDialog();
      window.requestAnimationFrame(() => {
        one<HTMLInputElement>("[data-channel-new-slug]")?.focus({ preventScroll: true });
      });
    });
    one<HTMLButtonElement>("[data-channel-switch]")?.addEventListener(
      "click",
      openChannelDialog,
    );
    one<HTMLButtonElement>("[data-channel-dialog-close]")?.addEventListener(
      "click",
      closeChannelDialog,
    );
    {
      const dialog = one<HTMLDialogElement>("[data-channel-dialog]");
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener("close", () => {
        disarmChannelArchive();
        one<HTMLButtonElement>("[data-channel-switch]")
          ?.setAttribute("aria-expanded", "false");
      });
    }
    one<HTMLFormElement>("[data-channel-create-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      void submitChannelCreate();
    });
    one<HTMLFormElement>("[data-channel-manage-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      void submitChannelRename();
    });
    one<HTMLButtonElement>("[data-channel-archive]")?.addEventListener("click", () => {
      void submitChannelArchive();
    });
    one<HTMLInputElement>("[data-channel-rename-slug]")?.addEventListener(
      "input",
      disarmChannelArchive,
    );
    for (const button of all<HTMLButtonElement>("[data-feed-filter]")) {
      button.addEventListener("click", () => {
        const next = button.dataset.feedFilter;
        if (next !== "all" && next !== "broadcast" && next !== "direct-to-you") return;
        signalFilter = next;
        renderFeed();
      });
    }
    {
      const dialog = one<HTMLDialogElement>("[data-workspace-details-popover]");
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener("close", () => {
        one<HTMLButtonElement>("[data-workspace-details-trigger]")
          ?.setAttribute("aria-expanded", "false");
      });
    }
    {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      /* A click landing on the dialog element itself is a click on the backdrop — the
         dialog's box did not catch it. */
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener("close", () => {
        one<HTMLButtonElement>("[data-roster-open]")?.setAttribute("aria-expanded", "false");
      });
    }
    one<HTMLButtonElement>("[data-close-agent-choice]")?.addEventListener("click", returnToChannel);
    one<HTMLButtonElement>("[data-agent-owner-self]")?.addEventListener("click", openConnect);
    one<HTMLButtonElement>("[data-agent-owner-teammate]")?.addEventListener(
      "click",
      () => openInvite("agent-choice"),
    );
    one<HTMLButtonElement>("[data-close-invite]")?.addEventListener("click", () => {
      if (inviteReturnView === "channel") returnToChannel();
      else openAgentChoice();
    });
    one<HTMLButtonElement>("[data-invite-done]")?.addEventListener("click", () => {
      if (one<HTMLButtonElement>("[data-copy-invite]")?.dataset.inviteComplete === "true") {
        openInvite(inviteReturnView);
        return;
      }
      resetFreshInviteResult();
      returnToChannel();
    });
    one<HTMLButtonElement>("[data-close-connect]")?.addEventListener("click", closeConnect);
    one<HTMLButtonElement>("[data-retry-workspace]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-retry-workspaces]")?.addEventListener("click", () => {
      runBoot();
    });
    one<HTMLButtonElement>("[data-refresh]")?.addEventListener("click", () => {
      if (!activeWorkspaceId) return;
      /* THE SAMPLE REFRESH REOPENS THE SAMPLE WORKSPACE, rather than asking a server that is
         not there. The control is hidden in sample mode because there is nothing to fetch,
         but the handler is the one the visible button reaches in a real workspace, and both
         now take the same step the defect lives in: advance the generation and leave the
         composer standing. */
      const current = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      if (sampleMode && current) {
        openSampleWorkspace(current);
        return;
      }
      void openWorkspace(activeWorkspaceId);
    });
    /* AUTO-LOAD OLDER ON SCROLL-UP. Deliberately drives the SAME button rather than calling
     * loadSignals directly: the button already owns the disabled state, the inline error, the
     * request-version guard and the "still here" recovery message. A second loading route would
     * be a second place for those to drift, and the two could fire concurrently.
     *
     * The anchoring that stops the viewport jumping lives in `renderFeed`, NOT here. Wrapping
     * this click was the first attempt and it was a no-op: the handler is `async` and returns at
     * its first `await`, so the measurement ran before a single row had been added. Reaching the
     * top and being thrown back down is worse than no lazy-loading at all. */
    const wireFeedAutoLoad = (): void => {
      const scroller = feedScroller();
      const button = one<HTMLButtonElement>("[data-load-older]");
      if (!scroller || !button) return;
      let pending = false;
      scroller.addEventListener("scroll", () => {
        if (pending || button.disabled || !signalHasMore) return;
        /* One viewport of headroom: fire before the reader hits the very top, so the page is
         * usually already there by the time they would have noticed the end. */
        if (scroller.scrollTop > scroller.clientHeight) return;
        pending = true;
        /* Plain click. The anchoring happens in renderFeed, where the rows actually arrive. */
        button.click();
        window.setTimeout(() => { pending = false; }, 400);
      }, { passive: true });
    };
    wireFeedAutoLoad();

    one<HTMLButtonElement>("[data-load-older]")?.addEventListener("click", async (event) => {
      if (!activeWorkspaceId || !signalHasMore) return;
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      const button = event.currentTarget as HTMLButtonElement;
      const inlineError = one<HTMLElement>("[data-load-older-error]");
      if (inlineError) {
        inlineError.textContent = "";
        inlineError.hidden = true;
      }
      button.disabled = true;
      button.textContent = "Loading older updates…";
      try {
        await loadSignals(workspaceId, false, version);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        if (inlineError) {
          inlineError.textContent = `${readableError(error)} The loaded updates are still here.`;
          inlineError.hidden = false;
        }
      } finally {
        button.disabled = false;
        button.textContent = "Load older updates";
      }
    });

    app.addEventListener("commonswarm:agent-prompt-ready", async (event) => {
      const detail = (event as CustomEvent<{
        workspaceId?: unknown;
        principalId?: unknown;
      }>).detail;
      const workspaceId = detail?.workspaceId;
      if (
        typeof workspaceId !== "string" ||
        workspaceId !== activeWorkspaceId ||
        sampleMode
      ) return;
      if (typeof detail?.principalId === "string") {
        livePromptPrincipalId = detail.principalId;
      }
      const version = requestVersion;
      try {
        const [nextAgents, nextStatuses] = await Promise.all([
          roster(workspaceId),
          agentAccessStatuses(workspaceId),
        ]);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        accessStatuses = nextStatuses;
        renderRoster();
        renderPendingAccess();
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        if (refresh) refresh.hidden = agents.length === 0;
      } catch {
        /* The mint result remains on screen; a roster refresh must never erase its secret. */
      }
    });

    app.addEventListener("commonswarm:agent-secret-cleared", (event) => {
      const detail = (event as CustomEvent<{ reason?: unknown }>).detail;
      livePromptPrincipalId = "";
      const nextWorkspaceId = pendingWorkspaceId;
      pendingWorkspaceId = "";
      const createWorkspaceNext = pendingWorkspaceCreate;
      pendingWorkspaceCreate = false;
      if (nextWorkspaceId) {
        void openWorkspace(nextWorkspaceId);
        return;
      }
      if (createWorkspaceNext && session) {
        renderCreate(session);
        return;
      }
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      syncConnectWorkspace(selected);
      returnToChannel();
      const receipt = one<HTMLElement>("[data-channel-receipt]");
      if (receipt && detail?.reason === "consumed") {
        receipt.textContent = "Agent connected. Its one-time prompt has been cleared.";
        receipt.hidden = false;
        window.setTimeout(() => {
          receipt.hidden = true;
        }, 6_000);
      }
      void agentAccessStatuses(activeWorkspaceId).then((next) => {
        if (selected.id !== activeWorkspaceId) return;
        accessStatuses = next;
        renderPendingAccess();
      });
      window.requestAnimationFrame(() => {
        /* A plain focus(): the platform's heuristic decides the ring — this runs
           after the prompt completes, so a keyboard user following the flow sees
           where focus landed and a pointer user is not decorated. */
        one<HTMLElement>("[data-channel-name]")?.focus({ preventScroll: true });
      });
    });

    const queueAuthReload = (nextSession: Session | null): void => {
      const nextUserId = nextSession?.user.id ?? "";
      if (nextUserId === renderedAuthUserId || authReloadQueued) return;
      resetWorkspaceSessionState();
      renderedAuthUserId = nextUserId;
      requestVersion += 1;
      authReloadQueued = true;
      queueMicrotask(() => {
        authReloadQueued = false;
        runBoot();
      });
    };

    /* /start now preserves its query and hash while handing old callbacks to /app, so this
       listener is the one auth-return controller for both current and compatibility links. */
    client()?.auth.onAuthStateChange((event, nextSession) => {
      if (nextSession?.user.id === renderedAuthUserId) session = nextSession;
      if (
        event === "INITIAL_SESSION" ||
        event === "SIGNED_IN" ||
        event === "SIGNED_OUT"
      ) {
        queueAuthReload(nextSession);
      }
    });

    /*
     * THIS PAGE IS NOT WHAT THE SERVER IS SERVING. Not "newer" — a rollback serves a different
     * build too, and the bar says "out of date" for exactly that reason.
     *
     * TWO signals, because neither one covers a build on its own. Measured, not assumed: a build
     * that changed only markup produced a different /app/index.html and BYTE-IDENTICAL
     * /_astro/<name>.<contenthash>.<js|css> names, so an asset-only check would have missed every
     * copy change we ship.
     *
     *  1. The served asset URLs against the ones this page is RUNNING, read out of its own DOM
     *     once, below, before any poll. This is the certain one: the code being served is not the
     *     code in this tab. It holds even for a build deployed before this page loaded.
     *  2. The served HTML against the first served HTML this tab saw. This is the one that catches
     *     a markup-only build, and it can only see changes made after the first poll.
     *
     * The served page rather than a generated build id: a build id is a CLAIM about the build, and
     * a stale or half-deployed one would lie in exactly the case this exists for. These bytes ARE
     * the build, and there is no new constant to keep in step.
     *
     * NOT covered: a build deployed in the gap between this document loading and the first poll,
     * which changed markup only. Signal 1 sees nothing (same assets) and signal 2 baselines the
     * new page. The next build after it is detected normally.
     */
    const buildAssetsFrom = (root: ParentNode): string => {
      const urls = new Set<string>();
      for (const node of root.querySelectorAll<HTMLElement>("script[src], link[href]")) {
        const raw = node.getAttribute("src") ?? node.getAttribute("href") ?? "";
        if (/\/_astro\/[^"']+\.(?:js|css)$/.test(raw)) urls.add(raw);
      }
      return [...urls].sort().join("\n");
    };
    const runningBuild = buildAssetsFrom(document);
    /* OUR markup, not the whole document. Comparing the entire served HTML would flap on bytes
       that are not ours: an injected analytics or preview toolbar, a per-request id from a proxy.
       Everything this build renders lives inside <live-dashboard>, and anything injected around
       it does not, so this is the part of the page a deploy actually changes. */
    const buildMarkupFrom = (root: ParentNode): string =>
      root.querySelector("live-dashboard")?.outerHTML ?? "";
    let baselineMarkup = "";
    /* One poll at a time: two in flight can settle out of order and baseline the wrong page.
       But DROPPING the second request is wrong too — coming back to the tab while a poll is
       still open is exactly when a reader wants an answer, and the next timer tick is five
       minutes away. So the request is remembered and run once the open one finishes. */
    let pollInFlight = false;
    let pollRequested = false;
    /* NOT the empty string. "nothing dismissed yet" has to be a value no served build can equal,
       or a probe that returns nothing compares equal to it and reads as already dismissed. */
    let dismissedBuild: string | null = null;
    let servedBuild = "";
    /* THE READER'S LAST ACTION, counted. A poll answers about the server as it was when its
       request went out, so an answer that arrives after the reader has acted is older than the
       action. Same shape as `requestVersion` above, which drops workspace responses that a later
       switch has overtaken; kept separate because bumping that one would cancel unrelated work. */
    let noticeActionVersion = 0;

    const showUpdateNotice = (show: boolean): void => {
      const notice = one<HTMLElement>("[data-update-notice]");
      if (notice) notice.hidden = !show;
    };

    /* Silence is the only honest output of a probe that did not reach what it measures. A failed
     * fetch, a non-OK status, and a body with no hashed assets in it — a login redirect, an SSO
     * interstitial, an error page — all mean the poll learned nothing, not that nothing changed. */
    const checkForNewBuild = async (): Promise<void> => {
      if (!runningBuild) return;
      if (pollInFlight) {
        pollRequested = true;
        return;
      }
      pollInFlight = true;
      /* Captured before the request goes out, checked when its answer comes back. */
      const version = noticeActionVersion;
      let body = "";
      try {
        /* PATHNAME ONLY, deliberately. This URL receives auth callbacks — the client runs with
           `detectSessionInUrl`, and /start hands old callbacks here with their query intact — so
           replaying the query would re-send a one-time code to the server. The site is static
           output, so the query cannot change which bytes this path returns anyway. */
        const response = await fetch(window.location.pathname, {
          cache: "no-store",
          credentials: "same-origin",
          headers: { accept: "text/html" },
        });
        if (!response.ok) return;
        body = await response.text();
      } catch {
        return;
      } finally {
        pollInFlight = false;
        if (pollRequested) {
          pollRequested = false;
          void checkForNewBuild();
        }
      }
      /* THE READER MOVED WHILE THIS WAS OPEN, so this answer is older than what they acted on and
         none of it is applied: not the baseline, not the dismissal, not the reset below. MEASURED
         (see `a poll that was already open when Not now was clicked does not undo it`): a poll
         held open across a Not now click came back with "the same build you are running", cleared
         the dismissal through the reset, and the build the reader had just dismissed raised the
         bar again. Nothing is lost by dropping it — the next poll asks about the server as it is
         after the click, and the `finally` above has already started one if a poll was queued. */
      if (version !== noticeActionVersion) return;
      const page = new DOMParser().parseFromString(body, "text/html");
      const served = buildAssetsFrom(page);
      if (!served) return;
      const markup = buildMarkupFrom(page);
      /* IS THIS EVEN OUR PAGE? `fetch` follows redirects, so a sign-in wall or an SSO gate can
         answer 200 with a page of its own — and if that page is also built with Astro it carries
         /_astro/ URLs and clears the check above. No <live-dashboard> means the probe did not
         reach the app, which is not news about a deploy. */
      if (!markup) return;
      if (!baselineMarkup) baselineMarkup = markup;
      /* BOTH parts, always. Branching on which one differs made a dismissal hide later builds:
       * dismissing an asset change stored the asset set, and the next build that changed only
       * markup carried that same asset set and compared equal to it. */
      servedBuild = `${served}\n${markup}`;
      const isNewBuild = served !== runningBuild || markup !== baselineMarkup;
      if (!isNewBuild) {
        /* WHAT THIS RESET IS ALLOWED TO DO, AND WHEN. It clears the reader's dismissal, and it
           may do that only from a poll that started after the reader's last action — which is
           what the version check above enforces. Within that limit it is needed: without it a
           rollback stranded the dismissal, because after dismissing B and rolling back to A, B
           shipping again still equalled the remembered value and was swallowed for the life of
           the tab. Outside it, it is the branch that silently undid the reader's click. */
        dismissedBuild = null;
        showUpdateNotice(false);
        return;
      }
      /* Dismissal is remembered against what caused it, in memory only: a reload takes the new
       * build anyway, so there is nothing to persist, and a THIRD build differs from the
       * dismissed one and asks again. */
      showUpdateNotice(servedBuild !== dismissedBuild);
    };

    one<HTMLButtonElement>("[data-update-reload]")?.addEventListener("click", () => {
      window.location.reload();
    });
    one<HTMLButtonElement>("[data-update-dismiss]")?.addEventListener("click", () => {
      /* The reader has acted on what is on screen now. Any poll already open asked the server
         before this, so it is retired here rather than allowed to answer over the click. */
      noticeActionVersion += 1;
      dismissedBuild = servedBuild;
      showUpdateNotice(false);
    });

    /* Only while the document is visible. A hidden tab is not being read, and the reload happens
     * on the reader's schedule rather than ours. */
    const UPDATE_POLL_MS = 5 * 60_000;
    let updatePollTimer = 0;
    const stopUpdatePoll = (): void => {
      if (!updatePollTimer) return;
      window.clearInterval(updatePollTimer);
      updatePollTimer = 0;
    };
    const startUpdatePoll = (): void => {
      if (updatePollTimer || document.visibilityState !== "visible") return;
      updatePollTimer = window.setInterval(() => void checkForNewBuild(), UPDATE_POLL_MS);
      void checkForNewBuild();
    };
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") startUpdatePoll();
      else stopUpdatePoll();
    });
    startUpdatePoll();

    runBoot();
  }
</script>

<style is:global>
  .dashboard {
    --dashboard-rail: 18.5rem;
    position: relative;
    display: block;
    min-block-size: var(--dashboard-viewport-height, 100dvh);
    color: var(--text);
    background: var(--bg);
    isolation: isolate;
  }

  .dashboard__wash {
    position: fixed;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        55rem 34rem at 4% -8%,
        color-mix(in oklab, var(--accent) 13%, transparent),
        transparent 72%
      ),
      linear-gradient(
        90deg,
        transparent 0,
        transparent calc(50% - 1px),
        color-mix(in oklab, var(--border) 30%, transparent) 50%,
        transparent calc(50% + 1px)
      );
    background-size: auto, 5rem 100%;
    mask-image: linear-gradient(to bottom, black, transparent 76%);
  }

  .dashboard[data-state="channel"] .dashboard__wash {
    display: none;
  }

  .dashboard [hidden] {
    display: none !important;
  }

  .dashboard__root {
    min-block-size: var(--dashboard-viewport-height, 100dvh);
  }

  .dashboard[data-state="channel"],
  .dashboard[data-state="channel"] .dashboard__root {
    block-size: var(--dashboard-viewport-height, 100dvh);
    min-block-size: 0;
    overflow: hidden;
  }

  .dashboard__loading {
    min-block-size: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__spinner {
    display: inline-block;
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
    border: 2px solid var(--border-strong);
    border-block-start-color: var(--accent);
    border-radius: 50%;
    animation: dashboard-spin 700ms linear infinite;
  }

  @keyframes dashboard-spin {
    to {
      transform: rotate(1turn);
    }
  }

  .dashboard__wordmark {
    inline-size: fit-content;
    color: var(--text);
    font-size: var(--t-base);
    line-height: 1;
    font-weight: var(--weight-head);
    letter-spacing: var(--track-head);
    text-decoration: none;
    white-space: nowrap;
  }

  .dashboard__wordmark::after {
    content: "";
    display: block;
    inline-size: 1.45rem;
    block-size: 3px;
    margin-block-start: var(--s-2);
    border-radius: var(--radius-pill);
    background: var(--accent);
    transition: inline-size var(--dur-2) var(--ease-standard);
  }

  .dashboard__wordmark:hover::after {
    inline-size: 100%;
  }

  .dashboard__gateway {
    min-block-size: 100svh;
    display: grid;
    align-content: center;
    gap: var(--s-8);
    inline-size: min(100% - var(--gutter) * 2, 42rem);
    margin-inline: auto;
    padding-block: var(--s-12);
  }

  .dashboard__gateway-copy {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__eyebrow,
  .dashboard__channel-kicker {
    margin: 0;
    color: var(--accent-bright);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__gateway h1 {
    max-inline-size: 16ch;
    margin: 0;
    font-size: clamp(var(--t-2xl), 6vw, var(--t-4xl));
    line-height: 1.02;
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
    text-wrap: balance;
  }

  .dashboard__gateway-copy > p:last-child {
    max-inline-size: 55ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    text-wrap: pretty;
  }

  .dashboard__auth,
  .dashboard__create-form {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .dashboard__button,
  .dashboard__icon-button,
  .dashboard__workspace-trigger,
  .dashboard__workspace-button,
  .dashboard__workspace-create-button,
  .dashboard__rail-add,
  .dashboard__back-button,
  .dashboard__roster-button,
  .dashboard__text-button {
    font: inherit;
  }

  .dashboard__model-editor {
    inline-size: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-start: var(--s-2);
  }

  .dashboard__model-editor input {
    flex: 1;
    min-inline-size: 0;
    padding: var(--s-1) var(--s-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 6px);
    background: var(--surface-2);
    color: var(--text);
    font-size: var(--t-xs);
  }

  .dashboard__button {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: var(--t-sm);
    line-height: 1;
    font-weight: var(--weight-semibold);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard),
      transform var(--dur-2) var(--ease-standard);
  }

  .dashboard__button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .dashboard__button:disabled {
    opacity: 0.58;
    cursor: wait;
  }

  .dashboard__button--primary {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .dashboard__button--primary:hover:not(:disabled) {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  .dashboard__button--secondary {
    color: var(--text);
    background: var(--elev-2);
    border-color: var(--border-interactive);
  }

  .dashboard__text-button,
  .dashboard__back-button {
    min-block-size: 2.75rem;
    padding: var(--s-2);
    color: var(--text-muted);
    background: transparent;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .dashboard__text-button {
    white-space: nowrap;
  }

  .dashboard__text-button:hover,
  .dashboard__back-button:hover {
    color: var(--text);
  }

  .dashboard__email {
    display: grid;
    gap: var(--s-3);
    max-inline-size: 38rem;
  }

  .dashboard__email label {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__email-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-3);
  }

  .dashboard__auth-note {
    max-inline-size: 58ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__auth-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-faint);
    font-size: var(--t-xs);
  }

  .dashboard__auth-divider::before,
  .dashboard__auth-divider::after {
    content: "";
    block-size: 1px;
    background: var(--border);
  }

  .dashboard__email input,
  .dashboard__create-form input {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-base);
  }

  .dashboard__email-sent {
    display: grid;
    gap: var(--s-2);
    max-inline-size: 38rem;
    padding: var(--s-5);
    border: 1px solid var(--accent-dim);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent-dim) 48%, var(--elev-1));
  }

  .dashboard__email-sent p {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-base);
  }

  .dashboard__email-sent-title {
    color: var(--text) !important;
    font-weight: var(--weight-semibold);
  }

  .dashboard__form-error {
    max-inline-size: 56ch;
    margin: 0;
    color: var(--danger);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__legal-note {
    max-inline-size: 42rem;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__legal-note a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .dashboard__account-line {
    inline-size: fit-content;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__account-dot {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-dim);
  }

  .dashboard__create-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .dashboard__gateway--create h1 {
    max-inline-size: 22ch;
  }

  .dashboard__gateway--create .dashboard__gateway-copy > p:last-child {
    max-inline-size: 48ch;
    line-height: var(--lh-sm);
  }

  .dashboard__signout-link {
    inline-size: fit-content;
  }

  .dashboard__product {
    block-size: var(--dashboard-viewport-height, 100dvh);
    min-block-size: 0;
    display: grid;
    /* Three rows, and every child is pinned to one of them. A hidden notice is not a grid item
       at all, so its row collapses to zero and nothing below it moves; pinning is what keeps a
       shown notice from pushing the frame out of the viewport row. */
    grid-template-rows: auto auto minmax(0, 1fr);
    overflow: hidden;
    padding: 0;
    background: var(--bg);
  }

  .dashboard__sample-notice {
    grid-row: 2;
    margin: 0;
  }

  /* ONE ROW, and it earns its height only while a different build is actually being served.
     This bar sits above the app bar on a phone, which is the space the 2026-09-04 mobile work
     was for, so it stays on one line: nothing wraps, the sentence truncates before the controls
     give way, and the controls keep their 44px targets. Measured at 390x844: 128px when the
     sentence wrapped and "Not now" wrapped inside its own button, 53px after, and 53px at
     320x568 too. */
  .dashboard__update-notice {
    grid-row: 1;
    /* A grid item's automatic minimum is its MIN-CONTENT width, so without this the bar sizes
       to its buttons and overflows the column instead of being constrained by it. Measured at
       320x568 before this line: the bar was 394.6px in a 320px shell, and the product clips its
       overflow, so the Update button was off-screen and unreachable. */
    min-inline-size: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin: 0;
    padding: var(--s-1) var(--s-4);
    border-block-end: 1px solid var(--border);
    background: var(--surface);
  }

  /* The sentence is the flexible column and the only one allowed to run out of room. */
  .dashboard__update-notice-text {
    flex: 1 1 auto;
    margin: 0;
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text);
    font-size: var(--t-sm);
  }

  /* The controls are the column that must never give way: the sentence above truncates first. */
  .dashboard__update-notice-actions {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .dashboard__update-notice-actions .dashboard__button {
    white-space: nowrap;
  }

  .dashboard__frame {
    /* BLOCK-SIZE, not only min-block-size. With a minimum alone the grid row sizes to CONTENT, so
     * the whole app grew to the height of the transcript — measured 14,907px against an 846px
     * viewport — and the PAGE scrolled instead of the transcript. `overflow: hidden` below was
     * already here and was doing nothing, because nothing ever exceeded a bound that did not
     * exist. Measured in the browser before and after. */
    block-size: 100%;
    min-block-size: 0;
    /* A hidden notice is not a grid item. Pin the frame to the LAST row so it still takes the
       minmax viewport row instead of auto-placing into a content-sized notice row. Row 1 is the
       update notice and row 2 the sample notice; both are pinned below. */
    grid-row: 3;
    display: grid;
    grid-template-columns: var(--dashboard-rail) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    box-shadow: none;
  }

  .dashboard__frame--entity-panel {
    grid-template-columns: var(--dashboard-rail) minmax(0, 1fr) minmax(18rem, 22rem);
  }

  .dashboard__sample-notice:not([hidden]) + .dashboard__frame {
    /* BOTH axes of the constraint, or this rule stops working. It set only min-block-size, which
     * was enough while the frame had no block-size — the frame grew to content and the minimum
     * was the only thing holding it up. Now that the frame is pinned to 100svh, a minimum alone
     * cannot SHRINK it, so the sample notice would push the frame's last 3.5rem below the fold. */
    block-size: 100%;
    min-block-size: 0;
  }

  .dashboard__rail {
    min-inline-size: 0;
    max-block-size: var(--dashboard-viewport-height, 100dvh);
    display: flex;
    flex-direction: column;
    padding: var(--s-5) var(--s-4) var(--s-4);
    overflow-y: auto;
    border-inline-end: 1px solid var(--border);
    background: var(--bg-raised);
  }

  .dashboard__rail .dashboard__wordmark {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    letter-spacing: -0.02em;
  }

  .dashboard__rail .dashboard__wordmark::after {
    display: none;
  }

  .dashboard__workspace-control {
    position: relative;
    z-index: 4;
    min-inline-size: 0;
    display: flex;
    align-items: stretch;
    gap: var(--s-2);
  }

  .dashboard__workspace-trigger {
    flex: 1 1 auto;
    min-inline-size: 0;
    min-block-size: 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    text-align: start;
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__workspace-trigger:hover,
  .dashboard__workspace-trigger[aria-expanded="true"] {
    background: var(--surface);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }

  .dashboard__workspace-trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__workspace-trigger-name {
    min-inline-size: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--t-base);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.035em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__workspace-trigger svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    transition: transform var(--dur-2) var(--ease-standard);
  }

  .dashboard__workspace-trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .dashboard__workspace-menu {
    position: absolute;
    inset-block-start: calc(100% + var(--s-2));
    inset-inline: 0;
    z-index: 6;
    min-inline-size: 15rem;
    padding: var(--s-2);
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 1rem 2.5rem color-mix(in oklab, var(--text) 14%, transparent);
  }

  /* Toothed gear beside the workspace name — opens workspace settings. */
  .dashboard__gear-button {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    min-block-size: 3rem;
    color: var(--text-muted);
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      color var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__gear-button:hover,
  .dashboard__gear-button[aria-expanded="true"] {
    color: var(--text);
    background: var(--surface);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }

  .dashboard__gear-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__gear-button svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  /* Account popover. Workspace settings is a native dialog outside the rail. */
  .dashboard__popover {
    position: absolute;
    z-index: 6;
    min-inline-size: 15rem;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-3);
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 1rem 2.5rem color-mix(in oklab, var(--text) 14%, transparent);
  }

  .dashboard__workspace-details-dialog {
    inline-size: min(calc(100% - var(--s-8)), 23rem);
    max-inline-size: calc(100% - var(--s-8));
    max-block-size: min(42rem, calc(100dvh - var(--s-8)));
    margin: auto;
    padding: 0;
    color: var(--text);
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dashboard__workspace-details-dialog::backdrop {
    background: color-mix(in oklab, var(--text) 32%, transparent);
  }

  .dashboard__workspace-details-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: dashboard-dialog-in var(--dur-3) var(--ease-decelerate);
  }

  .dashboard__workspace-details-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__workspace-details-dialog-head p {
    margin: 0;
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__workspace-details-dialog-body {
    min-block-size: 0;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    overflow-y: auto;
  }

  .dashboard__workspace-settings-title,
  .dashboard__workspace-danger h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-sm);
  }

  .dashboard__workspace-settings-counts,
  .dashboard__workspace-danger p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: 1.5;
  }

  .dashboard__workspace-danger {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-2);
    padding-block-start: var(--s-3);
    border-block-start: 1px solid color-mix(in oklab, var(--danger) 45%, var(--border));
  }

  .dashboard__workspace-danger form,
  .dashboard__workspace-danger label {
    display: grid;
    gap: var(--s-2);
  }

  .dashboard__workspace-danger label {
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__workspace-danger input {
    min-inline-size: 0;
    inline-size: 100%;
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font: inherit;
  }

  .dashboard__workspace-danger input:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__danger-button {
    justify-self: start;
    padding: var(--s-2) var(--s-3);
    color: var(--danger-ink);
    background: var(--danger);
    border: 1px solid color-mix(in oklab, var(--danger) 72%, black);
    border-radius: var(--radius);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .dashboard__danger-button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .dashboard__popover-label {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Account button + menu at the rail foot. */
  .dashboard__user-trigger {
    inline-size: 100%;
    min-inline-size: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    text-align: start;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__user-trigger:hover,
  .dashboard__user-trigger[aria-expanded="true"] {
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    border-color: var(--border);
  }

  .dashboard__user-trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__user-trigger-name {
    min-inline-size: 0;
    overflow: hidden;
    font-size: var(--t-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__user-trigger svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .dashboard__user-menu {
    inset-block-end: calc(100% + var(--s-2));
    inset-inline: 0;
  }

  .dashboard__user-menu-item,
  .dashboard__user-menu-brand {
    justify-self: start;
  }

  .dashboard__user-menu-brand {
    margin-block-start: var(--s-1);
    padding-block-start: var(--s-2);
    border-block-start: 1px solid var(--border);
    inline-size: 100%;
  }

  .dashboard__workspace-context {
    display: grid;
    gap: var(--s-1);
    /* --s-1 inline, not --s-2. Measured: the rail had FOUR text insets — labels and item rows at
     * 20px, this counts line at 24, the ownership note at 28 — so text began somewhere different
     * in every block. One inset gives the eye a single left edge to follow down the rail. */
    padding: var(--s-3) var(--s-1) var(--s-4);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__workspace-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-1);
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    line-height: var(--lh-xs);
  }

  .dashboard__workspace-summary strong {
    color: inherit;
    font-weight: var(--weight-semibold);
  }

  .dashboard__sample-chip {
    padding: 0.2rem 0.45rem;
    color: var(--warning);
    background: var(--warning-dim);
    border-radius: var(--radius-pill);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__rail-section {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-1);
    border-block-start: 0;
  }

  .dashboard__rail-section + .dashboard__rail-section {
    border-block-start: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
  }

  /* The roster fills the rail's leftover height instead of sitting content-tall
     with dead space beneath it: the participants section grows, its list takes
     the slack and scrolls when the roster is long, and the ownership note stays
     pinned at the bottom. min-block-size:0 lets the inner list actually scroll
     inside a flex/grid parent rather than overflow the rail. */
  .dashboard__rail-section--participants {
    flex: 1 1 auto;
    min-block-size: 0;
    grid-template-rows: auto 1fr auto;
  }

  .dashboard__rail-section--participants .dashboard__sidebar-agent-list {
    min-block-size: 0;
    /* Override the base 14rem cap: in the sidebar the roster is the 1fr row of a
       flex:1 section, so it should take ALL the rail's leftover height and scroll
       within that — not clip at ~5 rows with dead space beneath. The 14rem cap is
       for the header-dialog copy of this list, which is not inside a growing rail. */
    max-block-size: none;
    overflow-y: auto;
    align-content: start;
  }

  .dashboard__rail-details-body {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__rail-details {
    padding-block: var(--s-4);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__rail-details > summary {
    min-block-size: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__rail-details > summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__rail-details-body {
    padding-block-start: var(--s-3);
  }

  .dashboard__workspace-id {
    max-inline-size: 100%;
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__copy-status {
    min-block-size: 1em;
    color: var(--text-muted);
    font-size: var(--t-2xs);
  }

  .dashboard__rail-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__rail-label-row h2,
  .dashboard__rail-label-row span {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__rail-label-row h2 span {
    color: var(--text-faint);
    font-size: inherit;
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .dashboard__sidebar-place {
    min-block-size: 2.25rem;
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    color: var(--text);
    border-radius: var(--radius-sm);
    font-size: var(--t-sm);
    font-weight: var(--weight-medium);
    inline-size: 100%;
    background: transparent;
    border: 0;
    font-family: inherit;
    text-align: start;
    cursor: pointer;
  }

  .dashboard__sidebar-place:hover,
  .dashboard__sidebar-place[aria-current="page"] {
    background: var(--elev-2);
  }

  .dashboard__sidebar-place:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__sidebar-place-mark {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-base);
    text-align: center;
  }

  .dashboard__sidebar-agent-list {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__sidebar-agent-list {
    max-block-size: 14rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }

  .dashboard__sidebar-owner-group,
  .dashboard__sidebar-owner-agents {
    min-inline-size: 0;
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__sidebar-owner-group + .dashboard__sidebar-owner-group {
    margin-block-start: var(--s-1);
  }

  /* Indentation carries ownership without adding another rail divider or repeated caption. */
  .dashboard__sidebar-owner-agents {
    margin-inline-start: 0.875rem;
    padding-inline-start: var(--s-3);
  }

  .dashboard__sidebar-person,
  .dashboard__sidebar-agent {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
  }

  .dashboard__sidebar-person--unresolved {
    color: var(--text-muted);
  }

  .dashboard__sidebar-unresolved-mark {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    background: var(--surface);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
  }

  .dashboard__sidebar-person--unresolved > strong {
    overflow: hidden;
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__sidebar-person-avatar {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    display: grid;
    place-items: center;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: var(--weight-semibold);
  }

  .dashboard__sidebar-model-mark {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    display: grid;
    place-items: center;
    color: var(--text-muted);
  }

  .dashboard__sidebar-model-glyph {
    inline-size: 0.875rem;
    block-size: 0.875rem;
  }

  .dashboard__sidebar-avatar-wrap {
    position: relative;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    display: grid;
    place-items: center;
  }

  .dashboard__presence-dot {
    position: absolute;
    inset-inline-end: -0.08rem;
    inset-block-end: -0.08rem;
    inline-size: 0.52rem;
    block-size: 0.52rem;
    border: 2px solid var(--bg-raised);
    border-radius: 50%;
    background: var(--success);
  }

  .dashboard__sidebar-participant-copy {
    min-inline-size: 0;
    display: grid;
    gap: 0.08rem;
  }

  .dashboard__sidebar-participant-copy > strong {
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__sidebar-agent .dashboard__sidebar-participant-copy > strong {
    font-weight: var(--weight-medium);
  }

  .dashboard__sidebar-participant-copy > span {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: var(--s-1);
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.62rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__sidebar-participant-copy > .dashboard__sidebar-orphan-owner {
    color: var(--text-faint);
  }

  .dashboard__agent-ownership-note {
    /* Inline margin dropped to meet the rail's single text inset — it sat 8px further in. */
    margin: var(--s-1) 0 0;
    color: var(--text-faint);
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .dashboard__workspace-list {
    display: grid;
    gap: var(--s-1);
    max-block-size: min(40svh, 20rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .dashboard__workspace-button,
  .dashboard__workspace-create-button {
    min-inline-size: 0;
    min-block-size: 2.25rem;
    display: grid;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    text-align: start;
    cursor: pointer;
  }

  .dashboard__workspace-button {
    inline-size: 100%;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .dashboard__workspace-button > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__workspace-button:hover,
  .dashboard__workspace-create-button:hover {
    color: var(--text);
    background: var(--elev-2);
  }

  .dashboard__workspace-button:focus-visible,
  .dashboard__workspace-create-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__workspace-button[aria-checked="true"] {
    color: var(--text);
    background: color-mix(in oklab, var(--text) 6%, transparent);
  }

  .dashboard__workspace-check {
    color: var(--accent);
    opacity: 0;
  }

  .dashboard__workspace-button[aria-checked="true"] .dashboard__workspace-check {
    opacity: 1;
  }

  .dashboard__workspace-menu-create {
    margin-block-start: var(--s-2);
    padding-block-start: var(--s-2);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__workspace-create-button {
    inline-size: 100%;
    grid-template-columns: auto minmax(0, 1fr);
    color: var(--text);
    font-weight: var(--weight-medium);
  }

  .dashboard__workspace-create-button > span:first-child {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--t-base);
  }

  .dashboard__agent-list {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__agent {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
  }

  [data-member-list] > .dashboard__agent {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  [data-member-list] > .dashboard__agent > span {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Pending rows have copy first and an action second (unlike roster rows, whose
     first cell is an avatar). Give the action its intrinsic width so "Cancel"
     stays horizontal while the identity copy takes the remaining space. */
  .dashboard__pending-access-row {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .dashboard__pending-access-row > .dashboard__text-button {
    white-space: nowrap;
  }

  .dashboard__agent-avatar,
  .dashboard__message-avatar {
    inline-size: 2rem;
    block-size: 2rem;
    display: grid;
    place-items: center;
    flex: none;
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
  }

  /* The tint carries the per-agent identity now that the shape is fixed to the circle.
     Initials use --text rather than a pastel of the hue: the pastel was tuned for the
     dark palette and washed out on the light tint, while --text clears 16:1 on every
     surface in both modes. The hue still distinguishes agents in the fill and the ring. */
  .dashboard__agent-avatar.dashboard__avatar--tinted,
  .dashboard__message-avatar.dashboard__avatar--tinted {
    color: var(--text);
    background: color-mix(in oklab, hsl(var(--avatar-hue) 58% 48%) 20%, var(--elev-3));
    border-color: color-mix(in oklab, hsl(var(--avatar-hue) 70% 58%) 52%, var(--border));
  }

  .dashboard__agent-copy {
    min-inline-size: 0;
    display: grid;
  }

  .dashboard__agent-copy strong {
    overflow: hidden;
    color: var(--text);
    font-size: var(--t-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__agent-copy span,
  .dashboard__agent-empty {
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__agent-copy > .dashboard__grant-standing-copy {
    color: var(--text);
    line-height: 1.4;
  }

  .dashboard__agent-copy > .dashboard__grant-risk {
    inline-size: max-content;
    margin-block-start: var(--s-1);
    padding: 0.1rem 0.35rem;
    color: var(--warning-text, var(--text));
    background: var(--warning-dim, var(--elev-3));
    border: 1px solid var(--warning, var(--border-strong));
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: var(--weight-semibold);
  }

  .dashboard__agent-empty {
    padding: var(--s-2) var(--s-3);
    font-style: italic;
  }

  .dashboard__rail-add {
    min-block-size: 2.75rem;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: start;
    cursor: pointer;
  }

  .dashboard__rail-add:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .dashboard__rail-foot {
    position: relative;
    display: grid;
    gap: var(--s-3);
    /* No margin-block-start:auto here on purpose. The owner-grouped roster is back in the
       sidebar (dashboard__rail-section--participants, flex:1), and that section growing is
       what pushes the footer down — an auto margin would win over its flex-grow and eat the
       slack, leaving the roster content-tall with dead space beneath it. */
    padding: var(--s-3) var(--s-2) 0;
    border-block-start: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__rail-account {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__theme-toggle {
    inline-size: fit-content;
    min-block-size: 2rem;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    color: var(--text-muted);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    cursor: pointer;
  }

  .dashboard__theme-toggle:hover {
    color: var(--text);
    background: var(--surface);
  }

  .dashboard__theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__theme-toggle svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .dashboard__theme-toggle path {
    fill: currentColor;
    stroke: none;
  }

  .dashboard__rail-account > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__channel {
    min-inline-size: 0;
    /* The BLOCK axis needs it too. A grid item defaults to min-height:auto and refuses to shrink
     * below its content, which keeps the column taller than its track no matter what the frame
     * does. */
    min-block-size: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: var(--surface);
  }

  .dashboard__entity-panel {
    min-inline-size: 0;
    max-block-size: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    background: var(--surface-3);
    border-inline-start: 1px solid var(--border);
  }

  .dashboard__entity-panel-head {
    min-block-size: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__entity-panel-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__entity-panel-body {
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* An id or a tool name is one long word. It wraps rather than being cut or pushing the
     * panel wider than the screen. */
    overflow-wrap: anywhere;
  }

  .dashboard__entity-identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-4);
  }

  .dashboard__entity-avatar {
    inline-size: 3rem;
    block-size: 3rem;
    display: grid;
    place-items: center;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__entity-avatar.dashboard__avatar--tinted {
    background: color-mix(in oklab, hsl(var(--avatar-hue) 58% 48%) 20%, var(--surface-2));
    border-color: color-mix(in oklab, hsl(var(--avatar-hue) 70% 58%) 52%, var(--border));
  }

  .dashboard__entity-identity h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-badge {
    color: var(--text-muted);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-xs);
  }

  .dashboard__entity-revoked {
    margin: 0 var(--s-4) var(--s-4);
    padding: var(--s-3);
    color: var(--danger);
    background: var(--danger-dim);
    border: 1px solid color-mix(in oklab, var(--danger) 42%, var(--border));
    border-radius: var(--radius-sm);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__entity-live {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4);
    background: color-mix(in oklab, var(--accent-dim) 22%, var(--surface));
    border-block-start: 1px solid var(--border);
  }

  .dashboard__entity-live > header,
  .dashboard__entity-live-title {
    display: flex;
    align-items: center;
  }

  .dashboard__entity-live > header {
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__entity-live-title {
    gap: var(--s-2);
  }

  .dashboard__entity-live h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__entity-live > header > span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
  }

  .dashboard__entity-live-dot {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    background: var(--text-faint);
    border-radius: 50%;
  }

  .dashboard__entity-live[data-activity-state="fresh"] .dashboard__entity-live-dot {
    background: var(--accent);
    box-shadow: 0 0 0 0.2rem var(--accent-dim);
  }

  .dashboard__entity-live[data-activity-state="stale"] .dashboard__entity-live-dot {
    background: var(--text-muted);
  }

  .dashboard__entity-live-empty {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: var(--lh-body);
  }

  .dashboard__entity-live dl {
    display: grid;
    grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr);
    gap: var(--s-2) var(--s-3);
    margin: 0;
    font-size: var(--t-xs);
  }

  .dashboard__entity-live dt {
    color: var(--text-muted);
  }

  .dashboard__entity-live dd {
    min-inline-size: 0;
    margin: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-section {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-4);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__entity-section h3 {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__entity-section > p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__entity-link,
  .dashboard__entity-agent-link,
  .dashboard__message-entity {
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
    font-weight: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
    text-underline-offset: 0.16em;
    cursor: pointer;
  }

  .dashboard__entity-link:hover,
  .dashboard__entity-agent-link:hover,
  .dashboard__message-entity:hover {
    color: var(--accent-bright);
    text-decoration-color: currentColor;
  }

  .dashboard__entity-link:focus-visible,
  .dashboard__entity-agent-link:focus-visible,
  .dashboard__message-entity:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__entity-section dl {
    display: grid;
    grid-template-columns: minmax(6rem, auto) minmax(0, 1fr);
    gap: var(--s-2) var(--s-3);
    margin: 0;
    font-size: var(--t-xs);
  }

  .dashboard__entity-section dt {
    color: var(--text-muted);
  }

  .dashboard__entity-section dd {
    min-inline-size: 0;
    margin: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-id summary {
    inline-size: fit-content;
    color: var(--text);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  .dashboard__entity-id code {
    display: block;
    margin-block-start: var(--s-2);
    color: var(--text-muted);
    font-size: var(--t-2xs);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-agent-list {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    list-style: none;
  }

  .dashboard__entity-agent-link {
    color: var(--text);
  }

  .dashboard__channel-head {
    min-block-size: 4.75rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-3) clamp(var(--s-5), 4vw, var(--s-8));
    border-block-end: 1px solid var(--border);
  }

  .dashboard__channel-titleblock {
    min-inline-size: 0;
    display: grid;
    gap: var(--s-1);
  }

  .dashboard__channel-kicker {
    margin-block-end: var(--s-1);
    font-size: var(--t-2xs);
  }

  .dashboard__channel-head h1 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--t-lg);
    line-height: var(--lh-xl);
    letter-spacing: var(--track-head);
    overflow-wrap: anywhere;
  }

  .dashboard__channel-description {
    max-inline-size: 64ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
  }

  .dashboard__channel-actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
    white-space: nowrap;
  }

  /* The live affordance: the same pulse idiom the landing FeedPanel uses for a
     signal that just landed, reused here as a standing state. motion.css stills
     the pulse under prefers-reduced-motion; the dot itself stays. */
  .dashboard__live {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    /* Same flex-child floor as the choice copy: the chip must be allowed to give
       up width (and let the actions row wrap below 34rem) rather than hold it. */
    min-inline-size: 0;
    color: var(--success);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__live-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    animation: dashboard-live-pulse 2.6s var(--ease-standard) infinite;
  }

  @keyframes dashboard-live-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--success-dim);
    }
    70% {
      box-shadow: 0 0 0 6px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* --- the header agent roster: one stack button + its dialog ----------------------- */

  /* The stack sits between the title and the actions while there is room, glued right;
     at ≤52rem it takes its own row (see the media query) so it never squeezes out. */
  .dashboard__channel-roster {
    flex: none;
    min-inline-size: 0;
    margin-inline-start: auto;
  }

  .dashboard__roster-button {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__roster-button:hover {
    background: var(--elev-3);
    border-color: var(--border-strong);
  }

  .dashboard__roster-button--pending {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }

  .dashboard__roster-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__roster-stack {
    display: flex;
    align-items: center;
  }

  /* The overlap ring reads as a cut between neighbours when it matches the button's own
     fill, so it follows the hover fill too. */
  .dashboard__roster-stack .dashboard__agent-avatar {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 2px solid var(--elev-2);
    margin-inline-start: -0.5rem;
  }

  .dashboard__roster-stack .dashboard__agent-avatar:first-child {
    margin-inline-start: 0;
  }

  .dashboard__roster-button:hover .dashboard__roster-stack .dashboard__agent-avatar {
    border-color: var(--elev-3);
  }

  .dashboard__roster-count {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  /* The dialog. Native <dialog>: the UA centers it over a backdrop and owns Escape,
     focus containment, and focus restore; the styles only make it ours. At ≤52rem the
     same element becomes a bottom sheet rather than a second component. */
  .dashboard__roster-dialog {
    inline-size: min(calc(100% - var(--s-8)), 26rem);
    max-inline-size: calc(100% - var(--s-8));
    max-block-size: min(42rem, calc(100dvh - var(--s-8)));
    /* global.css's universal * { margin: 0 } beats the UA's dialog-centering margin:auto,
       so centering is restated here; the ≤52rem sheet re-anchors it to the bottom. */
    margin: auto;
    padding: 0;
    color: var(--text);
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dashboard__roster-dialog::backdrop {
    background: color-mix(in oklab, var(--text) 32%, transparent);
  }

  .dashboard__roster-dialog[open] {
    animation: dashboard-dialog-in var(--dur-3) var(--ease-decelerate);
  }

  @keyframes dashboard-dialog-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .dashboard__roster-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__roster-dialog-head h2 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text);
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    letter-spacing: var(--track-head);
  }

  .dashboard__roster-dialog-count {
    color: var(--text-muted);
    font-size: var(--t-sm);
    font-weight: var(--weight-medium);
  }

  .dashboard__roster-dialog-body {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5) var(--s-5);
  }

  .dashboard__roster-dialog-add {
    inline-size: 100%;
  }

  .dashboard__roster-dialog-search {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-sm);
  }

  /* The roster scrolls inside the dialog rather than growing it past the viewport. */
  .dashboard__roster-dialog-list {
    max-block-size: min(46svh, 20rem);
    overflow: auto;
    margin-inline: calc(var(--s-2) * -1);
  }

  /* Pending access in the dialog exists only where the rail's own details are
     hidden. At desktop the rail keeps the control and the dialog does not
     duplicate it; at ≤52rem this section is the ONLY reachable pending surface.
     The [hidden] case (nothing pending, or sample) stays hidden by the global
     [hidden] rule in every width. */
  .dashboard__roster-dialog-pending {
    display: none;
  }

  /* The dialog becomes a column so the body can scroll when the pending section
     makes the content taller than the sheet. Scoped to [open]: an unscoped
     display would override the UA's dialog:not([open]){display:none} and show
     the dialog permanently. */
  .dashboard__roster-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .dashboard__roster-dialog-body {
    min-block-size: 0;
    overflow-y: auto;
  }

  .dashboard__roster-dialog-pending-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__roster-dialog-pending-count {
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-medium);
  }

  .dashboard__roster-dialog-pending-list {
    max-block-size: 12rem;
    overflow: auto;
    margin-inline: calc(var(--s-2) * -1);
  }

  .dashboard__roster-dialog-pending-list .dashboard__agent {
    border-radius: var(--radius-sm);
  }

  /* ── Channels ───────────────────────────────────────────────────────────────────── */

  /* The + beside the CHANNELS heading. It is the icon button the head already uses, at the
     size the label row can carry, rather than the full-width dashed rail-add control. */
  .dashboard__rail-section-add {
    inline-size: 1.75rem;
    min-block-size: 1.75rem;
    padding: 0;
  }

  /* The phone's channel control. `display: none` here and shown only at ≤52rem, exactly the
     split the view switcher uses: above that width the rail lists the channels. */
  .dashboard__channel-switch {
    display: none;
  }

  /* The channel a message is in, on the message. Shown only in all-signals, where filed and
     unfiled messages sit together. It is a real control: it opens that channel. */
  .dashboard__message-channel {
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: var(--t-xs);
    cursor: pointer;
  }

  .dashboard__message-channel:hover,
  .dashboard__message-channel:focus-visible {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .dashboard__channel-dialog {
    inline-size: min(30rem, calc(100vw - var(--s-6)));
    max-block-size: min(42rem, calc(100dvh - var(--s-6)));
    overflow: auto;
    padding: var(--s-5);
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .dashboard__channel-dialog::backdrop {
    background: rgb(0 0 0 / 45%);
  }

  .dashboard__channel-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__channel-dialog-head h2 {
    margin: 0;
    font-size: var(--t-md);
  }

  .dashboard__channel-dialog-reach,
  .dashboard__channel-hint {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__channel-dialog-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__channel-dialog-status:empty {
    display: none;
  }

  .dashboard__channel-dialog-list {
    display: grid;
    gap: var(--s-1);
    margin-block: var(--s-4);
  }

  .dashboard__channel-form {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-5);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__channel-form h3 {
    margin: 0;
    font-size: var(--t-sm);
  }

  .dashboard__channel-form label {
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__channel-form input[type="text"] {
    min-block-size: 2.75rem;
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font: inherit;
  }

  .dashboard__channel-form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  @media (max-width: 52rem) {
    .dashboard__roster-dialog-pending {
      display: grid;
      gap: var(--s-2);
      padding-block-start: var(--s-3);
      border-block-start: 1px solid var(--border);
    }
  }

  .dashboard__roster-dialog-list .dashboard__agent {
    grid-template-columns: auto minmax(0, 1fr) auto;
    border-radius: var(--radius-sm);
  }

  .dashboard__icon-button {
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .dashboard__icon-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dashboard__icon-button:hover {
    color: var(--text);
    background: var(--elev-3);
  }

  .dashboard__channel-body {
    min-block-size: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
  }

  .dashboard__channel-body > [data-channel-view] {
    grid-area: 1 / 1;
    overflow: auto;
  }

  .dashboard__channel-empty {
    place-self: center;
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    inline-size: min(100% - var(--s-10), 36rem);
    padding-block: var(--s-12);
  }

  .dashboard__channel-empty h2,
  .dashboard__feed-state h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
  }

  .dashboard__channel-empty > p:not(.dashboard__eyebrow),
  .dashboard__feed-state p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    text-wrap: pretty;
  }

  .dashboard__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .dashboard__empty-orbit {
    position: relative;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--elev-2);
  }

  .dashboard__empty-orbit::before,
  .dashboard__empty-orbit span {
    content: "";
    position: absolute;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-dim);
  }

  .dashboard__empty-orbit::before {
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
  }

  .dashboard__empty-orbit span:nth-child(1) {
    inset: 0.35rem auto auto 0.55rem;
    opacity: 0.35;
  }

  .dashboard__empty-orbit span:nth-child(2) {
    inset: auto 0.4rem 0.7rem auto;
    opacity: 0.2;
  }

  .dashboard__empty-orbit span:nth-child(3) {
    display: none;
  }

  .dashboard__connect-view {
    min-inline-size: 0;
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .dashboard__channel-receipt {
    z-index: 3;
    grid-area: 1 / 1;
    align-self: start;
    justify-self: center;
    margin: var(--s-4);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: color-mix(in oklab, var(--success-dim) 82%, var(--elev-2));
    border: 1px solid color-mix(in oklab, var(--success) 40%, var(--border));
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    font-size: var(--t-sm);
  }

  .dashboard__choice-view,
  .dashboard__invite-view {
    /* The gap was declared without a display, so it never applied: these sections
       stayed block boxes and their children touched — most visibly the invite
       form's "Their email" label crowding the intro paragraph. The grid makes
       the declared rhythm real. */
    display: grid;
    align-content: start;
    gap: var(--s-6);
  }

  /* Inside the grid the back button's own trailing margin would stack on the
     gap; the connect view keeps the margin because it is not a grid. */
  .dashboard__choice-view .dashboard__back-button,
  .dashboard__invite-view .dashboard__back-button {
    margin-block-end: 0;
  }

  .dashboard__choice-copy {
    display: grid;
    gap: var(--s-3);
    max-inline-size: 42rem;
  }

  .dashboard__choice-copy h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
  }

  .dashboard__choice-copy > p:last-child {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-base);
  }

  .dashboard__choice-list {
    display: grid;
    max-inline-size: 46rem;
    border-block-start: 1px solid var(--border);
  }

  .dashboard__choice {
    min-block-size: 5.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: var(--s-4) var(--s-2);
    color: var(--text);
    background: transparent;
    border: 0;
    border-block-end: 1px solid var(--border);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .dashboard__choice:hover {
    padding-inline: var(--s-4);
    background: var(--accent-dim);
  }

  .dashboard__choice:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__choice > span:first-child {
    display: grid;
    gap: var(--s-1);
    /* A flex child's automatic minimum is its content's min-content width; without
       this, one long unbreakable string in the copy could hold the row open past
       the viewport at 320px instead of wrapping. */
    min-inline-size: 0;
  }

  .dashboard__choice strong {
    font-size: var(--t-lg);
  }

  .dashboard__choice small {
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__invite-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-3);
    max-inline-size: 42rem;
  }

  .dashboard__invite-form label {
    grid-column: 1 / -1;
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__invite-form input {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
  }

  .dashboard__invite-result {
    display: grid;
    gap: var(--s-3);
    max-inline-size: 42rem;
  }

  .dashboard__invite-receipt {
    margin: 0;
    color: var(--success);
    font-size: var(--t-sm);
  }

  .dashboard__invite-link {
    max-inline-size: 100%;
    max-block-size: 8rem;
    margin: 0;
    padding: var(--s-4);
    overflow: auto;
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    white-space: pre;
  }

  .dashboard__back-button {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-block-end: var(--s-4);
  }

  .dashboard__connect-view .dashboard__connect {
    min-inline-size: 0;
    inline-size: 100%;
    max-inline-size: none;
    box-shadow: none;
  }

  .dashboard__feed-state {
    place-self: center;
    inline-size: min(100% - var(--s-10), 38rem);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--s-4);
    padding-block: var(--s-12);
  }

  .dashboard__feed-state > div {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__feed-zero {
    inline-size: 2.75rem;
    block-size: 2.75rem;
    display: grid;
    place-items: center;
    color: var(--accent-bright);
    background: var(--accent-dim);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
  }

  .dashboard__feed-state code {
    white-space: nowrap;
  }

  .dashboard__files-view {
    align-self: stretch;
    min-inline-size: 0;
    min-block-size: 0;
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .dashboard__file-warning {
    max-inline-size: 72rem;
    margin: 0 0 var(--s-5);
    padding: var(--s-3) var(--s-4);
    color: var(--warning);
    background: var(--warning-dim);
    border-radius: var(--radius-sm);
    font-size: var(--t-xs);
    line-height: var(--lh-sm);
  }

  .dashboard__file-empty {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__file-error {
    margin: 0;
  }

  .dashboard__file-list {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__file-row {
    display: grid;
    grid-template-columns: minmax(12rem, 2fr) 5rem 3rem minmax(8rem, 1fr) 6rem minmax(8rem, auto);
    align-items: center;
    gap: var(--s-3);
    min-inline-size: 0;
    padding: var(--s-3) var(--s-4);
    background: var(--elev-1);
    border-radius: var(--radius-sm);
  }

  .dashboard__file-identity {
    display: grid;
    gap: var(--s-1);
    min-inline-size: 0;
  }

  .dashboard__file-identity strong {
    overflow-wrap: anywhere;
    color: var(--text);
    font-size: var(--t-sm);
  }

  .dashboard__file-state,
  .dashboard__file-row > span,
  .dashboard__file-row > time,
  .dashboard__file-download-status {
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: var(--lh-sm);
  }

  .dashboard__file-row [data-field-label]::before {
    content: attr(data-field-label);
    display: block;
    margin-block-end: var(--s-1);
    color: var(--text-faint);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__file-row--removed [data-file-name] {
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .dashboard__file-action {
    display: grid;
    justify-items: end;
    gap: var(--s-1);
  }

  .dashboard__file-download {
    min-block-size: 2.25rem;
    padding: var(--s-1) var(--s-3);
    font-size: var(--t-xs);
  }

  .dashboard__file-download-status {
    max-inline-size: 18rem;
    color: var(--danger);
    text-align: end;
  }

  .dashboard__channel-body > .dashboard__brain-view {
    align-self: stretch;
    min-inline-size: 0;
    min-block-size: 0;
    display: grid;
    grid-template-columns: minmax(13rem, 18rem) minmax(0, 1fr);
    overflow: hidden;
  }

  .dashboard__brain-index,
  .dashboard__brain-topic {
    min-inline-size: 0;
    min-block-size: 0;
    overflow: auto;
  }

  .dashboard__brain-index {
    padding: var(--s-4);
    background: var(--bg);
  }

  .dashboard__brain-empty,
  .dashboard__brain-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__brain-list,
  .dashboard__brain-history ul {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__brain-list button {
    inline-size: 100%;
    display: grid;
    gap: var(--s-1);
    padding: var(--s-3);
    color: var(--text);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .dashboard__brain-list button:hover,
  .dashboard__brain-list button[aria-current="page"] {
    background: var(--elev-2);
  }

  .dashboard__brain-list button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__brain-list strong {
    overflow-wrap: anywhere;
    font-size: var(--t-sm);
  }

  .dashboard__brain-list span {
    color: var(--text-muted);
    font-size: var(--t-2xs);
    line-height: var(--lh-sm);
  }

  .dashboard__brain-topic {
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .dashboard__brain-topic-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--s-4);
    margin-block-end: var(--s-5);
  }

  .dashboard__brain-topic-head h2,
  .dashboard__brain-topic-head p {
    margin: 0;
  }

  .dashboard__brain-topic-head h2 {
    overflow-wrap: anywhere;
    font-size: var(--t-xl);
  }

  .dashboard__brain-topic-head p {
    margin-block-start: var(--s-1);
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__brain-markdown {
    max-inline-size: 52rem;
  }

  .dashboard__brain-body-mode {
    display: flex;
    align-items: baseline;
    max-inline-size: 52rem;
    margin: 0 0 var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__brain-raw-toggle {
    padding: 0;
    color: var(--accent-bright);
    background: transparent;
    border: 0;
    font: inherit;
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__brain-raw-toggle[aria-pressed="true"] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .dashboard__brain-raw-toggle:focus-visible {
    border-radius: var(--radius-sm);
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__brain-markdown :where(h2, h3, h4, h5, p, ul, ol, blockquote, pre, table, hr) {
    margin: 0;
  }

  .dashboard__brain-markdown :where(h2, h3, h4, h5, p, ul, ol, blockquote, pre, table, hr) +
    :where(h2, h3, h4, h5, p, ul, ol, blockquote, pre, table, hr) {
    margin-block-start: var(--s-3);
  }

  .dashboard__brain-markdown h2 {
    font-size: var(--t-lg);
  }

  .dashboard__brain-markdown h3 {
    font-size: var(--t-base);
  }

  .dashboard__brain-markdown :where(h4, h5) {
    font-size: var(--t-sm);
  }

  .dashboard__brain-markdown :where(h2, h3, h4, h5) {
    line-height: var(--lh-tight);
  }

  .dashboard__brain-raw {
    max-inline-size: 52rem;
    margin: 0;
    padding: var(--s-4);
    overflow: auto;
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    line-height: var(--lh-base);
    overflow-wrap: normal;
    white-space: pre;
  }

  .dashboard__brain-form {
    max-inline-size: 52rem;
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__brain-form label {
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__brain-form textarea {
    inline-size: 100%;
    min-block-size: 18rem;
    resize: vertical;
    padding: var(--s-4);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    line-height: var(--lh-base);
  }

  .dashboard__brain-form textarea:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__brain-form-actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .dashboard__brain-status {
    min-block-size: 1.25rem;
    margin-block-start: var(--s-3);
  }

  .dashboard__brain-history {
    max-inline-size: 52rem;
    margin-block-start: var(--s-5);
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__brain-history summary {
    inline-size: fit-content;
    color: var(--text);
    cursor: pointer;
  }

  .dashboard__brain-history ul {
    margin-block-start: var(--s-3);
  }

  .dashboard__brain-history a {
    color: var(--accent-bright);
  }

  .dashboard__mobile-view {
    display: none;
  }

  /* The phone view switcher. Above 52rem the rail's own STREAMS and ARTIFACTS lists do this
     job, so the whole group is absent rather than merely restyled. */
  .dashboard__rail-tabs {
    display: none;
  }

  /* The gear beside the workspace name is the desktop door to the same dialog. */
  .dashboard__workspace-settings-item {
    display: none;
  }

  /* On desktop the account trigger itself carries the name, so this line would repeat it. */
  .dashboard__user-menu-account {
    display: none;
    margin: 0;
  }

  .dashboard__feed {
    /* The composer already owns a separate auto-sized grid row. Reserving its height here
       counted it twice and left a 135-275px hole. Keep only the normal 12px transcript rhythm. */
    padding: 0 0 var(--s-3);
    margin: 0;
    list-style: none;
  }

  .dashboard__feed-view {
    /* ~~align-self: start~~ — dead 2026-08-11, and it was the actual blocker. A grid item aligned
     * to `start` is sized to its CONTENT rather than stretched to its track, so this section was
     * 14,680px tall inside a 619px row and its own `overflow-y: auto` never engaged. `stretch`
     * makes it fill the track, which is what turns it into the scroller.
     *
     * Found by measuring computed heights up the ancestor chain in the browser, not by reading:
     * every candidate above this (frame bound, min-block-size on the column) was necessary and
     * none of them was sufficient. */
    align-self: stretch;
    min-inline-size: 0;
    min-block-size: 0;
  }

  .dashboard__feed-toolbar {
    position: sticky;
    z-index: 2;
    inset-block-start: 0;
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: clamp(var(--s-5), 4vw, var(--s-8));
    background: color-mix(in oklab, var(--surface) 94%, transparent);
    border-block-end: 1px solid var(--border);
    backdrop-filter: blur(12px);
  }

  .dashboard__feed-filters {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .dashboard__feed-filters button {
    position: relative;
    min-block-size: 2.75rem;
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: var(--t-xs);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .dashboard__feed-filters button::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    block-size: 2px;
    background: transparent;
  }

  .dashboard__feed-filters button:hover,
  .dashboard__feed-filters button[aria-pressed="true"] {
    color: var(--text);
  }

  .dashboard__feed-filters button[aria-pressed="true"]::after {
    background: var(--text);
  }

  .dashboard__feed-filters button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__feed-more {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    padding: 0 clamp(var(--s-5), 4vw, var(--s-8)) var(--s-10);
  }

  .dashboard__feed-more-error {
    max-inline-size: 36rem;
    margin: 0;
    color: var(--danger);
    font-size: var(--t-sm);
    text-align: center;
  }

  .dashboard__composer {
    --composer-border-width: 1px;
    --composer-inset: var(--s-2);
    --composer-target: 2.75rem;
    --composer-text-rest: calc(var(--s-6) + var(--s-4));

    z-index: 3;
    grid-row: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-1);
    padding: var(--s-1) clamp(var(--s-5), 4vw, var(--s-8))
      calc(var(--s-1) + env(safe-area-inset-bottom));
    background: var(--surface);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__composer-box {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .dashboard__composer-input {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-2);
    min-block-size: calc(
      var(--composer-target) + var(--composer-border-width) + var(--composer-border-width)
    );
    padding: var(--composer-inset);
    background: var(--elev-1);
    border: var(--composer-border-width) solid var(--border-interactive);
    border-radius: var(--radius);
    transition: border-color var(--dur-1) var(--ease-standard),
      box-shadow var(--dur-1) var(--ease-standard);
  }

  .dashboard__composer-input--drop {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }

  .dashboard__composer-drop-target {
    position: absolute;
    z-index: 4;
    inset: var(--composer-inset);
    display: grid;
    place-items: center;
    color: var(--accent-bright);
    background: color-mix(in oklab, var(--elev-1) 90%, var(--accent-dim));
    border: 1px dashed var(--accent);
    border-radius: var(--radius-sm);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
    pointer-events: none;
  }

  .dashboard__composer-attachments {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: var(--s-1);
  }

  .dashboard__attachment-chip {
    display: inline-flex;
    align-items: center;
    min-inline-size: 0;
    max-inline-size: min(100%, 20rem);
    min-block-size: var(--composer-target);
    padding: var(--s-1);
    gap: var(--s-2);
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .dashboard__attachment-chip img {
    inline-size: 2rem;
    block-size: 2rem;
    object-fit: cover;
    border-radius: calc(var(--radius-sm) / 2);
  }

  .dashboard__attachment-chip > span {
    display: grid;
    min-inline-size: 0;
    line-height: 1.15;
  }

  .dashboard__attachment-chip strong,
  .dashboard__attachment-chip small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__attachment-chip strong {
    color: var(--text);
    font-size: var(--t-xs);
  }

  .dashboard__attachment-chip small {
    color: var(--text-muted);
    font-size: var(--t-2xs);
  }

  .dashboard__attachment-chip button,
  .dashboard__composer-attach {
    display: grid;
    place-items: center;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .dashboard__attachment-chip button {
    inline-size: 2rem;
    block-size: 2rem;
    padding: 0;
    font-size: var(--t-lg);
  }

  .dashboard__composer-attach {
    position: absolute;
    z-index: 2;
    inset-inline-end: calc(var(--composer-inset) + var(--composer-target) + var(--s-2));
    inset-block-end: var(--composer-inset);
    inline-size: var(--composer-target);
    block-size: var(--composer-target);
    border-radius: var(--radius-sm);
  }

  .dashboard__composer-attach:hover:not(:disabled),
  .dashboard__attachment-chip button:hover:not(:disabled) {
    color: var(--text);
    background: var(--elev-3);
  }

  .dashboard__composer-attach:disabled,
  .dashboard__attachment-chip button:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .dashboard__composer-attach svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* Operator feedback 2026-08-29, twice: the focus ring on the entry box was
   * "very strong" and the first fix did not quiet it. The first fix keyed on
   * :focus-visible, which works for buttons — but browsers deliberately treat a
   * clicked TEXT FIELD as :focus-visible too, so both the global ring in
   * global.css and the shell ring still fired on every click.
   *
   * The composer's focus indicator is therefore the SHELL BORDER turning accent
   * — a clear visible change, Slack's own pattern — and the textarea opts out of
   * the global outline/halo, which cannot distinguish click from keyboard on an
   * editable element. Every non-editable control (send, chips, select) keeps the
   * full global ring, where :focus-visible really is keyboard-only. */
  .dashboard__composer-input:focus-within {
    border-color: var(--accent);
  }

  .dashboard__composer-input textarea:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .dashboard__mention-chip {
    position: relative;
    block-size: var(--s-8);
    display: inline-flex;
    align-items: center;
    max-inline-size: 100%;
    padding-inline-end: var(--s-6);
    color: var(--accent-bright);
    background: var(--accent-dim);
    border: 1px solid color-mix(in oklab, var(--accent) 28%, var(--border));
    border-radius: var(--radius-pill);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    vertical-align: baseline;
  }

  .dashboard__mention-entity,
  .dashboard__message-mention {
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .dashboard__mention-entity {
    min-block-size: var(--s-8);
    min-inline-size: 0;
    padding: 0 var(--s-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The composer chip and its × are gone: a tag is a word in the message now. What is left is
   * the entity control inside a POSTED row, which still opens the profile panel. */
  .dashboard__mention-entity:focus-visible,
  .dashboard__message-mention:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__message-mention {
    padding: 0 var(--s-2);
  }

  .dashboard__composer textarea {
    flex: 1 1 14rem;
    align-self: center;
    min-inline-size: 7rem;
    min-block-size: var(--composer-text-rest);
    /* Against the VISIBLE viewport, not a viewport unit. `dvh` describes the layout viewport,
       which on iOS Safari does not shrink when the keyboard opens, so a cap written in dvh
       lets the box grow into the space the keyboard is using. `--dashboard-viewport-height` is
       measured from visualViewport; the dvh in the fallback is only for the first paint and
       for a browser with no visualViewport at all. */
    max-block-size: min(calc(var(--dashboard-viewport-height, 100dvh) * 0.4), 20rem);
    padding: var(--s-2) calc(var(--composer-target) + var(--s-2)) var(--s-2) 0;
    overflow-y: auto;
    resize: none;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: 0;
    font: inherit;
    line-height: var(--s-6);
  }

  .dashboard__composer-reload-warning {
    margin: var(--s-1) 0 0;
    color: var(--warning);
    font-size: var(--t-xs);
  }

  .dashboard__composer textarea::placeholder {
    color: var(--text-faint);
  }

  .dashboard__composer-send {
    flex: 0 0 auto;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    align-self: end;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--accent-ink);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-standard),
      opacity var(--dur-1) var(--ease-standard),
      transform var(--dur-1) var(--ease-standard);
  }

  .dashboard__composer-send:hover:not(:disabled) {
    background: var(--accent-bright);
  }

  .dashboard__composer-send:active:not(:disabled) {
    transform: translateY(1px) scale(0.97);
  }

  .dashboard__composer-send:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__composer-send:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .dashboard__composer-send[data-state="posting"] {
    cursor: wait;
    opacity: 0.82;
  }

  .dashboard__composer-send svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dashboard__composer-send-icon,
  .dashboard__composer-send-progress {
    grid-area: 1 / 1;
  }

  .dashboard__composer-send-progress {
    inline-size: 1rem;
    block-size: 1rem;
    display: none;
    border: 2px solid color-mix(in oklab, currentColor 35%, transparent);
    border-block-start-color: currentColor;
    border-radius: 50%;
    animation: dashboard-composer-spin 700ms linear infinite;
  }

  .dashboard__composer-send[data-state="posting"] .dashboard__composer-send-icon {
    visibility: hidden;
  }

  .dashboard__composer-send[data-state="posting"] .dashboard__composer-send-progress {
    display: block;
  }

  @keyframes dashboard-composer-spin {
    to {
      transform: rotate(1turn);
    }
  }

  .dashboard__composer-meta,
  .dashboard__composer-feedback {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  /* THE ADDRESS ROW. One line at rest: the label, the chips, and the sentence that says who
   * is woken. It costs the bar height the 2026-09-04 direction had bought by deleting a TO
   * control; the operator asked for it back on 2026-09-05 and the measured resting height is
   * pinned in composer-polish.observer.test.ts rather than assumed here.
   *
   * The chips scroll rather than wrap, so a full set of eight cannot push the text box off a
   * phone. The note is allowed to wrap: truncating it would hide which recipients are woken,
   * which is the one thing this row exists to say. */
  .dashboard__composer-to {
    grid-column: 1;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    min-inline-size: 0;
    padding-inline: calc(var(--composer-border-width) + var(--composer-inset));
    font-size: var(--t-xs);
  }

  .dashboard__composer-to-label {
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .dashboard__composer-to-chips {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .dashboard__composer-to-note {
    min-inline-size: 0;
    flex: 1 1 12rem;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .dashboard__composer-chip {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.125rem;
    padding-inline: 0.25rem;
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* The one recipient the service wakes, marked so the sentence and the chips agree. */
  .dashboard__composer-chip[data-composer-to-notified] {
    border-color: var(--border-interactive);
    background: var(--accent-dim);
  }

  .dashboard__composer-chip--everyone {
    padding-block: 0.125rem;
    color: var(--text-muted);
  }

  .dashboard__composer-chip-name,
  .dashboard__composer-chip-remove {
    padding: 0.125rem;
    color: var(--text);
    background: none;
    border: 0;
    border-radius: calc(var(--radius-sm) / 2);
    font: inherit;
    line-height: 1.2;
    cursor: pointer;
  }

  .dashboard__composer-chip-remove {
    color: var(--text-muted);
    padding-inline: 0.25rem;
  }

  .dashboard__composer-chip-name:hover,
  .dashboard__composer-chip-remove:hover {
    color: var(--text);
    background: var(--elev-1);
  }

  .dashboard__composer-chip-name:focus-visible,
  .dashboard__composer-chip-remove:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Empty unless the body is near the character limit, and it must take no height while it
   * is empty: this bar has a measured budget and this row is not part of it. */
  .dashboard__composer-meta {
    grid-column: 1;
    grid-row: 4;
    padding-inline: calc(var(--composer-border-width) + var(--composer-inset));
  }

  .dashboard__composer-meta:empty,
  .dashboard__composer-meta:has(> [hidden]:only-child) {
    display: none;
  }

  .dashboard__composer-feedback {
    grid-column: 1;
    grid-row: 5;
    padding-inline: calc(var(--composer-border-width) + var(--composer-inset));
  }

  .dashboard__composer-count {
    margin: 0;
    color: var(--text-faint);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
  }

  .dashboard__composer-count {
    margin-inline-start: auto;
    text-align: end;
  }

  .dashboard__composer-count[data-state="firm"] {
    color: var(--danger);
  }

  .dashboard__composer-status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
  }

  .dashboard__composer-status[data-state="error"] {
    color: var(--danger);
  }

  .dashboard__composer-status:empty {
    display: none;
  }

  .dashboard__composer-retry {
    min-block-size: 2.75rem;
    margin-inline-start: auto;
    padding-inline: var(--s-3);
    color: var(--text);
    background: var(--elev-2);
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__composer-retry:hover {
    background: var(--elev-3);
  }

  .dashboard__composer-retry:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__mention-picker {
    position: absolute;
    z-index: 5;
    inset: auto 0 calc(100% + var(--s-2));
    max-block-size: 15rem;
    padding: var(--s-2);
    overflow-y: auto;
    background: var(--elev-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .dashboard__mention-picker button {
    inline-size: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-1);
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .dashboard__mention-picker button[aria-selected="true"],
  .dashboard__mention-picker button:hover {
    background: var(--accent-dim);
  }

  .dashboard__mention-picker button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__mention-picker strong {
    font-size: var(--t-sm);
  }

  .dashboard__mention-picker-copy {
    min-inline-size: 0;
    display: grid;
    gap: var(--s-1);
  }

  .dashboard__mention-picker-copy > span {
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__mention-picker-avatar {
    inline-size: 1.9rem;
    block-size: 1.9rem;
    display: grid;
    place-items: center;
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
  }

  .dashboard__message {
    --message-row-background: transparent;

    /* Layout containment, because the composer forces a synchronous layout on every autogrow
       and a transcript is hundreds of these rows. A contained row's inside cannot affect
       anything outside it, so that layout can reuse each row's box instead of measuring its
       contents again. `layout` only: paint containment would clip the entity popovers a row
       opens, and content-visibility would change the scrollHeight that renderFeed reads to
       hold the reader's scroll position. */
    contain: layout;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-4) clamp(var(--s-5), 4vw, var(--s-8));
    background: var(--message-row-background);
    transition: background var(--dur-2) var(--ease-standard);
  }

  .dashboard__message:hover {
    background: color-mix(in oklab, var(--message-row-background) 90%, var(--elev-3));
  }

  .dashboard__message--direct-to-viewer {
    --message-row-background: var(--accent-dim);

    background: var(--message-row-background);
  }

  .dashboard__message + .dashboard__message {
    border-block-start: 1px solid var(--border);
  }

  .dashboard__message--fresh {
    border-inline-start: 2px solid transparent;
    animation: dashboard-fresh-arrival 2s var(--ease-decelerate) both;
  }

  @keyframes dashboard-fresh-arrival {
    0%,
    72% {
      border-inline-start-color: var(--success);
      background: color-mix(in oklab, var(--success-dim) 44%, transparent);
    }

    100% {
      border-inline-start-color: transparent;
      background: var(--message-row-background);
    }
  }

  .dashboard__message-body {
    min-inline-size: 0;
    display: grid;
    gap: 0.36rem;
  }

  .dashboard__message-meta {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.32rem var(--s-2);
  }

  .dashboard__message-meta strong {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__message-identity-badge {
    padding: 0.08rem 0.32rem;
    color: var(--text-muted);
    background: transparent;
    border-radius: var(--radius-sm);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-xs);
  }

  .dashboard__message-target {
    color: var(--text);
    font-size: var(--t-xs);
    font-weight: var(--weight-medium);
  }

  .dashboard__message-operator {
    min-inline-size: 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--t-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__message-meta time {
    margin-inline-start: auto;
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__message-kind {
    padding: 0.16rem 0.42rem;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__message-mentions {
    margin: 0;
    color: var(--text);
    font-size: var(--t-base);
    line-height: var(--lh-base);
  }

  .dashboard__message-markdown {
    min-inline-size: 0;
    color: var(--text);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    overflow-wrap: anywhere;
  }

  /* A fold, not a fade. The old version made the last lines progressively transparent, and the
   * operator's report is the proof of what that costs: "the fade makes the last sentence hard to
   * read". Any gradient over text trades legibility for a hint, and the "Show more" beneath the
   * box already gives the hint in words.
   *
   * The height is MESSAGE_COLLAPSE_LINES body line boxes. That is a whole number of lines for
   * ordinary prose, and NOT a guaranteed line boundary for everything: a fenced block sets a
   * smaller line height, and blocks carry margins between them, so a mixed message can be cut
   * through a line. It is a hard cut either way — a cut line stays at full contrast rather than
   * fading out, and the link underneath is what says there is more. No fallback value here: the
   * script always sets the variable, and if it ever did not, no clip is a safer failure than a
   * clip at a number typed in a second place. */
  .dashboard__message-markdown--collapsed {
    max-block-size: calc(var(--message-collapse-lines) * var(--lh-base) * 1em);
    overflow: hidden;
  }

  .dashboard__message-markdown :where(p, ul, ol, blockquote, pre, table, hr) {
    margin: 0;
  }

  .dashboard__message-markdown :where(p, ul, ol, blockquote, pre, table, hr) +
    :where(p, ul, ol, blockquote, pre, table, hr) {
    margin-block-start: var(--s-3);
  }

  .dashboard__message-markdown :where(ul, ol) {
    padding-inline-start: var(--s-6);
  }

  .dashboard__message-markdown blockquote {
    padding-inline-start: var(--s-3);
    color: var(--text-muted);
    border-inline-start: 3px solid var(--border-strong);
  }

  .dashboard__message-markdown :where(code, pre) {
    font-family: var(--font-mono);
  }

  .dashboard__message-markdown :not(pre) > code {
    padding: 0.08rem 0.3rem;
    background: var(--elev-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .dashboard__message-markdown pre {
    max-inline-size: 100%;
    padding: var(--s-3);
    overflow-x: auto;
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    /* Agent messages carry install commands, SHAs, and URLs inside fenced blocks. `pre` sent
     * those sideways behind a scrollbar, so a phone reader saw a truncated command and had to
     * drag to read it. `pre-wrap` keeps the author's line breaks and wraps the overflow;
     * `anywhere` breaks the single unbroken token (a URL or a 40-character SHA) that wrapping
     * alone cannot place. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .dashboard__message-markdown pre code {
    font-size: var(--t-sm);
  }

  .dashboard__message-markdown a {
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  /* The four constructs the renderer gained on 2026-09-04 — a table, a rule, strikethrough, and a
   * task item — styled once for the feed and the Brain panel, because one renderer builds both and
   * a rule written for only one of them is a difference a reader would meet.
   *
   * Each selector names both classes rather than putting them in one `:where()`. `:where()` scores
   * zero, so `:where(.a, .b) table` would score (0,0,1) — the same as any bare `table` rule
   * anywhere in the app's stylesheets, leaving stylesheet ORDER to decide every property the two
   * share. Naming the class scores (0,1,1) and takes these rules out of that race.
   *
   * CORRECTION, and the retired wording, because a later reader will meet the reasoning before the
   * result. This comment first said the tie was live: that global.css's bare `table` rule competed
   * for the scroll, and that SeoPage.css carried a `table` rule with `min-inline-size: 44rem` that
   * would break it. Both are false, measured. global.css:203 is
   * `table { border-collapse; border-spacing }` and sets none of the scroll properties, so a tie
   * with it cannot turn the scroll off. seo.css:191 is `.seo-table`, not `table` — a `grep 'table{'`
   * over the built CSS matched the tail of `.seo-table{` and read as a bare rule. Nothing competes
   * with these rules today. The reason to name the class is the one above: (0,0,1) is the score of
   * every bare type rule, so a `table { overflow-x: visible }` added later in any sheet this page
   * loads would tie and be settled by link order. The layout observer measures the computed values,
   * so a rule that lost would fail rather than ship. */

  /* A table is its own scroll container.
   *
   * An agent posts tables of facts, and a table of SHAs is wider than a phone. A default
   * `display: table` grows past the message and pushes the whole page sideways, so every OTHER
   * message moves too and the composer leaves the viewport. `display: block` makes the table an
   * ordinary block box that `overflow-x` can scroll; `inline-size: max-content` still lets it grow
   * to the width its columns want, and `max-inline-size: 100%` stops that growth at the width of
   * the message. The rows keep their table layout inside it, so the columns still line up. */
  .dashboard__message-markdown table,
  .dashboard__brain-markdown table {
    display: block;
    inline-size: max-content;
    max-inline-size: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  /* No `text-align` here, deliberately. The `align` attribute the delimiter row produces is a
   * presentational hint, and ANY author `text-align` rule on a cell outranks it — so a rule added
   * for tidiness would silently delete the alignment feature. The UA defaults (a header centred, a
   * body cell at the start edge) are what an unaligned column gets.
   *
   * `overflow-wrap: normal` is the other half of the scroll rule above, and without it that rule
   * does nothing. The message body sets `anywhere`, which lets a line break inside a word; a cell
   * inheriting it can shrink to almost no width at all, so the table always fits and never
   * scrolls — a column of 40-character SHAs became three characters per line, forty lines tall.
   * Measured at 320px before this rule: the table reported no overflow. A table is a grid of
   * values, and a value the reader has to reassemble down a column is worse than one they scroll
   * to. So a cell keeps whole words, the table takes the width it needs, and the sideways travel
   * happens inside the table. Prose in a cell still wraps at its spaces. */
  .dashboard__message-markdown :where(th, td),
  .dashboard__brain-markdown :where(th, td) {
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--border);
    vertical-align: top;
    overflow-wrap: normal;
  }

  .dashboard__message-markdown th,
  .dashboard__brain-markdown th {
    background: var(--elev-3);
  }

  /* No `margin` here. The flow rules above already zero it and then give every block after the
   * first its top gap, and those selectors score one class where this one scores a class plus a
   * type — so a `margin: 0` written here outranks them and pins a rule flush against the paragraph
   * above it. It did, until the block-spacing observer measured 0px on one side and 12px on the
   * other. Set only what the flow rules do not. */
  .dashboard__message-markdown hr,
  .dashboard__brain-markdown hr {
    border: 0;
    border-block-start: 1px solid var(--border-strong);
  }

  .dashboard__message-markdown del,
  .dashboard__brain-markdown del {
    color: var(--text-muted);
  }

  /* A task item carries its own ballot marker, so the list bullet in front of it would be a
   * second, meaningless dot. Only the task items lose their marker: a plain item in the same list
   * keeps its bullet. */
  .dashboard__message-markdown li.md-task,
  .dashboard__brain-markdown li.md-task {
    list-style: none;
  }

  /* Said when a control names a topic the workspace no longer holds. It sits above the topic
   * list, which is where the reader has just landed, so it is legible with no topic pane open. */
  .dashboard__brain-notice {
    margin: 0 0 var(--s-3);
    padding: var(--s-3);
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: var(--t-sm);
  }

  /* A named brain topic. It reads like the link it is, but it opens a panel in this app rather
   * than leaving for a URL, so it is a button and carries no external-link affordance. The
   * dotted underline is the one thing that tells the two apart at a glance. */
  .dashboard__brain-link {
    display: inline;
    margin: 0;
    padding: 0;
    color: var(--accent-bright);
    background: transparent;
    border: 0;
    font: inherit;
    text-align: start;
    text-decoration: underline dotted;
    text-underline-offset: 0.14em;
    cursor: pointer;
    overflow-wrap: anywhere;
  }

  .dashboard__brain-link:hover {
    text-decoration: underline solid;
  }

  /* The same ring every other control in this dashboard uses. A review arm noted the first
   * version changed only the underline, which is not a focus indicator. */
  .dashboard__brain-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
    text-decoration: underline solid;
  }


  .dashboard__message-markdown a:hover,
  .dashboard__message-toggle:hover {
    color: var(--accent);
  }

  .dashboard__message-markdown a:focus-visible,
  .dashboard__message-toggle:focus-visible {
    border-radius: var(--radius-sm);
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Small, as asked: a quiet link under a long message, not a button competing with it. */
  .dashboard__message-toggle {
    justify-self: start;
    padding: 0;
    color: var(--accent-bright);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__message-actions {
    display: flex;
    gap: var(--s-3);
    margin-block-start: var(--s-1);
  }

  .dashboard__message-reply {
    font-size: var(--t-xs);
  }

  /* THE THREAD. One row under its root: a count that opens in place, and the replies indented
     under it. No drawer, no navigation, and no second copy of the message, so the rows the
     reader was reading stay where they were when a thread opens. */
  .dashboard__thread {
    display: grid;
    gap: var(--s-2);
    /* Aligns with the message body, whose row begins after the 32px avatar and its gap. */
    padding-inline-start: calc(2rem + var(--s-3));
  }

  .dashboard__thread-toggle {
    justify-self: start;
    padding: var(--s-1) var(--s-2);
    color: var(--accent-bright);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__thread-toggle:hover,
  .dashboard__thread-toggle:focus-visible {
    background: var(--surface-raised);
  }

  .dashboard__thread-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__thread-replies {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: 2px solid var(--border);
    padding-inline-start: var(--s-4);
  }

  /* THE COMPOSER'S REPLY BAR. Hidden until a reply is in progress, so the composer at rest is
     the same height it was before threads shipped — which is what the phone budget in
     composer-polish.observer.test.ts is measured against. */
  .dashboard__composer-reply {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-2) var(--s-3);
    margin-block-end: var(--s-2);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: var(--t-xs);
  }

  .dashboard__composer-reply-target {
    margin: 0;
    color: var(--text-muted);
  }

  .dashboard__composer-reply-window {
    display: block;
    color: var(--text-muted);
  }

  .dashboard__composer-reply-broadcast {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-muted);
  }

  /* The To: row is locked while a reply is written: it has no chips to grey out, so the state
     is carried by the row itself and the sentence inside it says why. */
  .dashboard__composer-to[data-composer-to-locked] {
    color: var(--text-muted);
  }

  .dashboard__message-attachments {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--s-2);
    margin-block-start: var(--s-1);
  }

  .dashboard__attachment-card {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .dashboard__attachment-card--image {
    align-items: stretch;
    flex-direction: column;
  }

  .dashboard__attachment-card--image > img {
    inline-size: 100%;
    max-block-size: 18rem;
    min-block-size: 7rem;
    object-fit: contain;
    background: var(--elev-3);
    border-radius: var(--radius-sm);
  }

  .dashboard__attachment-card > div {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-1) var(--s-3);
  }

  .dashboard__attachment-card strong,
  .dashboard__attachment-card span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__attachment-card strong {
    color: var(--text);
    font-size: var(--t-sm);
  }

  .dashboard__attachment-card span {
    grid-column: 1;
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__attachment-download {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-block-size: 2.25rem;
    padding: 0 var(--s-3);
    color: var(--accent-bright);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__attachment-download:hover:not(:disabled) {
    background: var(--accent-dim);
  }

  .dashboard__message-about {
    justify-self: start;
    max-inline-size: 100%;
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    font-size: var(--t-xs);
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .dashboard__message-receipt {
    justify-self: end;
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__message-receipt summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-block-size: 1.75rem;
    padding: 0.16rem 0.46rem;
    background: var(--elev-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }

  .dashboard__message-receipt summary::-webkit-details-marker {
    display: none;
  }

  .dashboard__message-receipt summary::after {
    content: "›";
    margin-inline-start: 0.1rem;
    transition: transform var(--dur-1) var(--ease-standard);
  }

  .dashboard__message-receipt[open] summary::after {
    transform: rotate(90deg);
  }

  .dashboard__message-receipt summary:hover {
    border-color: var(--border-strong);
  }

  .dashboard__message-receipt summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__message-receipt p {
    max-inline-size: 34rem;
    margin: var(--s-2) 0 0;
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: var(--elev-3);
    border-radius: var(--radius);
    line-height: var(--lh-sm);
  }

  .dashboard__message-receipt-section {
    max-inline-size: 34rem;
    margin-block-start: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: var(--elev-3);
    border-radius: var(--radius);
  }

  .dashboard__message-receipt-section h4 {
    margin: 0 0 var(--s-1);
    color: var(--text);
    font-size: var(--t-xs);
  }

  .dashboard__message-receipt-section ul {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding-inline-start: 1rem;
  }

  .dashboard__message-receipt-cut {
    font-style: italic;
  }

  .dashboard__message-receipt-glyph {
    min-inline-size: 1.15rem;
    color: currentColor;
    font-family: var(--font-mono);
    text-align: center;
  }

  .dashboard__message-receipt[data-receipt-state="seen"],
  .dashboard__message-receipt[data-receipt-state="delivered"],
  .dashboard__message-receipt[data-receipt-state="working"],
  .dashboard__message-receipt[data-receipt-state="done"] {
    color: var(--success);
  }

  .dashboard__message-receipt[data-receipt-state="stuck"],
  .dashboard__message-receipt[data-receipt-outcome="expired"] {
    color: var(--warning);
  }

  .dashboard__message-receipt[data-receipt-outcome="failed_terminal"] {
    color: var(--danger);
  }

  .dashboard__filter-empty {
    padding: var(--s-10) clamp(var(--s-5), 4vw, var(--s-8));
    color: var(--text-muted);
    font-size: var(--t-sm);
    text-align: center;
  }

  @media (max-width: 70rem) {
    .dashboard__file-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .dashboard__file-identity,
    .dashboard__file-action {
      grid-column: 1 / -1;
    }

    .dashboard__file-action {
      justify-items: start;
    }

    .dashboard__file-download-status {
      text-align: start;
    }
  }

  @media (max-width: 52rem) {
    .dashboard__product {
      padding: 0;
    }

    .dashboard__frame {
      block-size: 100%;
      min-block-size: 0;
      inline-size: 100%;
      max-inline-size: 100%;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      border: 0;
      border-radius: 0;
    }

    .dashboard__composer textarea {
      font-size: 16px;
    }

    .dashboard__frame--entity-panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .dashboard__entity-panel {
      position: fixed;
      z-index: 8;
      inset-block: 0;
      inset-inline-end: 0;
      inline-size: min(92vw, 22rem);
      max-block-size: 100svh;
      border-inline-start: 1px solid var(--border-strong);
      box-shadow: var(--shadow-lg);
    }

    .dashboard__sample-notice {
      margin: var(--s-3);
    }

    /* THE mobile header. One row, and the only chrome above the transcript: the workspace
       name, the view switcher, the account control. The gear is NOT among them -- it is
       `display: none` in this same block and its dialog is reached from the workspace menu.
       Everything the channel head used
       to stack below it now floats over the transcript instead of taking a row of its own.
       Measured at 390x844 before this change: 73px app bar + 53px channel head + 45px filter
       row = 171px of header before the first message. */
    .dashboard__rail {
      display: grid;
      /* The workspace name is the only flexible column, so it is the one that gives way when
         the view switcher and the account control need the room. The floor keeps enough of the
         name to tell two workspaces apart; below it the name would be an empty pill. Note that
         1rem is not 16px on this page — measured 6rem = 82px at 390px wide. */
      grid-template-columns: minmax(9rem, 1fr) auto auto;
      align-items: center;
      gap: var(--s-3);
      max-block-size: none;
      padding: var(--s-3) var(--s-4);
      overflow: visible;
      border-inline-end: 0;
      border-block-end: 1px solid var(--border);
    }

    .dashboard__rail-tabs {
      grid-column: 2;
      grid-row: 1;
      min-inline-size: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--s-1);
    }

    /* The gear leaves the bar and its dialog is reached from the workspace menu instead. It
       was 55px of a row that now also carries the view switcher, and with it there the
       workspace name had nothing left: measured 2px of text at 390px wide. */
    .dashboard__gear-button {
      display: none;
    }

    .dashboard__workspace-settings-item {
      display: flex;
    }

    .dashboard__rail-section {
      padding: 0;
      border: 0;
    }

    .dashboard__workspace-context,
    .dashboard__rail-section--places,
    .dashboard__rail-section--participants {
      display: none;
    }

    .dashboard__rail-label-row,
    .dashboard__rail-details {
      display: none;
    }

    /* The rail-foot is the account menu now (operator direction 2026-08-19). At mobile
       it sits in the top-bar's second column so the account control — and the home link,
       theme toggle, and sign-out inside its menu — stay reachable. It keeps its own box
       (not display:contents) so the popover anchors to it. */
    .dashboard__rail-foot {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
      padding: 0;
      border: 0;
    }

    .dashboard__user-trigger {
      inline-size: auto;
    }

    /* Measured at 390px: the account name is 75px of a 390px row that now also carries the
       view switcher, and with it there the workspace name got 24px — "R…". The trigger keeps
       its chevron, its 44px target and its "Account menu" accessible name; the name itself
       moves into the menu the trigger opens, where nothing competes for the width. */
    .dashboard__user-trigger-name {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .dashboard__user-menu-account {
      display: block;
      padding: var(--s-2) var(--s-3);
      color: var(--text-muted);
      font-size: var(--t-xs);
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .dashboard__workspace-trigger-name {
      min-inline-size: 0;
    }

    /* The menu opens DOWNWARD here. On desktop the trigger is the rail footer, so upward is
     * right; at this width the same trigger sits in the TOP bar, and upward put every item —
     * Sign out included — above y=0. Measured before this rule at 390x844, 320x568, and
     * 700x800: the Sign out box was at a negative top in all three. */
    .dashboard__user-menu {
      inset-block-end: auto;
      inset-block-start: calc(100% + var(--s-2));
      inset-inline: auto 0;
    }

    .dashboard__workspace-context,
    .dashboard__rail-section--places,
    .dashboard__rail-section--participants {
      display: none;
    }

    .dashboard__workspace-control {
      grid-column: 1;
      grid-row: 1;
      min-inline-size: 0;
      inline-size: auto;
      max-inline-size: 100%;
    }

    /* The channel head STOPS BEING A ROW here. It is positioned over the top of the
       transcript, so it costs the reading area no height at all, and it carries only the two
       things a phone still needs from it: the live dot and the roster pill that opens agent
       management. The channel name is redundant with the view switcher in the bar above —
       "Signals" is already marked aria-current — so the titleblock is hidden from sight and
       kept for the accessible name of this section. */
    .dashboard__channel {
      position: relative;
      grid-template-rows: minmax(0, 1fr);
      /* ONE height for the floating band, read by every clearance that keeps the transcript
         out from under it. The two floating parts are not the same height: the filter row is
         2.5rem, and the roster cluster is a 2.75rem tap target inside var(--s-1) of padding,
         which is 3.25rem. The clearance was the filter row's 2.5rem, so at rest 12px of the
         first message sat under the roster pill — measured at 390x844: the first row began
         113px below the top of the app bar and the pill ended at 125px. The band is as tall
         as its tallest part, and the clearance is the band. */
      --feed-band-height: 3.25rem;
    }

    .dashboard__channel-head {
      position: absolute;
      z-index: 4;
      inset-block-start: 0;
      inset-inline-end: 0;
      min-block-size: 0;
      justify-content: flex-end;
      flex-wrap: nowrap;
      gap: var(--s-2);
      padding: var(--s-1) var(--s-4);
      background: none;
      border-block-end: 0;
      pointer-events: none;
    }

    /* These two float over live text, so each one carries the same translucent backdrop the
       filter row on the other side of the band uses. Without it the roster count reads on top
       of a message body. */
    .dashboard__channel-actions,
    .dashboard__channel-roster {
      pointer-events: auto;
      padding-inline: var(--s-2);
      background: color-mix(in oklab, var(--surface) 94%, transparent);
      border-radius: 999px;
      backdrop-filter: blur(12px);
    }

    /* Hidden from sight, not from a screen reader: this h1 is the accessible name of the
       channel section through aria-labelledby. `display: none` would leave that name empty. */
    .dashboard__channel-titleblock {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .dashboard__channel-actions {
      order: 2;
      margin-inline-start: auto;
    }

    .dashboard__channel-roster {
      order: 3;
      margin-inline-start: 0;
    }

    /* The filter row floats too. Sticky keeps it at the top of the scroller; the negative
       margin takes ITS OWN height back out of the flow, so the transcript passes UNDER it
       instead of starting below it. That pair is 2.5rem and must match each other. The list's
       top padding is NOT the same amount: it clears the whole band, whose height is the taller
       of the two floating parts, so it is var(--feed-band-height). It is clearance at rest and
       scrolls away with the content. */
    .dashboard__feed-toolbar {
      min-block-size: 2.5rem;
      margin-block-end: -2.5rem;
      padding-inline: var(--s-4);
      /* Room for the floating roster cluster on the opposite side of the same band. */
      padding-inline-end: 8rem;
      background: none;
      border-block-end: 0;
      backdrop-filter: none;
    }

    /* The filters carry the backdrop themselves rather than the full-width bar, so the band
       is two chips over the transcript and not a painted row. They scroll sideways at 320px,
       where three labels do not fit beside the roster pill. */
    .dashboard__feed-filters {
      min-inline-size: 0;
      gap: var(--s-3);
      padding-inline: var(--s-3);
      overflow-x: auto;
      background: color-mix(in oklab, var(--surface) 94%, transparent);
      border-radius: 999px;
      backdrop-filter: blur(12px);
      scrollbar-width: none;
    }

    .dashboard__feed-filters::-webkit-scrollbar {
      display: none;
    }

    .dashboard__feed-filters button {
      min-block-size: 2.5rem;
      white-space: nowrap;
    }

    .dashboard__feed {
      padding-block-start: var(--feed-band-height);
    }

    .dashboard__feed-more {
      padding-block-start: var(--feed-band-height);
    }

    /* The clearance belongs to whatever is FIRST under the floating band, and only to that.
       "Load older updates" sits between the band and the list, so when it is showing it has
       already cleared the band and the list's own clearance becomes a band's height of dead
       screen between the button and the first message. Measured at 390x844 when that clearance
       was still the filter row's 2.5rem: a 40px gap. It is --feed-band-height now. */
    .dashboard__feed-more:not([hidden]) + .dashboard__feed {
      padding-block-start: 0;
    }

    /* The same dialog, presented as a bottom sheet. */
    .dashboard__roster-dialog {
      inline-size: 100%;
      max-inline-size: 100%;
      max-block-size: calc(var(--dashboard-viewport-height, 100dvh) * 0.82);
      margin-block-start: auto;
      margin-block-end: 0;
      margin-inline: 0;
      border-inline: 0;
      border-block-end: 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .dashboard__workspace-details-dialog {
      inline-size: 100%;
      max-inline-size: 100%;
      max-block-size: calc(var(--dashboard-viewport-height, 100dvh) * 0.82);
      margin-block-start: auto;
      margin-block-end: 0;
      border-block-end: 0;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .dashboard__roster-dialog-list {
      max-block-size: calc(var(--dashboard-viewport-height, 100dvh) * 0.46);
    }

    .dashboard__mobile-view {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      padding-inline: var(--s-2);
    }

    /* The channel control appears exactly where the rail's channel list disappears. It
       rides in the toolbar band, which floats over the transcript on a negative margin
       equal to its own height, so it adds NO height to the header: the 73px app bar
       remains the only standing header (2026-09-04 ruling). Its own height is the band's
       2.5rem, so it cannot make the band taller either. */
    .dashboard__channel-switch {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.5rem;
      /* MEASURED 2026-09-05 at 390x844 and 320x568. A slug may be 32 characters, which is
         the edge's own CHANNEL_SLUG_MAX, and an uncapped chip rendered 249px of it: the
         filter row beside it fell to 24px of visible width at BOTH widths. The cap plus the
         ellipsis on the label is what keeps the band usable at the longest legal name. It
         costs the filters some room, and they scroll sideways for it, which is the shape
         that row already had at 320px. */
      max-inline-size: 8rem;
      margin-inline-end: var(--s-2);
      padding-inline: var(--s-3);
      color: var(--text);
      background: color-mix(in oklab, var(--surface) 94%, transparent);
      border: 1px solid var(--border);
      border-radius: 999px;
      font: inherit;
      font-size: var(--t-xs);
      white-space: nowrap;
      cursor: pointer;
      backdrop-filter: blur(12px);
    }

    .dashboard__channel-switch [data-channel-switch-label] {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* A bottom sheet, the same shape the roster dialog takes at this width. */
    .dashboard__channel-dialog {
      inline-size: 100%;
      max-inline-size: none;
      max-block-size: 85dvh;
      margin: auto auto 0;
      border-end-end-radius: 0;
      border-end-start-radius: 0;
    }

    .dashboard__mobile-view[aria-current="page"] {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }

    .dashboard__update-count {
      display: none;
    }

    .dashboard__channel-body > .dashboard__brain-view {
      grid-template-columns: minmax(0, 1fr);
      overflow: auto;
    }

    .dashboard__brain-index,
    .dashboard__brain-topic {
      overflow: visible;
    }

    .dashboard__brain-index {
      max-block-size: 13rem;
    }

  }

  @media (max-width: 34rem) {
    /* A phone has no room for the avatar column's worth of indent, and the rule on the replies
       already says where the thread is. */
    .dashboard__thread {
      padding-inline-start: var(--s-4);
    }

    .dashboard__gateway {
      padding-block: var(--s-8);
    }

    .dashboard__email-row,
    .dashboard__create-form {
      grid-template-columns: 1fr;
    }

    .dashboard__button {
      inline-size: 100%;
    }

    .dashboard__rail {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }

    .dashboard__workspace-control {
      inline-size: 100%;
    }

    /* DELETED 2026-09-03: two grid placements left over from when the theme toggle and the
     * wordmark sat in the rail itself. Both now live inside the account popover, which is a
     * grid, so a leftover grid-row of 3 on the theme toggle was reordering the MENU: Sign out
     * painted first, Theme last, while DOM and focus order still started at Theme. The
     * wordmark rule matched nothing at all — the menu brand is a child of the popover, not of
     * .dashboard__rail-foot. This mattered here because this change makes that menu the only
     * Sign out on a phone. */

    /* ~~The one-row channel head~~ retired 2026-09-04. It was one row, and one row was still
     * one row too many: 73px app bar + 53px head + 45px filter row = 171px of header on a
     * 844px screen. The head is now positioned over the transcript by the 52rem block above
     * and costs the reading area nothing, so there is no grid here to place anything in. What
     * survives at this width is the pill's refusal to wrap, below. */
    .dashboard__channel-head {
      padding-inline: var(--s-4);
    }

    .dashboard__mobile-view {
      padding-inline: var(--s-1);
      font-size: var(--t-xs);
    }

    .dashboard__channel-actions .dashboard__icon-button {
      inline-size: 2.25rem;
    }

    /* Dot only. The word costs 46px of a 358px row, and the channel name needs that width
     * more than the label does; aria-label on the chip still says "Live". */
    .dashboard__live-word {
      display: none;
    }

    /* The pill reads "0 · 3 pending" while access is waiting. Wrapping it took the floating
     * cluster to two lines and pushed it over the first message. It stays on one line and
     * truncates instead. */
    .dashboard__channel-roster {
      min-inline-size: 0;
      max-inline-size: 9rem;
    }

    /* No overflow clip on the button itself: it would cut the 4px focus ring. The label
     * inside it is what truncates. */
    .dashboard__roster-button {
      max-inline-size: 100%;
      min-inline-size: 0;
    }

    .dashboard__roster-count {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .dashboard__file-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard__file-identity,
    .dashboard__file-action {
      grid-column: 1 / -1;
    }

    .dashboard__file-action {
      justify-items: start;
    }

    .dashboard__file-download-status {
      text-align: start;
    }

    .dashboard__channel-actions {
      inline-size: auto;
      gap: var(--s-1);
      flex-wrap: nowrap;
      margin-inline-start: 0;
      padding-block-start: 0;
    }

    .dashboard__channel-empty,
    .dashboard__feed-state,
    .dashboard__choice-view,
    .dashboard__invite-view {
      inline-size: calc(100% - var(--s-8));
    }

    .dashboard__invite-form {
      grid-template-columns: 1fr;
    }

    .dashboard__invite-form label {
      grid-column: 1;
    }

    .dashboard__feed-state {
      grid-template-columns: 1fr;
    }

    .dashboard__message {
      padding-inline: var(--s-4);
    }

    .dashboard__composer {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
      padding-inline: var(--s-4);
      padding-block: var(--s-1);
    }

    .dashboard__composer-box,
    .dashboard__composer-to,
    .dashboard__composer-meta,
    .dashboard__composer-feedback {
      grid-column: 1;
      grid-row: auto;
    }

    .dashboard__composer-input {
      padding-block: var(--s-1);
    }

    .dashboard__message-meta time {
      margin-inline-start: 0;
    }

    .dashboard__message-operator {
      flex: 1 1 12rem;
    }
  }

  @media (max-width: 52rem) and (max-height: 36rem) {
    .dashboard__sample-notice {
      margin: var(--s-1);
    }

    .dashboard__rail {
      padding-block: var(--s-1);
    }

    /* The head floats now, so this block must not put a height or a taller padding back:
     * at 320x568 that once made the head 61px against a 57px app bar. */
    .dashboard__channel-head {
      min-block-size: 0;
      padding-block: var(--s-1);
    }

    /* ~~`.dashboard__feed-toolbar { display: none }`~~ removed 2026-09-04. The filter row was
     * hidden here because it took a row the short viewport could not spare. It floats over the
     * transcript now and takes no height, so hiding it only removed a control. */
    .dashboard__channel-description,
    .dashboard__composer-meta {
      display: none;
    }

    .dashboard__composer {
      gap: var(--s-1);
      padding-block-start: var(--s-1);
      padding-block-end: calc(var(--s-1) + env(safe-area-inset-bottom));
    }

    /* ~~`max-block-size: 2.75rem`~~ retired 2026-09-04. One line, and a second line of what
     * you were typing was clipped out of sight — measured at 390x508: the box needed 64px and
     * was given 44px. A short viewport is a reason to keep the composer small, not a reason to
     * hide the sentence being written. A quarter of the visible viewport is still small. */
    .dashboard__composer textarea {
      max-block-size: min(calc(var(--dashboard-viewport-height, 100dvh) * 0.25), 5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dashboard__spinner {
      animation-duration: 1.4s;
    }

    .dashboard__button,
    .dashboard__composer-send,
    .dashboard__composer-send-progress,
    .dashboard__message--fresh,
    .dashboard__roster-button,
    .dashboard__workspace-details-dialog[open],
    .dashboard__roster-dialog[open],
    .dashboard__wordmark::after {
      transition: none;
      animation: none;
    }
  }
  /* ── EDGES (operator, 2026-08-11: "scale it back further, we don't need most of these
   * dividers and borders") ─────────────────────────────────────────────────────────────────
   *
   * Method was subtractive, which is the only honest way to answer "which of these are needed":
   * every edge inside the frame was set transparent, the result was looked at, and the ones that
   * were MISSED were restored. Nothing here is a guess about what looks better.
   *
   * TWO survive, and only two:
   *   .dashboard__composer-input — a text field has to look like a text field. It is the one
   *     place a user is expected to click INTO rather than ON, and nothing else marks it.
   *   .dashboard__presence-dot — its "border" is the background colour punching the dot out of
   *     the avatar underneath. That is a mask, not a line; removing it merges two shapes.
   *
   * WHY THE REST WERE REDUNDANT, measured rather than asserted:
   *   - The rail/channel divider: the surfaces differ already, rgb(13,15,20) against
   *     rgb(18,21,28). The line was restating a boundary the fill was already making.
   *   - The rail's internal dividers: the section headings (STREAMS, PEOPLE & AGENTS) and the
   *     spacing separate those groups. Two devices for one job.
   *   - Avatar rings: the fill carries the identity hue, so the ring was the redundant half of a
   *     pair — see the tinted rules above, whose own comment says the hue reads "in the fill AND
   *     the ring".
   *   - Buttons and the workspace trigger: they have their own backgrounds and hover states.
   *
   * NOT written as `.dashboard__frame * { border-color: transparent }`. That was the probe, and
   * it is the wrong thing to ship: it would silently swallow the edge of anything added later,
   * including one that needed it, and the next person would have no way to see why their border
   * did not appear. Listing them means a new component starts with its own edges and someone
   * decides deliberately. */
  .dashboard__rail,
  .dashboard__rail-section,
  .dashboard__rail-details,
  .dashboard__rail-foot,
  .dashboard__rail-add,
  .dashboard__channel-head,
  .dashboard__workspace-context,
  .dashboard__workspace-trigger,
  .dashboard__workspace-menu,
  .dashboard__workspace-menu-create,
  .dashboard__workspace-id,
  .dashboard__icon-button,
  .dashboard__roster-button,
  .dashboard__workspace-details-dialog,
  .dashboard__roster-dialog,
  .dashboard__message-avatar,
  .dashboard__sidebar-person-avatar,
  .dashboard__entity-avatar,
  .dashboard__agent-avatar.dashboard__avatar--tinted,
  .dashboard__message-avatar.dashboard__avatar--tinted,
  .dashboard__entity-avatar.dashboard__avatar--tinted,
  .dashboard__invite-form input,
  .dashboard__create-form input,
  .dashboard__roster-dialog-search {
    border-color: transparent;
  }

  /* Three that the single-class list above could not reach, and the reason is worth keeping:
   * `.dashboard__rail-section + .dashboard__rail-section` and `.dashboard__message + .dashboard__message`
   * are SIBLING selectors — specificity
   * (0,2,0) — so a one-class override loses to it wherever it sits in the file. The toolbar and
   * composer edges were simply missed on the first pass; they were found by re-enumerating the
   * painted edges on the DEPLOYED page rather than by re-reading the source. */
  .dashboard__rail-section + .dashboard__rail-section,
  .dashboard__message + .dashboard__message,
  .dashboard__feed-toolbar,
  .dashboard__composer,
  .dashboard__composer select,
  .dashboard__composer-recipient {
    border-color: transparent;
  }

  /* THE RAIL IS SEPARATED BY SURFACE, NOT BY A LINE — and this is the one place removing an edge
   * genuinely lost something, caught by checking BOTH themes rather than the one on screen.
   *
   * In dark the rail already sat on rgb(13,15,20) against the channel's rgb(18,21,28), so the
   * divider was restating what the fill said. In LIGHT both were #fff, identical, and that border
   * was the ONLY thing separating the sidebar from the transcript. Dropping it flattened the two
   * columns into one white field.
   *
   * So the separation moves to the fill in both themes, which is the same answer the rest of this
   * block gives: a tint, not a rule. --bg is the page colour behind the frame, so the rail reads
   * as the surface the content sits ON rather than as a boxed-off panel. */
  .dashboard__rail {
    background: var(--bg);
  }

  /* The one edge a user needs: this is the field they click INTO. */
  .dashboard__composer-input {
    border-color: color-mix(in oklab, var(--border) 40%, transparent);
  }

</style>
