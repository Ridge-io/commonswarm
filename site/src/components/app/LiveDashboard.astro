    const renderSample = (): void => {
      sampleMode = true;
      stopAgentActivity();
      agentActivityConnection = "subscribed";
      signalHasMore = false;
      signalCursor = null;
      signalCutoff = "";
      syncPendingPoll();
      const now = Date.now();
      /* TWO SAMPLE WORKSPACES, because one workspace cannot show what a workspace switch
         does. A real account has several, and moving between them is the transition that
         used to lose a draft's address: the roster is briefly unknown, and everything the
         composer knows has to survive that gap. The second one is also the only sample
         roster large enough to reach the To: cap, which is eight. */
      workspaces = [
        { id: "sample-design-studio", name: "Design studio", archived: false },
        { id: "sample-field-lab", name: "Field lab", archived: false },
      ];
      applySampleRoster("sample-design-studio");
      accessStatuses = [
        {
          workspaceId: "sample-design-studio",
          principalId: "sample-river",
          ownerUserId: "sample-owner",
          agentName: "River",
          model: "GPT-5",
          tokenId: "sample-token-river-8c51b6a2",
          issuedAt: new Date(now - 50 * 60_000).toISOString(),
