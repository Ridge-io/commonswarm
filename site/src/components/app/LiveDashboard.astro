---
/*
 * The dashboard is deliberately rendered by the browser script below. Astro's static HTML
 * contains only a loading state, so a build can never bake sample workspaces or signals into
 * the page. Dynamic strings are assigned with textContent rather than parsed as markup.
 */
---

<div class="dashboard" data-dashboard>
  <div class="dashboard__wash" aria-hidden="true"></div>
  <section
    class="dashboard__root"
    data-dashboard-root
    aria-live="polite"
    aria-busy="true"
  >
    <div class="dashboard__loading" role="status">
      <span class="dashboard__spinner" aria-hidden="true"></span>
      <span>Opening your workspaces…</span>
    </div>
  </section>
</div>

<script>
  import {
    NoDeployment,
    client,
    currentSession,
    feed,
    myWorkspaces,
    signInWithGitHub,
    signOut,
  } from "../../lib/commonswarm.ts";

  type Workspace = Awaited<ReturnType<typeof myWorkspaces>>[number];
  type FeedSignal = Awaited<ReturnType<typeof feed>>[number];

  const root = document.querySelector<HTMLElement>("[data-dashboard-root]");

  let workspaces: Workspace[] = [];
  let activeWorkspaceId: string | null = null;
  let requestVersion = 0;

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function icon(name: "github" | "refresh" | "signout" | "arrow"): SVGSVGElement {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("width", "18");
    svg.setAttribute("height", "18");
    svg.setAttribute("aria-hidden", "true");
    svg.setAttribute("fill", name === "github" ? "currentColor" : "none");
    svg.setAttribute("stroke", "currentColor");
    svg.setAttribute("stroke-width", "1.8");
    svg.setAttribute("stroke-linecap", "round");
    svg.setAttribute("stroke-linejoin", "round");

    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    const paths: Record<typeof name, string> = {
      github:
        "M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z",
      refresh:
        "M20 6v5h-5M4 18v-5h5M6.1 9a7 7 0 0 1 11.7-2.6L20 8.5M4 15.5l2.2 2.1A7 7 0 0 0 17.9 15",
      signout: "M10 5H5v14h5M14 8l4 4-4 4M18 12H9",
      arrow: "M5 12h14M14 7l5 5-5 5",
    };
    path.setAttribute("d", paths[name]);
    if (name === "github") path.removeAttribute("stroke");
    svg.append(path);
    return svg;
  }

  function button(
    label: string,
    variant: "primary" | "secondary" | "quiet",
    iconName?: "github" | "refresh" | "signout",
  ): HTMLButtonElement {
    const control = element("button", `dashboard__button dashboard__button--${variant}`);
    control.type = "button";
    if (iconName) control.append(icon(iconName));
    control.append(document.createTextNode(label));
    return control;
  }

  function linkButton(
    label: string,
    href: string,
    variant: "primary" | "secondary" | "quiet" = "primary",
  ): HTMLAnchorElement {
    const control = element("a", `dashboard__button dashboard__button--${variant}`);
    control.href = href;
    control.append(document.createTextNode(label));
    if (variant === "primary") control.append(icon("arrow"));
    return control;
  }

  function replaceRoot(node: HTMLElement, busy = false): void {
    if (!root) return;
    root.replaceChildren(node);
    root.setAttribute("aria-busy", busy ? "true" : "false");
  }

  function loading(label = "Opening your workspaces…"): void {
    const wrap = element("div", "dashboard__loading");
    wrap.setAttribute("role", "status");
    wrap.append(
      element("span", "dashboard__spinner"),
      element("span", undefined, label),
    );
    wrap.firstElementChild?.setAttribute("aria-hidden", "true");
    replaceRoot(wrap, true);
  }

  function statePanel(
    eyebrow: string,
    title: string,
    body: string,
    actions: HTMLElement[] = [],
  ): HTMLElement {
    const panel = element("div", "dashboard__state");
    const brand = element("a", "dashboard__brand", "CommonSwarm");
    brand.href = "/";
    brand.setAttribute("aria-label", "CommonSwarm home");
    const copy = element("div", "dashboard__state-copy");
    copy.append(
      element("p", "dashboard__eyebrow", eyebrow),
      element("h1", "dashboard__state-title", title),
      element("p", "dashboard__state-body", body),
    );
    panel.append(brand, copy);
    if (actions.length > 0) {
      const controls = element("div", "dashboard__state-actions");
      controls.append(...actions);
      panel.append(controls);
    }
    return panel;
  }

  function readableError(error: unknown): string {
    if (
      error instanceof Error &&
      /network|fetch|offline|connection/i.test(error.message)
    ) {
      return "Check your internet connection, then try again.";
    }
    return "CommonSwarm could not complete that request. Try again in a moment.";
  }

  function renderNoDeployment(): void {
    replaceRoot(
      statePanel(
        "Dashboard unavailable",
        "This page is not connected yet.",
        "The dashboard was published without the settings it needs. Nothing you did caused this. Return to the CommonSwarm home page and try again later.",
        [linkButton("Back to CommonSwarm", "/")],
      ),
    );
  }

  function renderSignedOut(): void {
    const signIn = button("Sign in with GitHub", "primary", "github");
    const emailSignIn = linkButton("Use email instead", "/start", "secondary");
    const status = element("p", "dashboard__signin-error");
    status.setAttribute("role", "alert");
    status.hidden = true;

    signIn.addEventListener("click", async () => {
      signIn.disabled = true;
      signIn.setAttribute("aria-busy", "true");
      status.hidden = true;
      try {
        await signInWithGitHub(new URL("/app", window.location.origin).href);
      } catch (error) {
        if (error instanceof NoDeployment) {
          renderNoDeployment();
          return;
        }
        status.textContent = readableError(error);
        status.hidden = false;
        signIn.disabled = false;
        signIn.removeAttribute("aria-busy");
      }
    });

    const panel = statePanel(
      "Your shared workspace",
      "See what everyone is working on.",
      "Sign in to open the workspaces you belong to and read updates from people and AI agents. CommonSwarm only shows you workspaces where you are a member.",
      [signIn, emailSignIn],
    );
    panel.append(status);
    replaceRoot(panel);
  }

  function makeSignOutButton(): HTMLButtonElement {
    const control = button("Sign out", "quiet", "signout");
    control.addEventListener("click", async () => {
      control.disabled = true;
      await signOut();
      workspaces = [];
      activeWorkspaceId = null;
      requestVersion += 1;
      renderSignedOut();
    });
    return control;
  }

  function renderNoWorkspaces(): void {
    replaceRoot(
      statePanel(
        "You’re signed in",
        "Create or join your first workspace.",
        "Start a free workspace of your own, or use an invitation from someone else. The next page walks you through either path.",
        [linkButton("Choose how to join", "/start"), makeSignOutButton()],
      ),
    );
  }

  function renderLoadError(error: unknown, retry: () => void): void {
    if (error instanceof NoDeployment) {
      renderNoDeployment();
      return;
    }
    const retryButton = button("Try again", "primary", "refresh");
    retryButton.addEventListener("click", retry);
    replaceRoot(
      statePanel(
        "Could not open your workspaces",
        "The dashboard needs another try.",
        `${readableError(error)} Nothing was changed.`,
        [retryButton, makeSignOutButton()],
      ),
    );
  }

  function formatDate(value: string): {
    relative: string;
    absolute: string;
    valid: boolean;
  } {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) {
      return { relative: "Time unavailable", absolute: "", valid: false };
    }

    const deltaSeconds = Math.round((date.getTime() - Date.now()) / 1000);
    const ranges: Array<[number, Intl.RelativeTimeFormatUnit]> = [
      [60, "second"],
      [60, "minute"],
      [24, "hour"],
      [7, "day"],
      [4.345, "week"],
      [12, "month"],
      [Number.POSITIVE_INFINITY, "year"],
    ];
    let valueForUnit = deltaSeconds;
    let unit: Intl.RelativeTimeFormatUnit = "second";
    for (const [range, nextUnit] of ranges) {
      unit = nextUnit;
      if (Math.abs(valueForUnit) < range) break;
      valueForUnit /= range;
    }

    const relative = new Intl.RelativeTimeFormat(undefined, {
      numeric: "auto",
    }).format(Math.round(valueForUnit), unit);
    const absolute = new Intl.DateTimeFormat(undefined, {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(date);
    return { relative, absolute, valid: true };
  }

  function signalBadge(kind: string): HTMLElement {
    const normalized = kind.toLowerCase();
    const labels: Record<string, string> = {
      "working-on": "Working on",
      note: "Note",
      ask: "Question",
    };
    const label = labels[normalized];
    const badge = element(
      "span",
      `dashboard__kind dashboard__kind--${label ? normalized : "unknown"}`,
      label ?? (kind || "Update"),
    );
    return badge;
  }

  function signalRow(signal: FeedSignal, index: number): HTMLLIElement {
    const row = element("li", "dashboard__signal");
    row.style.setProperty("--signal-index", String(Math.min(index, 10)));

    const rail = element("div", "dashboard__signal-rail");
    const mark = element("span", "dashboard__author-mark");
    mark.textContent = signal.from.trim().charAt(0).toUpperCase() || "·";
    mark.setAttribute("aria-hidden", "true");
    rail.append(mark, element("span", "dashboard__rail-line"));

    const content = element("article", "dashboard__signal-content");
    const meta = element("div", "dashboard__signal-meta");
    const authorGroup = element("div", "dashboard__author-group");
    const author = element(
      "span",
      "dashboard__author",
      signal.from.trim() || "Unknown author",
    );
    const authorKind =
      signal.fromKind.toLowerCase() === "agent" ? "AI agent" : "Person";
    authorGroup.append(
      author,
      element("span", "dashboard__author-kind", authorKind),
      signalBadge(signal.kind),
    );

    const when = formatDate(signal.createdAt);
    const time = element("time", "dashboard__time", when.relative);
    if (when.valid) {
      time.dateTime = signal.createdAt;
      time.title = when.absolute;
      time.setAttribute("aria-label", when.absolute);
    }
    meta.append(authorGroup, time);

    const body = element("p", "dashboard__signal-body", signal.body);
    content.append(meta, body);

    const details = element("div", "dashboard__signal-details");
    if (signal.about) {
      const about = element("p", "dashboard__about");
      about.append(
        element("span", "dashboard__detail-label", "About"),
        element("code", undefined, signal.about),
      );
      details.append(about);
    }
    if (signal.until) {
      const until = formatDate(signal.until);
      const expiry = element("p", "dashboard__until");
      expiry.append(element("span", "dashboard__detail-label", "Until"));
      const expiryTime = element("time", undefined, until.relative);
      if (until.valid) {
        expiryTime.dateTime = signal.until;
        expiryTime.title = until.absolute;
        expiryTime.setAttribute("aria-label", until.absolute);
      }
      expiry.append(expiryTime);
      details.append(expiry);
    }
    if (details.childElementCount > 0) content.append(details);

    row.append(rail, content);
    return row;
  }

  function workspaceHeader(selected: Workspace): {
    header: HTMLElement;
    refreshButton: HTMLButtonElement;
  } {
    const header = element("header", "dashboard__header");
    const identity = element("div", "dashboard__identity");
    const brand = element("a", "dashboard__brand", "CommonSwarm");
    brand.href = "/";
    brand.setAttribute("aria-label", "CommonSwarm home");

    const workspaceCopy = element("div", "dashboard__workspace-copy");
    workspaceCopy.append(
      element("span", "dashboard__workspace-label", "Workspace"),
      element("h1", "dashboard__workspace-name", selected.name),
    );
    identity.append(brand, workspaceCopy);

    const controls = element("div", "dashboard__header-controls");
    if (workspaces.length > 1) {
      const field = element("label", "dashboard__select-field");
      field.append(element("span", "dashboard__select-label", "Switch workspace"));
      const select = element("select", "dashboard__select");
      select.setAttribute("aria-label", "Switch workspace");
      for (const workspace of workspaces) {
        const option = element("option", undefined, workspace.name);
        option.value = workspace.id;
        option.selected = workspace.id === selected.id;
        select.append(option);
      }
      select.addEventListener("change", () => {
        void openWorkspace(select.value);
      });
      field.append(select);
      controls.append(field);
    }

    const refreshButton = button("Refresh", "secondary", "refresh");
    refreshButton.addEventListener("click", () => {
      void openWorkspace(selected.id);
    });
    controls.append(refreshButton, makeSignOutButton());
    header.append(identity, controls);
    return { header, refreshButton };
  }

  function renderWorkspace(
    selected: Workspace,
    signals: FeedSignal[] | null,
    error: unknown = null,
  ): void {
    const shell = element("div", "dashboard__shell");
    const { header, refreshButton } = workspaceHeader(selected);
    const feedPanel = element("section", "dashboard__feed");
    feedPanel.setAttribute("aria-labelledby", "signal-feed-title");

    const feedHeader = element("div", "dashboard__feed-header");
    const feedTitleGroup = element("div");
    const feedTitle = element("h2", "dashboard__feed-title", "What everyone is working on");
    feedTitle.id = "signal-feed-title";
    feedTitleGroup.append(
      feedTitle,
      element(
        "p",
        "dashboard__feed-subtitle",
        "Updates from people and AI agents, newest first.",
      ),
    );
    feedHeader.append(feedTitleGroup);

    if (signals && !error) {
      const count = element(
        "span",
        "dashboard__count",
        `${signals.length} ${signals.length === 1 ? "update" : "updates"}`,
      );
      feedHeader.append(count);
    }
    feedPanel.append(feedHeader);

    if (error) {
      const errorPanel = element("div", "dashboard__feed-state");
      errorPanel.append(
        element("h3", "dashboard__feed-state-title", "The latest updates could not load."),
        element(
          "p",
          "dashboard__feed-state-body",
          `${readableError(error)} Your workspace is still here.`,
        ),
      );
      const retry = button("Try again", "primary", "refresh");
      retry.addEventListener("click", () => void openWorkspace(selected.id));
      errorPanel.append(retry);
      feedPanel.append(errorPanel);
    } else if (signals === null) {
      refreshButton.disabled = true;
      refreshButton.setAttribute("aria-busy", "true");
      const loadingPanel = element("div", "dashboard__feed-state");
      const spinner = element("span", "dashboard__spinner");
      spinner.setAttribute("aria-hidden", "true");
      loadingPanel.append(
        spinner,
        element("p", "dashboard__feed-state-body", "Loading the latest updates…"),
      );
      feedPanel.append(loadingPanel);
    } else if (signals.length === 0) {
      const empty = element("div", "dashboard__feed-state dashboard__feed-state--empty");
      const emptyActions = element("div", "dashboard__state-actions");
      emptyActions.append(linkButton("Set up CommonSwarm", "/download", "secondary"));
      empty.append(
        element("span", "dashboard__empty-mark", "0"),
        element("h3", "dashboard__feed-state-title", "No updates yet."),
        element(
          "p",
          "dashboard__feed-state-body",
          "You can post the first one. Use the guided setup, sign in from your terminal, then run cswarm working-on \"what I’m doing\". Come back here and press Refresh.",
        ),
        emptyActions,
      );
      feedPanel.append(empty);
    } else {
      const list = element("ol", "dashboard__signal-list");
      list.append(...signals.map(signalRow));
      feedPanel.append(list);
    }

    shell.append(header, feedPanel);
    replaceRoot(shell, signals === null && !error);
  }

  async function openWorkspace(workspaceId: string): Promise<void> {
    const selected = workspaces.find((workspace) => workspace.id === workspaceId);
    if (!selected) return;
    activeWorkspaceId = selected.id;
    const version = ++requestVersion;
    renderWorkspace(selected, null);

    try {
      const signals = await feed(selected.id, 50);
      if (version !== requestVersion || activeWorkspaceId !== selected.id) return;
      renderWorkspace(selected, signals);
    } catch (error) {
      if (version !== requestVersion || activeWorkspaceId !== selected.id) return;
      if (error instanceof NoDeployment) {
        renderNoDeployment();
        return;
      }
      renderWorkspace(selected, [], error);
    }
  }

  async function loadDashboard(): Promise<void> {
    const version = ++requestVersion;
    loading();

    if (!client()) {
      renderNoDeployment();
      return;
    }

    try {
      const session = await currentSession();
      if (version !== requestVersion) return;
      if (!session) {
        renderSignedOut();
        return;
      }

      workspaces = await myWorkspaces();
      if (version !== requestVersion) return;
      if (workspaces.length === 0) {
        activeWorkspaceId = null;
        renderNoWorkspaces();
        return;
      }

      const selected =
        workspaces.find((workspace) => workspace.id === activeWorkspaceId) ?? workspaces[0];
      await openWorkspace(selected.id);
    } catch (error) {
      if (version !== requestVersion) return;
      renderLoadError(error, () => void loadDashboard());
    }
  }

  const configuredClient = client();
  configuredClient?.auth.onAuthStateChange((event) => {
    if (event !== "SIGNED_IN" && event !== "SIGNED_OUT" && event !== "USER_UPDATED") {
      return;
    }
    queueMicrotask(() => void loadDashboard());
  });

  void loadDashboard();
</script>

<style is:global>
  .dashboard {
    position: relative;
    min-block-size: 100svh;
    color: var(--text);
    isolation: isolate;
  }

  .dashboard__wash {
    position: fixed;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        52rem 30rem at 8% -4%,
        color-mix(in oklab, var(--accent) 12%, transparent),
        transparent 72%
      ),
      linear-gradient(
        90deg,
        transparent 0,
        transparent calc(50% - 1px),
        color-mix(in oklab, var(--border) 35%, transparent) 50%,
        transparent calc(50% + 1px)
      );
    background-size: auto, 5rem 100%;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
  }

  .dashboard__root {
    display: grid;
    min-block-size: 100svh;
  }

  .dashboard__loading {
    place-self: center;
  }

  .dashboard__loading {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--elev-1);
    box-shadow: var(--ring-top);
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__spinner {
    display: inline-block;
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
    border: 2px solid var(--border-strong);
    border-block-start-color: var(--accent);
    border-radius: 50%;
    animation: dashboard-spin 700ms linear infinite;
  }

  @keyframes dashboard-spin {
    to {
      transform: rotate(1turn);
    }
  }

  .dashboard__signin-error {
    max-inline-size: 32rem;
    margin: calc(-1 * var(--s-4)) 0 0;
    color: var(--danger);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    text-align: center;
  }

  .dashboard__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-block-size: 2.75rem;
    padding-inline: var(--s-4);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform var(--dur-2) var(--ease-standard),
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard),
      box-shadow var(--dur-2) var(--ease-standard);
  }

  .dashboard__button:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .dashboard__button:active {
    transform: translateY(0);
  }

  .dashboard__button:focus-visible,
  .dashboard__select:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__button:disabled {
    opacity: 0.55;
    pointer-events: none;
  }

  .dashboard__button--primary {
    color: var(--accent-ink);
    background: linear-gradient(180deg, var(--accent-bright), var(--accent));
    border-color: color-mix(in oklab, var(--accent-bright) 65%, transparent);
    box-shadow: var(--shadow-glow);
  }

  .dashboard__button--secondary {
    color: var(--text);
    background: var(--elev-1);
    border-color: var(--border-interactive);
    box-shadow: var(--ring-top);
  }

  .dashboard__button--secondary:hover {
    background: var(--elev-3);
  }

  .dashboard__button--quiet {
    color: var(--text-muted);
    background: transparent;
    border-color: transparent;
  }

  .dashboard__button--quiet:hover {
    color: var(--text);
    background: var(--elev-3);
  }

  .dashboard__state {
    place-self: center;
    display: grid;
    gap: var(--s-8);
    inline-size: min(100% - var(--gutter) * 2, 42rem);
    padding: clamp(var(--s-8), 7vw, var(--s-12));
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--elev-1);
    box-shadow: var(--ring-top), var(--shadow-lg);
  }

  .dashboard__state-copy {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__eyebrow,
  .dashboard__state-title,
  .dashboard__state-body {
    margin: 0;
  }

  .dashboard__eyebrow {
    color: var(--accent-bright);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__state-title {
    max-inline-size: 18ch;
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
    text-wrap: balance;
  }

  .dashboard__state-body {
    max-inline-size: 56ch;
    color: var(--text-muted);
