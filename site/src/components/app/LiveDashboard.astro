  }

  .dashboard__button--primary {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .dashboard__button--primary:hover:not(:disabled) {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .dashboard__button--secondary {
    color: var(--text);
    background: var(--elev-2);
    border-color: var(--border-interactive);
  }

  .dashboard__text-button,
  .dashboard__back-button {
    min-block-size: 2.75rem;
    padding: var(--s-2);
    color: var(--text-muted);
    background: transparent;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .dashboard__text-button:hover,
  .dashboard__back-button:hover {
    color: var(--text);
  }

  .dashboard__email {
    display: grid;
    gap: var(--s-3);
    max-inline-size: 38rem;
  }

  .dashboard__email label,
  .dashboard__create-form label {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__email-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-3);
  }

  .dashboard__auth-note {
    max-inline-size: 58ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__auth-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-faint);
    font-size: var(--t-xs);
  }

  .dashboard__auth-divider::before,
  .dashboard__auth-divider::after {
    content: "";
    block-size: 1px;
    background: var(--border);
  }

  .dashboard__email input,
  .dashboard__create-form input {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-base);
  }

  .dashboard__email-sent {
    display: grid;
    gap: var(--s-2);
    max-inline-size: 38rem;
    padding: var(--s-5);
    border: 1px solid var(--accent-dim);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent-dim) 48%, var(--elev-1));
  }

  .dashboard__email-sent p {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-base);
  }

  .dashboard__email-sent-title {
    color: var(--text) !important;
    font-weight: var(--weight-semibold);
  }

  .dashboard__form-error {
    max-inline-size: 56ch;
    margin: 0;
    color: var(--danger);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__legal-note {
    max-inline-size: 42rem;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__legal-note a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .dashboard__account-line {
    inline-size: fit-content;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__account-dot {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-dim);
  }

  .dashboard__create-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .dashboard__create-form label {
    grid-column: 1 / -1;
  }

  .dashboard__signout-link {
    inline-size: fit-content;
  }

  .dashboard__product {
    min-block-size: 100svh;
    padding: var(--s-4);
  }

  .dashboard__sample-notice {
    max-inline-size: 88rem;
    margin: 0 auto var(--s-3);
  }

  .dashboard__frame {
    min-block-size: calc(100svh - var(--s-8));
    max-inline-size: 88rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: var(--dashboard-rail) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--elev-1);
    box-shadow: var(--ring-top), var(--shadow-lg);
  }

  .dashboard__sample-notice:not([hidden]) + .dashboard__frame {
    min-block-size: calc(100svh - var(--s-8) - 4rem);
  }

  .dashboard__rail {
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    padding: var(--s-5) var(--s-4);
    border-inline-end: 1px solid var(--border);
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--accent-dim) 34%, transparent),
        transparent 11rem
      ),
      var(--elev-0);
  }

  .dashboard__rail-head {
    min-block-size: 4rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__sample-chip {
    padding: 0.2rem 0.45rem;
    color: var(--warning);
    background: var(--warning-dim);
    border-radius: var(--radius-pill);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__rail-section {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__rail-details-body {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__rail-details {
    padding-block: var(--s-4);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__rail-details > summary {
    min-block-size: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__rail-details > summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__rail-details-body {
    padding-block-start: var(--s-3);
  }

  .dashboard__workspace-id {
    max-inline-size: 100%;
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__copy-status {
    min-block-size: 1em;
    color: var(--text-muted);
    font-size: var(--t-2xs);
  }

  .dashboard__rail-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__rail-label-row h2,
  .dashboard__rail-label-row span {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__workspace-list {
    display: grid;
    gap: var(--s-1);
    max-block-size: min(40svh, 20rem);
    overflow: auto;
  }

  .dashboard__workspace-button {
    min-inline-size: 0;
    min-block-size: 2.75rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    text-align: start;
    cursor: pointer;
  }

  .dashboard__workspace-button > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__workspace-button:hover {
    color: var(--text);
    background: var(--elev-2);
  }

  .dashboard__workspace-button[aria-current="page"] {
    color: var(--text);
    background: var(--accent-dim);
    border-color: color-mix(in oklab, var(--accent) 25%, transparent);
  }

  .dashboard__workspace-mark {
    inline-size: 1.8rem;
    block-size: 1.8rem;
    display: grid;
    place-items: center;
    color: var(--accent-bright);
    background: var(--elev-1);
    border: 1px solid var(--border);
    border-radius: 0.48rem;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__agent-list {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__agent {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
  }

  .dashboard__agent-avatar,
  .dashboard__message-avatar {
    inline-size: 2rem;
    block-size: 2rem;
    display: grid;
    place-items: center;
    flex: none;
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
  }

  /* The tint carries the per-agent identity now that the shape is fixed to the circle.
     Initials use --text rather than a pastel of the hue: the pastel was tuned for the
     dark palette and washed out on the light tint, while --text clears 16:1 on every
     surface in both modes. The hue still distinguishes agents in the fill and the ring. */
  .dashboard__agent-avatar.dashboard__avatar--tinted,
  .dashboard__message-avatar.dashboard__avatar--tinted {
    color: var(--text);
    background: color-mix(in oklab, hsl(var(--avatar-hue) 58% 48%) 20%, var(--elev-3));
    border-color: color-mix(in oklab, hsl(var(--avatar-hue) 70% 58%) 52%, var(--border));
  }

  .dashboard__agent-copy {
    min-inline-size: 0;
    display: grid;
  }

  .dashboard__agent-copy strong {
    overflow: hidden;
    color: var(--text);
    font-size: var(--t-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__agent-copy span,
  .dashboard__agent-empty {
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__agent-empty {
    padding: var(--s-2) var(--s-3);
    font-style: italic;
  }

  .dashboard__rail-add {
    min-block-size: 2.75rem;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: start;
    cursor: pointer;
  }

  .dashboard__rail-add:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .dashboard__rail-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    /* The agents section used to flex:1 the footer to the bottom; with the roster moved
       to the header dialog, the footer's own margin does the pinning now. */
    margin-block-start: auto;
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__channel {
    min-inline-size: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: var(--elev-1);
  }

  .dashboard__channel-head {
    min-block-size: 6.5rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    padding: var(--s-5) clamp(var(--s-5), 4vw, var(--s-8));
    border-block-end: 1px solid var(--border);
  }

  .dashboard__channel-titleblock {
    min-inline-size: 0;
  }

  .dashboard__channel-kicker {
    margin-block-end: var(--s-1);
    font-size: var(--t-2xs);
  }

  .dashboard__channel-head h1 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--t-xl);
    line-height: var(--lh-xl);
    letter-spacing: var(--track-head);
    overflow-wrap: anywhere;
  }

  .dashboard__channel-actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
    white-space: nowrap;
  }

  /* The live affordance: the same pulse idiom the landing FeedPanel uses for a
     signal that just landed, reused here as a standing state. motion.css stills
     the pulse under prefers-reduced-motion; the dot itself stays. */
  .dashboard__live {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    /* Same flex-child floor as the choice copy: the chip must be allowed to give
       up width (and let the actions row wrap below 34rem) rather than hold it. */
    min-inline-size: 0;
    color: var(--success);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__live-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    animation: dashboard-live-pulse 2.6s var(--ease-standard) infinite;
  }

  @keyframes dashboard-live-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--success-dim);
    }
    70% {
      box-shadow: 0 0 0 6px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* --- the header agent roster: one stack button + its dialog ----------------------- */

  /* The stack sits between the title and the actions while there is room, glued right;
     at ≤52rem it takes its own row (see the media query) so it never squeezes out. */
  .dashboard__channel-roster {
    flex: none;
    min-inline-size: 0;
    margin-inline-start: auto;
  }

  .dashboard__roster-button {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1);
    color: var(--text);
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__roster-button:hover {
    background: var(--elev-3);
    border-color: var(--border-strong);
  }

  .dashboard__roster-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__roster-stack {
    display: flex;
    align-items: center;
  }

  /* The overlap ring reads as a cut between neighbours when it matches the button's own
     fill, so it follows the hover fill too. */
  .dashboard__roster-stack .dashboard__agent-avatar {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 2px solid var(--elev-2);
    margin-inline-start: -0.5rem;
  }

  .dashboard__roster-stack .dashboard__agent-avatar:first-child {
    margin-inline-start: 0;
  }

  .dashboard__roster-button:hover .dashboard__roster-stack .dashboard__agent-avatar {
    border-color: var(--elev-3);
  }

  .dashboard__roster-count {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  /* The dialog. Native <dialog>: the UA centers it over a backdrop and owns Escape,
     focus containment, and focus restore; the styles only make it ours. At ≤52rem the
     same element becomes a bottom sheet rather than a second component. */
  .dashboard__roster-dialog {
    inline-size: min(calc(100% - var(--s-8)), 26rem);
    max-inline-size: calc(100% - var(--s-8));
    max-block-size: min(42rem, calc(100dvh - var(--s-8)));
    /* global.css's universal * { margin: 0 } beats the UA's dialog-centering margin:auto,
       so centering is restated here; the ≤52rem sheet re-anchors it to the bottom. */
    margin: auto;
    padding: 0;
    color: var(--text);
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dashboard__roster-dialog::backdrop {
    background: color-mix(in oklab, var(--text) 32%, transparent);
  }

  .dashboard__roster-dialog[open] {
    animation: dashboard-dialog-in var(--dur-3) var(--ease-decelerate);
  }

  @keyframes dashboard-dialog-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .dashboard__roster-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__roster-dialog-head h2 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text);
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    letter-spacing: var(--track-head);
  }

  .dashboard__roster-dialog-count {
    color: var(--text-muted);
    font-size: var(--t-sm);
    font-weight: var(--weight-medium);
  }

  .dashboard__roster-dialog-body {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5) var(--s-5);
  }

  .dashboard__roster-dialog-add {
    inline-size: 100%;
  }

  .dashboard__roster-dialog-search {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-sm);
  }

  /* The roster scrolls inside the dialog rather than growing it past the viewport. */
  .dashboard__roster-dialog-list {
    max-block-size: min(46svh, 20rem);
    overflow: auto;
    margin-inline: calc(var(--s-2) * -1);
  }

  .dashboard__roster-dialog-list .dashboard__agent {
    border-radius: var(--radius-sm);
  }

  .dashboard__mobile-signout {
    display: none;
    min-block-size: 2.75rem;
    align-items: center;
  }

  .dashboard__mobile-signout[hidden] {
    display: none;
  }

  .dashboard__icon-button {
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .dashboard__icon-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dashboard__icon-button:hover {
    color: var(--text);
    background: var(--elev-3);
  }

  .dashboard__channel-body {
    min-block-size: 0;
    display: grid;
    overflow: auto;
  }

  .dashboard__channel-body > [data-channel-view] {
    grid-area: 1 / 1;
  }

  .dashboard__channel-empty {
    place-self: center;
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    inline-size: min(100% - var(--s-10), 36rem);
    padding-block: var(--s-12);
  }

  .dashboard__channel-empty h2,
  .dashboard__feed-state h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
  }

  .dashboard__channel-empty > p:not(.dashboard__eyebrow),
  .dashboard__feed-state p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    text-wrap: pretty;
  }

  .dashboard__empty-orbit {
    position: relative;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--elev-2);
  }

  .dashboard__empty-orbit::before,
  .dashboard__empty-orbit span {
    content: "";
    position: absolute;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-dim);
  }

  .dashboard__empty-orbit::before {
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
  }

  .dashboard__empty-orbit span:nth-child(1) {
    inset: 0.35rem auto auto 0.55rem;
    opacity: 0.35;
  }

  .dashboard__empty-orbit span:nth-child(2) {
    inset: auto 0.4rem 0.7rem auto;
    opacity: 0.2;
  }

  .dashboard__empty-orbit span:nth-child(3) {
    display: none;
  }

  .dashboard__connect-view {
    min-inline-size: 0;
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .dashboard__channel-receipt {
    z-index: 3;
    grid-area: 1 / 1;
    align-self: start;
    justify-self: center;
    margin: var(--s-4);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: color-mix(in oklab, var(--success-dim) 82%, var(--elev-2));
