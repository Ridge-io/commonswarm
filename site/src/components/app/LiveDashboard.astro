  interface Workspace extends CloseableWorkspace {}

  interface Agent {
    principalId: string;
    name: string;
    model: string | null;
    ownerUserId: string;
  }

  interface Member {
    userId: string;
    name: string;
    role: "owner" | "admin" | "member";
  }

  interface SecretHoldingAgentConnect extends HTMLElement {
    clearPrompt(notify?: boolean): void;
    finishPrompt(reason: "done" | "back" | "consumed", notify?: boolean): void;
    requestPromptFor(principalId: string): void;
  }

  interface CreateIntent {
    workspaceId: string;
    commandId: string;
    name: string;
  }

  interface SignalCursor {
    createdAt: string;
    id: string;
  }

  interface ComposerDraft {
    body: string;
    hadAttachments?: boolean;
    /**
     * The To: set this body was being written to, and which of its tags have already been
     * lifted into chips. THE PAIR TRAVELS TOGETHER or neither does: the applied record on
     * its own suppresses a tag whose chip was not saved, and the set on its own lets a
     * removed recipient come back on the next keystroke. A review arm found the second
     * shape, and the first appeared while fixing it.
     *
     * This is the state of a message being written. The LAST SENT set is remembered
     * separately (`rememberComposerTo`) and is what the composer opens with when there is
     * no draft.
     */
    to?: { kind: "agent" | "person"; id: string }[];
    applied?: string[];
  }

  interface StagedComposerAttachment {
    intent: BrowserAttachmentUploadIntent;
    previewUrl: string | null;
  }

  type EntityRef =
    | { kind: "agent"; id: string }
    | { kind: "person"; id: string };

  type ComposerAudience = BrowserSignalRecipient;

  const app = document.querySelector<HTMLElement>("live-dashboard");

  if (app) {
    /*
     * Top-level dashboard panels only. AgentConnect reuses data-panel=… for its own
     * loading/form/result surfaces inside <agent-connect>. A broad [data-panel] walk
     * would stamp hidden on those children whenever showPanel("channel") ran, and the
     * UA's [hidden] { display:none !important } permanently hides the name field and
     * mint button even after AgentConnect sets data-state=ready. Scope to the root's
     * direct panel sections so nested connect markup keeps its own visibility model.
     */
    const panel = (name: string): HTMLElement | null =>
      app.querySelector<HTMLElement>(`.dashboard__root > [data-panel="${name}"]`);
    const one = <T extends Element>(selector: string): T | null => app.querySelector<T>(selector);
    const all = <T extends Element>(selector: string): T[] =>
      Array.from(app.querySelectorAll<T>(selector));

    let session: Session | null = null;
    let workspaces: Workspace[] = [];
    let agents: Agent[] = [];
    let members: Member[] = [];
    let pendingInvites: PendingMemberInvite[] = [];
    let accessStatuses: AgentAccessStatus[] = [];
    let renderedPendingAccessKey = "";
    let people = new Map<string, string>();
    let signals: Signal[] = [];
    let files: WorkspaceFile[] = [];
    let fileLoadError = "";
    let brainView: BrainView | null = null;
    let signalFilter: SignalFilter = "all";
    /* Channels the viewer can see, archived ones included: an archived channel still has to
       resolve for a permalink and still names the messages already in it. The rail lists the
       live ones only. */
    let channels: WorkspaceChannel[] = [];
    /** The channel the feed is narrowed to. `null` is all-signals, the whole feed. */
    let activeChannelId: string | null = null;
    /** A ?c= that resolves to no channel here. Held so the empty state can say so. */
    let unknownChannelId: string | null = null;
    /**
     * Which of the three workspace views is on screen. The channel head and the rail's current
     * mark belong to the signals view: a rename done from Files ran renderChannelHead and put
     * the channel's name over a Files body, with both Files and that channel marked current.
     * Found by a review arm.
     */
    let activeWorkspaceView: "signals" | "files" | "brain" = "signals";
    /**
     * The channel read soft-fails to an empty list so a channel outage cannot take the feed
     * down with it. That makes an empty list ambiguous — no channels, or none READ — and a
     * `?c=` cannot be told apart from a bad id without this. The copy says which it is.
     */
    let channelListFailed = false;
    /** The whole made-up feed in sample mode, which has no server to page back to. */
    let sampleSignals: Signal[] = [];
    /**
     * Ids this browser posted since the last full page request went out. A channel click
     * starts a fresh page and does not cancel a send: the page was requested before the post
     * committed, so it cannot carry it, and replacing the list wholesale dropped a row that
     * the new screen should show. Measured as a message that appeared, vanished, and came
     * back on the next poll. Found by a review arm.
     *
     * A row leaves the map as soon as a fetched page carries it: the map exists to answer
     * "did the server not know about this yet", and once the server hands it back the answer
     * is no. Without that it grew for as long as the reader stayed in one channel, which a
     * second arm found.
     *
     * It holds the ROW and not only the id, because a channel move empties `signals`: coming
     * back before the replica caught up, an id-only record had nothing left to put back. A
     * third arm found that.
     */
    let postedSinceReset = new Map<
      string,
      { row: Signal; workspaceId: string; at: number }
    >();

    /**
     * How long a posted row may stand in for a page that has not caught up. The record exists
     * to cover ONE thing — the read replica not yet carrying a row this browser just wrote —
     * and that is a short window; the poll runs every two seconds. It is a chosen bound and
     * not a measured one: no replication lag was measured for this lane.
     *
     * Without it the record had no end. A row that fell off the first page of its channel was
     * re-prepended as the NEWEST message every time the reader came back, and the map grew for
     * the life of the tab. Found by a review arm.
     */
    const POSTED_ROW_GRACE_MS = 30_000;

    /** Drop the rows a fetched page proves the server knows about. */
    const forgetFetchedPostedIds = (rows: readonly Signal[]): void => {
      if (postedSinceReset.size === 0) return;
      for (const row of rows) postedSinceReset.delete(row.id);
    };

    /**
     * Drop what the record may no longer speak for: rows older than the grace, and rows from
     * another workspace. `Signal` carries no workspace, and holding the row rather than the id
     * is what made a cross-workspace leak visible — a message posted in workspace A was
     * painted into workspace B's feed, which no query of B's had returned. Found by a review
     * arm, on the fix from the round before.
     */
    const prunePostedRows = (): void => {
      if (postedSinceReset.size === 0) return;
      const cutoff = Date.now() - POSTED_ROW_GRACE_MS;
      for (const [id, entry] of postedSinceReset) {
        if (entry.at < cutoff || entry.workspaceId !== activeWorkspaceId) {
          postedSinceReset.delete(id);
        }
      }
    };

    /**
     * Would the list on screen show this row? The SERVER stamped its channel, so this asks the
     * same question the query on screen asks. The composer's landing rule and the reset page's
     * merge are the same question and must not be two answers.
     */
    const rowShowsOnScreen = (row: Signal): boolean =>
      unknownChannelId === null &&
      (activeChannelId === null || row.channelId === activeChannelId);
    /**
     * One generation per channel READ, because a channel command does not bump requestVersion
     * (it is not a workspace change). Archive and Create are different buttons and each only
     * disables its own, so two refreshes can be in flight at once; without this the older
     * answer wins whenever it lands second, dropping a channel that was just created or
     * flagging a healthy list as failed. Raised by a review arm.
     */
    let channelReadGeneration = 0;
    let activeWorkspaceId = "";
    let requestVersion = 0;
    let sampleMode = false;
    let signalCursor: SignalCursor | null = null;
    let signalHasMore = false;
    let signalCutoff = "";
    let pendingWorkspaceId = "";
    let pendingWorkspaceCreate = false;
    let renderedAuthUserId = "";
    let authReloadQueued = false;
    let bootInFlight: Promise<void> | null = null;
    let bootAgain = false;
    let signalExpiryTimer: number | undefined;
    let liveFeedTimer: number | undefined;
    let liveFeedInFlight = false;
    let rosterRefreshInFlight = false;
    let rosterRefreshAttemptedAt = 0;
    /* Ownership of the pending-access refresh lives in the gate, not in flags:
       (workspaceId, version) pairs, so a slow request from the workspace the
       user just left can neither block nor clear the fresh one. */
    const PENDING_REFRESH_ACTIVE_COOLDOWN_MS = 12_000;
    const PENDING_REFRESH_DISCOVERY_COOLDOWN_MS = 30_000;
    const pendingRefreshGate = new PendingRefreshGate(
      PENDING_REFRESH_ACTIVE_COOLDOWN_MS,
      PENDING_REFRESH_DISCOVERY_COOLDOWN_MS,
    );
    let rosterFilter = "";
    /* Catch-up queues UNKNOWN principals here and settles CONFIRMED-absent ones there.
       Both are per workspace session; openWorkspace clears them. */
    const unknownAgentCandidates = new Set<string>();
    const settledUnknownAgents = new Set<string>();
    let armLiveFeed = (): void => {};
    let connectFocusObserver: MutationObserver | null = null;
    let previousSignalIds = new Set<string>();
    let feedWasEmpty = false;
    let channelLoadError = "";
    let activeCreate: { version: number; userId: string } | null = null;
    /** Principal whose live Copy-prompt secret is still on screen, if any. */
    let livePromptPrincipalId = "";
    let freshInviteLink = "";
    let freshInviteId = "";
    let freshInviteWorkspaceId = "";
    let inviteIntent: { email: string; commandId: string } | null = null;
    let entityPanelOrigin: HTMLElement | null = null;
    let selectedEntity: EntityRef | null = null;
    let agentActivityFrames = new Map<string, AgentActivityFrame>();
    let agentActivityConnection: AgentActivityConnectionState = "connecting";
    let agentActivitySubscription: AgentActivitySubscription | null = null;
    let agentActivityGeneration = 0;
    let agentActivityGraceTimer: number | undefined;
    let entityActivityTimer: number | undefined;
    /* THE To: SET IS THE ADDRESS, and this variable is it. It is deliberately a second copy
     * of nothing: the body holds prose, the chips hold recipients, and an @tag copies a name
     * from the first into the second exactly once (composerToApplied below is what keeps the
     * copy from repeating). An empty set is a broadcast and says so on screen.
     *
     * RETIRED 2026-09-04 wording: "No composer address state. The body IS the address ...
     * Keeping a second copy in a variable is what let the TO row and the text disagree." The
     * disagreement it feared is prevented here by rendering the set on every change and by
     * pruning it against the roster, not by refusing to hold it. */
    let composerTo: ComposerRecipient[] = [];
    /* Keys already lifted out of the body into a chip. Without it, removing a chip while its
     * @tag stayed in the sentence would put the chip straight back on the next keystroke. */
    let composerToApplied: string[] = [];
    /* HAS A PASS COMMITTED A PAIR FOR THIS WORKSPACE YET. Before it has, the two variables
     * above are the empty starting value and not a set anybody chose, so the pass must read
     * the stored draft rather than treat them as what is on screen. Without this flag an
     * entry that painted before the roster settled looked identical to a reader who had
     * emptied To: on purpose, which is the difference the whole pair exists to keep. */
    let composerToLive = false;
    /* Recipients the roster took out of the set while the reader was looking at it. It is a
     * count and not a sentence: the name cannot be part of it, because the roster no longer
     * holds them. It is not stored, because a prune on arrival is silent. */
    let composerToPruned = 0;
    /* What the row says about a tag it could not honour: a duplicate name, or a full set.
     * It sits beside the delivery note rather than in the error status, because nothing is
     * wrong with the message -- the reader is being told what To: does and does not hold.
     * DERIVED by the pass on every commit, never pushed in by whichever handler noticed. */
    let composerToNotice = "";
    /**
     * THE MESSAGE A REPLY IN PROGRESS ANSWERS, or `null` when the composer is writing a
     * message of its own.
     *
     * It holds the root's CHANNEL ID and not its slug. A signal is immutable, so the id
     * cannot go stale; a slug can be renamed between opening a reply and sending it, and the
     * bar redraws its name from the live channel list every time it is synced. That is the
     * same rule `composerIntent` follows for the same reason, and a review arm found the
     * slug-shaped version of it in the channels lane.
     */
    let threadReplyRoot: ThreadReplyRoot | null = null;
    /** Thread roots the reader has opened. Replies are collapsed under their root until then. */
    let expandedThreadIds = new Set<string>();
    /** True while a reply is being written, which is the whole of what the To: row is locked by. */
    const composerIsReplying = (): boolean => threadReplyRoot !== null;
    let mentionPickerIndex = 0;
    let composerIntent: {
      /** ONE id for the whole message, because a To: set of any size is one signal now.
       * Retrying an unchanged message reuses it, so a retry cannot double-post. */
      commandId: string;
      body: string;
      audienceKey: string;
      attachmentKey: string;
      signalKind: BrowserSignalKind;
      /**
       * WHERE it was addressed, as an ID and never as a slug. A retry replays the address the
       * message was sent to rather than the channel the reader is looking at when they press
       * it. It is the id because `post_signal` takes a SLUG and the edge resolves that slug
       * against the live row: a rename between a failed send and its Retry made the replay
       * name a channel that no longer exists, or — if another member had taken the freed name
       * — someone else's. Found by a review arm. The slug is resolved from this id at the
       * moment of sending.
       */
      placementChannelId: string | null;
      /**
       * AND WHICH THREAD, when the message is a reply. `null` is a top-level message.
       *
       * A reply's address is its THREAD, not the channel on screen: a reply to a message in
       * #mobile is written from all-signals as readily as from #mobile, and its
       * `placementChannelId` is its root's either way. Comparing only the channel would have
       * called every such reply "addressed somewhere else" and refused a valid Retry. The two
       * fields are read together by `composerAddressStillPromised`, which is the one place
       * that decides whether an unfinished send may still be replayed.
       */
      placementThreadRootId: string | null;
      /**
       * AND WHETHER THE REPLY ALSO GOES TO ITS CHANNEL. Part of the message's identity, because
       * the command id is the server's idempotency key: a reader who ticks the box after a
       * failure and presses Retry must send a DIFFERENT command, not replay the one the server
       * already holds. The object carried it from the start and this declaration did not; a
       * review arm found the gap. `.astro` script blocks are outside `tsc`, so nothing else
       * would have.
       */
      broadcastToChannel: boolean;
    } | null = null;
    let composerSending = false;
    /* WHOSE FLAG IT IS. One submit raises `composerSending`, and only that submit or a
     * teardown that took the composer away from it may lower it again. `requestVersion`
     * cannot answer that question: it is the SCREEN's generation, and six controls reopen
     * the CURRENT workspace — Refresh, retry-workspace, remove-member, edit-model, revoke,
     * remove-agent — each bumping the generation without running `resetComposer`. While the
     * lift sat behind that guard, pressing Refresh mid-post left the flag up for the rest of
     * the session: a read-only box, dead chips, a frozen To: row, and a failed send that
     * never put the body back. A review arm found it. The token is the send's own identity,
     * the way `sendDraftKey` and `sendToKey` already are.
     */
    let composerSendToken = 0;
    let stagedAttachments: StagedComposerAttachment[] = [];
    let composerAttachmentsMissingAfterReload = false;
    let composerDragDepth = 0;
    /* ONE KEY FOR ONE TRANSACTION. The body and the address used to have a once-per-workspace
     * key each, and a switch could satisfy one and not the other: the draft restore marked
     * itself done against an empty roster while the address restore correctly refused, and
     * the paint after that wrote last-sent over the draft's own set. */
    let restoredComposerKey = "";
    let focusedComposerWorkspaceId = "";
    const visualMentions = new Map<string, EntityRef[]>();
    const expandedSignalIds = new Set<string>();
    const attachmentObjectUrls = new Map<string, string>();
    const deliveryReceiptCache = new Map<string, BrowserDeliveryReceiptCacheEntry>();
    let deliveryReceiptRefreshOwner = "";
    let humanSeenObserver: IntersectionObserver | null = null;

    const humanSeenReporter = new HumanSeenReporter({
      hasFocus: () => document.hasFocus(),
      send: async (scope, signalIds) => {
        const separator = scope.indexOf(":");
        const userId = separator < 0 ? "" : scope.slice(0, separator);
        const workspaceId = separator < 0 ? "" : scope.slice(separator + 1);
        const activeSession = session;
        if (!activeSession || activeSession.user.id !== userId || !workspaceId) return;
        await reportBrowserSignalsSeen(
          activeSession,
          uuid(),
          workspaceId,
          signalIds,
        );
        if (workspaceId !== activeWorkspaceId) return;
        for (const signalId of signalIds) {
          const cached = deliveryReceiptCache.get(signalId);
          if (cached) deliveryReceiptCache.set(signalId, { ...cached, checkedAt: 0 });
        }
        void refreshDeliveryReceipts(workspaceId, requestVersion);
      },
    });

    /* 25, not 50. The operator asked for 20-30 on first paint with older pages fetched on
     * scroll-up. The FETCH size stays one larger so `hasMore` is known without a second query. */
    const SIGNAL_PAGE_SIZE = 25;
    const SIGNAL_FETCH_SIZE = SIGNAL_PAGE_SIZE + 1;

    /* The first presentation of EACH independently gated surface takes no scripted
       focus: it is not necessarily a response to anything the reader did, so moving focus
       would paint a ring around something they never asked for, raise the
       on-screen keyboard on a phone before any orientation, and pull assistive
       technology past the surrounding context. Later presentations of that same
       surface move focus. One gate per surface: panels and the auth form present
       independently, so a signed-in boot does not pre-consume the auth form's skip. */
    const panelBootFocus = new BootFocusGate();
    const authBootFocus = new BootFocusGate();

    const showPanel = (
      name: "loading" | "signed-out" | "create" | "workspace-error" | "channel",
    ): void => {
      const previous = app.dataset.state;
      for (const section of all<HTMLElement>(".dashboard__root > [data-panel]")) {
        section.hidden = section.dataset.panel !== name;
      }
      app.dataset.state = name;
      const root = one<HTMLElement>(".dashboard__root");
      root?.setAttribute("aria-busy", name === "loading" ? "true" : "false");
      if (previous !== name && name !== "loading") {
        if (!panelBootFocus.allowsFocus()) return;
        window.requestAnimationFrame(() => {
          const visible = panel(name);
          const heading = visible?.querySelector<HTMLElement>("h1, h2");
          if (!heading) return;
          heading.tabIndex = -1;
          heading.focus({ preventScroll: true });
        });
      }
    };

    const setLoading = (label: string): void => {
      const target = one<HTMLElement>("[data-loading-label]");
      if (target) target.textContent = label;
      showPanel("loading");
    };

    const showChannelView = (
      name:
        | "no-agents"
        | "agent-choice"
        | "invite"
        | "connect"
        | "feed-pending"
        | "feed-empty"
        | "feed-error"
        | "feed"
        | "files"
        | "brain",
    ): void => {
      if (name !== "feed") {
        window.clearTimeout(signalExpiryTimer);
        signalExpiryTimer = undefined;
      }
      if (name !== "feed" && name !== "feed-empty") {
        window.clearInterval(liveFeedTimer);
        liveFeedTimer = undefined;
      }
      for (const section of all<HTMLElement>("[data-channel-view]")) {
        section.hidden = section.dataset.channelView !== name;
      }
      const composer = one<HTMLFormElement>("[data-composer]");
      /* An unresolved ?c= is a feed view with nothing in it, and the composer was reachable
         there. A post from it went to the UNFILTERED feed while the head said Channel not
         found, and renderFeed then threw the pending row away, so the writer saw nothing.
         Found by a review arm. There is no channel to post to, so there is no composer. */
      if (composer) {
        composer.hidden = unknownChannelId !== null ||
          (name !== "feed" && name !== "feed-empty");
      }
      if (composer?.hidden) {
        closeMentionPicker();
      }
      app.dataset.channelView = name;
      /* The Live chip is true exactly while armLiveFeed is allowed to run. */
      const liveChip = one<HTMLElement>("[data-live-chip]");
      if (liveChip) {
        liveChip.hidden = sampleMode || !(name === "feed" || name === "feed-empty");
      }
      if (name === "feed" || name === "feed-empty") {
        queueMicrotask(() => armLiveFeed());
      }
    };

    const addAgentViewOpen = (): boolean =>
      ["agent-choice", "invite", "connect"].includes(app.dataset.channelView ?? "");

    const accountName = (value: Session): string => {
      const meta = (value.user.user_metadata ?? {}) as Record<string, unknown>;
      return (
        (typeof meta.user_name === "string" && meta.user_name) ||
        (typeof meta.preferred_username === "string" && meta.preferred_username) ||
        value.user.email ||
        "your account"
      );
    };

    const defaultWorkspaceName = (value: Session): string => {
      const who = accountName(value).split("@")[0] || "My";
      return `${who}’s workspace`.slice(0, 80);
    };

    const readableError = (error: unknown): string => {
      if (error instanceof EmailRateLimited) {
        return "Email sign-in is busy right now. Use GitHub, or try email again in a little while.";
      }
      if (error instanceof EmailAddressRejected) {
        return "That address could not receive a sign-in link. Check it and try again.";
      }
      if (error instanceof WorkspaceLimitReached) {
        return `You already have ${error.limit} workspaces, the free-account limit.`;
      }
      if (error instanceof EmailNotVerified) return error.message;
      if (error instanceof EmailDomainNotAccepted) return error.message;
      if (error instanceof ClientTooOld) return error.message;
      if (error instanceof SignupRefused) return error.detail;
      if (error instanceof NoDeployment) {
        return "This saved page is not connected to CommonSwarm.";
      }
      if (
        error instanceof Error &&
        /network|fetch|offline|connection/i.test(error.message)
      ) {
        return "Check your internet connection, then try again.";
      }
      return error instanceof Error
        ? error.message
        : "CommonSwarm could not complete that request.";
    };

    const authError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-auth-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const showAuthView = (name: "choices" | "email-sent"): void => {
      for (const view of all<HTMLElement>("[data-auth-view]")) {
        view.hidden = view.dataset.authView !== name;
      }
      authError(null);
      /* The gate consumes only on choices presentations. Its first presentation
         skips the email move; on a signed-in boot that can be the first explicit
         sign-out, where showPanel already moves context to the signed-out heading.
         Later choices presentations (such as "use a different address") focus it. */
      if (name === "choices" && authBootFocus.allowsFocus()) {
        window.requestAnimationFrame(() => one<HTMLInputElement>("#dashboard-email")?.focus());
      }
    };

    const createStorageKey = (userId: string): string =>
      `commonswarm:app-create-intent:v1:${userId}`;

    const readCreateIntent = (userId: string): CreateIntent | null => {
      try {
        const raw = window.localStorage.getItem(createStorageKey(userId));
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<CreateIntent>;
        if (
          typeof parsed.workspaceId !== "string" ||
          typeof parsed.commandId !== "string" ||
          typeof parsed.name !== "string"
        ) {
          return null;
        }
        return {
          workspaceId: parsed.workspaceId,
          commandId: parsed.commandId,
          name: parsed.name,
        };
      } catch {
        return null;
      }
    };

    const writeCreateIntent = (userId: string, intent: CreateIntent): void => {
      try {
        window.localStorage.setItem(createStorageKey(userId), JSON.stringify(intent));
      } catch {
        /* The in-memory call still uses this intent. A reload cannot safely resume it. */
      }
    };

    const clearCreateIntent = (userId: string): void => {
      try {
        window.localStorage.removeItem(createStorageKey(userId));
      } catch {
        /* Nothing else reads a failed removal during this page load. */
      }
    };

    const setCreateError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-create-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const renderCreate = (value: Session, message: string | null = null): void => {
      const who = accountName(value);
      for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
        target.textContent = who;
      }
      const hasWorkspace = Boolean(
        activeWorkspaceId && workspaces.some((workspace) => workspace.id === activeWorkspaceId),
      );
      const title = one<HTMLElement>("[data-create-title]");
      const description = one<HTMLElement>("[data-create-description]");
      const cancel = one<HTMLButtonElement>("[data-create-cancel]");
      const button = one<HTMLButtonElement>("[data-create-button]");
      if (title) title.textContent = hasWorkspace ? "Name another workspace." : "Name your workspace.";
      if (description) {
        description.textContent = hasWorkspace
          ? "Start a separate feed for a different group of people and AI agents."
          : "People and AI agents share one feed here.";
      }
      if (cancel) cancel.hidden = !hasWorkspace;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      if (input) {
        input.disabled = false;
        if (hasWorkspace && message === null) input.value = "";
        else if (!input.value) input.value = defaultWorkspaceName(value);
      }
      if (button) {
        button.disabled = false;
        button.removeAttribute("aria-busy");
        button.textContent = "Create workspace";
      }
      setCreateError(message);
      showPanel("create");
      window.requestAnimationFrame(() => {
        input?.focus({ preventScroll: true });
        input?.select();
      });
    };

    const renderWorkspaceError = (value: Session, error: unknown): void => {
      for (const target of all<HTMLElement>("[data-account-name]")) {
        target.textContent = accountName(value);
      }
      const message = one<HTMLElement>("[data-workspace-error]");
      if (message) {
        message.textContent = `${readableError(error)} Nothing was created or changed.`;
      }
      showPanel("workspace-error");
    };

    const workspaceMemberships = async (): Promise<Workspace[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Workspace[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("workspaces")
          .select("workspace_id,name,archived_at")
          .is("archived_at", null)
          .order("name", { ascending: true })
          .order("workspace_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page
          .filter((row) => row.archived_at === null)
          .map((row) => ({
            id: String(row.workspace_id ?? ""),
            name: String(row.name ?? row.workspace_id ?? ""),
            archived: false,
          }))
          .filter((workspace) => workspace.id.length > 0));
        if (page.length < pageSize) return result;
      }
    };

    const roster = async (workspaceId: string): Promise<Agent[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Agent[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("agent_principals")
          .select("principal_id,name,model,owner_user_id,revoked_at,workspace_id")
          .eq("workspace_id", workspaceId)
          .is("revoked_at", null)
          .order("name", { ascending: true })
          .order("principal_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...rosterAgentsFromRows(page));
        if (page.length < pageSize) return result;
      }
    };

    const memberRoster = async (
      workspaceId: string,
    ): Promise<{ names: Map<string, string>; members: Member[] }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const { data, error } = await api
        .schema("swarm_read")
        .from("member_profiles")
        .select("user_id,display_name,role")
        .eq("workspace_id", workspaceId)
        .limit(1_000);
      if (error) throw new Error(error.message);
      const members = (data ?? []).map((row) => ({
        userId: String(row.user_id ?? ""),
        name: String(row.display_name ?? ""),
        role: String(row.role ?? "") as Member["role"],
      })).filter((member) =>
        member.userId.length > 0 &&
        member.name.length > 0 &&
        ["owner", "admin", "member"].includes(member.role)
      );
      return {
        members,
        names: new Map(members.map((member) => [member.userId, member.name])),
      };
    };

    const renderMembers = (): void => {
      const list = one<HTMLUListElement>("[data-member-list]");
      const details = one<HTMLDetailsElement>("[data-member-details]");
      const me = members.find((member) => member.userId === session?.user.id);
      if (details) {
        details.hidden =
          sampleMode || (me?.role !== "owner" && me?.role !== "admin");
        if (details.hidden) details.open = false;
      }
      if (!list) return;
      list.replaceChildren();
      for (const member of members) {
        const item = document.createElement("li");
        item.className = "dashboard__agent";
        const label = document.createElement("span");
        label.textContent = `${member.name} · ${member.role}`;
        item.append(label);
        const mayRemove = me?.role === "owner" ||
          (me?.role === "admin" && member.role !== "owner");
        if (mayRemove && member.userId !== session?.user.id) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Remove";
          button.dataset.removeMember = member.userId;
          button.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (
              !window.confirm(
                `Remove ${member.name} from this workspace? This does not affect their other workspaces.`,
              )
            ) return;
            const errorTarget = one<HTMLElement>("[data-member-error]");
            const reauth = one<HTMLElement>("[data-member-reauth]");
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            if (reauth) reauth.hidden = true;
            button.disabled = true;
            try {
              await removeWorkspaceMember(
                session,
                uuid(),
                activeWorkspaceId,
                member.userId,
              );
              await openWorkspace(activeWorkspaceId);
            } catch (error) {
              if (error instanceof FreshLoginRequired) {
                sessionStorage.setItem(
                  "commonswarm.pending-member-selection",
                  JSON.stringify({
                    workspaceId: activeWorkspaceId,
                    userId: member.userId,
                  }),
                );
                if (reauth) reauth.hidden = false;
              }
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          item.append(button);
        }
        list.append(item);
      }
    };

    /*
     * ONE row model, TWO lists. The rail's Pending access details (desktop) and the
     * Agents dialog section (the only reachable surface at ≤52rem) both render from
     * a single pendingAccessRows call, so they can never disagree about content,
     * order, or wording — the lists are mirrors of one state, never two states.
     * Each list's Cancel closures capture that list's own error slot, and each row
     * carries the exact id its cancel command needs, so a Cancel always reaches the
     * right revoke with the right invitation/token id.
     */
    const currentPendingAccessRows = () =>
      pendingAccessRows(
        pendingInvites,
        accessStatuses,
        (userId) => people.get(userId) ?? "Workspace member",
        Date.now(),
        (iso) => formatTime(iso).relative,
      );

    const pendingAccessKey = (rows = currentPendingAccessRows()): string =>
      rows.map((row) => `${row.kind}:${row.id}`).join("\n");

    const renderPendingAccess = (): void => {
      const rows = currentPendingAccessRows();
      renderedPendingAccessKey = pendingAccessKey(rows);
      const total = rows.length;
      const railList = one<HTMLUListElement>("[data-access-list]");
      const dialogList = one<HTMLUListElement>("[data-dialog-access-list]");
      const active = document.activeElement;
      const focusedPending =
        active instanceof HTMLButtonElement &&
          (railList?.contains(active) || dialogList?.contains(active)) &&
          active.dataset.pendingKind && active.dataset.pendingId
          ? {
              surface: dialogList?.contains(active) ? "dialog" as const : "rail" as const,
              kind: active.dataset.pendingKind,
              id: active.dataset.pendingId,
            }
          : null;

      const count = one<HTMLElement>("[data-access-count]");
      const details = one<HTMLDetailsElement>("[data-access-details]");
      if (count) count.textContent = String(total);
      if (details) {
        details.hidden = sampleMode || total === 0;
        if (details.hidden) details.open = false;
      }

      const dialogSection = one<HTMLElement>("[data-dialog-access-section]");
      const dialogCount = one<HTMLElement>("[data-dialog-access-count]");
      if (dialogCount) dialogCount.textContent = String(total);
      if (dialogSection) dialogSection.hidden = sampleMode || total === 0;

      const buildRows = (errorTarget: HTMLElement | null): DocumentFragment => {
        const fragment = document.createDocumentFragment();
        for (const row of rows) {
          const item = document.createElement("li");
          item.className = "dashboard__agent dashboard__pending-access-row";
          const copy = document.createElement("span");
          copy.className = "dashboard__agent-copy";
          const title = document.createElement("strong");
          title.textContent = row.title;
          const state = document.createElement("span");
          state.textContent = row.state;
          copy.append(title, state);
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Cancel";
          button.dataset.pendingKind = row.kind;
          button.dataset.pendingId = row.id;
          button.setAttribute("aria-label", row.cancelLabel);
          button.addEventListener("click", async () => {
            if (!session) return;
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            button.disabled = true;
            try {
              if (row.kind === "invite") {
                await revokeWorkspaceInvitation(session, uuid(), row.workspaceId, row.id);
              } else {
                await revokeAgentToken(session, uuid(), row.workspaceId, row.id);
              }
              /* The reload closes the dialog and re-renders both lists from the
                 fresh state. The row that held focus is gone, so hand focus to
                 the door that reopens the roster — or to the empty channel's
                 Add door when no agents remain — instead of dropping it on
                 <body>. Same pattern as the roster Remove path. */
              await openWorkspace(row.workspaceId);
              const door = agents.length > 0
                ? one<HTMLButtonElement>("[data-roster-open]")
                : one<HTMLButtonElement>("[data-add-agent]");
              door?.focus({ preventScroll: true });
            } catch (error) {
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          item.append(copy, button);
          fragment.append(item);
        }
        return fragment;
      };

      railList?.replaceChildren(buildRows(one("[data-access-error]")));
      dialogList?.replaceChildren(buildRows(one("[data-dialog-access-error]")));

      /* Pending access is itself a reason to expose the header management door,
         including in a brand-new zero-agent workspace on mobile. Resync before
         focus repair so a newly-valid fallback door is already visible. */
      renderHeaderRoster(total);

      /* A background refresh replaces DOM nodes even when the rows are unchanged.
         Preserve the focused Cancel by semantic identity. If that row genuinely
         disappeared, move focus to a stable control instead of dropping it behind
         a modal or onto <body>. */
      if (focusedPending) {
        const focusList = focusedPending.surface === "dialog" ? dialogList : railList;
        const replacement = Array.from(
          focusList?.querySelectorAll<HTMLButtonElement>(
            "[data-pending-kind][data-pending-id]",
          ) ?? [],
        ).find((candidate) =>
          candidate.dataset.pendingKind === focusedPending.kind &&
          candidate.dataset.pendingId === focusedPending.id
        );
        if (replacement) {
          replacement.focus({ preventScroll: true });
        } else if (focusedPending.surface === "dialog") {
          one<HTMLButtonElement>("[data-add-agent-dialog]")?.focus({ preventScroll: true });
        } else if (total > 0) {
          one<HTMLDetailsElement>("[data-access-details]")
            ?.querySelector<HTMLElement>("summary")
            ?.focus({ preventScroll: true });
        } else {
          /* The title is present in every channel subview. Unlike Add an agent it
             stays visible while invite/connect is open, so it is the only safe
             zero-row rail fallback across the complete flow. */
          one<HTMLElement>("[data-channel-name]")?.focus({ preventScroll: true });
        }
      }
      syncPendingPoll();
    };

    /*
     * THE CHANNEL NARROWING IS THE QUERY'S, not the rendered list's. The shipped
     * All / Broadcast / Direct-to-you filter runs in the browser over the loaded page, so
     * it says "your direct signals" and means "among the last 25 loaded". A channel must not
     * copy that: a reader who opens #mobile and sees four messages has to be seeing the four
     * newest messages in #mobile, not the ones that happened to be in the page already.
     * Narrowing here also cannot widen anything — the view's WHERE is the authorization and
     * a client-issued equality is applied on top of it.
     */
    const signalPage = async (
      workspaceId: string,
      cursor: SignalCursor | null,
      cutoff: string,
      channelId: string | null,
    ): Promise<{ rows: Signal[]; hasMore: boolean }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      let query = api
        .schema("swarm_read")
        .from("signals")
        .select(BROWSER_SIGNAL_COLUMNS)
        .eq("workspace_id", workspaceId)
        .or(`until.is.null,until.gt.${cutoff}`);
      if (channelId !== null) query = query.eq("channel_id", channelId);
      if (cursor) {
        query = query.or(
          `created_at.lt.${cursor.createdAt},and(created_at.eq.${cursor.createdAt},id.lt.${cursor.id})`,
        );
      }
      const { data, error } = await query
        .order("created_at", { ascending: false })
        .order("id", { ascending: false })
        .limit(SIGNAL_FETCH_SIZE);
      if (error) throw new Error(error.message);
      const page = data ?? [];
      return {
        hasMore: page.length === SIGNAL_FETCH_SIZE,
        rows: page.slice(0, SIGNAL_PAGE_SIZE).map((row) =>
          browserSignalFromRow(row as unknown as Record<string, unknown>)
        ),
      };
    };

    const initials = (name: string): string => {
      const parts = name.trim().split(/\s+/).filter(Boolean);
      return (parts.length > 1 ? `${parts[0]?.[0] ?? ""}${parts[1]?.[0] ?? ""}` : name.slice(0, 2))
        .toUpperCase();
    };

    /* One shape, one tint. The avatar set once mixed three border-radii (a circle, a
       rounded square, and an asymmetric blob) across identical 32px initial tiles, which
       read as inconsistency rather than identity — most visibly where the tiles now sit
       shoulder to shoulder in the header strip. The hue keeps the per-agent distinction;
       the shape is always the circle. */
    const markAgentAvatar = (node: HTMLElement, principalId: string): void => {
      let hash = 2_166_136_261;
      for (const char of principalId) {
        hash ^= char.charCodeAt(0);
        hash = Math.imul(hash, 16_777_619);
      }
      const unsigned = hash >>> 0;
      node.style.setProperty("--avatar-hue", String(unsigned % 360));
      node.classList.add("dashboard__avatar--tinted");
    };

    const entityDate = (value: string): string => {
      const date = new Date(value);
      return Number.isNaN(date.getTime())
        ? value
        : new Intl.DateTimeFormat(undefined, {
            dateStyle: "medium",
            timeStyle: "short",
          }).format(date);
    };

    const stopAgentActivity = (): void => {
      agentActivityGeneration += 1;
      window.clearTimeout(agentActivityGraceTimer);
      agentActivityGraceTimer = undefined;
      const active = agentActivitySubscription;
      agentActivitySubscription = null;
      agentActivityFrames.clear();
      agentActivityConnection = "connecting";
      if (active) void active.unsubscribe().catch(() => undefined);
    };

    const refreshEntityActivitySection = (): void => {
      if (selectedEntity?.kind !== "agent") return;
      const current = one<HTMLElement>("[data-agent-activity]");
      if (!current) return;
      current.replaceWith(renderAgentActivitySection(selectedEntity.id));
    };

    const startAgentActivity = (workspaceId: string, version: number): void => {
      stopAgentActivity();
      const generation = agentActivityGeneration;
      void subscribeAgentActivity(
        workspaceId,
        (frame) => {
          if (
            generation !== agentActivityGeneration ||
            version !== requestVersion ||
            workspaceId !== activeWorkspaceId
          ) return;
          const current = agentActivityFrames.get(frame.principalId);
          if (!agentActivityFrameIsNewer(current, frame)) return;
          agentActivityFrames.set(frame.principalId, frame);
          if (selectedEntity?.kind === "agent" && selectedEntity.id === frame.principalId) {
            refreshEntityActivitySection();
          }
        },
        (state) => {
          if (
            generation !== agentActivityGeneration ||
            version !== requestVersion ||
            workspaceId !== activeWorkspaceId
          ) return;
          window.clearTimeout(agentActivityGraceTimer);
          agentActivityGraceTimer = undefined;
          if (state === "subscribed") {
            /* Broadcast has no replay. Give an already-running listener one
               15s heartbeat before showing that no frames were received. */
            agentActivityGraceTimer = window.setTimeout(() => {
              if (
                generation !== agentActivityGeneration ||
                version !== requestVersion ||
                workspaceId !== activeWorkspaceId
              ) return;
              agentActivityConnection = "subscribed";
              refreshEntityActivitySection();
            }, AGENT_ACTIVITY_INSTRUMENTATION_GRACE_MS);
          } else {
            agentActivityConnection = state;
            refreshEntityActivitySection();
          }
        },
      ).then((subscription) => {
        if (
          generation !== agentActivityGeneration ||
          version !== requestVersion ||
          workspaceId !== activeWorkspaceId
        ) {
          void subscription.unsubscribe();
          return;
        }
        agentActivitySubscription = subscription;
      }).catch(() => {
        if (
          generation === agentActivityGeneration &&
          version === requestVersion &&
          workspaceId === activeWorkspaceId
        ) {
          agentActivityConnection = "unavailable";
          refreshEntityActivitySection();
        }
      });
    };

    const refreshEntityActivityAge = (): void => {
      if (selectedEntity?.kind !== "agent") return;
      const frame = agentActivityFrames.get(selectedEntity.id);
      const view = agentActivityPanelView(
        frame,
        agentActivityConnection,
        Date.now(),
        "unknown",
      );
      const section = one<HTMLElement>("[data-agent-activity]");
      const age = one<HTMLElement>("[data-agent-activity-age]");
      const elapsed = one<HTMLElement>("[data-agent-activity-elapsed]");
      if (section) section.dataset.activityState = view.state;
      if (age) age.textContent = view.ageLabel;
      if (elapsed && view.elapsedLabel) elapsed.textContent = view.elapsedLabel;
    };

    const startEntityActivityTimer = (): void => {
      window.clearInterval(entityActivityTimer);
      entityActivityTimer = undefined;
      if (selectedEntity?.kind !== "agent") return;
      entityActivityTimer = window.setInterval(refreshEntityActivityAge, 1_000);
    };

    function closeEntityPanel(restoreFocus = true): void {
      window.clearInterval(entityActivityTimer);
      entityActivityTimer = undefined;
      const panel = one<HTMLElement>("[data-entity-panel]");
      if (!panel || panel.hidden) return;
      panel.hidden = true;
      one<HTMLElement>(".dashboard__frame")?.classList.remove(
        "dashboard__frame--entity-panel",
      );
      selectedEntity = null;
      if (restoreFocus && entityPanelOrigin?.isConnected) {
        entityPanelOrigin.focus({ preventScroll: true });
      }
      entityPanelOrigin = null;
    }

    function entityControl(
      label: string,
      entity: EntityRef,
      className: string,
    ): HTMLButtonElement {
      const button = document.createElement("button");
      button.type = "button";
      button.className = className;
      button.textContent = label;
      button.dataset.entityKind = entity.kind;
      button.dataset.entityId = entity.id;
      button.addEventListener("click", () => openEntityPanel(entity, button));
      return button;
    }

    const appendEntityField = (
      list: HTMLDListElement,
      term: string,
      value: string,
    ): void => {
      const label = document.createElement("dt");
      label.textContent = term;
      const detail = document.createElement("dd");
      detail.textContent = value;
      list.append(label, detail);
    };

    function renderAgentActivitySection(principalId: string): HTMLElement {
      const view = agentActivityPanelView(
        agentActivityFrames.get(principalId),
        agentActivityConnection,
        Date.now(),
        "unknown",
      );
      const live = document.createElement("section");
      live.className = "dashboard__entity-live";
      live.dataset.agentActivity = "";
      live.dataset.activityState = view.state;

      const header = document.createElement("header");
      const titleWrap = document.createElement("div");
      titleWrap.className = "dashboard__entity-live-title";
      const dot = document.createElement("span");
      dot.className = "dashboard__entity-live-dot";
      dot.setAttribute("aria-hidden", "true");
      const title = document.createElement("h3");
      title.textContent = "Live";
      const age = document.createElement("span");
      age.dataset.agentActivityAge = "";
      age.textContent = view.ageLabel;
      titleWrap.append(dot, title);
      header.append(titleWrap, age);
      live.append(header);

      if (view.emptyMessage !== null) {
        const empty = document.createElement("p");
        empty.className = "dashboard__entity-live-empty";
        empty.textContent = view.emptyMessage;
        live.append(empty);
        return live;
      }

      const details = document.createElement("dl");
      appendEntityField(details, "Phase", view.phaseLabel ?? "Idle");
      /* Whole, not abbreviated. This one had no disclosure and no title behind it, so the
       * shortened form was the only copy the reader could see. The id field below keeps its
       * summary because the full value sits inside the disclosure. */
      appendEntityField(details, "Signal", view.signalLabel ?? "None");
      appendEntityField(
        details,
        "Now",
        view.toolTitle ?? (view.phaseLabel === "Idle" ? "Waiting for work" : "Between tools"),
      );
      appendEntityField(details, "Elapsed", view.elapsedLabel ?? "0s");
      details.lastElementChild?.setAttribute("data-agent-activity-elapsed", "");
      live.append(details);
      return live;
    }

    const appendEntityId = (
      list: HTMLDListElement,
      term: string,
      value: string,
    ): void => {
      const label = document.createElement("dt");
      label.textContent = term;
      const detail = document.createElement("dd");
      if (value === "Not available") {
        detail.textContent = value;
      } else {
        const disclosure = document.createElement("details");
        disclosure.className = "dashboard__entity-id";
        const summary = document.createElement("summary");
        summary.textContent = truncateEntityId(value);
        summary.title = value;
        const full = document.createElement("code");
        full.textContent = value;
        disclosure.append(summary, full);
        detail.append(disclosure);
      }
      list.append(label, detail);
    };

    function renderEntityPanel(): void {
      const body = one<HTMLElement>("[data-entity-panel-body]");
      if (!body || !selectedEntity) return;
      body.replaceChildren();

      const identity = document.createElement("div");
      identity.className = "dashboard__entity-identity";
      const avatar = document.createElement("span");
      avatar.className = "dashboard__entity-avatar";
      avatar.setAttribute("aria-hidden", "true");
      const headingWrap = document.createElement("div");
      const heading = document.createElement("h2");
      heading.id = "dashboard-entity-panel-title";
      const identityBadge = document.createElement("span");
      identityBadge.className = "dashboard__entity-badge";

      if (selectedEntity.kind === "agent") {
        const agent = agents.find((candidate) => candidate.principalId === selectedEntity?.id);
        if (!agent) {
          closeEntityPanel(false);
          return;
        }
        const status = accessStatuses.find(
          (candidate) => candidate.principalId === agent.principalId,
        );
        const details = agentEntityView(
          agent,
          status,
          people.get(agent.ownerUserId) ?? "Workspace member",
          entityDate,
        );
        avatar.textContent = initials(details.name);
        markAgentAvatar(avatar, details.principalId);
        heading.textContent = details.name;
        identityBadge.textContent = "AGENT";
        headingWrap.append(heading, identityBadge);
        identity.append(avatar, headingWrap);
        body.append(identity);

        if (details.revoked) {
          const revoked = document.createElement("p");
          revoked.className = "dashboard__entity-revoked";
          revoked.textContent = `Access revoked · ${details.revokedAt}`;
          body.append(revoked);
        }

        const live = renderAgentActivitySection(details.principalId);
        const info = document.createElement("section");
        info.className = "dashboard__entity-section";
        const infoTitle = document.createElement("h3");
        infoTitle.textContent = "Info";
        const ownerLine = document.createElement("p");
        ownerLine.append(
          "operated by ",
          entityControl(
            details.ownerName,
            { kind: "person", id: details.ownerUserId },
            "dashboard__entity-link",
          ),
        );
        const infoList = document.createElement("dl");
        appendEntityField(infoList, "Model", details.model);
        appendEntityId(infoList, "Principal ID", details.principalId);
        info.append(infoTitle, ownerLine, infoList);

        const runtime = document.createElement("section");
        runtime.className = "dashboard__entity-section";
        const runtimeTitle = document.createElement("h3");
        runtimeTitle.textContent = "Runtime";
        const runtimeList = document.createElement("dl");
        appendEntityId(runtimeList, "Token ID", details.tokenId);
        appendEntityField(runtimeList, "Issued", details.issuedAt);
        appendEntityField(runtimeList, "Expires", details.expiresAt);
        appendEntityField(runtimeList, "First used", details.firstUsedAt);
        appendEntityField(runtimeList, "Revoked", details.revokedAt);
        runtime.append(runtimeTitle, runtimeList);
        body.append(live, info, runtime);
      } else {
        const member = members.find((candidate) => candidate.userId === selectedEntity?.id);
        if (!member) {
          closeEntityPanel(false);
          return;
        }
        avatar.textContent = initials(member.name);
        heading.textContent = member.name;
        identityBadge.textContent = "PERSON";
        headingWrap.append(heading, identityBadge);
        identity.append(avatar, headingWrap);

        const related = document.createElement("section");
        related.className = "dashboard__entity-section";
        const relatedTitle = document.createElement("h3");
        relatedTitle.textContent = "Agents";
        const relatedList = document.createElement("ul");
        relatedList.className = "dashboard__entity-agent-list";
        const operatedAgents = agents.filter((agent) => agent.ownerUserId === member.userId);
        if (operatedAgents.length === 0) {
          const empty = document.createElement("li");
          empty.textContent = "No agents";
          relatedList.append(empty);
        } else {
          for (const agent of operatedAgents) {
            const item = document.createElement("li");
            item.append(entityControl(
              agent.name,
              { kind: "agent", id: agent.principalId },
              "dashboard__entity-agent-link",
            ));
            relatedList.append(item);
          }
        }
        related.append(relatedTitle, relatedList);
        body.append(identity, related);
      }
    }

    function openEntityPanel(entity: EntityRef, trigger: HTMLElement): void {
      const panel = one<HTMLElement>("[data-entity-panel]");
      if (!panel) return;
      if (!panel.contains(trigger)) entityPanelOrigin = trigger;
      selectedEntity = entity;
      panel.hidden = false;
      one<HTMLElement>(".dashboard__frame")?.classList.add(
        "dashboard__frame--entity-panel",
      );
      renderEntityPanel();
      startEntityActivityTimer();
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-entity-panel-close]")
          ?.focus({ preventScroll: true });
      });
    }

    const entityName = (entity: EntityRef): string => entity.kind === "agent"
      ? agents.find((agent) => agent.principalId === entity.id)?.name ?? "Unknown agent"
      : members.find((member) => member.userId === entity.id)?.name ?? "Workspace member";

    const composerAudienceKey = (audience: ComposerAudience): string =>
      audience.kind === "everyone" ? "everyone" : `${audience.kind}:${audience.id}`;


    /* THE To: FIELD IS THE ADDRESS (operator direction 2026-09-05). One message carries the
     * whole set, and `composerTo` is the only thing the send reads. An @tag ADDS to that set
     * (ruling D2): it never opens a DM and it never drops whoever was already there.
     *
     * Longest name first, so "@Dana Rivera" is not read as "@Dana" plus stray text. Names are
     * matched case-insensitively and must end on a boundary, so "@Wrenley" never resolves to
     * "@Wren". */
    /* The parser lives in ../../lib/mention-address so it can be tested directly; this file
     * only supplies the roster. Keeping a second copy here is how the two would drift. */
    const composerAddressFrom = (body: string) =>
      addressFromBody(body, mentionTargets(agents, members));

    /** Recipients named by @tags in this text, in the order they appear, each one once. */
    const composerRecipientsFrom = (body: string): ComposerRecipient[] =>
      composerAddressFrom(body).recipients.map((entity) => ({ kind: entity.kind, id: entity.id }));

    /**
     * Every addressee of the next send, in order. Empty is a broadcast, and the row says so
     * in words rather than by showing nothing.
     */
    const composerRecipients = (): ComposerRecipient[] =>
      composerSendRecipients(composerTo, composerIsReplying());

    /** Identity of the whole addressee set, so changing it invalidates a pending send intent. */
    const composerRecipientsKey = (): string =>
      composerTo.length === 0
        ? composerAudienceKey({ kind: "everyone" })
        : composerTo.map(composerAudienceKey).join("+");

    const composerHasRecipient = (entity: EntityRef): boolean =>
      composerTo.some((recipient) => recipient.kind === entity.kind && recipient.id === entity.id);

    /* IS THIS NAME STILL HERE. A chip for a revoked agent or a departed member would be a
     * recipient the reader can see and the send cannot honour, so the set is pruned against
     * the live roster every time the roster is rendered. */
    const composerRecipientKnown = (entity: ComposerRecipient): boolean =>
      entity.kind === "agent"
        ? agents.some((agent) => agent.principalId === entity.id)
        : members.some((member) => member.userId === entity.id);

    /**
     * AN EMPTY ROSTER MEANS "NOT FETCHED YET", NOT "NOBODY IS HERE". renderWorkspace runs
     * before the roster request settles, so pruning against an empty one would drop every
     * chip; and because the restore runs once per workspace, nothing would put them back.
     * A real workspace always has at least the member reading it.
     */
    const composerRosterKnown = (): boolean => agents.length > 0 || members.length > 0;

    /** WHERE THE LAST SET IS REMEMBERED. Per signed-in reader and per workspace. */
    /* THE WORKSPACE IS AN ARGUMENT, not a global read at call time.
     *
     * A send captures its workspace, its version, its recipients, its body and its command id,
     * and then addressed its STORAGE through `activeWorkspaceId` — whatever that happened to
     * be when the write ran. Every storage call the send makes therefore sits behind a
     * "workspace still mine?" guard, and a send that landed after the reader switched away did
     * neither its remember nor its clear; had it tried, it would have written the new
     * workspace's key. Two review rounds found opposite halves of that one cause. Passing the
     * workspace in lets the send bind its storage the way it already binds everything else. */
    const composerToStorageKey = (workspaceId = activeWorkspaceId): string | null => {
      if (!workspaceId) return null;
      const owner = session?.user.id ?? (sampleMode ? "sample-owner" : "");
      if (!owner) return null;
      return `commonswarm:composer-to:${owner}:${workspaceId}`;
    };

    /** Remembers the set a message actually went to, so the next message starts addressed. */
    const rememberComposerTo = (
      recipients: readonly ComposerRecipient[],
      key = composerToStorageKey(),
    ): void => {
      if (!key) return;
      try {
        if (recipients.length === 0) window.localStorage.removeItem(key);
        else window.localStorage.setItem(key, JSON.stringify(recipients));
      } catch {
        /* The chips on screen stay authoritative when storage is unavailable. */
      }
    };

    /**
     * The set the last message from here went to, exactly as it was written down. It is READ
     * and nothing more: no pruning, no assignment, no clearing of the applied record. The one
     * pass below decides what to do with it, which is the difference between this and the
     * four restores it replaces.
     */
    const readRememberedComposerTo = (): ComposerRecipient[] => {
      const key = composerToStorageKey();
      if (!key) return [];
      try {
        const raw = window.localStorage.getItem(key);
        if (!raw) return [];
        const value = JSON.parse(raw) as unknown;
        if (!Array.isArray(value)) return [];
        const parsed: ComposerRecipient[] = [];
        for (const entry of value) {
          if (entry === null || typeof entry !== "object") continue;
          const candidate = entry as { kind?: unknown; id?: unknown };
          if (typeof candidate.id !== "string") continue;
          if (candidate.kind !== "agent" && candidate.kind !== "person") continue;
          parsed.push({ kind: candidate.kind, id: candidate.id });
        }
        return parsed;
      } catch {
        return [];
      }
    };

    /** The name a chip shows. `entityName` already answers for both kinds. */
    const composerRecipientName = (entity: ComposerRecipient): string => entityName(entity);

    /**
     * DRAWING ONLY. It reads `composerTo` and writes the DOM; it decides nothing and changes
     * no state. Pruning used to happen here, which is how a render came to move the address:
     * the prune ran on a paint the reader had not caused, including the paint after a
     * workspace switch where the roster was not known yet. That work is now the pass below,
     * so what a reader sees on the row is always what the last commit decided.
     */
    const renderComposerTo = (): void => {
      const chips = one<HTMLElement>("[data-composer-to-chips]");
      const note = one<HTMLElement>("[data-composer-to-note]");
      const row = one<HTMLElement>("[data-composer-to]");
      if (!chips || !note) return;
      chips.replaceChildren();
      /* THE ROW DRAWS WHAT THE SEND POSTS, from the one derivation both of them read. While a
         reply is in progress that is the empty set, whatever `composerTo` still holds — and
         `composerTo` deliberately still holds it, because it is the address of the message
         the reader goes back to when they cancel. Drawing `composerTo` here while the submit
         read something else is the exact disagreement this row exists to rule out. */
      const replying = composerIsReplying();
      const shown = composerRecipients();
      /* LOCKED, and said in the markup rather than only in the sentence. `aria-disabled`
         rather than `disabled` on a container: the chips are gone in this state, so there is
         no control to disable, and the row still has to be readable by a screen reader. */
      if (row) {
        if (replying) row.setAttribute("aria-disabled", "true");
        else row.removeAttribute("aria-disabled");
        row.toggleAttribute("data-composer-to-locked", replying);
      }
      /* EVERY AGENT IN THE SET CARRIES THE MARK, because every one of them is woken. One
         rule, asked here and by the sentence below, so a chip and that sentence cannot
         disagree about who the service wakes. */
      const notified = notifiedRecipients(shown);
      const notifiedKeys = new Set(notified.map(recipientKey));
      if (shown.length === 0) {
        /* THE ADDRESS IS SHOWN, never implied by an empty row. Which name it takes follows the
           mode, because the two are different addresses: a broadcast reaches the workspace, a
           reply reaches the thread. "Everyone here" on a reply would name the wrong set.

           THIS BRANCH IS NOT SKIPPED FOR A REPLY, and that is the point. An earlier version
           returned here before it built anything, so "the row draws what the send posts" held
           only because two separate rules both produced nothing; a mutation of
           `composerSendRecipients` changed the wire and left the row identical. The row draws
           `shown` in every state now, so a recipient that reached a reply would appear here. */
        const chip = document.createElement("span");
        chip.className = "dashboard__composer-chip dashboard__composer-chip--everyone";
        chip.dataset.composerToBroadcast = "";
        chip.setAttribute("role", "listitem");
        chip.textContent = replying ? THREAD_REPLY_CHIP_LABEL : BROADCAST_CHIP_LABEL;
        chips.append(chip);
      }
      for (const entity of shown) {
        const chip = document.createElement("span");
        chip.className = "dashboard__composer-chip";
        chip.setAttribute("role", "listitem");
        chip.dataset.composerToChip = recipientKey(entity);
        chip.dataset.composerToKind = entity.kind;
        const name = composerRecipientName(entity);
        const promote = document.createElement("button");
        promote.type = "button";
        promote.className = "dashboard__composer-chip-name";
        promote.dataset.composerToPromote = recipientKey(entity);
        promote.textContent = name;
        /* ~~"The only control over WHO IS WOKEN"~~ Retired 2026-09-05: promoting decides
           nothing about the wake, because every agent in the set is woken wherever it sits.
           What it still decides is the SCALAR column — the target an old reader sees and the
           name the feed row prints after its arrow — and the label says that. The wake is the
           note's to state, in one place, and no chip answers it. */
        promote.title = composerPromoteLabel(entity, shown, composerRecipientName);
        promote.setAttribute("aria-label", promote.title);
        if (notifiedKeys.has(recipientKey(entity))) {
          chip.dataset.composerToNotified = "";
        }
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "dashboard__composer-chip-remove";
        remove.dataset.composerToRemove = recipientKey(entity);
        remove.title = `Remove ${name}`;
        remove.setAttribute("aria-label", `Remove ${name} from To:`);
        remove.textContent = "\u00d7";
        chip.append(promote, remove);
        chips.append(chip);
      }
      /* AND THE SENTENCE FOLLOWS THE SAME MODE. A reply's reach is not the delivery note's
         subject: that note is about which recipient is woken, and a reply has none. The notice
         about names the pass could not honour is not shown either, because the pass HELD and
         made no such decision about this message. */
      if (replying) {
        note.textContent = THREAD_REPLY_TO_TEXT;
        return;
      }
      const sentence = composerDeliveryNote(shown, composerRecipientName);
      note.textContent = composerToNotice === ""
        ? sentence
        : `${sentence} ${composerToNotice}`;
    };

    /**
     * THE ONE PASS. Every handler that can change the address calls this and assigns nothing
     * itself: a keystroke, a pick from the mention list, a chip click, a draft restore, a
     * roster paint, the flush before a submit, and the settle after one.
     *
     * It derives the pair from what is known — the body's tags, the roster, the stored draft,
     * the last-sent set — and COMMITS ALL OF IT OR NONE OF IT. When it commits, the same call
     * writes the stored pair, so an edit cannot be on screen and absent from storage; when it
     * holds, nothing is written and no restore is marked done, so a later paint with a real
     * roster still has everything it needs.
     *
     * `edit` is a set the reader chose by hand. It replaces the live set for this pass and is
     * then pruned and merged like any other, so a removal made while a tag is still in the
     * sentence is honoured by the same rule that honours it on the next keystroke.
     *
     * Returns whether it committed, which is what the restore reads.
     */
    const syncComposerAddress = (edit?: readonly ComposerRecipient[]): boolean => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const rosterKnown = composerRosterKnown();
      const live: ComposerAddressPair | null = edit !== undefined
        ? { to: [...edit], applied: composerToApplied }
        : composerToLive
        ? { to: composerTo, applied: composerToApplied }
        : null;
      /* THE STORED DRAFT IS READ ONLY WHEN IT CAN BE USED, which is a cold entry with no pair
       * on screen yet. With a live pair the pass never looks at it, and reading it anyway put
       * a synchronous localStorage read plus a JSON parse inside every chip click — and on
       * iOS Safari that read is synchronous ACROSS PROCESSES, which is the cost the composer
       * already moved off the keystroke path once. */
      const draftKey = composerDraftKey();
      const stored = live !== null || draftKey === null
        ? null
        : readComposerDraft(draftKey);
      /* THE TAGS ARE READ ONCE, here, and the two things the parser reports that are not
       * recipients travel with them to the sentence builder. */
      const parsed = rosterKnown && input !== null
        ? composerAddressFrom(input.value)
        : { recipients: [], overflow: [], ambiguous: [] };
      const state = deriveComposerAddress({
        rosterKnown,
        sending: composerSending,
        /* AND A REPLY HOLDS THE PAIR TOO. The reply is not addressed by it, so deriving one
           against the reply's body would let an @tag inside a reply edit the address of the
           message the reader comes back to. Holding is the whole lock: there is no second
           write path to keep in step, and cancelling gives the chips back untouched. */
        replying: composerIsReplying(),
        known: composerRecipientKnown,
        live,
        draft: stored === null
          ? null
          : { to: stored.to ?? null, applied: stored.applied ?? [] },
        remembered: readRememberedComposerTo(),
        tagged: parsed.recipients.map((entity) => ({ kind: entity.kind, id: entity.id })),
        /* A HAND EDIT ANSWERS THE PRUNE SENTENCE. The reader has looked at the row and acted
         * on it, so the notice about a set they were not looking at has done its work. */
        announcedPrune: edit !== undefined ? 0 : composerToPruned,
      });
      if (!state.committed) {
        renderComposerTo();
        return false;
      }
      composerTo = state.recipients;
      composerToApplied = state.applied;
      composerToPruned = state.announcedPrune;
      composerToLive = true;
      composerToNotice = composerAddressNotice(state, parsed, composerRecipientName);
      /* AND THE SAME CALL WRITES IT DOWN, so an edit cannot be on screen and absent from
       * storage. A chip edit used to reach storage only on the next keystroke or at
       * `pagehide`, and a workspace switch cancelled the pending write without flushing, so an
       * edit that changed nothing else was lost. The switch now flushes too: the two are
       * separate routes to the same write, which is why the control in
       * docs/evidence/2026-09-05-composer-to/mutate.mjs breaks the WRITE rather than either
       * route, and why the README says so rather than claiming each is load-bearing alone. */
      persistComposerDraft();
      renderComposerTo();
      syncComposerControls();
      return true;
    };

    /* Two idle delays on the keystroke path. 150ms is the shortest pause that reads as a stop
     * in typing, so the mention list still appears to open as you type; 300ms is a longer one,
     * because nothing but a reload reads the draft. */
    const COMPOSER_MENTION_DEBOUNCE_MS = 150;
    const COMPOSER_DRAFT_DEBOUNCE_MS = 300;
    /* Declared here, above every function that reads them, because both are cancelled from
     * inside the direct paths (`persistComposerDraft`, `closeMentionPicker`) that a pending
     * timer must never be allowed to undo — a debounced write that lands after a send would
     * put the sent text back as a draft. */
    let composerDraftTimer = 0;
    let mentionPickerTimer = 0;
    /* The tag-to-chip pass has its OWN timer and is not folded into the picker's. The picker
     * closes as soon as the caret leaves an @word, and a finished tag ("@Wren ") is exactly
     * that case, so a chip hung off the picker's schedule would never be added. */
    let composerToTimer = 0;
    /* There is nothing to put back until something has been remembered, and the starting value
     * is not a caret anybody chose. Without this flag the first focus that did not follow a tap
     * — tabbing into a draft the page restored — would set the caret to the START of a sentence
     * the reader had already written, which is the defect the caret block exists to remove.
     * Declared here, with the timers, because the entry restore clears it and that runs
     * above the caret block. */
    let composerCaretKnown = false;
    const cancelComposerDraftTimer = (): void => {
      if (!composerDraftTimer) return;
      window.clearTimeout(composerDraftTimer);
      composerDraftTimer = 0;
    };
    const cancelMentionPickerRender = (): void => {
      if (!mentionPickerTimer) return;
      window.clearTimeout(mentionPickerTimer);
      mentionPickerTimer = 0;
    };
    const cancelComposerToPass = (): void => {
      if (!composerToTimer) return;
      window.clearTimeout(composerToTimer);
      composerToTimer = 0;
    };
    const COMPOSER_COUNTER_THRESHOLD = 500;
    const COMPOSER_DRAFT_STORAGE_MAX = SIGNAL_BODY_MAX * 2;
    /* A STORAGE KEY SEGMENT, and the one place "all-signals" is deliberately typed rather
       than built from ALL_SIGNALS_SLUG. It names the drafts already saved in readers'
       browsers, so it must not move when the view's name does: following the constant would
       orphan every saved draft the day that constant changed, which is the opposite of what
       generating it is for. The old name carried "stream", the wire's word for the event
       log, which this lane retired from the app; the VALUE is frozen and the rename does not
       touch it. */
    const COMPOSER_DRAFT_SCOPE = "all-signals";

    const composerDraftKey = (workspaceId = activeWorkspaceId): string | null => {
      if (!workspaceId) return null;
      const owner = session?.user.id ?? (sampleMode ? "sample-owner" : "");
      if (!owner) return null;
      return `commonswarm:composer-draft:${owner}:${workspaceId}:${COMPOSER_DRAFT_SCOPE}`;
    };

    const readComposerDraft = (key: string): ComposerDraft | null => {
      try {
        const raw = window.localStorage.getItem(key);
        if (!raw) return null;
        const value = JSON.parse(raw) as Partial<ComposerDraft>;
        if (typeof value.body !== "string") return null;
        return {
          body: value.body.slice(0, COMPOSER_DRAFT_STORAGE_MAX),
          ...(value.hadAttachments === true ? { hadAttachments: true } : {}),
          ...(Array.isArray(value.to)
            ? {
              to: value.to.filter((entry): entry is ComposerRecipient =>
                entry !== null && typeof entry === "object" &&
                typeof (entry as ComposerRecipient).id === "string" &&
                ((entry as ComposerRecipient).kind === "agent" ||
                  (entry as ComposerRecipient).kind === "person")
              ),
            }
            : {}),
          ...(Array.isArray(value.applied)
            ? { applied: value.applied.filter((key) => typeof key === "string") }
            : {}),
        };
      } catch {
        return null;
      }
    };

    /* NOT GATED ON `composerSending`, unlike the write, and it takes the key rather than
       reading the live one. Both halves are load-bearing and neither is enough alone: a
       landed post has to remove its own draft while its own send flag is still up, and it has
       to name the workspace it posted from, because the reader may have switched away by the
       time the server answered. Ungated ALONE was claimed to be enough and was not — every
       call site sat behind the send's changed-workspace return, so a landed post under a
       switch cleared nothing, and had it tried it would have removed the new workspace's
       draft. A review arm found that, and found the claim control that had been defending the
       false half of it. */
    const clearComposerDraft = (key = composerDraftKey()): void => {
      cancelComposerDraftTimer();
      if (!key) return;
      try {
        window.localStorage.removeItem(key);
      } catch {
        // The live input remains authoritative when storage is unavailable.
      }
    };

    const persistComposerDraft = (): void => {
      cancelComposerDraftTimer();
      /* THE STORED DRAFT IS FROZEN FOR THE WHOLE POST, exactly as the pair is.
       *
       * A send empties the box before it awaits, so while `composerSending` is true the
       * textarea holds "" and that is NOT the reader's state — it is the send's. Writing it
       * down destroyed the draft that still held their text: a workspace switch mid-post
       * flushes, read the emptied box, and either overwrote the good draft with an empty body
       * or removed it outright. The post then finished under a changed workspace, took its
       * early return, and never put `rawBody` back. The reader came back to nothing.
       *
       * A review arm found it. It is the same rule the pass already follows and the same
       * reason: a handler must not read a moment another handler is in the middle of. The
       * settle in the submit's `finally` runs after the flag drops and writes the real state
       * then; `clearComposerDraft` is a removal rather than a write and is not gated here,
       * because a landed post must clear its draft whatever else is in flight. */
      if (composerSending) return;
      const key = composerDraftKey();
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      if (!key || !input) return;
      const body = input.value.slice(0, COMPOSER_DRAFT_STORAGE_MAX);
      const hadAttachments = stagedAttachments.length > 0 || composerAttachmentsMissingAfterReload;
      try {
        /* THE DRAFT IS THE STATE OF THE MESSAGE BEING WRITTEN: the body, one attachment
           marker, the To: set it is addressed to, and which of the body's tags produced
           that set. The LAST SENT set is remembered separately (`rememberComposerTo`) and is
           what the composer opens with when there is no draft.

           `to` IS WRITTEN EVEN WHEN IT IS EMPTY, and that is the point. Omitting an empty
           set is what the WIRE does, where a missing key means "the whole workspace"; here
           a missing key means "no set was saved, keep the last-sent one", so a reader who
           emptied To: to a broadcast came back addressed to whoever they last messaged. A
           review arm found it. The two meanings look identical in storage, so the empty
           case has to be written down. */
        /* AN ADDRESS THE READER CHOSE IS A DRAFT, even with nothing typed yet. "Nothing to
           save" used to mean an empty box and no attachment, which threw away the one edit
           that writes nothing else: taking a name out of To:, or emptying it to a broadcast,
           before writing the message. The reader came back to the set they had just removed.

           WHAT COUNTS AS CHOSEN is the pure module's question, and it is not "does this differ
           from the last-sent set". Arrival PRUNES that set, so a set nobody touched differs
           from it too; writing that down made a silent prune permanent, and a member who left
           and came back stayed out of To: for good. A composer sitting at its normal starting
           point stores nothing, and the key does not grow for every workspace anybody opens.

           IT GATES WHETHER THE DRAFT IS KEPT, NOT WHAT ITS `to` HOLDS, and that asymmetry is
           deliberate. A draft WITH a body is a message in progress and owns its address: if a
           member the roster had lost rejoins while that message is being written, they must
           NOT reappear in its To:, because a recipient the reader never chose is the hidden
           recipient this row exists to rule out. A draft with no body is not a message, so
           there is nothing to own an address and the set is derived again on arrival. A review
           arm read the first case as the prune outliving its cause; it is the same set for a
           different reason, and adding the returning member back would be the worse failure. */
        const addressChosen = composerToLive &&
          composerAddressIsChosen(
            composerTo,
            readRememberedComposerTo(),
            composerRecipientKnown,
          );
        if (body === "" && !hadAttachments && !addressChosen) {
          window.localStorage.removeItem(key);
          return;
        }
        window.localStorage.setItem(
          key,
          JSON.stringify({
            body,
            ...(hadAttachments ? { hadAttachments: true } : {}),
            to: composerTo,
            ...(composerToApplied.length === 0 ? {} : { applied: composerToApplied }),
          }),
        );
      } catch {
        // A private or full storage area must not break composing or sending.
      }
    };

    /* AUTOGROW COSTS A SYNCHRONOUS LAYOUT. Writing `auto` and then reading scrollHeight forces
     * the browser to lay the document out again before the event handler can return, so on a
     * phone the price of one keystroke rose with the length of the transcript behind it. The
     * write is the same; WHEN it happens is not. Batched into an animation frame it runs after
     * the handler, outside the interaction that the browser measures, and several keystrokes in
     * one frame pay for one layout instead of one each. */
    let composerResizeFrame = 0;
    let composerResizeTimer = 0;
    const applyComposerResize = (input: HTMLTextAreaElement): void => {
      if (composerResizeFrame) window.cancelAnimationFrame(composerResizeFrame);
      if (composerResizeTimer) window.clearTimeout(composerResizeTimer);
      composerResizeFrame = 0;
      composerResizeTimer = 0;
      input.style.blockSize = "auto";
      input.style.blockSize = `${input.scrollHeight}px`;
    };
    /* localStorage is synchronous, and on iOS Safari it is synchronous ACROSS PROCESSES. One
     * write per keystroke put that cost inside the keystroke. The draft only has to survive a
     * reload, so an idle write is as good and the send path flushes it anyway. */
    const flushComposerDraft = (): void => {
      persistComposerDraft();
    };
    const scheduleComposerDraft = (): void => {
      cancelComposerDraftTimer();
      composerDraftTimer = window.setTimeout(() => {
        composerDraftTimer = 0;
        persistComposerDraft();
      }, COMPOSER_DRAFT_DEBOUNCE_MS);
    };

    const resizeComposerInput = (input: HTMLTextAreaElement, immediate = false): void => {
      if (immediate) {
        applyComposerResize(input);
        return;
      }
      if (composerResizeFrame || composerResizeTimer) return;
      composerResizeFrame = window.requestAnimationFrame(() => applyComposerResize(input));
      /* An animation frame is not guaranteed to arrive. A hidden tab does not get one, and
       * neither does a headless run with no compositor, so the box would keep a stale height.
       * The timer is the floor under the frame; whichever runs first cancels the other. */
      composerResizeTimer = window.setTimeout(() => applyComposerResize(input), 32);
    };

    const setComposerStatus = (
      message: string,
      state: "idle" | "posting" | "error" = "idle",
    ): void => {
      const status = one<HTMLElement>("[data-composer-status]");
      const feedback = one<HTMLElement>("[data-composer-feedback]");
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      if (feedback) feedback.hidden = message === "";
    };

    const formatAttachmentSize = (bytes: number): string => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    };

    const renderStagedAttachments = (): void => {
      const container = one<HTMLElement>("[data-composer-attachments]");
      if (!container) return;
      container.replaceChildren();
      container.hidden = stagedAttachments.length === 0;
      for (const attachment of stagedAttachments) {
        const chip = document.createElement("span");
        chip.className = "dashboard__attachment-chip";
        chip.dataset.stagedAttachment = attachment.intent.name;
        if (attachment.previewUrl) {
          const image = document.createElement("img");
          image.src = attachment.previewUrl;
          image.alt = "";
          image.setAttribute("aria-hidden", "true");
          chip.append(image);
        }
        const copy = document.createElement("span");
        const name = document.createElement("strong");
        name.textContent = attachment.intent.name;
        const size = document.createElement("small");
        size.textContent = formatAttachmentSize(attachment.intent.file.size);
        copy.append(name, size);
        const remove = document.createElement("button");
        remove.type = "button";
        remove.dataset.removeAttachment = attachment.intent.fileId;
        remove.setAttribute("aria-label", `Remove ${attachment.intent.name}`);
        remove.textContent = "×";
        remove.disabled = composerSending;
        remove.addEventListener("click", () => {
          if (composerSending) return;
          const index = stagedAttachments.indexOf(attachment);
          if (index < 0) return;
          if (attachment.previewUrl) URL.revokeObjectURL(attachment.previewUrl);
          stagedAttachments.splice(index, 1);
          composerIntent = null;
          renderStagedAttachments();
          persistComposerDraft();
          syncComposerControls();
        });
        chip.append(copy, remove);
        container.append(chip);
      }
    };

    const stageComposerFiles = (files: readonly File[]): void => {
      if (composerSending || files.length === 0) return;
      try {
        const prepared = prepareBrowserAttachments(files, stagedAttachments.length);
        stagedAttachments.push(...prepared.map((intent) => ({
          intent,
          previewUrl: intent.contentType.startsWith("image/")
            ? URL.createObjectURL(intent.file)
            : null,
        })));
        composerAttachmentsMissingAfterReload = false;
        composerIntent = null;
        const warning = one<HTMLElement>("[data-composer-reload-warning]");
        if (warning) warning.hidden = true;
        setComposerStatus(
          `${stagedAttachments.length} of ${BROWSER_ATTACHMENT_MAX} files attached. They upload when you send.`,
        );
        renderStagedAttachments();
        persistComposerDraft();
        syncComposerControls();
      } catch (error) {
        setComposerStatus(readableError(error), "error");
      }
    };

    const setComposerDropTarget = (active: boolean): void => {
      const shell = one<HTMLElement>(".dashboard__composer-input");
      const target = one<HTMLElement>("[data-composer-drop-target]");
      shell?.classList.toggle("dashboard__composer-input--drop", active);
      if (target) target.hidden = !active;
    };

    const syncComposerControls = (): void => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const send = one<HTMLButtonElement>("[data-composer-send]");
      const count = one<HTMLElement>("[data-composer-count]");
      if (!input || !send || !count) return;
      const length = input.value.length;
      const remaining = SIGNAL_BODY_MAX - length;
      count.hidden = remaining > COMPOSER_COUNTER_THRESHOLD;
      if (!count.hidden) {
        const limitLabel = SIGNAL_BODY_MAX.toLocaleString();
        count.textContent = remaining > 0
          ? `${remaining.toLocaleString()} ${remaining === 1 ? "character" : "characters"} left`
          : remaining === 0
          ? `${limitLabel}-character limit reached`
          : `${Math.abs(remaining).toLocaleString()} ${remaining === -1 ? "character" : "characters"} over the ${limitLabel}-character limit`;
        count.dataset.state = remaining <= 0 ? "firm" : "near";
      }
      const empty = input.value.trim() === "";
      const overLimit = length > SIGNAL_BODY_MAX;
      send.disabled = composerSending || empty || overLimit;
      if (composerSending) {
        send.title = "Posting signal…";
      } else if (empty) {
        send.title = "Write a signal before posting";
      } else if (overLimit) {
        send.title = `Shorten the signal by ${length - SIGNAL_BODY_MAX} characters`;
      } else {
        send.title = "Post signal (Enter)";
      }
    };

    const setComposerSending = (sending: boolean): void => {
      composerSending = sending;
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const send = one<HTMLButtonElement>("[data-composer-send]");
      if (input) {
        input.readOnly = sending;
        if (sending) {
          input.setAttribute("aria-busy", "true");
          input.setAttribute("aria-disabled", "true");
        } else {
          input.removeAttribute("aria-busy");
          input.removeAttribute("aria-disabled");
        }
      }
      if (send) {
        send.dataset.state = sending ? "posting" : "ready";
        send.setAttribute("aria-label", sending ? "Posting signal" : "Post signal");
        if (sending) send.setAttribute("aria-busy", "true");
        else send.removeAttribute("aria-busy");
      }
      const attach = one<HTMLButtonElement>("[data-composer-attach]");
      const picker = one<HTMLInputElement>("[data-composer-file-input]");
      if (attach) attach.disabled = sending;
      if (picker) picker.disabled = sending;
      renderStagedAttachments();
      syncComposerControls();
    };

    /**
     * THE COMPOSER'S STATE FOR THIS WORKSPACE, RESTORED AS ONE TRANSACTION.
     *
     * The body and the address are one thing and are put back together or not at all. They
     * used to be two restores with two once-per-workspace keys, and that is the class four
     * review rounds kept finding: a workspace switch paints once before the roster request
     * settles, the draft restore committed against that empty roster — pruning every chip and
     * marking itself done — and the later paint that did have a roster wrote the last-sent
     * set over a draft the reader had already addressed. A broadcast draft came back
     * directed; a chip the reader had removed came back.
     *
     * NOTHING HERE COMMITS UNTIL THE ROSTER IS KNOWN, and the gate is the PASS'S — there is
     * no second copy of it here. This may put the stored body in the box on a paint that
     * cannot yet know the roster, which is harmless because the box is the reader's own text
     * either way; what it may not do is decide the address, and it does not: the pass holds,
     * nothing is written, and the next paint derives the whole pair from the same stored
     * draft this one read. A guard here as well would be a rule with no control on it.
     */
    const restoreComposerOnEntry = (): void => {
      const key = composerDraftKey();
      if (!key || restoredComposerKey === key) {
        syncComposerControls();
        return;
      }
      const draft = readComposerDraft(key);
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      if (input === null) {
        syncComposerControls();
        return;
      }
      restoredComposerKey = key;
      if (draft !== null) {
        input.value = draft.body;
        /* A caret remembered in OTHER text is not a caret in this text. The restore would put
           it back at a position the reader never chose here. Kept ADJACENT to the assignment
           above: composer-sprint.observer.test.ts reads the two together in one window, and
           it is right to, because they are one operation. */
        composerCaretKnown = false;
        composerIntent = null;
        const warning = one<HTMLElement>("[data-composer-reload-warning]");
        composerAttachmentsMissingAfterReload = draft.hadAttachments === true;
        if (warning) warning.hidden = !composerAttachmentsMissingAfterReload;
        resizeComposerInput(input);
      }
      /* AND THE ADDRESS THAT BELONGS TO THAT BODY. The pass reads the same stored draft this
         function just read, so the set, the applied record and the body cannot come from
         different moments. With no draft it derives the last-sent set instead, which is what
         the composer opens with when there is no message being written. */
      syncComposerAddress();
      syncComposerControls();
    };

    const focusComposerOnEntry = (): void => {
      if (
        !activeWorkspaceId ||
        focusedComposerWorkspaceId === activeWorkspaceId ||
        window.matchMedia("(max-width: 52rem)").matches
      ) return;
      focusedComposerWorkspaceId = activeWorkspaceId;
      window.requestAnimationFrame(() => {
        one<HTMLTextAreaElement>("[data-composer-input]")?.focus({ preventScroll: true });
      });
    };

    /* THE CARET SURVIVES THE KEYBOARD.
     *
     * Showing and hiding a software keyboard moves focus off the textarea and back, and the
     * browser restores neither the selection nor the textarea's own scroll position. What the
     * operator met was a composer he could not return to the end of. Two pieces:
     *
     *  - remember the selection whenever it changes while the field has focus, and put it back
     *    when focus returns WITHOUT a pointer landing in the text. A tap inside the text is the
     *    reader choosing a new caret, and restoring over it would be worse than the bug.
     *  - after the visible viewport resizes, scroll the caret's line back into the textarea's
     *    scrollport. At its maximum height the textarea scrolls internally, which is where the
     *    typed line disappeared behind the keyboard furniture.
     */
    let composerCaret = { end: 0, start: 0 };
    let composerPointerAt = 0;
    const composerInputElement = (): HTMLTextAreaElement | null =>
      one<HTMLTextAreaElement>("[data-composer-input]");

    const rememberComposerCaret = (): void => {
      const input = composerInputElement();
      if (!input || document.activeElement !== input) return;
      composerCaretKnown = true;
      composerCaret = {
        end: input.selectionEnd ?? 0,
        start: input.selectionStart ?? 0,
      };
    };

    const scrollComposerCaretIntoView = (): void => {
      const input = composerInputElement();
      if (!input || document.activeElement !== input) return;
      const caret = input.selectionEnd ?? input.value.length;
      /* The end of the text is the case the operator hit and the only one that can be answered
       * exactly: scrollHeight already accounts for wrapped lines. */
      if (caret >= input.value.length) {
        input.scrollTop = input.scrollHeight;
        return;
      }
      /* Anywhere else, count hard line breaks. This does NOT count soft wraps, so a caret in
       * the middle of a long wrapped paragraph can land a line or two off. */
      const style = window.getComputedStyle(input);
      const lineHeight = Number.parseFloat(style.lineHeight) ||
        Number.parseFloat(style.fontSize) * 1.4;
      const caretTop = (input.value.slice(0, caret).split("\n").length - 1) * lineHeight;
      if (caretTop + lineHeight > input.scrollTop + input.clientHeight) {
        input.scrollTop = caretTop + lineHeight - input.clientHeight;
      } else if (caretTop < input.scrollTop) {
        input.scrollTop = caretTop;
      }
    };

    const restoreComposerCaret = (): void => {
      const input = composerInputElement();
      if (!input || !composerCaretKnown) return;
      const length = input.value.length;
      input.setSelectionRange(
        Math.min(composerCaret.start, length),
        Math.min(composerCaret.end, length),
      );
      scrollComposerCaretIntoView();
    };

    /* The visual viewport is the usable screen while a software keyboard is open. CSS viewport
     * units can still describe the larger layout viewport, which leaves the composer behind the
     * keyboard on mobile Chrome. Keep one measured height on the product shell.
     *
     * `window.innerHeight` is NOT a fallback here. On iOS Safari it reports the layout viewport,
     * which does not change when the keyboard opens, so using it would write a height that is
     * too tall at exactly the moment the composer needs a shorter one. When there is no
     * visualViewport the property stays unset and the stylesheet's own `100dvh` applies, which
     * is the browser's answer to the same question.
     *
     * iOS ALSO scrolls the LAYOUT viewport when a field near the bottom takes focus. That is
     * what threw the composer to the top of the screen and then dropped it part way: the app
     * is sized to the visible viewport, but the whole page had been pushed up underneath it.
     * Returning the page to 0 on every visual-viewport event pins the shell to the screen. */
    let viewportSyncFrame = 0;
    const syncDashboardViewport = (): void => {
      viewportSyncFrame = 0;
      if (window.scrollX !== 0 || window.scrollY !== 0) window.scrollTo(0, 0);
      const viewport = window.visualViewport;
      if (!viewport) return;
      app.style.setProperty("--dashboard-viewport-height", `${Math.round(viewport.height)}px`);
      /* The composer has just moved. Whatever was being typed goes back into view. */
      scrollComposerCaretIntoView();
    };
    /* visualViewport `scroll` fires many times per keyboard animation frame. Writing a custom
     * property invalidates layout for the whole shell, so coalesce to one write per frame. */
    const requestDashboardViewportSync = (): void => {
      if (viewportSyncFrame) return;
      viewportSyncFrame = window.requestAnimationFrame(syncDashboardViewport);
    };
    syncDashboardViewport();
    window.addEventListener("resize", requestDashboardViewportSync);
    window.visualViewport?.addEventListener("resize", requestDashboardViewportSync);
    window.visualViewport?.addEventListener("scroll", requestDashboardViewportSync);

    const closeMentionPicker = (): void => {
      cancelMentionPickerRender();
      const picker = one<HTMLElement>("[data-mention-picker]");
      if (picker) picker.hidden = true;
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      input?.setAttribute("aria-expanded", "false");
      input?.removeAttribute("aria-activedescendant");
      mentionPickerIndex = 0;
    };

    const mentionSearch = (): { query: string; start: number } | null => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      if (!input) return null;
      const beforeCursor = input.value.slice(0, input.selectionStart ?? input.value.length);
      const match = beforeCursor.match(/(?:^|\s)@([^@\s]*)$/);
      if (!match || match.index === undefined) return null;
      return {
        query: match[1]?.toLocaleLowerCase() ?? "",
        start: match.index + (match[0].startsWith(" ") ? 1 : 0),
      };
    };

    const mentionCandidates = (query: string): EntityRef[] => {
      const candidates: EntityRef[] = [
        ...members.map((member) => ({ kind: "person" as const, id: member.userId })),
        ...agents.map((agent) => ({ kind: "agent" as const, id: agent.principalId })),
      ];
      /* Every current recipient leaves the list, not just the first — offering a name that is
       * already addressed would produce a pick that does nothing. A name the parser cannot
       * resolve leaves too: writing it into the body would look addressed and reach nobody. */
      return candidates.filter((candidate) =>
        !composerHasRecipient(candidate) &&
        isTaggable(entityName(candidate)) &&
        entityName(candidate).toLocaleLowerCase().includes(query)
      );
    };

    /* The pick writes the NAME INTO THE BODY. It is a word in the message, not a chip beside
     * it, so what the reader sees in the text is exactly who the send will reach. */
    const selectMention = (mention: EntityRef): void => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const search = mentionSearch();
      if (!input || !search) return;
      const cursor = input.selectionStart ?? input.value.length;
      const tag = `@${entityName(mention)} `;
      input.value = `${input.value.slice(0, search.start)}${tag}${input.value.slice(cursor)}`;
      const caret = search.start + tag.length;
      input.setSelectionRange(caret, caret);
      composerIntent = null;
      closeMentionPicker();
      resizeComposerInput(input);
      persistComposerDraft();
      input.focus({ preventScroll: true });
      input.dispatchEvent(new Event("input"));
      /* A PICK IS A DECISION, so the chip appears now rather than after the typing pause the
         debounce waits for. The dispatch above armed that pass; this runs it and cancels it.
         The pass writes the draft itself, so the persist above is the body and this is the
         address; the two used to be one persist apart and a switch fell into that gap. */
      cancelComposerToPass();
      syncComposerAddress();
    };

    const renderMentionPicker = (): void => {
      const picker = one<HTMLElement>("[data-mention-picker]");
      const search = mentionSearch();
      if (!picker || !search) {
        closeMentionPicker();
        return;
      }
      const candidates = mentionCandidates(search.query);
      picker.replaceChildren();
      if (candidates.length === 0) {
        closeMentionPicker();
        return;
      }
      mentionPickerIndex = Math.min(mentionPickerIndex, candidates.length - 1);
      candidates.forEach((candidate, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.id = `dashboard-composer-mention-option-${index}`;
        button.tabIndex = -1;
        button.setAttribute("role", "option");
        button.setAttribute("aria-selected", String(index === mentionPickerIndex));
        const avatar = document.createElement("span");
        avatar.className = "dashboard__mention-picker-avatar";
        avatar.textContent = initials(entityName(candidate));
        avatar.setAttribute("aria-hidden", "true");
        if (candidate.kind === "agent") markAgentAvatar(avatar, candidate.id);
        const copy = document.createElement("span");
        copy.className = "dashboard__mention-picker-copy";
        const name = document.createElement("strong");
        name.textContent = entityName(candidate);
        copy.append(name);
        if (candidate.kind === "agent") {
          const agent = agents.find((entry) => entry.principalId === candidate.id);
          const detail = document.createElement("span");
          detail.textContent = `agent · managed by ${
            agent ? people.get(agent.ownerUserId) ?? "Workspace member" : "Workspace member"
          }`;
          copy.append(detail);
        }
        button.append(avatar, copy);
        button.addEventListener("pointerdown", (event) => event.preventDefault());
        button.addEventListener("click", () => selectMention(candidate));
        picker.append(button);
      });
      picker.hidden = false;
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      input?.setAttribute("aria-expanded", "true");
      input?.setAttribute(
        "aria-activedescendant",
        `dashboard-composer-mention-option-${mentionPickerIndex}`,
      );
    };

    /* The mention list is a search across every member and agent, and it rebuilt the whole
     * popover on every keystroke — including the keystrokes that cannot change the result,
     * which is most of them. It runs after typing pauses instead. `renderMentionPicker` itself
     * is unchanged and is still called directly by the arrow keys, where the reader is waiting
     * on it. */
    /**
     * Off the keystroke path, like the picker and the draft write. A body scan is the same
     * cost `addressFromBody` always was; it used to run once at submit and now runs when
     * typing pauses, so the chips appear as the sentence is written.
     */
    const scheduleComposerToPass = (): void => {
      cancelComposerToPass();
      composerToTimer = window.setTimeout(() => {
        composerToTimer = 0;
        syncComposerAddress();
      }, COMPOSER_MENTION_DEBOUNCE_MS);
    };

    const scheduleMentionPicker = (): void => {
      cancelMentionPickerRender();
      /* An open picker whose text no longer holds an @word must close at once, or it stays on
       * screen offering names for a query that is gone. Closing is cheap; opening is not. */
      if (!mentionSearch()) {
        closeMentionPicker();
        return;
      }
      mentionPickerTimer = window.setTimeout(() => {
        mentionPickerTimer = 0;
        renderMentionPicker();
      }, COMPOSER_MENTION_DEBOUNCE_MS);
    };

    const resetComposer = (): void => {
      /* THE FLUSH COMES FIRST, before the box is emptied and before the attachments go. It
         runs while `activeWorkspaceId` is still the workspace being left, so it lands on that
         workspace's key, and it reads the body and the To: set the reader actually had.

         It used to CANCEL the pending write instead, which was right about the timer and
         wrong about the draft. Cancelling is right because a debounced write armed against
         the old workspace fires afterwards, reads an empty box against the NEW key, and
         removes the draft the reader is about to be shown. But cancelling ALONE threw away
         every edit made inside the debounce window, and a chip edit writes nothing else, so a
         reader who took a name out of To: and switched workspace got that name back.
         Flushing does both jobs: `persistComposerDraft` cancels the timer itself. */
      persistComposerDraft();
      for (const attachment of stagedAttachments) {
        if (attachment.previewUrl) URL.revokeObjectURL(attachment.previewUrl);
      }
      stagedAttachments = [];
      composerAttachmentsMissingAfterReload = false;
      composerDragDepth = 0;
      composerIntent = null;
      visualMentions.clear();
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      if (input) {
        input.value = "";
        input.style.blockSize = "auto";
      }
      /* THIS IS NOT THE SEND PATH. The only callers are the workspace change and session
         teardown; a send empties the box in its own handler and clears the draft on success,
         and it deliberately keeps the caret because a FAILED send puts the body back and the
         reader's place in it with it. What has to go here is state that belongs to the
         workspace being left.
         The caret, because the text it indexes is about to be replaced by another
         workspace's draft. */
      composerCaretKnown = false;
      /* And the address, because it belongs to the workspace being left.

         THIS IS THE ONE WRITE OF THE PAIR OUTSIDE THE PASS, and it is a teardown rather than a
         derivation: the workspace is gone, so there is nothing left to derive from — no
         roster, no storage key, no body. The pass cannot answer that question, and asking it
         to would mean deriving an address for a workspace nobody is in.

         Clearing the restore key makes the next paint derive the new workspace's pair from
         that workspace's own storage rather than carry this one's chips into a place those
         people may not be in. `composerToLive` goes with it: until the next pass commits there
         is no set on screen, and an empty one here must not be read as a broadcast anybody
         chose. The flush above already wrote what this is about to throw away. */
      cancelComposerToPass();
      /* AND THE REPLY, BEFORE THE PAIR. A reply in progress belongs to one message in one
         workspace, and this runs on the way out of that workspace. It is cleared HERE and not
         in the send path, which keeps a failed reply for another try, and it is cleared BEFORE
         the pair below so `renderComposerTo` at the end of this block draws the empty row
         rather than the reply's own sentence for a workspace nobody is in. It is assigned
         directly rather than through `setThreadReplyRoot`: that writer retires an unfinished
         intent and syncs the pass, and both are done here already, in the order this teardown
         needs them. */
      threadReplyRoot = null;
      expandedThreadIds = new Set<string>();
      syncComposerPlacement();
      composerTo = [];
      composerToApplied = [];
      composerToNotice = "";
      composerToPruned = 0;
      composerToLive = false;
      restoredComposerKey = "";
      renderComposerTo();
      setComposerStatus("");
      const retry = one<HTMLButtonElement>("[data-composer-retry]");
      if (retry) retry.hidden = true;
      const warning = one<HTMLElement>("[data-composer-reload-warning]");
      if (warning) warning.hidden = true;
      setComposerDropTarget(false);
      /* THE FLAG COMES DOWN AND ITS OWNER IS RETIRED WITH IT. A send still on the wire raised
         this flag; the composer it raised it on is being torn down, so that send no longer
         owns the box and must not lower a flag a LATER send raises in the new workspace.
         Bumping the token here is what says so, and it is the same statement the send's own
         settle reads. */
      composerSendToken += 1;
      setComposerSending(false);
      renderStagedAttachments();
      closeMentionPicker();
      syncComposerControls();
    };

    /* The rail mirrors participants as presence/navigation only. Its shared renderer keeps
       ownership structural and names unresolved owners instead of hiding their agents. */
    /* Two ways an item in this menu is not on offer, and the list has to know both. The
       `hidden` attribute is one. The other is CSS: "Workspace settings" exists only below
       52rem, where the gear leaves the app bar, and above that width it is `display: none`.
       Filtering on `hidden` alone left it in this roving-focus list, so arrowing through the
       desktop menu stopped on an item nobody could see. A box is the test that covers both. */
    const workspaceMenuItems = (): HTMLButtonElement[] =>
      all<HTMLButtonElement>("[data-workspace-menu] [role='menuitemradio'], [data-workspace-menu] [role='menuitem']")
        .filter((item) => !item.hidden && item.getClientRects().length > 0);

    const closeWorkspaceMenu = (restoreFocus = false): void => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      const trigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      if (!menu || menu.hidden) return;
      menu.hidden = true;
      trigger?.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger?.focus({ preventScroll: true });
    };

    const openWorkspaceMenu = (edge: "current" | "first" | "last" = "current"): void => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      const trigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      if (!menu || !trigger || !menu.hidden) return;
      menu.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      const items = workspaceMenuItems();
      const current = items.find((item) => item.getAttribute("aria-checked") === "true");
      const target = edge === "last"
        ? items.at(-1)
        : edge === "first"
        ? items[0]
        : current ?? items[0];
      window.requestAnimationFrame(() => target?.focus({ preventScroll: true }));
    };

    const toggleWorkspaceMenu = (): void => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      if (!menu) return;
      if (menu.hidden) openWorkspaceMenu();
      else closeWorkspaceMenu(true);
    };

    const openNewWorkspace = (): void => {
      if (!session || sampleMode) return;
      closeWorkspaceMenu();
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (connect?.dataset.state === "done") {
        pendingWorkspaceCreate = true;
        connect.finishPrompt("back");
        return;
      }
      if (keepConnectCredentialVisible()) return;
      renderCreate(session);
    };

    /**
     * A SAMPLE SWITCH TAKES THE SAME STEPS A REAL ONE DOES, in the composer's terms. It used
     * to set the id and repaint, which is not what `openWorkspace` does and so could not
     * measure the thing a switch breaks. What matters here is the ORDER: the composer is torn
     * down while the old workspace is still current, so its draft is flushed to the right
     * key; then the roster is unknown for a frame, exactly as it is while a real roster
     * request is in flight; then it arrives and the paint after that is the one that may
     * commit the new workspace's pair.
     */
    const openSampleWorkspace = (workspace: Workspace): void => {
      /* A REOPEN IS NOT A SWITCH, and that difference is the whole reason this branch exists.
         `openWorkspace` runs `resetComposer` only when the workspace CHANGES, and then
         advances the generation whatever happened. So the composer has to survive a
         generation bump with nothing torn down: Refresh, retry-workspace and four roster
         edits all reopen the workspace already on screen. A sample open that returned here
         on the same id could not reach that moment, and the defect hiding in it wedged the
         composer for the rest of the session. */
      const reopen = activeWorkspaceId === workspace.id;
      if (!reopen) resetComposer();
      requestVersion += 1;
      activeWorkspaceId = workspace.id;
      agents = [];
      members = [];
      people = new Map();
      signals = [];
      if (!reopen) sampleSignals = [];
      channels = [];
      activeChannelId = null;
      /* A reopen keeps the shell and shows the pending view, exactly as `openWorkspace` does
         when it is already in a channel; a switch paints the new workspace outright. */
      renderChannel(workspace, reopen);
      /* A TIMER, NOT A FRAME. A real roster arrives on a network callback, which is a task;
         hanging it off a frame callback would also make the gap depend on whether anything is
         being painted, and a headless run with no compositor need not produce a frame at all. */
      window.setTimeout(() => {
        if (activeWorkspaceId !== workspace.id) return;
        const at = Date.now();
        applySampleRoster(workspace.id);
        channels = sampleChannelsFor(workspace.id, at);
        /* A REOPEN RE-READS WHAT THE WORKSPACE HOLDS; a switch builds it. The sample has no
           server, so the rows this session posted stand in for what a refetch returns: a
           refresh that rebuilt from the fixture would model a server that forgot the message
           the reader just sent. */
        signals = reopen ? [...sampleSignals] : sampleSignalsFor(workspace.id, at);
        if (!reopen) sampleSignals = [...signals];
        renderChannel(workspace);
      }, 0);
    };

    const renderWorkspaceList = (selected: Workspace): void => {
      const list = one<HTMLElement>("[data-workspace-list]");
      const trigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      const create = one<HTMLButtonElement>("[data-new-workspace]");
      if (trigger) {
        trigger.setAttribute(
          "aria-label",
          `Current workspace: ${selected.name}. Choose workspace`,
        );
        trigger.title = selected.name;
      }
      if (create) create.hidden = sampleMode;
      if (!list) return;
      list.replaceChildren();
      for (const workspace of workspaces) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard__workspace-button";
        button.dataset.workspaceId = workspace.id;
        button.setAttribute("role", "menuitemradio");
        button.setAttribute("aria-checked", String(workspace.id === selected.id));
        const label = document.createElement("span");
        label.textContent = workspace.name;
        const check = document.createElement("span");
        check.className = "dashboard__workspace-check";
        check.textContent = "✓";
        check.setAttribute("aria-hidden", "true");
        button.append(label, check);
        button.addEventListener("click", () => {
          closeWorkspaceMenu(true);
          if (sampleMode) {
            openSampleWorkspace(workspace);
            return;
          }
          void openWorkspace(workspace.id);
        });
        list.append(button);
      }
    };

    /*
     * One roster in memory, three surfaces: rail presence, the header stack summary, and the
     * management dialog. All render here from `agents`, so the surfaces cannot disagree.
     */
    const renderRoster = (): void => {
      const participantList = one<HTMLUListElement>("[data-sidebar-participant-list]");
      if (participantList) {
        renderSidebarParticipants(participantList, members, agents, initials);
      }
      renderHeaderRoster();
      renderDialogRoster();
      /* ONE CALL, AND ORDER STOPPED BEING LOAD-BEARING. There used to be three steps here in
         an order that had to be right: the remembered set, then the draft, then a tag pass.
         Every arrangement of them was wrong in some transition, because they were three
         writers of one pair. The restore below is a transaction and the pass inside it is the
         only writer, so a paint that arrives before the roster changes nothing and a paint
         that arrives after it derives the whole pair at once.

         A LATER PAINT STILL PRUNES. A roster change can revoke an agent a chip names, and a
         chip the send cannot honour is exactly the hidden recipient the To: field exists to
         rule out. That is the second call: the restore is a no-op once its key is marked, and
         the pass then prunes the live set and says so. */
      restoreComposerOnEntry();
      syncComposerAddress();
    };

    /*
     * The header stack is a summary, not a second management surface: up to three uniform
     * circular initials and the live count. The count spans (stack button + dialog title)
     * share one data-hook and one loop, so they cannot drift apart.
     */
    const HEADER_STACK_LIMIT = 3;

    const renderHeaderRoster = (pendingTotal = currentPendingAccessRows().length): void => {
      const wrap = one<HTMLElement>("[data-header-roster]");
      const stack = one<HTMLElement>("[data-header-agent-stack]");
      const button = one<HTMLButtonElement>("[data-roster-open]");
      const summary = one<HTMLElement>("[data-header-roster-summary]");
      const show = agents.length > 0 || pendingTotal > 0;
      if (wrap) wrap.hidden = !show;
      one<HTMLElement>(".dashboard__channel")?.classList.toggle(
        "dashboard__channel--roster",
        show,
      );
      for (const count of all<HTMLElement>("[data-agent-count]")) {
        count.textContent = String(agents.length);
      }
      if (summary) summary.textContent = pendingTotal > 0
        ? `${agents.length} · ${pendingTotal} pending`
        : String(agents.length);
      if (button) {
        button.classList.toggle("dashboard__roster-button--pending", pendingTotal > 0);
        const agentLabel = `${agents.length} ${agents.length === 1 ? "agent" : "agents"}`;
        const pendingLabel = pendingTotal > 0
          ? ` and ${pendingTotal} pending access ${pendingTotal === 1 ? "item" : "items"}`
          : "";
        button.setAttribute(
          "aria-label",
          `${agentLabel}${pendingLabel} — view and manage agents`,
        );
      }
      if (!stack) return;
      stack.replaceChildren();
      for (const agent of agents.slice(0, HEADER_STACK_LIMIT)) {
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        markAgentAvatar(avatar, agent.principalId);
        stack.append(avatar);
      }
    };

    /*
     * The dialog roster is the management list: model, owner, and a permission-aware
     * Remove per row — the same rules the rail roster enforced, unchanged. When a
     * background roster refresh re-renders while the dialog is open, focus parked inside
     * the list is handed back to the same agent's row rather than dropped out of the
     * dialog (a replaced node cannot keep focus, and losing it would strand a keyboard
     * user on <body> behind the modal).
     */
    const renderDialogRoster = (): void => {
      const add = one<HTMLButtonElement>("[data-add-agent-dialog]");
      if (add) add.hidden = sampleMode;
      const list = one<HTMLUListElement>("[data-dialog-agent-list]");
      if (!list) return;
      let refocusPrincipal = "";
      if (
        document.activeElement instanceof HTMLElement &&
        list.contains(document.activeElement)
      ) {
        refocusPrincipal =
          document.activeElement.closest<HTMLElement>("[data-agent-row]")?.dataset
            .agentRow ?? "";
      }
      list.replaceChildren();
      const query = rosterFilter.trim().toLowerCase();
      const visible = query
        ? agents.filter((agent) => agent.name.toLowerCase().includes(query))
        : agents;
      if (visible.length === 0) {
        const empty = document.createElement("li");
        empty.className = "dashboard__agent-empty";
        empty.textContent = query
          ? `No agents match “${rosterFilter.trim()}”.`
          : "No agents yet";
        list.append(empty);
        return;
      }
      const me = members.find((member) => member.userId === session?.user.id);
      for (const agent of visible) {
        const grant = accessStatuses.find(
          (candidate) => candidate.principalId === agent.principalId,
        );
        const row = document.createElement("li");
        row.className = "dashboard__agent";
        row.dataset.agentRow = agent.principalId;
        row.tabIndex = -1;
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        avatar.setAttribute("aria-hidden", "true");
        markAgentAvatar(avatar, agent.principalId);
        const copy = document.createElement("span");
        copy.className = "dashboard__agent-copy";
        const name = document.createElement("strong");
        name.textContent = agent.name;
        const state = document.createElement("span");
        state.textContent =
          `${agent.model ?? "Model not specified"} · owned by ${
            people.get(agent.ownerUserId) ?? "Workspace member"
          }`;
        copy.append(name, state);
        if (grant) {
          const grantLine = document.createElement("span");
          grantLine.className = "dashboard__grant-state";
          grantLine.textContent = grant.grantKind === "standing"
            ? `Standing · last used ${
              grant.lastUsedAt === null
                ? "never"
                : formatTime(grant.lastUsedAt).relative
            }`
            : `Timeboxed · horizon ${
              grant.horizonExpiresAt === null
                ? "not available"
                : formatTime(grant.horizonExpiresAt).relative
            } · last used ${
              grant.lastUsedAt === null
                ? "never"
                : formatTime(grant.lastUsedAt).relative
            }`;
          copy.append(grantLine);
          if (grant.grantKind === "standing") {
            const standingCopy = document.createElement("span");
            standingCopy.className = "dashboard__grant-standing-copy";
            standingCopy.textContent = STANDING_GRANT_COPY;
            copy.append(standingCopy);
          }
          const risk = grantRiskBadge({
            kind: grant.grantKind,
            horizonExpiresAt: grant.horizonExpiresAt,
            boundDeviceId: grant.boundDeviceId,
            lastUsedAt: grant.lastUsedAt,
            issuedAt: grant.issuedAt,
            newHostAt: grant.newHostAt,
            suspendedAt: grant.suspendedAt,
            revokedAt: grant.grantRevokedAt ?? grant.revokedAt,
          });
          if (risk !== null) {
            const badge = document.createElement("span");
            badge.className = "dashboard__grant-risk";
            badge.textContent = risk;
            badge.dataset.grantRisk = risk;
            copy.append(badge);
          }
        }
        row.append(avatar, copy);
        /* A prompt carries a fresh credential for this identity, so it is narrower than
           the management gate: only the person who owns the agent gets this action.
           AgentConnect owns minting, dashboardAgentPrompt, one-time display, and copy. */
        const mayGetPrompt = Boolean(
          me && agent.ownerUserId === me.userId && !sampleMode,
        );
        if (mayGetPrompt) {
          const promptButton = document.createElement("button");
          promptButton.type = "button";
          promptButton.className = "dashboard__text-button";
          promptButton.textContent = "Get prompt";
          promptButton.dataset.getAgentPrompt = agent.principalId;
          promptButton.setAttribute("aria-label", `Get prompt for ${agent.name}`);
          promptButton.addEventListener("click", () => {
            closeRosterDialog();
            openConnect();
            window.requestAnimationFrame(() => {
              one<SecretHoldingAgentConnect>("agent-connect")
                ?.requestPromptFor(agent.principalId);
            });
          });
          row.append(promptButton);
        }
        /* Model is editable under the SAME gate as removal (owner/admin any
           agent, member their own) — the human mirror of the agent's own
           declare. The value is free text and lands in the DOM only as
           textContent; the closed-default glyph mapper owns display. */
        const mayEditModel = Boolean(
          me &&
          (
            me.role === "owner" ||
            me.role === "admin" ||
            agent.ownerUserId === me.userId
          ),
        );
        if (mayEditModel && !sampleMode) {
          const editButton = document.createElement("button");
          editButton.type = "button";
          editButton.className = "dashboard__text-button";
          editButton.textContent = "Edit model";
          editButton.dataset.editModel = agent.principalId;
          editButton.addEventListener("click", () => {
            if (row.querySelector("[data-model-editor]")) return;
            const editor = buildAgentModelEditor(document, {
              agentName: agent.name,
              currentModel: agent.model,
              onCancel: () => editor.remove(),
              onSave: async (model) => {
                if (!session || !activeWorkspaceId) return;
                try {
                  await setAgentModel(
                    session,
                    uuid(),
                    activeWorkspaceId,
                    agent.principalId,
                    model,
                  );
                  /* Same refresh path removal uses: re-open the workspace so
                     the rail glyph, the dialog line, and local state all
                     re-read the one authority instead of a hand-patched copy. */
                  await openWorkspace(activeWorkspaceId);
                } catch (error) {
                  const errorTarget = one<HTMLElement>("[data-agent-error]");
                  if (errorTarget) {
                    errorTarget.textContent = readableError(error);
                    errorTarget.hidden = false;
                  }
                }
              },
            });
            editor.dataset.modelEditor = agent.principalId;
            row.append(editor);
            editor.querySelector("input")?.focus({ preventScroll: true });
          });
          row.append(editButton);
        }
        // Owner/admin any principal; member only own. Clear on the connect
        // prompt only hides the secret — it never revokes.
        const mayRemove = Boolean(
          me &&
          (
            me.role === "owner" ||
            me.role === "admin" ||
            agent.ownerUserId === me.userId
          ),
        );
        if (
          mayRemove &&
          !sampleMode &&
          grant &&
          grant.grantRevokedAt === null &&
          grant.revokedAt === null
        ) {
          const revokeButton = document.createElement("button");
          revokeButton.type = "button";
          revokeButton.className = "dashboard__text-button";
          revokeButton.textContent = "Revoke grant";
          revokeButton.dataset.revokeGrant = grant.grantId;
          revokeButton.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (!window.confirm(`Revoke ${agent.name}’s renewal grant? The agent will stop when its current bearer expires.`)) return;
            revokeButton.disabled = true;
            try {
              await revokeAgentToken(
                session,
                uuid(),
                activeWorkspaceId,
                grant.tokenId,
              );
              await openWorkspace(activeWorkspaceId);
            } catch (error) {
              const errorTarget = one<HTMLElement>("[data-agent-error]");
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              revokeButton.disabled = false;
            }
          });
          row.append(revokeButton);
        }
        if (mayRemove && !sampleMode) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Remove";
          button.dataset.removeAgent = agent.principalId;
          button.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (
              !window.confirm(
                `Remove ${agent.name}? This ends its identity and every live credential in this workspace. Clearing a Copy prompt only hides the secret — it does not remove the agent.`,
              )
            ) return;
            const errorTarget = one<HTMLElement>("[data-agent-error]");
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            button.disabled = true;
            try {
              await revokeAgentPrincipal(
                session,
                uuid(),
                activeWorkspaceId,
                agent.principalId,
              );
              if (livePromptPrincipalId === agent.principalId) {
                one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
                livePromptPrincipalId = "";
              }
              await openWorkspace(activeWorkspaceId);
              /* The reload closed the dialog; hand focus to the control that reopens
                 it, or to the empty channel's Add door when that was the last agent. */
              const door = agents.length > 0
                ? one<HTMLButtonElement>("[data-roster-open]")
                : one<HTMLButtonElement>("[data-add-agent]");
              door?.focus({ preventScroll: true });
            } catch (error) {
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          row.append(button);
        }
        list.append(row);
      }
      if (refocusPrincipal) {
        const row = list.querySelector<HTMLElement>(
          `[data-agent-row="${refocusPrincipal}"]`,
        );
        const target = row?.querySelector<HTMLButtonElement>("button") ?? row;
        target?.focus({ preventScroll: true });
      }
    };

    /*
     * Opening resets the filter so every session starts from the full roster. Initial
     * focus goes to Add an agent — the first visible primary action — or, when sample
     * mode hides that door, to the filter. Escape, modal focus containment, and focus
     * restore on close are the native <dialog>'s; the close event re-syncs the stack
     * button's aria-expanded no matter which path closed it.
     */
    const openRosterDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      if (!dialog || dialog.open) return;
      rosterFilter = "";
      const search = one<HTMLInputElement>("[data-roster-search]");
      if (search) search.value = "";
      renderDialogRoster();
      dialog.showModal();
      const add = one<HTMLButtonElement>("[data-add-agent-dialog]");
      const firstStop = add && !add.hidden ? add : search;
      window.requestAnimationFrame(() => firstStop?.focus({ preventScroll: true }));
      one<HTMLButtonElement>("[data-roster-open]")?.setAttribute("aria-expanded", "true");
    };

    const closeRosterDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      if (dialog?.open) dialog.close();
    };

    const openWorkspaceDetailsDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-workspace-details-popover]");
      if (!dialog || dialog.open) return;
      dialog.showModal();
      one<HTMLButtonElement>("[data-workspace-details-trigger]")
        ?.setAttribute("aria-expanded", "true");
    };

    const closeWorkspaceDetailsDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-workspace-details-popover]");
      if (dialog?.open) dialog.close();
    };

    const formatTime = (value: string): { relative: string; absolute: string } => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return { relative: "Time unavailable", absolute: "" };
      const seconds = Math.round((date.getTime() - Date.now()) / 1_000);
      const ranges: Array<[number, Intl.RelativeTimeFormatUnit]> = [
        [60, "second"],
        [60, "minute"],
        [24, "hour"],
        [7, "day"],
        [4.345, "week"],
        [12, "month"],
        [Number.POSITIVE_INFINITY, "year"],
      ];
      let amount = seconds;
      let unit: Intl.RelativeTimeFormatUnit = "second";
      for (const [range, next] of ranges) {
        unit = next;
        if (Math.abs(amount) < range) break;
        amount /= range;
      }
      return {
        relative: new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(
          Math.round(amount),
          unit,
        ),
        absolute: new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(date),
      };
    };

    const workspaceFileUploaderName = (file: WorkspaceFile): string =>
      file.uploadedByKind === "agent"
        ? agents.find((agent) => agent.principalId === file.uploadedBy)?.name ?? "Former agent"
        : people.get(file.uploadedBy) ?? "Former member";

    const renderFiles = (): void => {
      const list = one<HTMLUListElement>("[data-file-list]");
      const empty = one<HTMLElement>("[data-file-empty]");
      const warning = one<HTMLElement>("[data-file-warning]");
      const error = one<HTMLElement>("[data-file-error]");
      if (!list || !empty || !warning) return;
      const rows: DisplayFile[] = files.map((file) => ({
        ...file,
        uploaderName: workspaceFileUploaderName(file),
      }));
      renderFileList(
        { list, empty, warning },
        rows,
        {
          contentWarning: FILE_CONTENT_WARNING,
          download: async (file) => {
            if (!session || !activeWorkspaceId) throw new SessionExpired();
            const workspaceId = activeWorkspaceId;
            const version = requestVersion;
            const result = await fileDownloadUrl(
              session,
              uuid(),
              workspaceId,
              file.fileId,
              file.currentVersion,
            );
            if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
            window.location.assign(result.url);
          },
        },
      );
      if (error) {
        error.textContent = fileLoadError;
        error.hidden = fileLoadError.length === 0;
      }
      if (fileLoadError) {
        list.hidden = true;
        empty.hidden = true;
        warning.hidden = true;
      }
    };

    const brainViewTargets = (): BrainViewTargets | null => {
      const list = one<HTMLUListElement>("[data-brain-list]");
      const empty = one<HTMLElement>("[data-brain-empty]");
      const detail = one<HTMLElement>("[data-brain-detail]");
      const title = one<HTMLElement>("[data-brain-title]");
      const meta = one<HTMLElement>("[data-brain-meta]");
      const bodyMode = one<HTMLElement>("[data-brain-body-mode]");
      const markdown = one<HTMLElement>("[data-brain-markdown]");
      const raw = one<HTMLElement>("[data-brain-raw]");
      const rawToggle = one<HTMLButtonElement>("[data-brain-raw-toggle]");
      const error = one<HTMLElement>("[data-brain-error]");
      const edit = one<HTMLButtonElement>("[data-brain-edit]");
      const form = one<HTMLFormElement>("[data-brain-form]");
      const textarea = one<HTMLTextAreaElement>("[data-brain-textarea]");
      const save = one<HTMLButtonElement>("[data-brain-save]");
      const cancel = one<HTMLButtonElement>("[data-brain-cancel]");
      const status = one<HTMLElement>("[data-brain-status]");
      const history = one<HTMLDetailsElement>("[data-brain-history]");
      const historyList = one<HTMLUListElement>("[data-brain-history-list]");
      if (
        !list || !empty || !detail || !title || !meta || !bodyMode || !markdown ||
        !raw || !rawToggle || !error ||
        !edit || !form || !textarea || !save || !cancel || !status || !history ||
        !historyList
      ) return null;
      return {
        list, empty, detail, title, meta, bodyMode, markdown, raw, rawToggle,
        error, edit, form, textarea, save, cancel, status, history, historyList,
      };
    };

    const renderBrain = (): void => {
      if (!brainView) {
        const targets = brainViewTargets();
        if (!targets) return;
        brainView = createBrainView(targets, {
          read: async (topic, version) => {
            if (!session || !activeWorkspaceId) throw new SessionExpired();
            const grant = await fileDownloadUrl(
              session,
              uuid(),
              activeWorkspaceId,
              topic.fileId,
              version,
            );
            const response = await fetch(grant.url);
            if (!response.ok) {
              throw new Error(`Topic download failed (HTTP ${response.status}).`);
            }
            return await response.text();
          },
          save: async (topic, markdown) => {
            if (!session || !activeWorkspaceId) throw new SessionExpired();
            const workspaceId = activeWorkspaceId;
            const version = requestVersion;
            const intent = prepareBrowserAttachments([
              new File([markdown], topic.name, { type: "text/markdown" }),
            ])[0];
            if (!intent) throw new Error("The topic upload could not be prepared.");
            const committed = await uploadBrowserAttachment(
              session,
              workspaceId,
              intent,
            );
            if (version !== requestVersion || workspaceId !== activeWorkspaceId) {
              throw new BrainSaveCompletedElsewhere(topic.topic, committed.version_n);
            }
            const updatedFile: WorkspaceFile = {
              ...topic,
              fileId: committed.file_id,
              currentVersion: committed.version_n,
              sizeBytes: new Blob([markdown]).size,
              uploadedByKind: "user",
              uploadedBy: session.user.id,
              committedAt: new Date().toISOString(),
              tombstonedAt: null,
            };
            files = files
              .filter((file) => file.fileId !== topic.fileId)
              .concat(updatedFile)
              .sort((left, right) => left.name.localeCompare(right.name));
            renderFiles();
            return {
              ...updatedFile,
              topic: topic.topic,
              updaterName: people.get(session.user.id) ?? accountName(session),
            } satisfies BrainTopic;
          },
        });
        /* Inside the one-time init: renderBrain runs on every render, and binding here each
           time would stack a listener per render. The list is replaced by replaceChildren, so
           the listener is delegated on the container that survives. */
        one<HTMLElement>("[data-brain-list]")?.addEventListener(
          "click",
          () => setBrainNotice(""),
        );
      }
      brainView.setTopics(brainTopics(files, workspaceFileUploaderName));
      const empty = one<HTMLElement>("[data-brain-empty]");
      if (empty && fileLoadError) {
        empty.textContent = fileLoadError;
        empty.classList.add("dashboard__form-error");
        empty.hidden = false;
      } else {
        empty?.classList.remove("dashboard__form-error");
      }
    };

    /* The topics the Brain panel can open, from the same brainTopics() the panel itself lists. */
    const brainTopicNames = (): string[] =>
      brainTopics(files, () => "").map((topic) => topic.topic);

    /*
     * `files` IS A SNAPSHOT. workspaceFiles() runs only when a workspace opens; loadSignals,
     * renderFeed and refreshLatestSignals never touch it. A review arm found what that costs the
     * feed's brain links, and both halves were real:
     *
     *   - a topic created after load never linkified, because the snapshot could not grow;
     *   - a topic DELETED after load kept its control, and the click failed inside the download
     *     with "The topic could not be loaded" -- a dead control.
     *
     * Two things fix it. A bounded re-read while the reader is on the feed keeps the rendered
     * controls close to the truth, at one request per BRAIN_TOPIC_REFRESH_MS rather than at the
     * 2-second signal cadence. The CLICK re-reads first and is authoritative: whatever is on
     * screen, a control can only open a topic the workspace holds at the moment it is clicked.
     */
    const BRAIN_TOPIC_REFRESH_MS = 30_000;

    /*
     * One read. Resolves TRUE only when it replaced `files` for the workspace that is active NOW.
     * Every early return resolves FALSE, because "I did not read" and "the list is current" are
     * different facts: a review arm found the first version resolving on a workspace switch and
     * the reader calling that fresh, which authorized a click against the previous workspace.
     */
    const readBrainTopics = async (): Promise<boolean> => {
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      const next = await workspaceFiles(workspaceId);
      if (version !== requestVersion || workspaceId !== activeWorkspaceId) return false;
      const before = brainTopicNames().join("\n");
      files = next;
      fileLoadError = "";
      if (brainTopicNames().join("\n") === before) return true;
      /*
       * ONLY the feed. The feed is what carries the links, so it has to be rebuilt here.
       *
       * The Files and Brain panels deliberately are NOT. An earlier revision rebuilt whichever of
       * them was on screen, which is the opposite of what its own comment promised and is the one
       * case that can cost a reader something: renderFileList calls replaceChildren, so a rebuild
       * throws away focus, and brainView.setTopics can close a pane that is holding unsaved edits
       * when that topic's file changed underneath. Both panels are rebuilt by
       * activateWorkspaceView when a reader enters them, and openBrainTopic rebuilds Brain itself
       * after its own read, so nothing needs a background rebuild to stay correct.
       */
      if (!addAgentViewOpen() && ["feed", "feed-empty"].includes(app.dataset.channelView ?? "")) {
        renderFeed();
      }
      return true;
    };

    const brainTopicReader = createBrainTopicReader({
      read: async () => {
        /* Nothing to read against, so nothing is established: not fresh. */
        if (sampleMode || !activeWorkspaceId) return false;
        return await readBrainTopics();
      },
      staleAfterMs: BRAIN_TOPIC_REFRESH_MS,
    });

    const refreshBrainTopics = (force: boolean): Promise<boolean> =>
      brainTopicReader.refresh(force);

    const setBrainNotice = (message: string): void => {
      const notice = one<HTMLElement>("[data-brain-notice]");
      if (!notice) return;
      notice.textContent = message;
      notice.hidden = message.length === 0;
    };

    /*
     * Show the panel first so the click feels answered, then re-read and check. Failing inside
     * the download is what this replaces: if the topic is gone, the panel says so in the words a
     * reader needs and leaves them on the current list.
     */
    const openBrainTopic = async (topic: string): Promise<void> => {
      /* Captured BEFORE the await, compared after, exactly like every other continuation in this
       * file. This was the one that had neither, and a review arm walked the consequence: a click
       * in workspace A, a switch to B while the read was in flight, and the forced read then ran
       * against B and APPLIED -- so the list was fresh, the names were B's, and B's copy of the
       * slug opened for a click the reader never made there. */
      const version = requestVersion;
      const workspaceId = activeWorkspaceId;
      activateWorkspaceView("brain");
      setBrainNotice("");
      const listIsFresh = await refreshBrainTopics(true);
      const outcome = brainLinkClickOutcome(
        topic,
        brainTopicNames(),
        listIsFresh,
        version === requestVersion && workspaceId === activeWorkspaceId,
      );
      /* Nothing rendered, nothing opened, no notice: the workspace the reader is now on owes
       * them nothing about a click made somewhere else. */
      if (outcome.kind === "abandoned") return;
      /* The read does not rebuild this panel -- background reads rebuild nothing but the feed --
         so the list the reader is looking at is refreshed here, where it is on screen. */
      renderBrain();
      if (outcome.kind === "missing") {
        setBrainNotice(outcome.message);
        return;
      }
      void brainView?.open(outcome.topic);
    };

    const kindLabel = (kind: string): string => {
      if (kind === "working-on") return "Working on";
      if (kind === "ask") return "Question";
      if (kind === "note") return "Note";
      return "Update";
    };

    const renderSignalCounts = (): void => {
      const { broadcastCount, directCount } = signalCounts(signals);
      const broadcastTarget = one<HTMLElement>("[data-broadcast-count]");
      const directTarget = one<HTMLElement>("[data-direct-count]");
      if (broadcastTarget) broadcastTarget.textContent = String(broadcastCount);
      if (directTarget) directTarget.textContent = String(directCount);
    };

    const appendDeliveryReceipt = (
      body: HTMLElement,
      signal: Signal,
    ): void => {
      const cached = deliveryReceiptCache.get(signal.id);
      const recipient: ComposerAudience = signal.toAgent !== null
        ? { kind: "agent", id: signal.toAgent }
        : signal.to !== null
        ? { kind: "person", id: signal.to }
        : { kind: "everyone" };
      const receiptContext = {
        signalKind: signal.kind === "note" ? "note" as const : "ask" as const,
        ...(signal.toAgent === null
          ? {}
          : {
            agentName: agents.find((agent) => agent.principalId === signal.toAgent)?.name ??
              signal.toAgent,
          }),
      };
      const indicator: BrowserDeliveryIndicator = cached?.phase === "posting"
        ? browserPostingDeliveryIndicator()
        : cached?.phase === "accepted"
        ? browserAcceptedDeliveryIndicator(recipient)
        : signal.to !== null && signal.toAgent === null
        ? browserHumanDeliveryIndicator(signal.to, cached?.result ?? null)
        : signal.toAgent === null
        ? browserDeliveryIndicator(
          cached?.result ?? { addressed: false, receipts: [] },
        )
        : browserDeliveryIndicator(cached?.result ?? null, Date.now(), receiptContext);
      const details = document.createElement("details");
      details.className = "dashboard__message-receipt";
      details.dataset.receiptState = indicator.state;
      if (indicator.outcome !== null) details.dataset.receiptOutcome = indicator.outcome;
      const summary = document.createElement("summary");
      summary.title = indicator.detail;
      summary.setAttribute(
        "aria-label",
        `Delivery status: ${indicator.label}. ${indicator.detail}`,
      );
      const glyph = document.createElement("span");
      glyph.className = "dashboard__message-receipt-glyph";
      glyph.setAttribute("aria-hidden", "true");
      glyph.textContent = indicator.glyph;
      const label = document.createElement("span");
      label.textContent = indicator.label;
      summary.append(glyph, label);
      const detail = document.createElement("p");
      detail.textContent = indicator.detail;
      details.append(summary, detail);
      /* `hidden` is the section's remainder from the server's uncapped totals.
       * A cut section must not read "None": with 100 members and 60 seen the
       * capped list is 50 seen and 0 not-seen, and "None" under Not-seen would
       * be false. browserRosterSectionLines owns that decision. */
      const appendRosterSection = (
        title: string,
        rows: readonly string[],
        hidden: number,
      ): void => {
        const section = document.createElement("section");
        section.className = "dashboard__message-receipt-section";
        const heading = document.createElement("h4");
        heading.textContent = title;
        const list = document.createElement("ul");
        for (const text of browserRosterSectionLines(rows, hidden)) {
          const item = document.createElement("li");
          item.textContent = text;
          list.append(item);
        }
        section.append(heading, list);
        details.append(section);
      };
      const broadcastResult: BrowserDeliveryReceiptResult | null =
        signal.to === null && signal.toAgent === null && cached?.result?.addressed === false
          ? cached.result
          : null;
      if (broadcastResult?.broadcastRoster) {
        const roster = browserBroadcastRosterView(broadcastResult);
        appendRosterSection(
          "Seen members",
          roster.seenMembers.map((receipt) => {
            const seen = formatTime(receipt.seenAt!);
            return `${receipt.displayName ?? people.get(receipt.recipientUserId) ?? receipt.recipientUserId} · ${seen.relative}`;
          }),
          roster.seenHidden,
        );
        appendRosterSection(
          "Not-seen members",
          roster.notSeenMembers.map((receipt) =>
            receipt.displayName ?? people.get(receipt.recipientUserId) ?? receipt.recipientUserId
          ),
          roster.notSeenHidden,
        );
        appendRosterSection(
          `Seen agents · ${broadcastResult.broadcastRoster.agents.seen} of ${broadcastResult.broadcastRoster.agents.total}`,
          roster.seenAgents.map((receipt) => {
            const seen = formatTime(receipt.seenAt!);
            return `${receipt.displayName} · ${seen.relative}`;
          }),
          roster.seenAgentsHidden,
        );
        appendRosterSection(
          "Not-seen agents",
          roster.notSeenAgents.map((receipt) =>
            `${receipt.displayName} · not yet seen`
          ),
          roster.notSeenAgentsHidden,
        );
        if (
          broadcastResult.broadcastRoster.members.truncated ||
          broadcastResult.broadcastRoster.agents.truncated
        ) {
          const cut = document.createElement("p");
          cut.className = "dashboard__message-receipt-cut";
          const parts = [
            broadcastResult.broadcastRoster.members.truncated
              ? `Showing ${broadcastResult.broadcastRoster.members.returned} of ${broadcastResult.broadcastRoster.members.total} members.`
              : null,
            broadcastResult.broadcastRoster.agents.truncated
              ? `Showing ${broadcastResult.broadcastRoster.agents.returned} of ${broadcastResult.broadcastRoster.agents.total} agents.`
              : null,
          ].filter((part): part is string => part !== null);
          cut.textContent = parts.join(" ");
          details.append(cut);
        }
      }
      body.append(details);
    };

    /* ── transcript scroll behaviour ─────────────────────────────────────────────────────────
     * Three things a chat transcript must do, none of which it did:
     *   1. open at the NEWEST message, not the top of history;
     *   2. stay pinned to the bottom while you are already at the bottom, and NOT yank you down
     *      when you have scrolled up to read;
     *   3. load older messages as you approach the top, WITHOUT the viewport jumping.
     *
     * (3) is the one that is easy to get wrong and horrible when wrong: prepending rows above the
     * viewport moves everything down by their height. The fix is to measure scrollHeight before
     * the insert and add the difference back to scrollTop after it, so the row you were reading
     * stays under your eye. */
    const feedScroller = (): HTMLElement | null =>
      one<HTMLElement>(".dashboard__feed-view");

    const observeHumanSeenRows = (): void => {
      humanSeenReporter.resetVisible();
      humanSeenObserver?.disconnect();
      if (sampleMode || !session || !("IntersectionObserver" in window)) return;
      if (humanSeenObserver === null) {
        humanSeenObserver = new IntersectionObserver((entries) => {
          humanSeenReporter.intersections(entries.map((entry) => {
            const row = entry.target as HTMLElement;
            return {
              scope: row.dataset.humanSeenScope ?? "",
              signalId: row.dataset.humanSeenSignalId ?? "",
              isIntersecting: entry.isIntersecting && entry.intersectionRatio > 0,
            };
          }).filter((entry) => entry.scope !== "" && entry.signalId !== ""));
        }, {
          root: feedScroller(),
          threshold: 0.01,
        });
      }
      for (const row of all<HTMLElement>("[data-human-seen-signal-id]")) {
        humanSeenObserver.observe(row);
      }
    };

    /* Within this many px of the bottom counts as "at the bottom". Not zero: sub-pixel layout and
     * a mid-scroll render both leave a small remainder, and demanding exact equality means the
     * pin silently stops working. */
    const NEAR_BOTTOM_PX = 64;

    const atBottom = (): boolean => {
      const el = feedScroller();
      if (!el) return true;
      return el.scrollHeight - el.scrollTop - el.clientHeight <= NEAR_BOTTOM_PX;
    };

    const scrollToNewest = (): void => {
      const el = feedScroller();
      if (el) el.scrollTop = el.scrollHeight;
    };

    const attachmentKey = (fileId: string, version: number): string =>
      `${fileId}:${version}`;

    const freshAttachmentDownload = async (
      fileId: string,
      version: number,
    ): Promise<string> => {
      if (!session || !activeWorkspaceId) throw new SessionExpired();
      return (await fileDownloadUrl(
        session,
        uuid(),
        activeWorkspaceId,
        fileId,
        version,
      )).url;
    };

    const renderMessageAttachments = (body: HTMLElement, signal: Signal): void => {
      const attachments = signal.attachments ?? [];
      if (attachments.length === 0) return;
      const list = document.createElement("div");
      list.className = "dashboard__message-attachments";
      list.dataset.messageAttachments = String(attachments.length);
      for (const attachment of attachments) {
        const card = document.createElement("article");
        const inlineImage = /^(image\/(png|jpeg|gif|webp))$/.test(attachment.content_type);
        card.className = `dashboard__attachment-card${
          inlineImage ? " dashboard__attachment-card--image" : ""
        }`;
        card.dataset.attachmentKind = inlineImage ? "image" : "file";
        if (inlineImage) {
          const image = document.createElement("img");
          image.alt = attachment.name;
          image.loading = "lazy";
          const key = attachmentKey(attachment.file_id, attachment.version_n);
          const cachedUrl = attachmentObjectUrls.get(key);
          const load = async (): Promise<void> => {
            if (image.src) return;
            try {
              const signedUrl = await freshAttachmentDownload(
                attachment.file_id,
                attachment.version_n,
              );
              const response = await fetch(signedUrl);
              if (!response.ok) throw new Error(`HTTP ${response.status}`);
              const objectUrl = URL.createObjectURL(await response.blob());
              attachmentObjectUrls.set(key, objectUrl);
              if (image.isConnected) image.src = objectUrl;
            } catch {
              image.alt = `${attachment.name} preview unavailable`;
              card.dataset.previewState = "unavailable";
            }
          };
          if (cachedUrl) {
            image.src = cachedUrl;
          } else if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver((entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              observer.disconnect();
              void load();
            }, { root: feedScroller(), rootMargin: "120px" });
            observer.observe(card);
          } else {
            void load();
          }
          card.append(image);
        }
        const details = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = attachment.name;
        const metadata = document.createElement("span");
        metadata.textContent = `${formatAttachmentSize(attachment.size_bytes)} · ${attachment.content_type}`;
        const download = document.createElement("button");
        download.type = "button";
        download.className = "dashboard__attachment-download";
        download.textContent = "Download";
        download.addEventListener("click", async () => {
          download.disabled = true;
          const oldLabel = download.textContent;
          download.textContent = "Getting link…";
          try {
            window.location.assign(await freshAttachmentDownload(
              attachment.file_id,
              attachment.version_n,
            ));
          } catch (error) {
            setComposerStatus(readableError(error), "error");
          } finally {
            download.disabled = false;
            download.textContent = oldLabel;
          }
        });
        details.append(name, metadata, download);
        card.append(details);
        list.append(card);
      }
      body.append(list);
    };

    /**
     * A `?c=` that names no channel this reader can see. The loaded rows are the WHOLE
     * workspace's, because a channel that cannot be resolved cannot narrow the query, so
     * rendering them under that channel's name is the exact failure this state exists to
     * prevent: the reader would believe they were looking at the channel.
     *
     * It lives outside renderFeed so renderFeed's own reader-scroll order — measure, then
     * replaceChildren — is not interrupted by a branch that empties the list first.
     */
    const renderUnknownChannel = (): void => {
      const count = one<HTMLElement>("[data-update-count]");
      const more = one<HTMLElement>("[data-feed-more]");
      if (count) count.hidden = true;
      if (more) more.hidden = true;
      const list = one<HTMLOListElement>("[data-feed-list]");
      if (list) {
        list.replaceChildren();
        const row = document.createElement("li");
        row.className = "dashboard__filter-empty";
        row.textContent = unknownChannelText(channelListFailed);
        const open = document.createElement("button");
        open.type = "button";
        open.className = "dashboard__text-button";
        open.textContent = `Open ${channelLabel(ALL_SIGNALS_SLUG)}`;
        open.addEventListener("click", () => selectChannel(null));
        row.append(" ", open);
        list.append(row);
      }
      showChannelView("feed");
    };

    const renderFeed = (change: "history" | "latest" = "history"): void => {
      window.clearTimeout(signalExpiryTimer);
      signalExpiryTimer = undefined;
      if (addAgentViewOpen()) return;
      if (unknownChannelId !== null) {
        renderUnknownChannel();
        return;
      }
      const now = Date.now();
      signals = signals.filter(
        (signal) => signal.until === null || new Date(signal.until).getTime() > now,
      );
      const nextExpiry = signals.reduce<number | null>((nearest, signal) => {
        if (signal.until === null) return nearest;
        const expiresAt = new Date(signal.until).getTime();
        if (!Number.isFinite(expiresAt) || expiresAt <= now) return nearest;
        return nearest === null || expiresAt < nearest ? expiresAt : nearest;
      }, null);
      if (nextExpiry !== null) {
        signalExpiryTimer = window.setTimeout(
          renderFeed,
          Math.min(Math.max(nextExpiry - now + 25, 25), 2_147_483_647),
        );
      }
      /* THE REPLY BAR TICKS WITH THE FEED. Its window line is a relative time and a live
         eligibility, and both go stale the moment they are written: the design requires the
         ceiling on screen precisely because it can be milliseconds, so a line written once when
         the bar opened would be the failure the requirement exists to prevent.

         WHAT IT MAY TOUCH, stated exactly. It writes the bar's text and the placeholder, and it
         clears ONE control: a ticked broadcast box whose control is no longer offered.
         ~~"writes text and decides nothing"~~ was wrong about that box, and a review arm said
         so. Clearing it is the honest write — the control is gone from the screen, so the state
         behind it must go too, or the send would carry a flag the reader can no longer see. It
         touches nothing else: not the reply, not the To: pair, not the intent. */
      syncComposerPlacement();
      /* Captured BEFORE the list is rebuilt: once replaceChildren has run, the old scroll
       * geometry is gone and neither question can be answered. */
      const wasAtBottom = atBottom();
      const scrollerBefore = feedScroller();
      const heightBefore = scrollerBefore?.scrollHeight ?? 0;
      const topBefore = scrollerBefore?.scrollTop ?? 0;
      const list = one<HTMLOListElement>("[data-feed-list]");
      const count = one<HTMLElement>("[data-update-count]");
      const more = one<HTMLElement>("[data-feed-more]");
      renderSignalCounts();
      if (count) {
        count.textContent = `${signals.length}${signalHasMore ? "+" : ""} ${
          signals.length === 1 && !signalHasMore ? "update" : "updates"
        }`;
        count.hidden = signals.length === 0;
      }
      if (more) more.hidden = !signalHasMore;
      if (!list) return;
      list.replaceChildren();
      if (signals.length === 0) {
        humanSeenReporter.resetVisible();
        humanSeenObserver?.disconnect();
        const emptyTitle = one<HTMLElement>("[data-feed-empty-title]");
        const emptyDetail = one<HTMLElement>("[data-feed-empty-detail]");
        const channel = activeChannel();
        if (emptyTitle) {
          emptyTitle.textContent = channel !== null
            ? `Nothing in ${channelLabel(channel.slug)} yet.`
            : agents.length === 1
            ? `Waiting for ${agents[0]!.name}’s first update.`
            : "Waiting for your agents’ first updates.";
        }
        if (emptyDetail) {
          /* A channel is empty on the day it is made and can never be filled from the
             past: a signal row is immutable, so nothing written before the channel
             existed moves into it. Say that here, where the reader meets it. */
          emptyDetail.textContent = channel !== null
            ? CHANNEL_EMPTY_TEXT
            : "As soon as an agent starts something, asks a question, or leaves a note, it lands here. Nothing for you to do meanwhile.";
        }
        previousSignalIds.clear();
        feedWasEmpty = true;
        showChannelView("feed-empty");
        focusComposerOnEntry();
        return;
      }
      const agentById = new Map(agents.map((agent) => [agent.principalId, agent]));
      const viewerId = session?.user.id ?? (sampleMode ? "sample-owner" : "");
      const visibleSignals = filterSignals(signals, signalFilter, viewerId);
      for (const button of all<HTMLButtonElement>("[data-feed-filter]")) {
        const active = button.dataset.feedFilter === signalFilter;
        button.setAttribute("aria-pressed", String(active));
      }
      if (visibleSignals.length === 0) {
        const empty = document.createElement("li");
        empty.className = "dashboard__filter-empty";
        empty.textContent = signalFilter === "broadcast"
          ? "No broadcasts in the loaded signals."
          : "No loaded signals are directed to you.";
        list.append(empty);
      }
      /* OLDEST FIRST ON SCREEN, newest at the bottom — the shape of every chat client, and what
       * the transcript did NOT do: rows appeared newest-first.
       *
       * The reversal belongs HERE and not in the query. The fetch is deliberately
       * `.order(created_at, desc)` because the cursor pages BACKWARDS through history with
       * `created_at.lt`; flipping the query to ascending would fetch the OLDEST 25 on first paint
       * and break every "load older" page after it. So the array stays newest-first for
       * pagination and is reversed once, for display. */
      /* ONE ROW BUILDER for a thread root and for a reply alike. A reply is built into the
         thread's own list rather than into the feed, and two copies of a hundred and fifty
         lines of row would have drifted the first time either changed. */
      const buildMessageRow = (signal: Signal, isReply: boolean): HTMLLIElement => {
        const row = document.createElement("li");
        row.className = isReply
          ? "dashboard__message dashboard__message--reply"
          : "dashboard__message";
        row.dataset.signalId = signal.id;
        if (
          !sampleMode && session && activeWorkspaceId &&
          signal.toAgent === null &&
          (signal.to === null || signal.to === session.user.id)
        ) {
          row.dataset.humanSeenScope = `${session.user.id}:${activeWorkspaceId}`;
          row.dataset.humanSeenSignalId = signal.id;
        }
        if ((feedWasEmpty || previousSignalIds.size > 0) && !previousSignalIds.has(signal.id)) {
          row.classList.add("dashboard__message--fresh");
        }
        const authorAgent = agentById.get(signal.from);
        const targetAgent = signal.toAgent === null
          ? undefined
          : agentById.get(signal.toAgent);
        /* ~~`|| signal.to === session?.user.id`~~ Dead 2026-09-01: viewerId IS
         * session.user.id whenever a session exists, so the clause repeated the
         * call and left the function non-load-bearing for the tint. One rule,
         * one place: signal-feed.ts decides what "direct to you" means. */
        if (signalIsDirectToViewer(signal, viewerId)) {
          row.classList.add("dashboard__message--direct-to-viewer");
        }
        const authorName = authorAgent?.name ??
          people.get(signal.from) ??
          (signal.fromKind === "user" ? "Team member" : "Unknown agent");
        const avatar = document.createElement("span");
        avatar.className = "dashboard__message-avatar";
        avatar.textContent = initials(authorName);
        avatar.setAttribute("aria-hidden", "true");
        if (authorAgent) markAgentAvatar(avatar, authorAgent.principalId);

        const body = document.createElement("article");
        body.className = "dashboard__message-body";
        const meta = document.createElement("header");
        meta.className = "dashboard__message-meta";
        const author = document.createElement("strong");
        const authorEntity = authorAgent
          ? { kind: "agent" as const, id: authorAgent.principalId }
          : signal.fromKind === "user" && people.has(signal.from)
          ? { kind: "person" as const, id: signal.from }
          : null;
        if (authorEntity) {
          author.append(entityControl(
            authorName,
            authorEntity,
            "dashboard__message-entity dashboard__message-author",
          ));
        } else {
          author.textContent = authorName;
        }
        const identityBadge = document.createElement("span");
        identityBadge.className = "dashboard__message-identity-badge";
        identityBadge.textContent = signal.fromKind === "user" ? "PERSON" : "AGENT";
        const target = document.createElement("span");
        target.className = "dashboard__message-target";
        target.append("→ ");
        if (signal.toAgent !== null && targetAgent) {
          target.append(entityControl(
            targetAgent.name,
            { kind: "agent", id: targetAgent.principalId },
            "dashboard__message-entity",
          ));
        } else if (signal.to !== null && people.has(signal.to)) {
          target.append(entityControl(
            people.get(signal.to)!,
            { kind: "person", id: signal.to },
            "dashboard__message-entity",
          ));
        } else {
          target.append(
            signal.toAgent !== null
              ? "an agent"
              : signal.to !== null
              ? "a workspace member"
              : "everyone",
          );
        }
        const operator = document.createElement("span");
        operator.className = "dashboard__message-operator";
        if (authorAgent) {
          operator.append(`${authorAgent.model ?? "Model not specified"} · operated by `);
          const ownerName = people.get(authorAgent.ownerUserId);
          if (ownerName) {
            operator.append(entityControl(
              ownerName,
              { kind: "person", id: authorAgent.ownerUserId },
              "dashboard__message-entity",
            ));
          } else {
            operator.append("Workspace member");
          }
        } else {
          operator.textContent = signal.fromKind === "user" ? "Workspace member" : "AI agent";
        }
        const badge = document.createElement("span");
        badge.className = `dashboard__message-kind dashboard__message-kind--${signal.kind}`;
        badge.textContent = kindLabel(signal.kind);
        const time = document.createElement("time");
        const formatted = formatTime(signal.createdAt);
        time.dateTime = signal.createdAt;
        time.title = formatted.absolute;
        time.textContent = formatted.relative;
        /* The channel the message is IN, named on the row. all-signals shows every
           message, filed and unfiled together, so without this a reader cannot tell one
           from the other. Inside a channel every row is in that channel and the name would
           be repeated on every line, so it is not shown there. An unfiled message shows
           nothing rather than a word for "no channel": it is the ordinary case. */
        const rowChannel = activeChannelId === null && signal.channelId !== null
          ? channelById(channels, signal.channelId)
          : null;
        if (rowChannel !== null) {
          const place = document.createElement("button");
          place.type = "button";
          place.className = "dashboard__message-channel";
          place.textContent = channelLabel(rowChannel.slug);
          place.title = `Open ${channelLabel(rowChannel.slug)}`;
          place.addEventListener("click", () => selectChannel(rowChannel.channelId));
          meta.append(author, identityBadge, target, operator, badge, place, time);
        } else {
          meta.append(author, identityBadge, target, operator, badge, time);
        }
        body.append(meta);
        const mentions = visualMentions.get(signal.id) ?? [];
        if (mentions.length > 0) {
          const mentionRow = document.createElement("div");
          mentionRow.className = "dashboard__message-mentions";
          for (const mention of mentions) {
            mentionRow.append(entityControl(
              `@${entityName(mention)}`,
              mention,
              "dashboard__mention-chip dashboard__message-mention",
            ), " ");
          }
          body.append(mentionRow);
        }
        const markdown = document.createElement("div");
        markdown.className = "dashboard__message-markdown";
        /* The line count only. The stylesheet multiplies it by --lh-base, so the collapse height
         * cannot drift from the line height the way a hard-coded 1.62 here could. */
        markdown.style.setProperty(
          "--message-collapse-lines",
          String(MESSAGE_COLLAPSE_LINES),
        );
        /* headingOffset: 1 — the same option the Brain panel passes. Without it headingMatch
         * returns null and every "## Heading" an agent writes renders as literal text, which is
         * how a long agent report arrived as a wall of "#" characters. A message sits under the
         * channel title, so its "#" becomes an h2 rather than competing with the page's h1. */
        setSanitizedMessageMarkdown(markdown, signal.body, { headingOffset: 1 });
        /* AFTER the sanitizer, over the sanitized tree's text nodes only. A brain topic an agent
         * named becomes a control that opens that topic, Markdown-rendered, in the Brain panel.
         * Running it here rather than inside the renderer keeps it out of the innerHTML path:
         * it builds elements, never HTML strings, so it adds no injection surface. */
        linkifyBrainTopics(markdown, {
          topics: brainTopicNames(),
          open: (topic) => void openBrainTopic(topic),
        });
        if (!expandedSignalIds.has(signal.id)) {
          markdown.classList.add("dashboard__message-markdown--collapsed");
        }
        body.append(markdown);
        renderMessageAttachments(body, signal);
        if (signal.about) {
          const about = document.createElement("code");
          about.className = "dashboard__message-about";
          about.textContent = signal.about;
          body.append(about);
        }
        appendDeliveryReceipt(body, signal);
        /* THE REPLY CONTROL, offered only where the server would accept the thread.
           `threadRootBlock` is every rule `resolveThreadRoot` applies, in its order: directed
           or expiring inside the server's one-second margin (both 404), then an archived
           channel (409), then already a reply (400). ~~"every arm of the WHERE clause plus the
           archive check that follows it"~~ was this comment's claim and a review arm found it
           wrong — `already-a-reply` is not a WHERE arm and the archive is checked before it.
           Offering a control the server refuses is a lie in a button, and the pre-cut version
           of this row asked only two of the four.

           `channelById` finds an ARCHIVED channel on purpose — a permalink into one still has
           to resolve — so the archived state is read here rather than inferred from the
           channel simply being absent. A channel missing from the list (a failed channel read
           leaves it empty) is not treated as archived: the server is the guard, and guessing
           archived would take the control off a live thread. */
        /* NOT `rowChannel` above: that one is deliberately null whenever the feed is narrowed
           to a channel, because the row's place is only worth printing in all-signals. Reusing
           it would have read every row inside a channel as unarchived and offered the control
           on threads the server refuses. The question here is about the ROW's channel, so it
           is asked of the row's channel, in every view. */
        const rootChannel = channelById(channels, signal.channelId);
        if (!isReply && canStartThread(signal, now, rootChannel?.archivedAt != null)) {
          const actions = document.createElement("div");
          actions.className = "dashboard__message-actions";
          const reply = document.createElement("button");
          reply.type = "button";
          reply.className = "dashboard__text-button dashboard__message-reply";
          reply.dataset.messageReply = signal.id;
          reply.textContent = THREAD_REPLY_CONTROL_LABEL;
          reply.addEventListener("click", () => {
            /* NOT WHILE A MESSAGE IS ON THE WIRE. Opening a reply changes where the box is
               addressed, and the chips already refuse an edit for that reason; a reply opened
               mid-post would retire the intent of a send the server may already hold. */
            if (composerSending) return;
            /* THE ROOT'S CHANNEL IS CAPTURED HERE, from the row the server sent. A signal is
               immutable, so this cannot go stale, and reading it again at send time from a
               live global is the shape of defect this file has found six times. */
            setThreadReplyRoot({
              id: signal.id,
              author: authorName,
              channelId: signal.channelId,
              until: signal.until,
            });
            expandedThreadIds.add(signal.id);
            renderFeed();
            one<HTMLTextAreaElement>("[data-composer-input]")?.focus({ preventScroll: true });
          });
          actions.append(reply);
          body.append(actions);
        }
        row.append(avatar, body);
        window.requestAnimationFrame(() => {
          if (!markdown.isConnected) return;
          const expandedAtRender = expandedSignalIds.has(signal.id);
          const overflowed = markdown.scrollHeight > markdown.clientHeight + 1;
          if (!overflowed && !expandedAtRender) return;
          const toggle = document.createElement("button");
          toggle.type = "button";
          toggle.className = "dashboard__message-toggle";
          toggle.textContent = expandedAtRender ? "Show less" : "Show more";
          toggle.setAttribute("aria-expanded", String(expandedAtRender));
          toggle.addEventListener("click", () => {
            const expanded = toggle.getAttribute("aria-expanded") !== "true";
            toggle.setAttribute("aria-expanded", String(expanded));
            toggle.textContent = expanded ? "Show less" : "Show more";
            markdown.classList.toggle("dashboard__message-markdown--collapsed", !expanded);
            if (expanded) expandedSignalIds.add(signal.id);
            else expandedSignalIds.delete(signal.id);
          });
          markdown.after(toggle);
        });
        return row;
      };

      /* OLDEST FIRST, then threads collapsed under the message they answer.
         ~~`for (const signal of [...visibleSignals].reverse())`~~ was the flat render this
         lane replaces; it shipped while the thread surface was cut on 2026-09-05, and it is
         still what an OLD client shows. The reversal itself is unchanged and is what the two
         observer pins are about: the array stays newest-first for the cursor and is reversed
         once, here, for display.

         AND THIS IS WHERE THREADS AND THE CHANNEL FILTER COMPOSE. The grouping runs over the
         rows already on screen, whatever narrowed them: the server stamps a reply with its
         ROOT's channel, so `channel_id=eq.<mobile>` returns the root and its replies together
         and so does the unfiltered read. A reply in #mobile therefore collapses under its
         root in #mobile and again in all-signals, with no client-side resolution and no
         second query. A reply whose root is not on the loaded page keeps its own place as a
         row of its own rather than disappearing with it. */
      for (const group of groupSignalThreads([...visibleSignals].reverse())) {
        list.append(buildMessageRow(group.root, group.root.threadRootId !== null));
        if (group.replies.length === 0) continue;
        const expanded = expandedThreadIds.has(group.root.id);
        const thread = document.createElement("li");
        thread.className = "dashboard__thread";
        thread.dataset.threadRoot = group.root.id;
        const replies = document.createElement("ol");
        replies.className = "dashboard__thread-replies";
        replies.id = `dashboard-thread-${group.root.id}`;
        replies.hidden = !expanded;
        for (const reply of group.replies) replies.append(buildMessageRow(reply, true));
        /* THE COUNT IS THE CONTROL. It opens the replies IN PLACE — no drawer, no navigation,
           and no second copy of the message — so a reader who opens a thread keeps the rows
           around it on screen. */
        const toggle = document.createElement("button");
        toggle.type = "button";
        toggle.className = "dashboard__thread-toggle";
        toggle.dataset.threadToggle = group.root.id;
        toggle.setAttribute("aria-expanded", String(expanded));
        toggle.setAttribute("aria-controls", replies.id);
        toggle.textContent = threadReplyCountLabel(group.replies.length);
        toggle.addEventListener("click", () => {
          const next = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(next));
          replies.hidden = !next;
          if (next) expandedThreadIds.add(group.root.id);
          else expandedThreadIds.delete(group.root.id);
        });
        thread.append(toggle, replies);
        list.append(thread);
      }
      previousSignalIds = new Set(signals.map((signal) => signal.id));
      feedWasEmpty = false;
      showChannelView("feed");
      observeHumanSeenRows();
      /* Two cases, and the anchoring MUST live here rather than around the load-older click.
       * The click handler is `async` and returns at its first `await`, so measuring around
       * `button.click()` reads the height before a single row has been added — the anchor was a
       * no-op and the viewport jumped anyway. This is the point at which the DOM has actually
       * changed, so it is the only place the measurement means anything.
       *
       * AT THE BOTTOM: pin to newest. Anywhere else: the reader is in history, so hold their
       * position by the exact height that was prepended above them. Scrolling them down
       * unconditionally is the defect every chat client ships at least once.
       *
       * showChannelView must run first: the view is `hidden` until then, and a hidden element
       * has no scroll geometry to read or set. */
      if (wasAtBottom) {
        scrollToNewest();
      } else {
        const el = feedScroller();
        if (el && change === "latest") {
          el.scrollTop = topBefore;
        } else if (el && heightBefore > 0) {
          el.scrollTop = topBefore + (el.scrollHeight - heightBefore);
        }
      }
      focusComposerOnEntry();
    };

    const syncConnectWorkspace = (workspace: Workspace): void => {
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!connect) return;
      connect.setAttribute("workspace-name", workspace.name);
      connect.setAttribute("workspace-id", workspace.id);
    };

    /* Receipt reads reuse the existing visible-feed refresh. There is no receipt timer.
     * Visible rows load first. New off-screen rows follow newest-first, while later ticks
     * revisit the stalest active rows. This keeps a 25-message page from turning one
     * two-second feed tick into a 25-request burst without starving old active receipts. */
    const visibleReceiptSignalIds = (): Set<string> => {
      const viewport = one<HTMLElement>(".dashboard__feed-view");
      if (!viewport) return new Set();
      const viewportBounds = viewport.getBoundingClientRect();
      return new Set(
        all<HTMLElement>("[data-signal-id]")
          .filter((row) => {
            const rowBounds = row.getBoundingClientRect();
            return rowBounds.bottom >= viewportBounds.top &&
              rowBounds.top <= viewportBounds.bottom;
          })
          .map((row) => row.dataset.signalId ?? "")
          .filter(Boolean),
      );
    };

    const refreshDeliveryReceipts = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      const viewerId = session?.user.id ?? "";
      if (sampleMode || !viewerId) return;
      const owner = `${workspaceId}:${version}`;
      if (deliveryReceiptRefreshOwner === owner) return;
      const now = Date.now();
      const candidates = browserDeliveryReceiptCandidates(
        signals,
        deliveryReceiptCache,
        visibleReceiptSignalIds(),
        now,
        BROWSER_RECEIPT_REQUESTS_PER_TICK,
      );
      if (candidates.length === 0) return;
      deliveryReceiptRefreshOwner = owner;
      try {
        const reads = await Promise.all(candidates.map(async (signal) => {
          try {
            return {
              signalId: signal.id,
              result: await browserDeliveryReceipts(workspaceId, signal.id),
            };
          } catch {
            return { signalId: signal.id, result: null };
          }
        }));
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        let changed = false;
        const checkedAt = Date.now();
        for (const read of reads) {
          const cached = deliveryReceiptCache.get(read.signalId);
          const previous = cached?.result;
          if (
            cached?.phase !== undefined ||
            JSON.stringify(previous) !== JSON.stringify(read.result)
          ) changed = true;
          deliveryReceiptCache.set(read.signalId, { result: read.result, checkedAt });
        }
        if (changed && !addAgentViewOpen()) renderFeed();
      } finally {
        if (deliveryReceiptRefreshOwner === owner) deliveryReceiptRefreshOwner = "";
      }
    };

    const loadSignals = async (
      workspaceId: string,
      reset: boolean,
      version: number,
    ): Promise<void> => {
      const cursor = reset ? null : signalCursor;
      if (reset) {
        signalCursor = null;
        signalCutoff = new Date().toISOString();
      }
      /* The channel is captured with the request and checked again when it lands, the same
         way the workspace is. Without it a page fetched for #mobile could be applied after
         the reader moved to all-signals, and the feed would silently be a channel's rows
         under the whole feed's name. */
      const channelId = activeChannelId;
      const page = await signalPage(workspaceId, cursor, signalCutoff, channelId);
      if (
        version !== requestVersion || workspaceId !== activeWorkspaceId ||
        channelId !== activeChannelId
      ) return;
      if (reset) {
        const fetched = new Set(page.rows.map((row) => row.id));
        /* ~~cleared as the request went out~~: that dropped a row posted BEFORE the request
           and not yet visible to the read replica, which is the case this set exists for. The
           set is not cleared here at all; what keeps a row from another channel out is the
           same question the screen asks, and `signals` was emptied by the move in any case.
           Found by a review arm. */
        prunePostedRows();
        /* AND WITHIN THE PAGE'S WINDOW. The grace bounds how long a row may stand in; it does
           not say WHERE the row belongs, and the two cases share every other bit. Replica lag
           is a row this browser wrote that the page does not carry YET. A page roll is a row
           the replica does have, below the newest 25. The boundary between them is the page's
           OLDEST row, not its newest: ~~`row.createdAt >= page.rows[0].createdAt`~~ dropped a
           row that still belongs whenever one message newer than it had already replicated,
           which in all-signals is any other member's next post. A review arm found that, on
           the fix from the round before, and an observer control had already pinned the wrong
           comparison. When the page is the whole history nothing has rolled off, so every
           stand-in belongs. A rolled-off row is not lost: it is in history, where Load older
           fetches it. */
        /* The floor is the WHOLE key the query orders by, `created_at DESC, id DESC`, and not
           the timestamp alone: a row sharing the floor row's timestamp with a smaller id sorts
           BELOW it and has rolled off, and `createdAt >= floor` kept it, so the page held
           twenty-six rows against a bound of twenty-five. A review arm found it. */
        const pageFloor = page.hasMore ? page.rows.at(-1) ?? null : null;
        const onThisPage = (row: Signal): boolean =>
          pageFloor === null ||
          row.createdAt > pageFloor.createdAt ||
          (row.createdAt === pageFloor.createdAt && row.id >= pageFloor.id);
        const arrivedWhileFetching = [...postedSinceReset.values()]
          .map((entry) => entry.row)
          .filter((row) =>
            !fetched.has(row.id) && rowShowsOnScreen(row) && onThisPage(row));
        forgetFetchedPostedIds(page.rows);
        /* Merged by time, not prepended. A stand-in is not always the newest row: it can be
           the second newest, and putting it on top painted it above a message that is newer
           than it. The comparator is the query's own order, `created_at DESC, id DESC`. */
        signals = [...arrivedWhileFetching, ...page.rows].sort((a, b) =>
          b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id));
      } else {
        forgetFetchedPostedIds(page.rows);
        const known = new Set(signals.map((signal) => signal.id));
        const additions = page.rows.filter((signal) => !known.has(signal.id));
        signals = [...signals, ...additions];
      }
      const last = page.rows.at(-1);
      signalCursor = last ? { createdAt: last.createdAt, id: last.id } : cursor;
      signalHasMore = page.hasMore;
      renderFeed();
      void refreshDeliveryReceipts(workspaceId, version);
    };

    const refreshLatestSignals = async (): Promise<void> => {
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      if (
        liveFeedInFlight ||
        sampleMode ||
        !workspaceId ||
        document.visibilityState !== "visible" ||
        !["feed", "feed-empty"].includes(app.dataset.channelView ?? "")
      ) return;
      liveFeedInFlight = true;
      try {
        const channelId = activeChannelId;
        const page = await signalPage(workspaceId, null, new Date().toISOString(), channelId);
        if (
          version !== requestVersion || workspaceId !== activeWorkspaceId ||
          channelId !== activeChannelId
        ) return;
        /* A signal from a principal the roster does not know is how a join first shows
           up here: queue it for one bounded catch-up. Settled principals (confirmed
           revoked/historical by a previous successful fetch) never re-queue, so their
           immutable old signals cannot keep the queue alive forever. */
        const knownAgents = new Set(agents.map((agent) => agent.principalId));
        for (const signal of page.rows) {
          if (
            signal.fromKind === "agent" &&
            !knownAgents.has(signal.from) &&
            !settledUnknownAgents.has(signal.from)
          ) {
            unknownAgentCandidates.add(signal.from);
          }
        }
        if (unknownAgentCandidates.size > 0) {
          void refreshRosterForUnknownAgents(workspaceId, version);
        }
        forgetFetchedPostedIds(page.rows);
        const known = new Set(page.rows.map((signal) => signal.id));
        const next = [...page.rows, ...signals.filter((signal) => !known.has(signal.id))];
        const changed =
          next.length !== signals.length ||
          next.some((signal, index) => signal.id !== signals[index]?.id);
        signalHasMore = signalHasMore || page.hasMore;
        if (changed) {
          signals = next;
          renderFeed("latest");
        }
        void refreshDeliveryReceipts(workspaceId, version);
        /* The dedicated access cadence owns discovery; a healthy feed tick also
           offers a catch-up, and the shared gate keeps the requests bounded. */
        void refreshPendingAccess(workspaceId, version);
        /* Brain topics decide which names in a body are controls. This offers a re-read on
           every healthy tick; refreshBrainTopics keeps it to one request per 30 seconds. */
        void refreshBrainTopics(false);
      } catch {
        // A live refresh never replaces a readable channel with an error. The
        // next tick retries, and the explicit refresh control remains available.
      } finally {
        liveFeedInFlight = false;
      }
    };

    /*
     * Pending access is where the inviter WAITS: a teammate invite or an agent key sits
     * there until it is consumed or cancelled. The dedicated workspace poll owns the
     * cadence in every view and also discovers access another browser created while this
     * one knew zero rows. Known pending access uses a prompt cadence; local zero uses a
     * slower discovery cadence. Feed refreshes may request the same catch-up, but the gate
     * bounds both triggers. A successful refresh updates access and membership without
     * touching the feed or closing an open add-agent view; failure stays silent and retries.
     *
     * Ownership is the gate's, and it is (workspaceId, version)-scoped: a slow request
     * started under the previous workspace holds no slot here, applies nothing when it
     * settles, and its finally cannot free the fresh workspace's ownership.
     */
    const hasPendingAccess = (): boolean =>
      pendingInvites.length > 0 ||
      accessStatuses.some(
        (access) =>
          access.firstUsedAt === null &&
          access.revokedAt === null &&
          new Date(access.expiresAt).getTime() > Date.now(),
      );

    const refreshPendingAccess = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      if (sampleMode) return;
      /* Acquiring also records the attempt. A stale owner — another workspace, or
         an older generation of this one — is replaced here rather than waited on. */
      if (
        !pendingRefreshGate.tryAcquire(
          workspaceId,
          version,
          Date.now(),
          hasPendingAccess(),
        )
      ) {
        return;
      }
      try {
        const [nextInvites, nextStatuses, nextRoster] = await Promise.all([
          pendingMemberInvites(workspaceId),
          agentAccessStatuses(workspaceId),
          memberRoster(workspaceId).catch(() => null),
        ]);
        /* A request that settles after the user moved on applies nothing: its
           generation and workspace no longer match the live ones. */
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        pendingInvites = nextInvites;
        accessStatuses = nextStatuses;
        if (nextRoster) {
          people = nextRoster.names;
          members = nextRoster.members;
          renderMembers();
          renderRoster();
        }
        if (
          freshInviteWorkspaceId === workspaceId &&
          shouldRetireFreshInvite(freshInviteId, nextInvites)
        ) {
          retireFreshInviteResult();
        }
        renderPendingAccess();
      } catch {
        // Stay silent and retryable; the last good list remains on screen.
      } finally {
        pendingRefreshGate.release(workspaceId, version);
      }
    };

    /*
     * The pending-access poll owes nothing to the channel view or locally-known rows.
     * That fixes both stale removal in a no-agents view and remote zero-to-one creation:
     * a visible live workspace keeps one cheap timer, while the gate permits actual
     * network work every 12 seconds with pending access and every 30 seconds at local
     * zero. The Live chip stays out of this: liveness of the FEED is a different claim.
     */
    const PENDING_POLL_TICK_MS = 4_000;
    let pendingPollTimer: number | undefined;

    const stopPendingPoll = (): void => {
      window.clearInterval(pendingPollTimer);
      pendingPollTimer = undefined;
    };

    const syncPendingPoll = (): void => {
      const should = shouldPollPendingAccess({
        sampleMode,
        activeWorkspaceId,
        visible: document.visibilityState === "visible",
      });
      if (should && pendingPollTimer === undefined) {
        pendingPollTimer = window.setInterval(() => {
          /* Time alone can retire an unused key. Re-render that local transition,
             then continue the slower discovery cadence rather than treating zero
             as proof that another browser cannot add access. */
          if (pendingAccessKey() !== renderedPendingAccessKey) renderPendingAccess();
          void refreshPendingAccess(activeWorkspaceId, requestVersion);
        }, PENDING_POLL_TICK_MS);
      } else if (!should && pendingPollTimer !== undefined) {
        stopPendingPoll();
      }
    };

    /** Clear every workspace-scoped value when auth identity or availability changes. */
    const resetWorkspaceSessionState = (): void => {
      stopAgentActivity();
      closeEntityPanel(false);
      closeWorkspaceMenu();
      closeRosterDialog();
      closeWorkspaceDetailsDialog();
      /* The channel dialog is the third modal this app opens with showModal, and it lives
         outside every panel for the same reason the other two do: a panel switch must not
         display:none it out from under an open session. That is exactly why it has to be
         closed HERE. Auth change is a privacy boundary, and a modal left open over the
         signed-out surface would keep the previous workspace's channel names and purposes on
         screen. Found by a review arm. */
      closeChannelDialog();
      one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
      connectFocusObserver?.disconnect();
      connectFocusObserver = null;
      activeWorkspaceId = "";
      restoredComposerKey = "";
      focusedComposerWorkspaceId = "";
      pendingWorkspaceId = "";
      pendingWorkspaceCreate = false;
      workspaces = [];
      agents = [];
      members = [];
      pendingInvites = [];
      accessStatuses = [];
      renderedPendingAccessKey = "";
      people = new Map();
      signals = [];
      sampleSignals = [];
      /* Channel state belongs to the workspace being left, and the rail is re-rendered so the
         slugs are out of the DOM as well as out of memory. */
      channels = [];
      channelListFailed = false;
      activeChannelId = null;
      unknownChannelId = null;
      postedSinceReset.clear();
      /* The intent carries the previous session's body and its command ids. */
      composerIntent = null;
      disarmChannelArchive();
      renderChannelRail();
      renderChannelHead();
      deliveryReceiptCache.clear();
      deliveryReceiptRefreshOwner = "";
      humanSeenReporter.resetVisible();
      humanSeenObserver?.disconnect();
      for (const url of attachmentObjectUrls.values()) URL.revokeObjectURL(url);
      attachmentObjectUrls.clear();
      files = [];
      fileLoadError = "";
      signalCursor = null;
      signalHasMore = false;
      signalCutoff = "";
      channelLoadError = "";
      livePromptPrincipalId = "";
      freshInviteLink = "";
      freshInviteId = "";
      freshInviteWorkspaceId = "";
      inviteIntent = null;
      resetInviteSubmitControl();
      activeCreate = null;
      rosterFilter = "";
      signalFilter = "all";
      unknownAgentCandidates.clear();
      settledUnknownAgents.clear();
      previousSignalIds = new Set();
      feedWasEmpty = false;
      liveFeedInFlight = false;
      rosterRefreshInFlight = false;
      rosterRefreshAttemptedAt = 0;
      expandedSignalIds.clear();
      resetComposer();
      window.clearTimeout(signalExpiryTimer);
      signalExpiryTimer = undefined;
      window.clearInterval(liveFeedTimer);
      liveFeedTimer = undefined;
      pendingRefreshGate.resetCooldown();
      syncPendingPoll();

      /* Auth changes are a privacy boundary, not merely a panel change. Remove the
         prior account's names, invite emails, agent rows, and signal bodies from
         the DOM before the signed-out/create surface is presented. */
      renderMembers();
      renderRoster();
      for (const list of all<HTMLElement>(
        "[data-workspace-list], [data-access-list], [data-dialog-access-list], [data-feed-list], " +
          "[data-sidebar-participant-list], [data-file-list], [data-workspace-details-content]",
      )) {
        list.replaceChildren();
      }
      for (const target of all<HTMLElement>(
        "[data-channel-name], [data-channel-id], [data-invite-link], [data-channel-receipt], " +
          "[data-sidebar-workspace-name], [data-file-warning], [data-file-empty]",
      )) {
        target.textContent = "";
      }
      for (const count of all<HTMLElement>("[data-broadcast-count], [data-direct-count]")) {
        count.textContent = "0";
      }
      for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
        target.textContent = "Your account";
      }
      const workspaceTrigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      if (workspaceTrigger) {
        workspaceTrigger.setAttribute("aria-label", "Choose workspace");
        workspaceTrigger.removeAttribute("title");
      }
      const emptyTitle = one<HTMLElement>("[data-feed-empty-title]");
      if (emptyTitle) emptyTitle.textContent = "Waiting for your agents’ first updates.";
      const rosterSearch = one<HTMLInputElement>("[data-roster-search]");
      if (rosterSearch) rosterSearch.value = "";
      const inviteEmail = one<HTMLInputElement>("[data-invite-email]");
      if (inviteEmail) inviteEmail.value = "";
      const workspaceName = one<HTMLInputElement>("#dashboard-workspace-name");
      if (workspaceName) workspaceName.value = "";
      const inviteResult = one<HTMLElement>("[data-invite-result]");
      if (inviteResult) inviteResult.hidden = true;
      const receipt = one<HTMLElement>("[data-channel-receipt]");
      if (receipt) receipt.hidden = true;
      const accessDetails = one<HTMLDetailsElement>("[data-access-details]");
      if (accessDetails) {
        accessDetails.open = false;
        accessDetails.hidden = true;
      }
      const dialogAccess = one<HTMLElement>("[data-dialog-access-section]");
      if (dialogAccess) dialogAccess.hidden = true;
      for (const count of all<HTMLElement>("[data-access-count], [data-dialog-access-count]")) {
        count.textContent = "0";
      }
      for (const error of all<HTMLElement>(
        "[data-access-error], [data-dialog-access-error], [data-agent-error], " +
          "[data-member-error], [data-feed-error], [data-file-error]",
      )) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    armLiveFeed = (): void => {
      if (
        sampleMode ||
        !activeWorkspaceId ||
        document.visibilityState !== "visible" ||
        !["feed", "feed-empty"].includes(app.dataset.channelView ?? "")
      ) return;
      if (liveFeedTimer !== undefined) return;
      liveFeedTimer = window.setInterval(() => void refreshLatestSignals(), 2_000);
    };

    /*
     * The feed polls every two seconds; the roster does not. When a poll brings in a
     * signal from an agent principal we do not know, that first signal IS the join event:
     * refresh the roster once so the header stack, the dialog, and the feed's author
     * names stop showing the "Agent a1b2c3" fallback.
     *
     * The catch-up is principal-aware because signals are immutable. A revoked agent's
     * old signals keep arriving in every latest page forever; settling is how that stops
     * costing fetches. Only a SUCCESSFUL fetch may settle, and only a candidate still
     * absent from that fetch — a failed fetch settles and drains nothing, so it stays
     * retryable after the cooldown. Concurrent candidates coalesce: the attempt drains
     * a snapshot of the queue while detection keeps filling it, and whatever arrives
     * during the flight is covered by the next bounded attempt.
     */
    const refreshRosterForUnknownAgents = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      if (rosterRefreshInFlight || sampleMode) return;
      if (unknownAgentCandidates.size === 0) return;
      if (Date.now() - rosterRefreshAttemptedAt < 10_000) return;
      rosterRefreshInFlight = true;
      rosterRefreshAttemptedAt = Date.now();
      const candidates = [...unknownAgentCandidates];
      try {
        const [nextAgents, nextRoster] = await Promise.all([
          roster(workspaceId),
          memberRoster(workspaceId),
        ]);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        people = nextRoster.names;
        members = nextRoster.members;
        const rosterIds = new Set(nextAgents.map((agent) => agent.principalId));
        /* A principal queued DURING the flight is not in the captured snapshot, but the
           fresh roster may already know it: prune those from the queue so they cannot
           cause a redundant fetch after the cooldown. Settling stays snapshot-only. */
        for (const principalId of [...unknownAgentCandidates]) {
          if (rosterIds.has(principalId)) unknownAgentCandidates.delete(principalId);
        }
        for (const principalId of candidates) {
          unknownAgentCandidates.delete(principalId);
          if (!rosterIds.has(principalId)) settledUnknownAgents.add(principalId);
        }
        renderRoster();
        renderMembers();
        renderFeed();
      } catch {
        // A roster refresh never replaces a readable channel with an error. Nothing is
        // settled or drained here, so the same candidates retry after the cooldown.
      } finally {
        rosterRefreshInFlight = false;
      }
    };

    document.addEventListener("visibilitychange", () => {
      humanSeenReporter.visibilityChange(document.visibilityState === "visible");
      if (document.visibilityState !== "visible") {
        window.clearInterval(liveFeedTimer);
        liveFeedTimer = undefined;
        syncPendingPoll();
        return;
      }
      void refreshLatestSignals();
      armLiveFeed();
      /* Coming back to the tab is exactly when a redemption has likely happened;
         catch up now rather than a tick later. */
      void refreshPendingAccess(activeWorkspaceId, requestVersion);
      syncPendingPoll();
    });

    window.addEventListener("focus", () => humanSeenReporter.focus());

    const renderWorkspaceSettingsPanel = (workspace: Workspace): void => {
      const root = one<HTMLElement>("[data-workspace-details-content]");
      if (!root) return;
      const me = members.find((member) => member.userId === session?.user.id);
      renderWorkspaceSettings(root, {
        name: workspace.name,
        workspaceId: workspace.id,
        memberCount: members.length,
        agentCount: agents.length,
        canClose: !sampleMode && me?.role === "owner",
        onCopy: async () => {
          await navigator.clipboard.writeText(workspace.id);
        },
        onClose: async () => {
          if (!session || sampleMode) return;
          const closingWorkspaceId = workspace.id;
          await archiveWorkspace(session, uuid(), closingWorkspaceId);
          const closed = workspaceStateAfterClose(
            activeWorkspaceId,
            closingWorkspaceId,
            workspaces,
          );
          workspaces = closed.workspaces;
          closeWorkspaceDetailsDialog();
          if (closed.activeWorkspaceRemains) {
            renderWorkspaceList(closed.nextWorkspace!);
            return;
          }
          activeWorkspaceId = "";
          one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
          const next = closed.nextWorkspace;
          if (next) {
            await openWorkspace(next.id, true);
            return;
          }
          ++requestVersion;
          resetWorkspaceSessionState();
          renderCreate(session);
        },
      });
    };

    const renderChannel = (workspace: Workspace, pending = false): void => {
      const id = one<HTMLElement>("[data-channel-id]");
      /* This IS the signals view: the loop below marks it current. */
      activeWorkspaceView = "signals";
      /* ORDER IS LOAD-BEARING. The all-signals button is both a view control and a place
         control, so the signals-view loop below marks it current; running it AFTER the rail
         means syncChannelCurrent has the last word, the way it already does in
         activateWorkspaceView. The other order marked all-signals current on every workspace
         open, including opens that resolved to a channel and opens whose ?c= resolved to
         nothing — two current places, or one that says you are reading the whole feed while
         the feed is not being shown. Found by a review arm. */
      for (const button of all<HTMLButtonElement>("[data-workspace-view]")) {
        if (button.dataset.workspaceView === "signals") button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      }
      renderChannelRail();
      renderChannelHead();
      for (const target of all<HTMLElement>("[data-sidebar-workspace-name]")) {
        target.textContent = workspace.name;
      }
      if (id) id.textContent = workspace.id;
      renderSignalCounts();
      const refresh = one<HTMLButtonElement>("[data-refresh]");
      if (refresh) refresh.hidden = sampleMode || agents.length === 0;
      const count = one<HTMLElement>("[data-update-count]");
      if (count) count.hidden = pending || agents.length === 0 || signals.length === 0;
      renderWorkspaceList(workspace);
      renderWorkspaceSettingsPanel(workspace);
      renderRoster();
      for (const target of all<HTMLElement>("[data-rail-account]")) {
        target.textContent = sampleMode || !session ? "Sample account" : accountName(session);
      }
      showPanel("channel");
      if (pending) {
        if (count) count.textContent = "Loading updates…";
        showChannelView("feed-pending");
      } else if (sampleMode) {
        renderFeed();
      } else if (agents.length === 0) {
        if (count) count.textContent = "Empty channel";
        showChannelView("no-agents");
      } else {
        showChannelView("feed-pending");
      }
    };

    const resetInviteSubmitControl = (): void => {
      const submit = one<HTMLButtonElement>("[data-invite-submit]");
      if (!submit) return;
      submit.disabled = false;
      submit.textContent = "Create invite link";
    };

    const openWorkspace = async (
      workspaceId: string,
      force = false,
    ): Promise<void> => {
      const selected = workspaces.find((workspace) => workspace.id === workspaceId);
      if (!selected) return;
      closeEntityPanel(false);
      closeWorkspaceMenu();
      const changesWorkspace = activeWorkspaceId !== selected.id;
      if (changesWorkspace) {
        previousSignalIds.clear();
        feedWasEmpty = false;
      }
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const promptWorkspaceId = connect?.getAttribute("workspace-id") ?? "";
      const connectState = connect?.dataset.state ?? "";
      const mintBusy = connect?.hasAttribute("data-mint-busy") ?? false;
      if (!force && connectState === "done") {
        pendingWorkspaceId = workspaceId;
        connect?.finishPrompt("back");
        return;
      }
      if (!force && (mintBusy || connectState === "working")) {
        const changesWorkspace =
          promptWorkspaceId.length > 0 && promptWorkspaceId !== workspaceId;
        pendingWorkspaceId = changesWorkspace ? workspaceId : "";
        showChannelView("connect");
        window.requestAnimationFrame(() => {
          one<HTMLElement>("[data-close-connect]")?.focus();
        });
        return;
      }
      pendingWorkspaceId = "";
      /* Every real workspace open advances requestVersion, so an invite submission
         from the prior generation no longer owns this shared form. Reset its busy
         affordance here; the stale async handler is forbidden from touching it. */
      resetInviteSubmitControl();
      if (changesWorkspace) {
        resetComposer();
        resetFreshInviteResult();
        inviteIntent = null;
        const email = one<HTMLInputElement>("[data-invite-email]");
        const error = one<HTMLElement>("[data-invite-error]");
        if (email) email.value = "";
        if (error) {
          error.textContent = "";
          error.hidden = true;
        }
      }
      /* The dialogs show the OLD workspace's data from here on; close them rather than
         let either outlive its data. The refresh cooldown resets with the workspace. */
      closeRosterDialog();
      closeWorkspaceDetailsDialog();
      rosterRefreshAttemptedAt = 0;
      pendingRefreshGate.resetCooldown();
      unknownAgentCandidates.clear();
      settledUnknownAgents.clear();
      const keepShell = app.dataset.state === "channel";
      stopPendingPoll();
      activeWorkspaceId = selected.id;
      syncConnectWorkspace(selected);
      const version = ++requestVersion;
      startAgentActivity(selected.id, version);
      agents = [];
      members = [];
      pendingInvites = [];
      accessStatuses = [];
      renderedPendingAccessKey = "";
      /* Restart one timer under the new workspace/version. The callbacks read the
         guarded live identity, and a failed initial load remains retryable. */
      syncPendingPoll();
      people = new Map();
      signals = [];
      deliveryReceiptCache.clear();
      deliveryReceiptRefreshOwner = "";
      files = [];
      fileLoadError = "";
      signalFilter = "all";
      /* A channel belongs to one workspace, so nothing about the old one survives the
         switch: not the list, not the narrowing, not a reply in progress. */
      channels = [];
      channelListFailed = false;
      activeChannelId = null;
      unknownChannelId = null;
      /* Nothing this browser posted in the workspace being left may stand in for a page of
         the one being opened. The prune's workspace test says the same thing; this is the
         cheaper half of it, done where the workspace actually changes. */
      postedSinceReset.clear();
      disarmChannelArchive();
      signalCursor = null;
      signalHasMore = false;
      signalCutoff = "";
      channelLoadError = "";
      if (keepShell) renderChannel(selected, true);
      else setLoading(`Opening ${selected.name}…`);
      /* The generation is taken BEFORE the read, not after it. Taken after, a slow open could
         land behind a create the reader made while it was still loading — same workspace,
         same requestVersion, so nothing else dropped it — and overwrite the list with the
         snapshot from before that channel existed. The URL then named an id the stale list
         did not have, and the head said "Channel not found" for a channel that does. Found by
         a review arm. */
      const channelGeneration = ++channelReadGeneration;
      try {
        const [nextAgents, nextRoster, nextInvites, nextAccessStatuses, nextFiles, nextChannels] = await Promise.all([
          roster(selected.id),
          memberRoster(selected.id),
          pendingMemberInvites(selected.id),
          agentAccessStatuses(selected.id),
          workspaceFiles(selected.id).then(
            (value) => ({ value, error: "" }),
            (error) => ({
              value: [] as WorkspaceFile[],
              error: `${readableError(error)} The signal feed is still available.`,
            }),
          ),
          /* Soft-fails like the file list does. A workspace whose channel list did not load
             still reads all-signals, which holds every message either way, so this must not
             take the feed down with it. */
          workspaceChannels(selected.id).then(
            (value) => ({ value, failed: false }),
            () => ({ value: [] as WorkspaceChannel[], failed: true }),
          ),
        ]);
        if (version !== requestVersion) return;
        agents = nextAgents;
        people = nextRoster.names;
        members = nextRoster.members;
        pendingInvites = nextInvites;
        accessStatuses = nextAccessStatuses;
        files = nextFiles.value;
        fileLoadError = nextFiles.error;
        /* Only if no newer channel read has landed since this one started. A create the
           reader made while the workspace was still opening is newer than this snapshot, and
           it stays. */
        if (channelGeneration === channelReadGeneration) {
          channels = nextChannels.value;
          channelListFailed = nextChannels.failed;
        }
        /* The URL is read ONCE per workspace open, after the channels are known: a ?c= that
           names no channel here must show an honest empty state, and the only way to tell
           that from a channel that is merely empty is to have the list. Then it is WRITTEN,
           so the address bar is the address of what is being read after every open and not
           only after a channel click. */
        applyChannelFromUrl(selected.id);
        syncChannelUrl();
        if (
          freshInviteWorkspaceId === selected.id &&
          shouldRetireFreshInvite(freshInviteId, nextInvites)
        ) {
          retireFreshInviteResult();
        }
        if (!addAgentViewOpen()) renderChannel(selected);
        renderMembers();
        renderPendingAccess();
        renderFiles();
        renderBrain();
        if (agents.length > 0) {
          await loadSignals(selected.id, true, version);
        }
      } catch (error) {
        if (version !== requestVersion) return;
        signalHasMore = false;
        channelLoadError = `${readableError(error)} Nothing was changed.`;
        const target = one<HTMLElement>("[data-feed-error]");
        if (target) target.textContent = channelLoadError;
        if (addAgentViewOpen()) return;
        renderChannel(selected);
        showChannelView("feed-error");
      }
    };

    const openAgentChoice = (): void => {
      if (sampleMode) return;
      showChannelView("agent-choice");
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-agent-owner-self]")?.focus({ preventScroll: true });
      });
    };

    const resetFreshInviteResult = (): void => {
      freshInviteLink = "";
      freshInviteId = "";
      freshInviteWorkspaceId = "";
      const result = one<HTMLElement>("[data-invite-result]");
      const form = one<HTMLFormElement>("[data-invite-form]");
      const receipt = one<HTMLElement>("[data-invite-receipt]");
      const link = one<HTMLElement>("[data-invite-link]");
      const copy = one<HTMLButtonElement>("[data-copy-invite]");
      const done = one<HTMLButtonElement>("[data-invite-done]");
      const status = one<HTMLElement>("[data-invite-status]");
      if (result) result.hidden = true;
      if (form) form.hidden = false;
      if (receipt) receipt.textContent = "Private one-use link · expires in 7 days";
      if (link) {
        link.textContent = "";
        link.hidden = false;
      }
      if (copy) {
        copy.textContent = "Copy invite link";
        delete copy.dataset.inviteComplete;
      }
      if (done) done.textContent = "Done";
      if (status) status.textContent = "";
    };

    /* Remote acceptance, cancellation, and expiry are indistinguishable from the
       pending endpoint, but all make the one-use URL dead. Clear the credential
       and turn the existing controls into truthful exits without moving focus.
       If the link itself holds focus, keep that node visible with safe text. */
    const retireFreshInviteResult = (): void => {
      freshInviteLink = "";
      freshInviteId = "";
      freshInviteWorkspaceId = "";
      const result = one<HTMLElement>("[data-invite-result]");
      const form = one<HTMLFormElement>("[data-invite-form]");
      const receipt = one<HTMLElement>("[data-invite-receipt]");
      const link = one<HTMLElement>("[data-invite-link]");
      const copy = one<HTMLButtonElement>("[data-copy-invite]");
      const done = one<HTMLButtonElement>("[data-invite-done]");
      const status = one<HTMLElement>("[data-invite-status]");
      if (result) result.hidden = false;
      if (form) form.hidden = true;
      if (receipt) receipt.textContent = "This invite is no longer pending.";
      if (link) {
        link.textContent = "The one-use link has been cleared.";
        link.hidden = document.activeElement !== link;
      }
      if (copy) {
        copy.textContent = "Back to channel";
        copy.dataset.inviteComplete = "true";
      }
      if (done) done.textContent = "Invite someone else";
      if (status) status.textContent = "The one-use link has been cleared.";
    };

    let inviteReturnView: "channel" | "agent-choice" = "agent-choice";

    const openInvite = (returnView: "channel" | "agent-choice"): void => {
      if (sampleMode) return;
      inviteReturnView = returnView;
      resetFreshInviteResult();
      const error = one<HTMLElement>("[data-invite-error]");
      const backLabel = one<HTMLElement>("[data-close-invite-label]");
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
      if (backLabel) {
        backLabel.textContent = returnView === "channel"
          ? "Back to the channel"
          : "Back to who runs this agent";
      }
      showChannelView("invite");
      window.requestAnimationFrame(() => {
        one<HTMLInputElement>("[data-invite-email]")?.focus({ preventScroll: true });
      });
    };

    const openConnect = (): void => {
      if (sampleMode) return;
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      syncConnectWorkspace(selected);
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) exitStatus.hidden = true;
      showChannelView("connect");
      connectFocusObserver?.disconnect();
      const focusField = (): boolean => {
        if (connect.dataset.state !== "ready") return false;
        const form = connect.querySelector<HTMLFormElement>("[data-panel='form']");
        const target = form?.dataset.hasAgents === "yes"
          ? connect.querySelector<HTMLSelectElement>("[data-field='identity']")
          : connect.querySelector<HTMLInputElement>("[data-field='name']");
        target?.focus({ preventScroll: true });
        return Boolean(target);
      };
      window.requestAnimationFrame(() => {
        if (focusField()) return;
        connectFocusObserver = new MutationObserver(() => {
          if (!focusField()) return;
          connectFocusObserver?.disconnect();
          connectFocusObserver = null;
        });
        connectFocusObserver.observe(connect, {
          attributes: true,
          attributeFilter: ["data-state"],
        });
      });
    };

    const keepConnectCredentialVisible = (): boolean => {
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const connectState = connect?.dataset.state ?? "";
      const mintBusy = connect?.hasAttribute("data-mint-busy") ?? false;
      if (!mintBusy && connectState !== "working") return false;
      showChannelView("connect");
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) {
        exitStatus.textContent =
          "Wait for CommonSwarm to finish creating the key before leaving this screen.";
        exitStatus.hidden = false;
      }
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-close-connect]")?.focus();
      });
      return true;
    };

    const returnToChannel = (): void => {
      pendingWorkspaceId = "";
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) exitStatus.hidden = true;
      if (channelLoadError) showChannelView("feed-error");
      else if (agents.length === 0) showChannelView("no-agents");
      else if (signals.length === 0) {
        const workspaceId = activeWorkspaceId;
        const version = requestVersion;
        showChannelView("feed-pending");
        void loadSignals(workspaceId, true, version).catch((error) => {
          if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
          channelLoadError = `${readableError(error)} Nothing was changed.`;
          const target = one<HTMLElement>("[data-feed-error]");
          if (target) target.textContent = channelLoadError;
          if (addAgentViewOpen()) return;
          showChannelView("feed-error");
        });
      }
      else {
        // This is an explicit exit from an add-agent view. Mark the feed active
        // before rendering so renderFeed's background-refresh guard does not
        // mistake the requested return for an unsolicited view change.
        showChannelView("feed");
        renderFeed();
      }
    };

    const activateWorkspaceView = (view: "signals" | "files" | "brain"): void => {
      if (keepConnectCredentialVisible()) return;
      activeWorkspaceView = view;
      const name = one<HTMLElement>("[data-channel-name]");
      const description = one<HTMLElement>("[data-channel-description]");
      for (const button of all<HTMLButtonElement>("[data-workspace-view]")) {
        if (button.dataset.workspaceView === view) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      }
      /* Files and Brain are not a channel, so no channel is current while one is open. The
         channel buttons deliberately carry no data-workspace-view (that attribute marks every
         signals-view button at once), so this loop is what clears them; without it the rail
         claimed a current channel while the head said Files. Found by a review arm. */
      if (view !== "signals") {
        for (const button of all<HTMLButtonElement>("[data-channel-place]")) {
          button.removeAttribute("aria-current");
        }
      }
      if (view === "files") {
        if (name) name.textContent = "Files";
        if (description) {
          description.textContent = "Files shared for this workspace’s work. Downloads are untrusted input.";
        }
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        const count = one<HTMLElement>("[data-update-count]");
        if (refresh) refresh.hidden = true;
        if (count) count.hidden = true;
        renderFiles();
        showChannelView("files");
      } else if (view === "brain") {
        if (name) name.textContent = "Brain";
        if (description) {
          description.textContent =
            "Durable Markdown notes kept by this workspace. Each save creates a new file version.";
        }
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        const count = one<HTMLElement>("[data-update-count]");
        if (refresh) refresh.hidden = true;
        if (count) count.hidden = true;
        renderBrain();
        showChannelView("brain");
      } else {
        renderChannelHead();
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        if (refresh) refresh.hidden = sampleMode || agents.length === 0;
        returnToChannel();
      }
      window.requestAnimationFrame(() => name?.focus({ preventScroll: true }));
    };


    /* ── Channels ─────────────────────────────────────────────────────────────────────
     * A channel is the ADDRESS of a message, not a scope on who reads it. Every member of
     * this workspace reads every channel, and filing a message in one changes nothing
     * about which agent is woken. `all-signals` is not a channel at all: it is the whole
     * feed, filed and unfiled together, which is why the command edge refuses that name
     * for a real channel.
     *
     * Nothing written before a channel existed can move into it. A signal row is
     * immutable, so a message posted before this feature keeps no channel forever and
     * reads in all-signals only. The empty state says that rather than letting a reader
     * conclude the channel is broken.
     */
    const activeChannel = (): WorkspaceChannel | null =>
      channelById(channels, activeChannelId);

    /** The name in the head, the phone's chip, and the composer, from one place. */
    const activeChannelName = (): string =>
      channelLabel(activeChannel()?.slug ?? ALL_SIGNALS_SLUG);

    /**
     * Which place the rail marks as current. An unresolved `?c=` marks NOTHING: the reader is
     * in the signals view but in no channel, and marking all-signals would say they are
     * reading the whole feed when the feed is not being shown. Both review arms read this
     * state and agreed the empty mark is the honest one, so it is written down rather than
     * left to fall out of the condition.
     */
    const syncChannelCurrent = (): void => {
      for (const button of all<HTMLButtonElement>("[data-channel-place]")) {
        const place = button.dataset.channelPlace ?? "";
        const id = place === "" ? null : place;
        if (
          activeWorkspaceView === "signals" && id === activeChannelId &&
          unknownChannelId === null
        ) {
          button.setAttribute("aria-current", "page");
        } else button.removeAttribute("aria-current");
      }
    };

    /**
     * The composer posts to the channel you are reading (design R10) and gains no chrome
     * for it: no channel dropdown and no `#` parsing of the body — bodies legitimately
     * contain `#`, so a parser could not tell a heading from an address. The To: row beneath
     * the box addresses PEOPLE and agents; it never names a channel. What the reader
     * gets instead is the destination in the box they are typing into.
     */
    /**
     * THE SLUG OF THE THREAD'S CHANNEL, resolved from the id every time it is drawn.
     *
     * `null` means the thread is unfiled, which the bar names `#all-signals`. A channel the
     * reader can no longer see in the list — deleted is impossible, but a failed channel read
     * leaves the list empty — also resolves to `null` here, and the SEND is what refuses in
     * that case, with the server's own rule. A label is a label; the guard is the guard.
     */
    /**
     * WHERE A REPLY IN PROGRESS WILL BE FILED, in the three states it can be in.
     *
     * ~~"A channel the reader can no longer see in the list — deleted is impossible, but a
     * failed channel read leaves the list empty — also resolves to `null` here, and the SEND is
     * what refuses in that case, with the server's own rule."~~ Retired: that was the two-state
     * model, and both halves of it were wrong. A row this page cannot see is its own state
     * (`unknown`), not the unfiled one; and the send's refusal for it was neither the server's
     * rule nor true, because a reply names only its thread and the edge stamps the root's
     * channel itself. A review arm found the second half.
     */
    const threadReplyPlaceOf = (root: ThreadReplyRoot | null): ThreadReplyPlace =>
      root === null
        ? { kind: "unfiled" }
        : threadReplyPlace(
          root.channelId,
          root.channelId === null
            ? null
            : channelById(channels, root.channelId)?.slug ?? null,
        );

    /**
     * WHAT STOPS THIS REPLY, right now, or null. The captured root carries the two things that
     * can change while a reply is being written — its horizon, and whether its channel has been
     * archived — and the other two arms were settled when the control was drawn and cannot
     * change, because a stored signal is immutable. One classifier answers for the bar and for
     * the send, so the sentence a reader reads while typing is the sentence they get if they
     * press Enter.
     */
    const threadReplyBlock = (root: ThreadReplyRoot | null) =>
      root === null
        ? null
        : threadRootBlock(
          { to: null, toAgent: null, threadRootId: null, until: root.until },
          Date.now(),
          root.channelId !== null &&
            channelById(channels, root.channelId)?.archivedAt != null,
        );

    const syncComposerPlacement = (): void => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const bar = one<HTMLElement>("[data-composer-reply]");
      const targetText = one<HTMLElement>("[data-composer-reply-target-text]");
      const windowText = one<HTMLElement>("[data-composer-reply-window]");
      const broadcastRow = one<HTMLElement>("[data-composer-reply-broadcast-row]");
      const broadcastLabel = one<HTMLElement>("[data-composer-reply-broadcast-label]");
      const broadcast = one<HTMLInputElement>("[data-composer-reply-broadcast]");
      if (bar) bar.hidden = threadReplyRoot === null;
      if (threadReplyRoot !== null) {
        const place = threadReplyPlaceOf(threadReplyRoot);
        const block = threadReplyBlock(threadReplyRoot);
        if (targetText) {
          targetText.textContent = threadReplyTargetText(threadReplyRoot.author, place);
        }
        if (windowText) {
          /* THE CEILING, when there is one, and the BLOCK when the thread has stopped taking
             replies. §6 P4 requires the ceiling on screen: the remaining window can be
             milliseconds, and a considered reply must not be written into a thread that expires
             while it is being read. That is also why this line is rewritten on every feed tick
             rather than once when the bar opens — a frozen "in 2 minutes" is the exact failure
             the requirement exists to prevent. A root with no expiry produces no sentence, so
             the line collapses rather than saying "never". */
          windowText.textContent = threadReplyWindowText(
            threadReplyRoot.until === null
              ? null
              : formatTime(threadReplyRoot.until).relative,
            block,
          );
        }
        /* AND THE BROADCAST CONTROL ONLY WHERE IT CAN DO SOMETHING. An unfiled thread has no
           channel to send a reply to: the edge stores the flag and leaves `channel_id` null,
           so the request is accepted and nothing happens. The CLI shipped that as a sentence
           claiming a send that never occurred and a review arm found it; this is one step
           earlier, where the control is simply not there. Its own state is cleared with it,
           so a box ticked for one thread cannot ride along into the next. */
        const mayBroadcast = threadReplyMayBroadcast(place, block);
        if (broadcastRow) broadcastRow.hidden = !mayBroadcast;
        if (broadcastLabel) {
          broadcastLabel.textContent = mayBroadcast && place.kind === "channel"
            ? threadReplyBroadcastLabel(place.slug)
            : "";
        }
        if (broadcast && !mayBroadcast) broadcast.checked = false;
        if (input) {
          input.placeholder = "Reply in this thread";
          input.setAttribute("aria-label", "Thread reply");
        }
        return;
      }
      if (broadcast) broadcast.checked = false;
      if (broadcastRow) broadcastRow.hidden = true;
      const channel = activeChannel();
      if (!input) return;
      if (channel === null) {
        input.placeholder = "What are you about to do?";
        input.setAttribute("aria-label", "Signal");
        return;
      }
      input.placeholder = `Message ${channelLabel(channel.slug)}`;
      input.setAttribute("aria-label", `Message in ${channelLabel(channel.slug)}`);
    };

    /**
     * IS THE COMPOSER STILL PROMISING THE ADDRESS THIS UNFINISHED SEND WAS WRITTEN TO?
     *
     * ONE QUESTION, asked by the channel switch that retires an intent and by the failure path
     * that decides whether Retry may be offered. The channels lane invented a second
     * comparison for the second caller and both arms found the contradiction it created, so
     * this lane adds no third: a reply is added as an arm of the same question.
     *
     * A TOP-LEVEL message is addressed to the channel on screen. A REPLY is addressed to its
     * THREAD, and the channel on screen has nothing to do with it: a reply to a message in
     * #mobile is written from all-signals as readily as from #mobile, and its placement
     * channel is its root's in both cases. Comparing only the channel would have refused a
     * valid Retry for every reply read from anywhere but its own channel.
     */
    const composerAddressStillPromised = (
      intent: { placementChannelId: string | null; placementThreadRootId: string | null },
    ): boolean =>
      intent.placementThreadRootId !== null || threadReplyRoot !== null
        ? intent.placementThreadRootId === (threadReplyRoot?.id ?? null)
        : intent.placementChannelId === (activeChannel()?.channelId ?? null);

    /**
     * The sentence that retires an unfinished send when the composer starts promising
     * somewhere else. Built from which of the two addresses moved, so it names the move that
     * happened rather than the one that is easiest to write.
     */
    const retireComposerIntentOnAddressMove = (): void => {
      if (composerIntent === null) return;
      if (composerAddressStillPromised(composerIntent)) return;
      const wasReply = composerIntent.placementThreadRootId !== null;
      composerIntent = null;
      const retryControl = one<HTMLButtonElement>("[data-composer-retry]");
      if (retryControl) retryControl.hidden = true;
      setComposerStatus(
        wasReply
          ? "The unfinished message belongs to the thread it was written in. Sending from here posts it here, as a new message."
          : "The unfinished message belongs to the channel it was written in. Sending from here posts it here, as a new message.",
        "error",
      );
    };

    /** Open a reply on a root, or close the one that is open. One writer for both. */
    const setThreadReplyRoot = (root: ThreadReplyRoot | null): void => {
      if ((threadReplyRoot?.id ?? null) === (root?.id ?? null)) return;
      threadReplyRoot = root;
      /* THE ADDRESS OF THE BOX JUST CHANGED, so an unfinished send addressed to the old one is
         retired by the same rule a channel move uses. Opening a reply while a top-level
         message is unsent, and cancelling a reply while the reply is unsent, are the same
         event: the composer is about to promise something else. */
      retireComposerIntentOnAddressMove();
      syncComposerPlacement();
      /* The pass HOLDS while replying and runs again when the reply closes, so the chips the
         reader had before the reply come back from `composerTo` rather than from storage. */
      syncComposerAddress();
    };

    const renderChannelHead = (): void => {
      /* Files and Brain own the head while they are on screen. Writing the channel's name
         over one of them was reachable from a rename, which re-renders the head without
         going through the view switch. */
      if (activeWorkspaceView !== "signals") {
        syncChannelCurrent();
        return;
      }
      const name = one<HTMLElement>("[data-channel-name]");
      const description = one<HTMLElement>("[data-channel-description]");
      const switchLabel = one<HTMLElement>("[data-channel-switch-label]");
      const channel = activeChannel();
      if (unknownChannelId !== null) {
        if (name) name.textContent = "Channel not found";
        if (description) description.textContent = unknownChannelHeadText(channelListFailed);
        if (switchLabel) switchLabel.textContent = "Channel not found";
      } else if (channel === null) {
        if (name) name.textContent = channelLabel(ALL_SIGNALS_SLUG);
        if (description) {
          description.textContent =
            "Intent posted by every agent in this workspace. Immutable, and never a claim.";
        }
        if (switchLabel) switchLabel.textContent = channelLabel(ALL_SIGNALS_SLUG);
      } else {
        if (name) name.textContent = channelLabel(channel.slug);
        if (description) {
          description.textContent = channel.archivedAt !== null
            ? CHANNEL_ARCHIVED_TEXT
            : channel.purpose ?? CHANNEL_REACH_TEXT;
        }
        if (switchLabel) switchLabel.textContent = channelLabel(channel.slug);
      }
      syncChannelCurrent();
      syncComposerPlacement();
    };

    const renderChannelRail = (): void => {
      const add = one<HTMLButtonElement>("[data-channel-new]");
      if (add) add.hidden = sampleMode;
      const list = one<HTMLElement>("[data-channel-list]");
      if (!list) return;
      list.replaceChildren();
      for (const channel of liveChannels(channels)) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard__sidebar-place";
        /* NOT data-workspace-view: activateWorkspaceView marks every signals-view button
           aria-current, which would mark every channel current at once. These buttons
           switch the view through selectChannel instead, and syncChannelCurrent owns
           which one is marked. */
        button.dataset.channelPlace = channel.channelId;
        const mark = document.createElement("span");
        mark.className = "dashboard__sidebar-place-mark";
        mark.setAttribute("aria-hidden", "true");
        mark.textContent = "#";
        const label = document.createElement("span");
        label.textContent = channel.slug;
        button.append(mark, label);
        if (channel.purpose !== null) button.title = channel.purpose;
        button.addEventListener("click", () => selectChannel(channel.channelId));
        list.append(button);
      }
      syncChannelCurrent();
    };

    /** The URL is the address of what you are reading: `?w=` the workspace, `?c=` the channel. */
    const syncChannelUrl = (): void => {
      if (sampleMode) return;
      const url = new URL(window.location.href);
      if (activeWorkspaceId === "") url.searchParams.delete("w");
      else url.searchParams.set("w", activeWorkspaceId);
      /* An unreadable ?c= is KEPT in the address bar. Dropping it would turn a bad link
         into the unfiltered feed on the next reload, which is the failure this state
         exists to prevent: the reader would think they were looking at the channel. */
      const channelId = unknownChannelId ?? activeChannelId;
      if (channelId === null) url.searchParams.delete("c");
      else url.searchParams.set("c", channelId);
      window.history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
    };

    /**
     * Read `?c=` once per workspace open, AFTER the channel list is known. A channel id that
     * names nothing here becomes an honest empty state; it never falls back to the unfiltered
     * feed under the channel's name.
     *
     * A `?c=` BELONGS TO THE WORKSPACE ITS `?w=` NAMES. Without that rule, switching workspace
     * from the menu carried the previous workspace's channel id into the new one, which is not
     * in it, so the reader who picked workspace B was shown "Channel not found" instead of B's
     * feed, and a reload took them back to A. Found by a review arm. A link the reader
     * FOLLOWED still resolves: its own `?w=` is the workspace being opened.
     */
    const applyChannelFromUrl = (workspaceId: string): void => {
      const params = new URL(window.location.href).searchParams;
      const requested = params.get("c");
      const forWorkspace = params.get("w");
      if (
        requested === null || requested === "" ||
        (forWorkspace !== null && forWorkspace !== workspaceId)
      ) {
        activeChannelId = null;
        unknownChannelId = null;
        return;
      }
      const found = channelById(channels, requested);
      activeChannelId = found === null ? null : found.channelId;
      unknownChannelId = found === null ? requested : null;
    };

    const selectChannel = (channelId: string | null): void => {
      const next = channelId === null
        ? null
        : channelById(channels, channelId)?.channelId ?? null;
      if (channelId !== null && next === null) return;
      const changed = next !== activeChannelId || unknownChannelId !== null;
      /* `changed` is also true when only the unresolved state clears. The RETIREMENT below
         needs the narrower question — did the address actually move — because clicking the
         place you are already in is not a move, and retiring there killed a valid Retry,
         replaced the send error with a sentence about a move that did not happen, and left
         Enter minting fresh command ids that reposted every hop that had already landed.
         Found by a review arm; introduced by the fix two rounds earlier. */
      /* AN UNFINISHED SEND SURVIVES ONLY WHILE THE COMPOSER STILL PROMISES ITS ADDRESS. Two
         narrower questions were tried and both were wrong: `changed` also fires when the
         unresolved state merely clears, so clicking the place you were already in killed a
         valid Retry; and comparing the place being left called a `?c=` heal into a DIFFERENT
         channel a no-op, leaving a retry pointed somewhere the box no longer names. This asks
         the thing that matters directly. Both were found by review arms. */
      activeChannelId = next;
      unknownChannelId = null;
      disarmChannelArchive();
      /* An unfinished send is addressed to the channel it was started in, and the composer is
         about to promise this one. Replaying the old address from a box that says
         "Message #ops" is the contradiction; the intent is retired here instead, so a send
         from this channel is a new message that goes where the box says. The hops that
         already landed stay where they landed.

         `composerAddressStillPromised` is asked rather than a comparison written here, so a
         channel move does NOT retire an unfinished REPLY: a reply is addressed to its thread,
         and the box still promises that thread whatever channel the reader is reading. The
         inline comparison this replaced would have killed a valid Retry on every such reply,
         which is the shape of the two defects the channels lane found in the same lines. */
      retireComposerIntentOnAddressMove();
      /* SAMPLE MODE NARROWS LOCALLY, and it is the one place that may. There is no server
         behind this page, so clearing the rows and asking for a page would replace the
         made-up feed with "not connected to CommonSwarm" — measured, before this branch
         existed. The dishonesty a client-side filter usually carries is absent here: the
         sample IS the whole set, so "the messages in this channel" is exactly true of it. */
      if (sampleMode) {
        signals = sampleSignals.filter(
          (signal) => activeChannelId === null || signal.channelId === activeChannelId,
        );
        syncChannelUrl();
        renderChannelRail();
        closeChannelDialog();
        renderChannelHead();
        renderFeed();
        return;
      }
      if (changed) {
        /* The narrowing is the QUERY's, so the loaded page belongs to the channel it was
           fetched for and none of it survives a move. Keeping rows here would show the
           previous channel's messages under this channel's name until the fetch landed. */
        signals = [];
        signalCursor = null;
        signalHasMore = false;
        signalCutoff = "";
        channelLoadError = "";
        previousSignalIds.clear();
        feedWasEmpty = false;
        deliveryReceiptCache.clear();
        deliveryReceiptRefreshOwner = "";
      }
      syncChannelUrl();
      renderChannelRail();
      closeChannelDialog();
      /* returnToChannel, reached through here, is what loads the new page: it sees an
         empty signal list and fetches one under the channel now in state. */
      activateWorkspaceView("signals");
    };

    const setChannelDialogError = (message: string): void => {
      const target = one<HTMLElement>("[data-channel-dialog-error]");
      if (!target) return;
      target.textContent = message;
      target.hidden = message === "";
    };

    const setChannelDialogStatus = (message: string): void => {
      const target = one<HTMLElement>("[data-channel-dialog-status]");
      if (target) target.textContent = message;
    };

    const renderChannelDialog = (): void => {
      const reach = one<HTMLElement>("[data-channel-reach]");
      if (reach) reach.textContent = CHANNEL_REACH_TEXT;
      for (const hint of all<HTMLElement>("[data-channel-name-hint], [data-channel-rename-hint]")) {
        hint.textContent = channelNameHint();
      }
      const purposeHint = one<HTMLElement>("[data-channel-purpose-hint]");
      if (purposeHint) purposeHint.textContent = channelPurposeHint();
      const archiveHint = one<HTMLElement>("[data-channel-archive-hint]");
      if (archiveHint) {
        archiveHint.textContent =
          "Archiving hides a channel from this list and refuses new messages. Nothing is deleted, and its messages still read.";
      }
      for (const input of all<HTMLInputElement>("[data-channel-new-slug], [data-channel-rename-slug]")) {
        input.maxLength = channelSlugInputMax();
      }
      const purposeInput = one<HTMLInputElement>("[data-channel-new-purpose]");
      if (purposeInput) purposeInput.maxLength = channelPurposeInputMax();
      const list = one<HTMLElement>("[data-channel-dialog-list]");
      if (list) {
        list.replaceChildren();
        const places: { id: string | null; slug: string }[] = [
          { id: null, slug: ALL_SIGNALS_SLUG },
          ...liveChannels(channels).map((channel) => ({
            id: channel.channelId as string | null,
            slug: channel.slug,
          })),
        ];
        for (const place of places) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__sidebar-place";
          button.dataset.channelPlace = place.id ?? "";
          button.textContent = channelLabel(place.slug);
          if (place.id === activeChannelId && unknownChannelId === null) {
            button.setAttribute("aria-current", "page");
          }
          button.addEventListener("click", () => selectChannel(place.id));
          list.append(button);
        }
      }
      const manage = one<HTMLFormElement>("[data-channel-manage-form]");
      const channel = activeChannel();
      const manageable = channel !== null && channel.archivedAt === null && !sampleMode;
      if (manage) manage.hidden = !manageable;
      if (manageable) {
        const title = one<HTMLElement>("[data-channel-manage-title]");
        if (title) title.textContent = `Manage ${channelLabel(channel!.slug)}`;
        const rename = one<HTMLInputElement>("[data-channel-rename-slug]");
        if (rename) rename.value = channel!.slug;
      }
      const create = one<HTMLFormElement>("[data-channel-create-form]");
      if (create) create.hidden = sampleMode;
    };

    const openChannelDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-channel-dialog]");
      if (!dialog || dialog.open) return;
      setChannelDialogError("");
      setChannelDialogStatus("");
      renderChannelDialog();
      dialog.showModal();
      one<HTMLButtonElement>("[data-channel-switch]")?.setAttribute("aria-expanded", "true");
    };

    const closeChannelDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-channel-dialog]");
      if (dialog?.open) dialog.close();
    };

    /**
     * Re-reads the channel list after a change and keeps the rail, the head and the dialog
     * on the same set. The command response carries the row it wrote, but another member
     * can have created a channel since this list was read, so the list is re-read rather
     * than patched.
     */
    const refreshChannels = async (workspaceId: string, version: number): Promise<void> => {
      const generation = ++channelReadGeneration;
      const current = (): boolean =>
        generation === channelReadGeneration && version === requestVersion &&
        workspaceId === activeWorkspaceId;
      let next: WorkspaceChannel[];
      try {
        next = await workspaceChannels(workspaceId);
      } catch (error) {
        /* The flag has to follow the LATEST read, in both directions. It was set once at
           workspace open and never again, so a first read that failed kept saying so after a
           later one succeeded, and a later one that failed left the copy claiming the id is
           simply not here. Found by a review arm. */
        if (current()) {
          channelListFailed = true;
          renderChannelHead();
          /* The feed carries the other half of that sentence. Rendering only the head left
             the head saying the list did not load while the feed still said the id is simply
             not here. Found by a review arm. */
          if (unknownChannelId !== null) renderFeed();
        }
        throw error;
      }
      if (!current()) return;
      channels = next;
      channelListFailed = false;
      /* A `?c=` that could not be resolved earlier gets one more chance against this list.
         The workspace open resolves the URL against the list it read, and that read can be
         dropped in favour of a newer one that has not landed yet, leaving a real id resolved
         against an empty list. It can also simply be a channel someone else created after
         this reader's list was read. Found by a review arm.
         It goes through selectChannel, not through applyChannelFromUrl: the head, the rail,
         the URL and the FEED have to move together. Resolving the id in place left the reader
         inside the channel with "Channel not found" still on the screen. */
      if (unknownChannelId !== null && channelById(channels, unknownChannelId) !== null) {
        selectChannel(unknownChannelId);
        return;
      }
      /* A channel that was archived while it was open stops being the active one: the rail
         no longer lists it and posting to it is refused. Its messages stay readable in
         all-signals, which is where the reader is sent. */
      if (activeChannelId !== null && activeChannel()?.archivedAt !== null) {
        selectChannel(null);
        return;
      }
      renderChannelRail();
      renderChannelHead();
      renderChannelDialog();
    };

    const closeConnect = (): void => {
      if (keepConnectCredentialVisible()) return;
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (connect?.dataset.state === "done") {
        connect.finishPrompt("back");
        return;
      }
      returnToChannel();
    };

    const createFromIntent = async (value: Session, intent: CreateIntent): Promise<void> => {
      const version = requestVersion;
      const userId = value.user.id;
      if (activeCreate?.version === version && activeCreate.userId === userId) return;
      const marker = { version, userId };
      activeCreate = marker;
      const isCurrent = (): boolean =>
        version === requestVersion && session?.user.id === userId;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const button = one<HTMLButtonElement>("[data-create-button]");
      if (input) {
        input.value = intent.name;
        input.disabled = true;
      }
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.textContent = "Creating your workspace…";
      }
      setCreateError(null);
      try {
        const made = await createWorkspace(
          value,
          intent.commandId,
          intent.workspaceId,
          intent.name,
        );
        if (!isCurrent()) return;
        clearCreateIntent(value.user.id);
        const madeWorkspace = {
          id: made.workspaceId,
          name: made.name,
          archived: false,
        };
        workspaces = [
          madeWorkspace,
          ...workspaces.filter((workspace) => workspace.id !== made.workspaceId),
        ];
        if (input) input.disabled = false;
        await openWorkspace(made.workspaceId);
      } catch (error) {
        if (!isCurrent()) return;
        renderCreate(
          value,
          `${readableError(error)} ${
            error instanceof WorkspaceLimitReached || error instanceof WorkspaceOutcomeUnknown
              ? ""
              : "Trying again checks the same request; it cannot create a duplicate."
          }`.trim(),
        );
      } finally {
        if (activeCreate === marker) activeCreate = null;
        if (!isCurrent()) return;
        if (input) input.disabled = false;
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.textContent = "Create workspace";
        }
      }
    };

    /* THE SAMPLE ROSTER, PER WORKSPACE. Kept out of `renderSample` so the workspace switch
       can apply it the way a real one does: the roster of the workspace being left goes, the
       screen paints with nothing known, and the new roster arrives on a later frame. */
