    const wirePopover = (triggerSel: string, popoverSel: string): void => {
      const trigger = one<HTMLButtonElement>(triggerSel);
      const popover = one<HTMLElement>(popoverSel);
      if (!trigger || !popover) return;
      const set = (open: boolean): void => {
        popover.hidden = !open;
        trigger.setAttribute("aria-expanded", open ? "true" : "false");
      };
      const close = (restoreFocus = false): void => {
        if (popover.hidden) return;
        set(false);
        if (restoreFocus) trigger.focus({ preventScroll: true });
      };
      trigger.addEventListener("click", () => {
        const willOpen = popover.hidden;
        set(willOpen);
        if (willOpen) {
          const first = popover.querySelector<HTMLElement>("button, a, [tabindex]");
          window.requestAnimationFrame(() => first?.focus({ preventScroll: true }));
        } else {
          trigger.focus({ preventScroll: true });
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || popover.hidden) return;
        event.preventDefault();
        close(true);
      });
      const dismiss = (event: Event): void => {
        if (popover.hidden) return;
        const target = event.target as Node;
        if (trigger.contains(target) || popover.contains(target)) return;
        close();
      };
      document.addEventListener("pointerdown", dismiss);
      document.addEventListener("focusin", dismiss);
