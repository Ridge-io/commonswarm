    const boot = async (): Promise<void> => {
      const version = ++requestVersion;
      if (!client()) {
        renderSample();
        return;
      }

      sampleMode = false;
      for (const button of all<HTMLButtonElement>("[data-signout]")) button.hidden = false;
      setLoading("Checking your sign-in…");
      try {
        session = await currentSession();
        if (version !== requestVersion) return;
        renderedAuthUserId = session?.user.id ?? "";
        if (!session) {
          resetWorkspaceSessionState();
          showAuthView("choices");
          showPanel("signed-out");
          return;
        }
        const who = accountName(session);
        for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
          target.textContent = who;
        }
        workspaces = await workspaceMemberships();
        if (version !== requestVersion) return;
        if (workspaces.length === 0) {
          resetWorkspaceSessionState();
          const pending = readCreateIntent(session.user.id);
          renderCreate(session);
          if (pending) await createFromIntent(session, pending);
          return;
        }
        const pending = readCreateIntent(session.user.id);
        if (pending && workspaces.some((workspace) => workspace.id === pending.workspaceId)) {
          clearCreateIntent(session.user.id);
        }
        await openWorkspace(workspaces[0]!.id);
      } catch (error) {
        if (version !== requestVersion) return;
        if (error instanceof SessionExpired) {
          session = null;
          renderedAuthUserId = "";
          resetWorkspaceSessionState();
          showAuthView("choices");
          showPanel("signed-out");
          authError(error.message);
          return;
        }
        if (session) {
          renderWorkspaceError(session, error);
        } else {
          resetWorkspaceSessionState();
          showAuthView("choices");
          showPanel("signed-out");
          authError(readableError(error));
        }
      }
    };

    const runBoot = (): void => {
      if (bootInFlight) {
        bootAgain = true;
        return;
      }
      bootInFlight = (async () => {
        do {
          bootAgain = false;
          await boot();
        } while (bootAgain);
      })().finally(() => {
        bootInFlight = null;
        if (bootAgain) runBoot();
      });
    };

    one<HTMLButtonElement>("[data-signin-github]")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      authError(null);
      try {
        await signInWithGitHub(new URL("/app", window.location.origin).href);
      } catch (error) {
        authError(readableError(error));
        button.disabled = false;
        button.removeAttribute("aria-busy");
      }
    });

    one<HTMLButtonElement>("[data-member-reauth-github]")?.addEventListener(
      "click",
      async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        try {
          await signInWithGitHub(new URL("/app", window.location.origin).href);
        } catch (error) {
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent = readableError(error);
            target.hidden = false;
          }
          button.disabled = false;
        }
      },
    );
    one<HTMLButtonElement>("[data-member-reauth-email]")?.addEventListener(
      "click",
      async (event) => {
        const email = window.prompt("Email address for a fresh sign-in link:");
        if (!email?.trim()) return;
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        try {
          await signInWithEmail(
            email.trim(),
            new URL("/app", window.location.origin).href,
          );
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent =
              "Check your email. After signing in, return here and press Remove again.";
            target.hidden = false;
          }
        } catch (error) {
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent = readableError(error);
            target.hidden = false;
          }
        } finally {
          button.disabled = false;
        }
      },
    );

    for (const button of all<HTMLButtonElement>("[data-use-email]")) {
      button.addEventListener("click", () => showAuthView("choices"));
    }

    one<HTMLFormElement>(".dashboard__email")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const input = form.elements.namedItem("email") as HTMLInputElement | null;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!input?.value.trim()) return;
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
      }
      authError(null);
      try {
        await signInWithEmail(input.value.trim(), new URL("/app", window.location.origin).href);
        const email = one<HTMLElement>("[data-auth-email]");
        if (email) email.textContent = input.value.trim();
        showAuthView("email-sent");
      } catch (error) {
        authError(readableError(error));
      } finally {
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      }
    });

    one<HTMLFormElement>("[data-create-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session) return;
      if (
        activeCreate?.version === requestVersion &&
        activeCreate.userId === session.user.id
      ) return;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const name = input?.value.trim() ?? "";
      if (!name) {
        setCreateError("Name the workspace first.");
        input?.focus();
        return;
      }
      const savedIntent = readCreateIntent(session.user.id);
      const intent: CreateIntent = savedIntent?.name === name
        ? savedIntent
        : {
            workspaceId: uuid(),
            commandId: uuid(),
            name,
          };
      writeCreateIntent(session.user.id, intent);
      await createFromIntent(session, intent);
    });

    for (const button of all<HTMLButtonElement>("[data-signout]")) {
      button.addEventListener("click", async () => {
        if (keepConnectCredentialVisible()) return;
        button.disabled = true;
        if (session) clearCreateIntent(session.user.id);
        requestVersion += 1;
        renderedAuthUserId = "";
        resetWorkspaceSessionState();
        await signOut();
        session = null;
        showAuthView("choices");
        showPanel("signed-out");
        button.disabled = false;
      });
    }

    one<HTMLFormElement>("[data-invite-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session || !activeWorkspaceId) return;
      const inviteSession = session;
      const submitOwner = {
        workspaceId: activeWorkspaceId,
        version: requestVersion,
      };
      const ownsInviteSubmit = (): boolean =>
        isInviteSubmitCurrent(submitOwner, activeWorkspaceId, requestVersion);
      const emailInput = one<HTMLInputElement>("[data-invite-email]");
      const submit = one<HTMLButtonElement>("[data-invite-submit]");
      const error = one<HTMLElement>("[data-invite-error]");
      const email = emailInput?.value.trim() ?? "";
      const emailValidationMessage = inviteEmailValidationMessage(email);
      if (emailValidationMessage) {
        if (error) {
          error.textContent = emailValidationMessage;
          error.hidden = false;
        }
        emailInput?.focus();
        return;
      }
      let submittedIntent = inviteIntent;
      if (!submittedIntent || submittedIntent.email !== email) {
        submittedIntent = { email, commandId: uuid() };
        inviteIntent = submittedIntent;
      }
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Creating a private link…";
      }
      try {
        const target = deployment();
        const workspace = workspaces.find((entry) => entry.id === submitOwner.workspaceId);
        if (!target || !workspace) throw new NoDeployment();
        const created = await inviteWorkspaceMember(
          inviteSession,
          submittedIntent.commandId,
          submitOwner.workspaceId,
          email,
        );
        /* A stale success may have created a pending row in the submitted workspace,
           where it remains visible and cancellable. Its one-use token is deliberately
           discarded: rendering or persisting it in the next workspace would cross the
           credential's tenancy boundary. */
        if (!ownsInviteSubmit()) return;
        if (created.workspaceId !== submitOwner.workspaceId) {
          throw new Error(
            "CommonSwarm returned an invite for another workspace. No link was shown.",
          );
        }
        freshInviteLink = memberInviteUrl(window.location.origin, {
          v: 1,
          url: target.url,
          anon_key: target.anonKey,
          workspace_id: created.workspaceId,
          invitation_token: created.invitationToken,
          workspace_name: created.workspaceName || workspace.name,
          inviter_display_name: created.inviterDisplayName || accountName(inviteSession),
          inviter_user_id: created.inviterUserId ?? inviteSession.user.id,
        });
        freshInviteId = created.invitationId;
        freshInviteWorkspaceId = created.workspaceId;
        if (inviteIntent === submittedIntent) inviteIntent = null;
        const link = one<HTMLElement>("[data-invite-link]");
        const result = one<HTMLElement>("[data-invite-result]");
        const form = one<HTMLFormElement>("[data-invite-form]");
        const receipt = one<HTMLElement>("[data-invite-receipt]");
        const copy = one<HTMLButtonElement>("[data-copy-invite]");
        const done = one<HTMLButtonElement>("[data-invite-done]");
        const status = one<HTMLElement>("[data-invite-status]");
        if (link) {
          link.textContent = freshInviteLink;
          link.hidden = false;
        }
        if (receipt) receipt.textContent = "Private one-use link · expires in 7 days";
        if (copy) {
          copy.textContent = "Copy invite link";
          delete copy.dataset.inviteComplete;
        }
        if (done) done.textContent = "Done";
        if (status) status.textContent = "";
        if (result) result.hidden = false;
        if (form) form.hidden = true;
        const nextInvites = await pendingMemberInvites(created.workspaceId);
        if (!ownsInviteSubmit()) return;
        pendingInvites = nextInvites;
        if (shouldRetireFreshInvite(freshInviteId, pendingInvites)) {
          retireFreshInviteResult();
        }
        renderPendingAccess();
        if (freshInviteLink) {
          window.requestAnimationFrame(() => {
            if (!ownsInviteSubmit()) return;
            one<HTMLButtonElement>("[data-copy-invite]")?.focus({ preventScroll: true });
          });
        }
      } catch (caught) {
        if (!ownsInviteSubmit()) return;
        if (
          inviteIntent === submittedIntent &&
          !(caught instanceof CommandOutcomeUnknown)
        ) {
          inviteIntent = null;
        }
        if (error) {
          error.textContent = readableError(caught);
          error.hidden = false;
        }
      } finally {
        if (ownsInviteSubmit()) resetInviteSubmitControl();
      }
    });

    one<HTMLButtonElement>("[data-copy-invite]")?.addEventListener("click", async (event) => {
      const status = one<HTMLElement>("[data-invite-status]");
      const button = event.currentTarget as HTMLButtonElement;
      if (button.dataset.inviteComplete === "true") {
        resetFreshInviteResult();
        returnToChannel();
        return;
      }
      if (!freshInviteLink) return;
      try {
        await navigator.clipboard.writeText(freshInviteLink);
        if (status) status.textContent = "Copied. Send this link to your teammate.";
      } catch {
        const link = one<HTMLElement>("[data-invite-link]");
        if (link) {
          const range = document.createRange();
          range.selectNodeContents(link);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        if (status) status.textContent = "The link is selected. Press ⌘C or Ctrl+C.";
      }
    });

    one<HTMLButtonElement>("[data-add-agent]")?.addEventListener("click", openAgentChoice);
    one<HTMLButtonElement>("[data-workspace-menu-trigger]")?.addEventListener(
      "click",
      toggleWorkspaceMenu,
    );
    one<HTMLButtonElement>("[data-workspace-menu-trigger]")?.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
        event.preventDefault();
        openWorkspaceMenu(event.key === "ArrowDown" ? "first" : "last");
      },
    );
    one<HTMLElement>("[data-workspace-menu]")?.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
      const items = workspaceMenuItems();
      if (items.length === 0) return;
      event.preventDefault();
      const activeIndex = items.indexOf(document.activeElement as HTMLButtonElement);
      const nextIndex = event.key === "Home"
        ? 0
        : event.key === "End"
        ? items.length - 1
        : event.key === "ArrowDown"
        ? (activeIndex + 1 + items.length) % items.length
        : (activeIndex - 1 + items.length) % items.length;
      items[nextIndex]?.focus({ preventScroll: true });
    });
    document.addEventListener("keydown", (event) => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      if (event.key !== "Escape" || !menu || menu.hidden) return;
      event.preventDefault();
      closeWorkspaceMenu(true);
    });
    document.addEventListener("pointerdown", (event) => {
      const root = one<HTMLElement>("[data-workspace-menu-root]");
      if (!root || root.contains(event.target as Node)) return;
      closeWorkspaceMenu();
    });
    document.addEventListener("focusin", (event) => {
      const root = one<HTMLElement>("[data-workspace-menu-root]");
      if (!root || root.contains(event.target as Node)) return;
      closeWorkspaceMenu();
    });
    one<HTMLButtonElement>("[data-new-workspace]")?.addEventListener(
      "click",
      openNewWorkspace,
    );
    one<HTMLButtonElement>("[data-create-cancel]")?.addEventListener("click", () => {
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      if (!selected) return;
      showPanel("channel");
      returnToChannel();
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-workspace-menu-trigger]")?.focus({ preventScroll: true });
      });
    });
    one<HTMLButtonElement>("[data-roster-open]")?.addEventListener("click", openRosterDialog);
    one<HTMLButtonElement>("[data-roster-close]")?.addEventListener("click", closeRosterDialog);
    one<HTMLButtonElement>("[data-entity-panel-close]")?.addEventListener(
      "click",
      () => closeEntityPanel(true),
    );
    document.addEventListener("keydown", (event) => {
      const panel = one<HTMLElement>("[data-entity-panel]");
      if (event.key !== "Escape" || !panel || panel.hidden) return;
      event.preventDefault();
      closeEntityPanel(true);
    });
    one<HTMLButtonElement>("[data-add-agent-dialog]")?.addEventListener("click", () => {
      closeRosterDialog();
      openAgentChoice();
    });
    one<HTMLInputElement>("[data-roster-search]")?.addEventListener("input", (event) => {
      rosterFilter = (event.currentTarget as HTMLInputElement).value;
      renderDialogRoster();
    });
    one<HTMLSelectElement>("[data-composer-audience]")?.addEventListener(
      "change",
      (event) => {
        const value = (event.currentTarget as HTMLSelectElement).value;
        if (value === "everyone") {
          composerAudience = { kind: "everyone" };
        } else if (value.startsWith("person:")) {
          composerAudience = { kind: "person", id: value.slice("person:".length) };
        } else if (value.startsWith("agent:")) {
          composerAudience = { kind: "agent", id: value.slice("agent:".length) };
        }
        composerIntent = null;
        renderComposerAudience();
      },
    );
    one<HTMLTextAreaElement>("[data-composer-input]")?.addEventListener(
      "input",
      (event) => {
        const input = event.currentTarget as HTMLTextAreaElement;
        input.style.blockSize = "auto";
        input.style.blockSize = `${Math.min(input.scrollHeight, 144)}px`;
        mentionPickerIndex = 0;
        renderMentionPicker();
      },
    );
    one<HTMLTextAreaElement>("[data-composer-input]")?.addEventListener(
      "keydown",
      (event) => {
        const input = event.currentTarget as HTMLTextAreaElement;
        const picker = one<HTMLElement>("[data-mention-picker]");
        if (event.key === "Backspace" && input.value === "" && composerMentions.length > 0) {
          composerMentions.pop();
          renderComposerMentions();
          return;
        }
        if (!picker || picker.hidden) return;
        const search = mentionSearch();
        const candidates = search ? mentionCandidates(search.query) : [];
        if (event.key === "Escape") {
          event.preventDefault();
          closeMentionPicker();
        } else if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          mentionPickerIndex = event.key === "ArrowDown"
            ? (mentionPickerIndex + 1) % candidates.length
            : (mentionPickerIndex - 1 + candidates.length) % candidates.length;
          renderMentionPicker();
        } else if (event.key === "Enter" && !event.shiftKey && candidates.length > 0) {
          event.preventDefault();
          const mention = candidates[mentionPickerIndex];
          if (mention) selectMention(mention);
        }
      },
    );
    one<HTMLFormElement>("[data-composer]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const send = one<HTMLButtonElement>("[data-composer-send]");
      const status = one<HTMLElement>("[data-composer-status]");
      const body = input?.value.trim() ?? "";
      if (!input || body === "" || !activeWorkspaceId) {
        input?.focus();
        return;
      }
      const audience = composerAudience;
      const audienceKey = composerAudienceKey(audience);
      let intent = composerIntent;
      if (!intent || intent.body !== body || intent.audienceKey !== audienceKey) {
        intent = { commandId: uuid(), body, audienceKey };
        composerIntent = intent;
      }
      const mentions = composerMentions.map((mention) => ({ ...mention }));
      if (send) send.disabled = true;
      input.disabled = true;
      if (status) status.textContent = "Posting…";
      try {
        const signal: Signal = sampleMode
          ? {
              id: `sample-composer-${Date.now()}`,
              from: "sample-owner",
              fromKind: "user",
              to: audience.kind === "person" ? audience.id : null,
              toAgent: audience.kind === "agent" ? audience.id : null,
              kind: "note",
              body,
              about: null,
              until: null,
              createdAt: new Date().toISOString(),
            }
          : await postBrowserSignal(
              session!,
              intent.commandId,
              activeWorkspaceId,
              body,
              audience.kind === "person" ? audience.id : null,
              audience.kind === "agent" ? audience.id : null,
            );
        visualMentions.set(signal.id, mentions);
        signals.unshift(signal);
        composerIntent = null;
        composerMentions = [];
        input.value = "";
        input.style.blockSize = "auto";
        renderComposerMentions();
        closeMentionPicker();
        renderFeed();
        if (status) status.textContent = "Posted.";
        input.focus({ preventScroll: true });
      } catch (caught) {
        if (!(caught instanceof CommandOutcomeUnknown)) composerIntent = null;
        if (status) status.textContent = readableError(caught);
      } finally {
        if (send) send.disabled = false;
        input.disabled = false;
      }
    });
    for (const button of all<HTMLButtonElement>("[data-feed-filter]")) {
      button.addEventListener("click", () => {
        const next = button.dataset.feedFilter;
        if (next !== "all" && next !== "broadcast" && next !== "direct-to-you") return;
        signalFilter = next;
        renderFeed();
      });
    }
    {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      /* A click landing on the dialog element itself is a click on the backdrop — the
         dialog's box did not catch it. */
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener("close", () => {
        one<HTMLButtonElement>("[data-roster-open]")?.setAttribute("aria-expanded", "false");
      });
    }
    one<HTMLButtonElement>("[data-close-agent-choice]")?.addEventListener("click", returnToChannel);
    one<HTMLButtonElement>("[data-agent-owner-self]")?.addEventListener("click", openConnect);
    one<HTMLButtonElement>("[data-agent-owner-teammate]")?.addEventListener("click", openInvite);
    one<HTMLButtonElement>("[data-close-invite]")?.addEventListener("click", openAgentChoice);
    one<HTMLButtonElement>("[data-invite-done]")?.addEventListener("click", () => {
      if (one<HTMLButtonElement>("[data-copy-invite]")?.dataset.inviteComplete === "true") {
        openInvite();
        return;
      }
      resetFreshInviteResult();
      returnToChannel();
    });
    one<HTMLButtonElement>("[data-close-connect]")?.addEventListener("click", closeConnect);
    one<HTMLButtonElement>("[data-copy-workspace-id]")?.addEventListener("click", async () => {
      const status = one<HTMLElement>("[data-workspace-id-status]");
      try {
        await navigator.clipboard.writeText(activeWorkspaceId);
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Could not copy";
      }
    });
    one<HTMLButtonElement>("[data-retry-workspace]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-retry-workspaces]")?.addEventListener("click", () => {
      runBoot();
    });
    one<HTMLButtonElement>("[data-refresh]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-load-older]")?.addEventListener("click", async (event) => {
      if (!activeWorkspaceId || !signalHasMore) return;
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      const button = event.currentTarget as HTMLButtonElement;
      const inlineError = one<HTMLElement>("[data-load-older-error]");
      if (inlineError) {
        inlineError.textContent = "";
        inlineError.hidden = true;
      }
      button.disabled = true;
      button.textContent = "Loading older updates…";
      try {
        await loadSignals(workspaceId, false, version);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        if (inlineError) {
          inlineError.textContent = `${readableError(error)} The loaded updates are still here.`;
          inlineError.hidden = false;
        }
      } finally {
        button.disabled = false;
        button.textContent = "Load older updates";
      }
    });

    app.addEventListener("commonswarm:agent-prompt-ready", async (event) => {
      const detail = (event as CustomEvent<{
        workspaceId?: unknown;
        principalId?: unknown;
      }>).detail;
      const workspaceId = detail?.workspaceId;
      if (
        typeof workspaceId !== "string" ||
        workspaceId !== activeWorkspaceId ||
        sampleMode
      ) return;
      if (typeof detail?.principalId === "string") {
        livePromptPrincipalId = detail.principalId;
      }
      const version = requestVersion;
      try {
        const [nextAgents, nextStatuses] = await Promise.all([
          roster(workspaceId),
          agentAccessStatuses(workspaceId),
        ]);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        accessStatuses = nextStatuses;
        renderRoster();
        renderPendingAccess();
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        if (refresh) refresh.hidden = agents.length === 0;
      } catch {
        /* The mint result remains on screen; a roster refresh must never erase its secret. */
      }
    });

    app.addEventListener("commonswarm:agent-secret-cleared", (event) => {
      const detail = (event as CustomEvent<{ reason?: unknown }>).detail;
      livePromptPrincipalId = "";
      const nextWorkspaceId = pendingWorkspaceId;
      pendingWorkspaceId = "";
      const createWorkspaceNext = pendingWorkspaceCreate;
      pendingWorkspaceCreate = false;
      if (nextWorkspaceId) {
        void openWorkspace(nextWorkspaceId);
        return;
      }
      if (createWorkspaceNext && session) {
        renderCreate(session);
        return;
      }
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      syncConnectWorkspace(selected);
      returnToChannel();
      const receipt = one<HTMLElement>("[data-channel-receipt]");
      if (receipt && detail?.reason === "consumed") {
        receipt.textContent = "Agent connected. Its one-time prompt has been cleared.";
        receipt.hidden = false;
        window.setTimeout(() => {
          receipt.hidden = true;
        }, 6_000);
      }
      void agentAccessStatuses(activeWorkspaceId).then((next) => {
        if (selected.id !== activeWorkspaceId) return;
        accessStatuses = next;
        renderPendingAccess();
      });
      window.requestAnimationFrame(() => {
        /* A plain focus(): the platform's heuristic decides the ring — this runs
           after the prompt completes, so a keyboard user following the flow sees
           where focus landed and a pointer user is not decorated. */
        one<HTMLElement>("[data-channel-name]")?.focus({ preventScroll: true });
      });
    });

    const queueAuthReload = (nextSession: Session | null): void => {
      const nextUserId = nextSession?.user.id ?? "";
      if (nextUserId === renderedAuthUserId || authReloadQueued) return;
      resetWorkspaceSessionState();
      renderedAuthUserId = nextUserId;
      requestVersion += 1;
      authReloadQueued = true;
      queueMicrotask(() => {
        authReloadQueued = false;
        runBoot();
      });
    };

    /* /start now preserves its query and hash while handing old callbacks to /app, so this
       listener is the one auth-return controller for both current and compatibility links. */
    client()?.auth.onAuthStateChange((event, nextSession) => {
      if (nextSession?.user.id === renderedAuthUserId) session = nextSession;
      if (
        event === "INITIAL_SESSION" ||
        event === "SIGNED_IN" ||
        event === "SIGNED_OUT"
      ) {
        queueAuthReload(nextSession);
      }
    });

    runBoot();
  }
</script>

<style is:global>
  .dashboard {
    --dashboard-rail: 18.5rem;
    position: relative;
    display: block;
    min-block-size: 100svh;
    color: var(--text);
    background: var(--bg);
    isolation: isolate;
  }

  .dashboard__wash {
    position: fixed;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        55rem 34rem at 4% -8%,
        color-mix(in oklab, var(--accent) 13%, transparent),
        transparent 72%
      ),
      linear-gradient(
        90deg,
        transparent 0,
        transparent calc(50% - 1px),
        color-mix(in oklab, var(--border) 30%, transparent) 50%,
        transparent calc(50% + 1px)
      );
    background-size: auto, 5rem 100%;
    mask-image: linear-gradient(to bottom, black, transparent 76%);
  }

  .dashboard[data-state="channel"] .dashboard__wash {
    display: none;
  }

  .dashboard [hidden] {
    display: none !important;
  }

  .dashboard__root {
    min-block-size: 100svh;
  }

  .dashboard__loading {
    min-block-size: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__spinner {
    display: inline-block;
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
    border: 2px solid var(--border-strong);
    border-block-start-color: var(--accent);
    border-radius: 50%;
    animation: dashboard-spin 700ms linear infinite;
  }

  @keyframes dashboard-spin {
    to {
      transform: rotate(1turn);
    }
  }

  .dashboard__wordmark {
    inline-size: fit-content;
    color: var(--text);
    font-size: var(--t-base);
    line-height: 1;
    font-weight: var(--weight-head);
    letter-spacing: var(--track-head);
    text-decoration: none;
    white-space: nowrap;
  }

  .dashboard__wordmark::after {
    content: "";
    display: block;
    inline-size: 1.45rem;
    block-size: 3px;
    margin-block-start: var(--s-2);
    border-radius: var(--radius-pill);
    background: var(--accent);
    transition: inline-size var(--dur-2) var(--ease-standard);
  }

  .dashboard__wordmark:hover::after {
    inline-size: 100%;
  }

  .dashboard__gateway {
    min-block-size: 100svh;
    display: grid;
    align-content: center;
    gap: var(--s-8);
    inline-size: min(100% - var(--gutter) * 2, 42rem);
    margin-inline: auto;
    padding-block: var(--s-12);
  }

  .dashboard__gateway-copy {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__eyebrow,
  .dashboard__channel-kicker {
    margin: 0;
    color: var(--accent-bright);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__gateway h1 {
    max-inline-size: 16ch;
    margin: 0;
    font-size: clamp(var(--t-2xl), 6vw, var(--t-4xl));
    line-height: 1.02;
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
    text-wrap: balance;
  }

  .dashboard__gateway-copy > p:last-child {
    max-inline-size: 55ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    text-wrap: pretty;
  }

  .dashboard__auth,
  .dashboard__create-form {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .dashboard__button,
  .dashboard__icon-button,
  .dashboard__workspace-trigger,
  .dashboard__workspace-button,
  .dashboard__workspace-create-button,
  .dashboard__rail-add,
  .dashboard__back-button,
  .dashboard__roster-button,
  .dashboard__text-button {
    font: inherit;
  }

  .dashboard__button {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: var(--t-sm);
    line-height: 1;
    font-weight: var(--weight-semibold);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard),
      transform var(--dur-2) var(--ease-standard);
  }

  .dashboard__button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .dashboard__button:disabled {
    opacity: 0.58;
    cursor: wait;
  }

  .dashboard__button--primary {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .dashboard__button--primary:hover:not(:disabled) {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  .dashboard__button--secondary {
    color: var(--text);
    background: var(--elev-2);
    border-color: var(--border-interactive);
  }

  .dashboard__text-button,
  .dashboard__back-button {
    min-block-size: 2.75rem;
    padding: var(--s-2);
    color: var(--text-muted);
    background: transparent;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .dashboard__text-button {
    white-space: nowrap;
  }

  .dashboard__text-button:hover,
  .dashboard__back-button:hover {
    color: var(--text);
  }

  .dashboard__email {
    display: grid;
    gap: var(--s-3);
    max-inline-size: 38rem;
  }

  .dashboard__email label,
  .dashboard__create-form label {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__email-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-3);
  }

  .dashboard__auth-note {
    max-inline-size: 58ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__auth-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-faint);
    font-size: var(--t-xs);
  }

  .dashboard__auth-divider::before,
  .dashboard__auth-divider::after {
    content: "";
    block-size: 1px;
    background: var(--border);
  }

  .dashboard__email input,
  .dashboard__create-form input {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-base);
  }

  .dashboard__email-sent {
    display: grid;
    gap: var(--s-2);
    max-inline-size: 38rem;
    padding: var(--s-5);
    border: 1px solid var(--accent-dim);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent-dim) 48%, var(--elev-1));
  }

  .dashboard__email-sent p {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-base);
  }

  .dashboard__email-sent-title {
    color: var(--text) !important;
    font-weight: var(--weight-semibold);
  }

  .dashboard__form-error {
    max-inline-size: 56ch;
    margin: 0;
    color: var(--danger);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__legal-note {
    max-inline-size: 42rem;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .dashboard__legal-note a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .dashboard__account-line {
    inline-size: fit-content;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__account-dot {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-dim);
  }

  .dashboard__create-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .dashboard__create-form label {
    grid-column: 1 / -1;
  }

  .dashboard__signout-link {
    inline-size: fit-content;
  }

  .dashboard__product {
    min-block-size: 100svh;
    padding: 0;
    background: var(--bg);
  }

  .dashboard__sample-notice {
    margin: 0;
  }

  .dashboard__frame {
    min-block-size: 100svh;
    display: grid;
    grid-template-columns: var(--dashboard-rail) minmax(0, 1fr);
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    box-shadow: none;
  }

  .dashboard__frame--entity-panel {
    grid-template-columns: var(--dashboard-rail) minmax(0, 1fr) minmax(18rem, 22rem);
  }

  .dashboard__sample-notice:not([hidden]) + .dashboard__frame {
    min-block-size: calc(100svh - 3.5rem);
  }

  .dashboard__rail {
    min-inline-size: 0;
    max-block-size: 100svh;
    display: flex;
    flex-direction: column;
    padding: var(--s-5) var(--s-4) var(--s-4);
    overflow-y: auto;
    border-inline-end: 1px solid var(--border);
    background: var(--bg-raised);
  }

  .dashboard__rail .dashboard__wordmark {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    letter-spacing: -0.02em;
  }

  .dashboard__rail .dashboard__wordmark::after {
    display: none;
  }

  .dashboard__workspace-control {
    position: relative;
    z-index: 4;
    min-inline-size: 0;
  }

  .dashboard__workspace-trigger {
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: color-mix(in oklab, var(--surface) 72%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    text-align: start;
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__workspace-trigger:hover,
  .dashboard__workspace-trigger[aria-expanded="true"] {
    background: var(--surface);
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }

  .dashboard__workspace-trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__workspace-trigger-name {
    min-inline-size: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--t-base);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.035em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__workspace-trigger svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    transition: transform var(--dur-2) var(--ease-standard);
  }

  .dashboard__workspace-trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .dashboard__workspace-menu {
    position: absolute;
    inset-block-start: calc(100% + var(--s-2));
    inset-inline: 0;
    z-index: 6;
    min-inline-size: 15rem;
    padding: var(--s-2);
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 1rem 2.5rem color-mix(in oklab, var(--text) 14%, transparent);
  }

  .dashboard__workspace-context {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-2) var(--s-4);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__workspace-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-1);
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    line-height: var(--lh-xs);
  }

  .dashboard__workspace-summary strong {
    color: inherit;
    font-weight: var(--weight-semibold);
  }

  .dashboard__sample-chip {
    padding: 0.2rem 0.45rem;
    color: var(--warning);
    background: var(--warning-dim);
    border-radius: var(--radius-pill);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__rail-section {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-1);
    border-block-start: 0;
  }

  .dashboard__rail-section + .dashboard__rail-section {
    border-block-start: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
  }

  .dashboard__rail-details-body {
    display: grid;
    gap: var(--s-3);
  }

  .dashboard__rail-details {
    padding-block: var(--s-4);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__rail-details > summary {
    min-block-size: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .dashboard__rail-details > summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__rail-details-body {
    padding-block-start: var(--s-3);
  }

  .dashboard__workspace-id {
    max-inline-size: 100%;
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__copy-status {
    min-block-size: 1em;
    color: var(--text-muted);
    font-size: var(--t-2xs);
  }

  .dashboard__rail-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__rail-label-row h2,
  .dashboard__rail-label-row span {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    line-height: var(--lh-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__rail-label-row h2 span {
    color: var(--text-faint);
    font-size: inherit;
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .dashboard__sidebar-place {
    min-block-size: 2.25rem;
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    color: var(--text);
    border-radius: var(--radius-sm);
    font-size: var(--t-sm);
    font-weight: var(--weight-medium);
  }

  .dashboard__sidebar-place[aria-current="page"] {
    background: color-mix(in oklab, var(--text) 6%, transparent);
  }

  .dashboard__sidebar-place-mark {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-base);
    text-align: center;
  }

  .dashboard__sidebar-agent-list {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__sidebar-agent-list {
    block-size: 14rem;
    max-block-size: 14rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }

  .dashboard__sidebar-person,
  .dashboard__sidebar-agent {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
  }

  .dashboard__sidebar-person-avatar,
  .dashboard__sidebar-agent-avatar {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    display: grid;
    place-items: center;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: var(--weight-semibold);
  }

  .dashboard__sidebar-agent-avatar {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }

  .dashboard__sidebar-agent-avatar.dashboard__avatar--tinted {
    background: color-mix(in oklab, hsl(var(--avatar-hue) 58% 48%) 18%, var(--surface));
    border-color: color-mix(in oklab, hsl(var(--avatar-hue) 70% 42%) 50%, var(--border));
  }

  .dashboard__sidebar-avatar-wrap {
    position: relative;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    display: grid;
    place-items: center;
  }

  .dashboard__presence-dot {
    position: absolute;
    inset-inline-end: -0.08rem;
    inset-block-end: -0.08rem;
    inline-size: 0.52rem;
    block-size: 0.52rem;
    border: 2px solid var(--bg-raised);
    border-radius: 50%;
    background: var(--success);
  }

  .dashboard__sidebar-participant-copy {
    min-inline-size: 0;
    display: grid;
    gap: 0.08rem;
  }

  .dashboard__sidebar-participant-copy > strong {
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__sidebar-agent .dashboard__sidebar-participant-copy > strong {
    font-weight: var(--weight-medium);
  }

  .dashboard__sidebar-participant-copy > span {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: var(--s-1);
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.62rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__agent-ownership-note {
    margin: var(--s-1) var(--s-2) 0;
    color: var(--text-faint);
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .dashboard__workspace-list {
    display: grid;
    gap: var(--s-1);
    max-block-size: min(40svh, 20rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .dashboard__workspace-button,
  .dashboard__workspace-create-button {
    min-inline-size: 0;
    min-block-size: 2.25rem;
    display: grid;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    text-align: start;
    cursor: pointer;
  }

  .dashboard__workspace-button {
    inline-size: 100%;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .dashboard__workspace-button > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__workspace-button:hover,
  .dashboard__workspace-create-button:hover {
    color: var(--text);
    background: var(--elev-2);
  }

  .dashboard__workspace-button:focus-visible,
  .dashboard__workspace-create-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__workspace-button[aria-checked="true"] {
    color: var(--text);
    background: color-mix(in oklab, var(--text) 6%, transparent);
  }

  .dashboard__workspace-check {
    color: var(--accent);
    opacity: 0;
  }

  .dashboard__workspace-button[aria-checked="true"] .dashboard__workspace-check {
    opacity: 1;
  }

  .dashboard__workspace-menu-create {
    margin-block-start: var(--s-2);
    padding-block-start: var(--s-2);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__workspace-create-button {
    inline-size: 100%;
    grid-template-columns: auto minmax(0, 1fr);
    color: var(--text);
    font-weight: var(--weight-medium);
  }

  .dashboard__workspace-create-button > span:first-child {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--t-base);
  }

  .dashboard__agent-list {
    display: grid;
    gap: var(--s-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dashboard__agent {
    min-inline-size: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
  }

  [data-member-list] > .dashboard__agent {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  [data-member-list] > .dashboard__agent > span {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Pending rows have copy first and an action second (unlike roster rows, whose
     first cell is an avatar). Give the action its intrinsic width so "Cancel"
     stays horizontal while the identity copy takes the remaining space. */
  .dashboard__pending-access-row {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .dashboard__pending-access-row > .dashboard__text-button {
    white-space: nowrap;
  }

  .dashboard__agent-avatar,
  .dashboard__message-avatar {
    inline-size: 2rem;
    block-size: 2rem;
    display: grid;
    place-items: center;
    flex: none;
    color: var(--text);
    background: var(--elev-3);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
  }

  /* The tint carries the per-agent identity now that the shape is fixed to the circle.
     Initials use --text rather than a pastel of the hue: the pastel was tuned for the
     dark palette and washed out on the light tint, while --text clears 16:1 on every
     surface in both modes. The hue still distinguishes agents in the fill and the ring. */
  .dashboard__agent-avatar.dashboard__avatar--tinted,
  .dashboard__message-avatar.dashboard__avatar--tinted {
    color: var(--text);
    background: color-mix(in oklab, hsl(var(--avatar-hue) 58% 48%) 20%, var(--elev-3));
    border-color: color-mix(in oklab, hsl(var(--avatar-hue) 70% 58%) 52%, var(--border));
  }

  .dashboard__agent-copy {
    min-inline-size: 0;
    display: grid;
  }

  .dashboard__agent-copy strong {
    overflow: hidden;
    color: var(--text);
    font-size: var(--t-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__agent-copy span,
  .dashboard__agent-empty {
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__agent-empty {
    padding: var(--s-2) var(--s-3);
    font-style: italic;
  }

  .dashboard__rail-add {
    min-block-size: 2.75rem;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    background: transparent;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: start;
    cursor: pointer;
  }

  .dashboard__rail-add:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .dashboard__rail-foot {
    display: grid;
    gap: var(--s-3);
    /* The agents section used to flex:1 the footer to the bottom; with the roster moved
       to the header dialog, the footer's own margin does the pinning now. */
    margin-block-start: auto;
    padding: var(--s-3) var(--s-2) 0;
    border-block-start: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--t-xs);
  }

  .dashboard__rail-account {
    min-inline-size: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .dashboard__theme-toggle {
    inline-size: fit-content;
    min-block-size: 2rem;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    color: var(--text-muted);
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    font: inherit;
    cursor: pointer;
  }

  .dashboard__theme-toggle:hover {
    color: var(--text);
    background: var(--surface);
  }

  .dashboard__theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__theme-toggle svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .dashboard__theme-toggle path {
    fill: currentColor;
    stroke: none;
  }

  .dashboard__rail-account > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dashboard__channel {
    min-inline-size: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: var(--surface);
  }

  .dashboard__entity-panel {
    min-inline-size: 0;
    max-block-size: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    background: var(--surface-3);
    border-inline-start: 1px solid var(--border);
  }

  .dashboard__entity-panel-head {
    min-block-size: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__entity-panel-head p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__entity-panel-body {
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .dashboard__entity-identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-4);
  }

  .dashboard__entity-avatar {
    inline-size: 3rem;
    block-size: 3rem;
    display: grid;
    place-items: center;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__entity-avatar.dashboard__avatar--tinted {
    background: color-mix(in oklab, hsl(var(--avatar-hue) 58% 48%) 20%, var(--surface-2));
    border-color: color-mix(in oklab, hsl(var(--avatar-hue) 70% 58%) 52%, var(--border));
  }

  .dashboard__entity-identity h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-badge {
    color: var(--text-muted);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-xs);
  }

  .dashboard__entity-revoked {
    margin: 0 var(--s-4) var(--s-4);
    padding: var(--s-3);
    color: var(--danger);
    background: var(--danger-dim);
    border: 1px solid color-mix(in oklab, var(--danger) 42%, var(--border));
    border-radius: var(--radius-sm);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
  }

  .dashboard__entity-section {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-4);
    border-block-start: 1px solid var(--border);
  }

  .dashboard__entity-section h3 {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__entity-section > p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
  }

  .dashboard__entity-link,
  .dashboard__entity-agent-link,
  .dashboard__message-entity {
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    font: inherit;
    font-weight: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
    text-underline-offset: 0.16em;
    cursor: pointer;
  }

  .dashboard__entity-link:hover,
  .dashboard__entity-agent-link:hover,
  .dashboard__message-entity:hover {
    color: var(--accent-bright);
    text-decoration-color: currentColor;
  }

  .dashboard__entity-link:focus-visible,
  .dashboard__entity-agent-link:focus-visible,
  .dashboard__message-entity:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__entity-section dl {
    display: grid;
    grid-template-columns: minmax(6rem, auto) minmax(0, 1fr);
    gap: var(--s-2) var(--s-3);
    margin: 0;
    font-size: var(--t-xs);
  }

  .dashboard__entity-section dt {
    color: var(--text-muted);
  }

  .dashboard__entity-section dd {
    min-inline-size: 0;
    margin: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-id summary {
    inline-size: fit-content;
    color: var(--text);
    font-family: var(--font-mono);
    cursor: pointer;
  }

  .dashboard__entity-id code {
    display: block;
    margin-block-start: var(--s-2);
    color: var(--text-muted);
    font-size: var(--t-2xs);
    overflow-wrap: anywhere;
  }

  .dashboard__entity-agent-list {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-sm);
    list-style: none;
  }

  .dashboard__entity-agent-link {
    color: var(--text);
  }

  .dashboard__channel-head {
    min-block-size: 6.25rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    padding: var(--s-4) clamp(var(--s-5), 4vw, var(--s-8));
    border-block-end: 1px solid var(--border);
  }

  .dashboard__channel-titleblock {
    min-inline-size: 0;
    display: grid;
    gap: var(--s-1);
  }

  .dashboard__channel-kicker {
    margin-block-end: var(--s-1);
    font-size: var(--t-2xs);
  }

  .dashboard__channel-head h1 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--t-lg);
    line-height: var(--lh-xl);
    letter-spacing: var(--track-head);
    overflow-wrap: anywhere;
  }

  .dashboard__channel-description {
    max-inline-size: 64ch;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
  }

  .dashboard__channel-actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--text-muted);
    font-size: var(--t-xs);
    white-space: nowrap;
  }

  /* The live affordance: the same pulse idiom the landing FeedPanel uses for a
     signal that just landed, reused here as a standing state. motion.css stills
     the pulse under prefers-reduced-motion; the dot itself stays. */
  .dashboard__live {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    /* Same flex-child floor as the choice copy: the chip must be allowed to give
       up width (and let the actions row wrap below 34rem) rather than hold it. */
    min-inline-size: 0;
    color: var(--success);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .dashboard__live-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    animation: dashboard-live-pulse 2.6s var(--ease-standard) infinite;
  }

  @keyframes dashboard-live-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--success-dim);
    }
    70% {
      box-shadow: 0 0 0 6px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* --- the header agent roster: one stack button + its dialog ----------------------- */

  /* The stack sits between the title and the actions while there is room, glued right;
     at ≤52rem it takes its own row (see the media query) so it never squeezes out. */
  .dashboard__channel-roster {
    flex: none;
    min-inline-size: 0;
    margin-inline-start: auto;
  }

  .dashboard__roster-button {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  .dashboard__roster-button:hover {
    background: var(--elev-3);
    border-color: var(--border-strong);
  }

  .dashboard__roster-button--pending {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }

  .dashboard__roster-button:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .dashboard__roster-stack {
    display: flex;
    align-items: center;
  }

  /* The overlap ring reads as a cut between neighbours when it matches the button's own
     fill, so it follows the hover fill too. */
  .dashboard__roster-stack .dashboard__agent-avatar {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border: 2px solid var(--elev-2);
    margin-inline-start: -0.5rem;
  }

  .dashboard__roster-stack .dashboard__agent-avatar:first-child {
    margin-inline-start: 0;
  }

  .dashboard__roster-button:hover .dashboard__roster-stack .dashboard__agent-avatar {
    border-color: var(--elev-3);
  }

  .dashboard__roster-count {
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  /* The dialog. Native <dialog>: the UA centers it over a backdrop and owns Escape,
     focus containment, and focus restore; the styles only make it ours. At ≤52rem the
     same element becomes a bottom sheet rather than a second component. */
  .dashboard__roster-dialog {
    inline-size: min(calc(100% - var(--s-8)), 26rem);
    max-inline-size: calc(100% - var(--s-8));
    max-block-size: min(42rem, calc(100dvh - var(--s-8)));
    /* global.css's universal * { margin: 0 } beats the UA's dialog-centering margin:auto,
       so centering is restated here; the ≤52rem sheet re-anchors it to the bottom. */
    margin: auto;
    padding: 0;
    color: var(--text);
    background: var(--elev-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dashboard__roster-dialog::backdrop {
    background: color-mix(in oklab, var(--text) 32%, transparent);
  }

  .dashboard__roster-dialog[open] {
    animation: dashboard-dialog-in var(--dur-3) var(--ease-decelerate);
  }

  @keyframes dashboard-dialog-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .dashboard__roster-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-block-end: 1px solid var(--border);
  }

  .dashboard__roster-dialog-head h2 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text);
    font-size: var(--t-lg);
    line-height: var(--lh-lg);
    letter-spacing: var(--track-head);
  }

  .dashboard__roster-dialog-count {
    color: var(--text-muted);
    font-size: var(--t-sm);
    font-weight: var(--weight-medium);
  }

  .dashboard__roster-dialog-body {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5) var(--s-5);
  }

  .dashboard__roster-dialog-add {
    inline-size: 100%;
  }

  .dashboard__roster-dialog-search {
    min-block-size: 2.75rem;
    inline-size: 100%;
    padding: var(--s-2) var(--s-3);
    color: var(--text);
    background: var(--elev-1);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius);
    font: inherit;
    font-size: var(--t-sm);
  }

  /* The roster scrolls inside the dialog rather than growing it past the viewport. */
  .dashboard__roster-dialog-list {
    max-block-size: min(46svh, 20rem);
    overflow: auto;
    margin-inline: calc(var(--s-2) * -1);
  }

  /* Pending access in the dialog exists only where the rail's own details are
     hidden. At desktop the rail keeps the control and the dialog does not
     duplicate it; at ≤52rem this section is the ONLY reachable pending surface.
     The [hidden] case (nothing pending, or sample) stays hidden by the global
     [hidden] rule in every width. */
  .dashboard__roster-dialog-pending {
    display: none;
  }

  /* The dialog becomes a column so the body can scroll when the pending section
     makes the content taller than the sheet. Scoped to [open]: an unscoped
     display would override the UA's dialog:not([open]){display:none} and show
     the dialog permanently. */
  .dashboard__roster-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .dashboard__roster-dialog-body {
    min-block-size: 0;
    overflow-y: auto;
  }

  .dashboard__roster-dialog-pending-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
  }

  .dashboard__roster-dialog-pending-count {
    color: var(--text-muted);
    font-size: var(--t-xs);
    font-weight: var(--weight-medium);
  }

  .dashboard__roster-dialog-pending-list {
    max-block-size: 12rem;
    overflow: auto;
    margin-inline: calc(var(--s-2) * -1);
  }

  .dashboard__roster-dialog-pending-list .dashboard__agent {
    border-radius: var(--radius-sm);
  }

  @media (max-width: 52rem) {
    .dashboard__roster-dialog-pending {
      display: grid;
      gap: var(--s-2);
      padding-block-start: var(--s-3);
      border-block-start: 1px solid var(--border);
    }
  }

  .dashboard__roster-dialog-list .dashboard__agent {
    grid-template-columns: auto minmax(0, 1fr) auto;
    border-radius: var(--radius-sm);
  }

  .dashboard__mobile-signout {
    display: none;
    min-block-size: 2.75rem;
    align-items: center;
  }

  .dashboard__mobile-signout[hidden] {
    display: none;
  }

  .dashboard__icon-button {
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .dashboard__icon-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dashboard__icon-button:hover {
    color: var(--text);
    background: var(--elev-3);
  }

  .dashboard__channel-body {
    min-block-size: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
  }

  .dashboard__channel-body > [data-channel-view] {
    grid-area: 1 / 1;
    overflow: auto;
  }

  .dashboard__channel-empty {
    place-self: center;
    display: grid;
    justify-items: start;
    gap: var(--s-4);
    inline-size: min(100% - var(--s-10), 36rem);
    padding-block: var(--s-12);
  }

  .dashboard__channel-empty h2,
  .dashboard__feed-state h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
    font-weight: var(--weight-head);
  }

  .dashboard__channel-empty > p:not(.dashboard__eyebrow),
  .dashboard__feed-state p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--t-base);
    line-height: var(--lh-base);
    text-wrap: pretty;
  }

  .dashboard__empty-orbit {
    position: relative;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--elev-2);
  }

  .dashboard__empty-orbit::before,
  .dashboard__empty-orbit span {
    content: "";
    position: absolute;
    inline-size: 0.65rem;
    block-size: 0.65rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-dim);
  }

  .dashboard__empty-orbit::before {
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
  }

  .dashboard__empty-orbit span:nth-child(1) {
    inset: 0.35rem auto auto 0.55rem;
    opacity: 0.35;
  }

  .dashboard__empty-orbit span:nth-child(2) {
    inset: auto 0.4rem 0.7rem auto;
    opacity: 0.2;
  }

  .dashboard__empty-orbit span:nth-child(3) {
    display: none;
  }

  .dashboard__connect-view {
    min-inline-size: 0;
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .dashboard__channel-receipt {
    z-index: 3;
    grid-area: 1 / 1;
    align-self: start;
    justify-self: center;
    margin: var(--s-4);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
    background: color-mix(in oklab, var(--success-dim) 82%, var(--elev-2));
    border: 1px solid color-mix(in oklab, var(--success) 40%, var(--border));
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    font-size: var(--t-sm);
  }

  .dashboard__choice-view,
  .dashboard__invite-view {
    /* The gap was declared without a display, so it never applied: these sections
       stayed block boxes and their children touched — most visibly the invite
       form's "Their email" label crowding the intro paragraph. The grid makes
       the declared rhythm real. */
    display: grid;
    align-content: start;
    gap: var(--s-6);
  }

  /* Inside the grid the back button's own trailing margin would stack on the
     gap; the connect view keeps the margin because it is not a grid. */
  .dashboard__choice-view .dashboard__back-button,
  .dashboard__invite-view .dashboard__back-button {
    margin-block-end: 0;
  }

  .dashboard__choice-copy {
    display: grid;
    gap: var(--s-3);
    max-inline-size: 42rem;
  }

  .dashboard__choice-copy h2 {
    margin: 0;
    color: var(--text);
    font-size: var(--t-2xl);
    line-height: var(--lh-2xl);
    letter-spacing: var(--track-head);
  }

  .dashboard__choice-copy > p:last-child {
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-base);
  }

  .dashboard__choice-list {
    display: grid;
