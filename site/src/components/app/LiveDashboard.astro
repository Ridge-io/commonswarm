---
/*
 * /app is the product surface. The browser owns the state machine because the page is
 * statically built while auth, workspaces, agents, and signals belong to the signed-in
 * session. Static markup contains every panel so focus, loading, and failure states stay
 * styled even before data arrives; dynamic values are written with textContent only.
 *
 * The workspace view follows the operator's Slack-shaped room model: a rail groups streams,
 * people, and agent presence while the signal feed remains the primary surface. Agent
 * management stays in the header dialog. The rail presence list shrinks to its contents and
 * scrolls inside a fixed maximum height when the roster grows. Workspace file artifacts use
 * the same rail-and-view pattern; upload remains deliberately absent in v1.
 *
 * Keep the older-message control above the list, where older rows appear. A control below the
 * list makes a click look idle because the reader stays pinned to the newest row.
 */

import AgentConnect from "../connect/AgentConnect.astro";
import ProviderButtons from "../auth/ProviderButtons.astro";
import SampleNotice from "./SampleNotice.astro";
import { SIGNAL_BODY_MAX } from "../../../../supabase/functions/_shared/signal-text";
/* The name of the unfiltered view, in the markup as well as in the script. It was typed in
   three places and generated in the script, so the static "# all-signals" even carried a
   space the rendered one does not. Both review arms called it. */
import { ALL_SIGNALS_SLUG, channelLabel } from "../../lib/channels";
import { THREAD_REPLY_CANCEL_LABEL } from "../../lib/thread-reply";
import "../../styles/tokens.css";
---

<live-dashboard class="dashboard" data-state="loading">
  <div class="dashboard__wash" aria-hidden="true"></div>

  <div class="dashboard__root">
    <section class="dashboard__loading" data-panel="loading" role="status" aria-live="polite">
      <span class="dashboard__spinner" aria-hidden="true"></span>
      <span data-loading-label>Opening CommonSwarm…</span>
    </section>

    <section
      class="dashboard__gateway"
      data-panel="signed-out"
      data-signed-out-onramp
      aria-labelledby="dashboard-signin-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow">CommonSwarm</p>
        <h1 id="dashboard-signin-title">Sign up or log in</h1>
        <p>
          Use your email to create an account or log in.
          Your free account includes up to ten workspaces, no card.
        </p>
      </div>

      <form class="dashboard__auth dashboard__email" data-auth-view="choices">
        <label for="dashboard-email">Email address</label>
        <div class="dashboard__email-row">
          <input
            id="dashboard-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            placeholder="you@example.com"
          />
          <button class="dashboard__button dashboard__button--primary" type="submit">
            Email me a sign-in link
          </button>
        </div>
        <p class="dashboard__auth-note">No password. The link returns you to this page.</p>
        <div class="dashboard__auth-divider" aria-hidden="true"><span>or</span></div>
        <button
          class="dashboard__button dashboard__button--secondary"
          type="button"
          data-signin-github
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          Sign in with GitHub
        </button>
      </form>

      <div class="dashboard__auth dashboard__email-sent" data-auth-view="email-sent" hidden>
        <p class="dashboard__email-sent-title">Check your inbox.</p>
        <p>
          We sent a sign-in link to <strong data-auth-email>your email</strong>. Open it in this
          browser — it brings you straight back here.
        </p>
        <button class="dashboard__text-button" type="button" data-use-email>
          Use a different address
        </button>
      </div>

      <p class="dashboard__form-error" role="alert" data-auth-error hidden></p>
      <p class="dashboard__legal-note">
        By continuing you acknowledge the
        <a href="/terms">Terms of Service</a>
        and
        <a href="/privacy">Privacy Policy</a>
        drafts published for review (not yet in force).
      </p>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="create"
      aria-labelledby="dashboard-create-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy">
        <h1 id="dashboard-create-title" data-create-title>Name your workspace.</h1>
        <p data-create-description>
          People and AI agents share one feed here.
        </p>
      </div>
      <form class="dashboard__create-form" data-create-form>
        <input
          id="dashboard-workspace-name"
          name="workspace-name"
          type="text"
          aria-label="Workspace name"
          maxlength="80"
          autocomplete="off"
          required
          spellcheck="false"
        />
        <button class="dashboard__button dashboard__button--primary" type="submit" data-create-button>
          Create workspace
        </button>
      </form>
      <p class="dashboard__form-error" role="alert" data-create-error hidden></p>
      <button class="dashboard__text-button" type="button" data-create-cancel hidden>
        Back to workspace
      </button>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="workspace-error"
      aria-labelledby="dashboard-workspace-error-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy" role="alert">
        <p class="dashboard__eyebrow">Workspace check interrupted</p>
        <h1 id="dashboard-workspace-error-title">Your workspaces could not load.</h1>
        <p data-workspace-error>
          CommonSwarm could not check your memberships. Nothing was created or changed.
        </p>
      </div>
      <button
        class="dashboard__button dashboard__button--primary"
        type="button"
        data-retry-workspaces
      >
        Try again
      </button>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section class="dashboard__product" data-panel="channel" hidden>
      {/* THIS PAGE IS NOT WHAT THE SERVER IS SERVING. Not "newer": a rollback is this too, which
          is why the bar does not say "new". Placed BEFORE the sample notice on
          purpose: `.dashboard__sample-notice:not([hidden]) + .dashboard__frame` is a real rule
          below, and putting this between them would quietly stop it matching. */}
      <div class="dashboard__update-notice" data-update-notice hidden>
        {/* "Out of date", not "new". What the page detects is that it is not running what the
            server is serving, and a rollback is that too — the older wording called a rollback a
            new version. One short line, because the buttons already say what the choices are:
            measured at 390x844, longer wording wrapped to two lines and took the bar to 128px
            against a 73px app bar. */}
        <p class="dashboard__update-notice-text">This page is out of date.</p>
        <div class="dashboard__update-notice-actions">
          <button
            class="dashboard__button dashboard__button--secondary"
            type="button"
            data-update-dismiss
          >
            Not now
          </button>
          <button class="dashboard__button" type="button" data-update-reload>Update</button>
        </div>
      </div>

      <div class="dashboard__sample-notice" data-sample-notice hidden>
        <SampleNotice />
      </div>

      <div class="dashboard__frame">
        <aside class="dashboard__rail" aria-label="Workspace navigation and details">
          <div class="dashboard__workspace-control" data-workspace-menu-root>
            <button
              class="dashboard__workspace-trigger"
              type="button"
              data-workspace-menu-trigger
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="dashboard-workspace-menu"
              aria-label="Current workspace: Workspace. Choose workspace"
            >
              <span class="dashboard__workspace-trigger-name" data-sidebar-workspace-name>Workspace</span>
              <span class="dashboard__sample-chip" data-sample-chip hidden>Sample</span>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="m4 6 4 4 4-4"></path>
              </svg>
            </button>
            {/* The settings trigger stays beside the workspace name. Its dialog lives
                outside the scrolling rail so the rail cannot clip the settings surface. */}
            <button
              class="dashboard__gear-button"
              type="button"
              data-workspace-details-trigger
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="dashboard-workspace-details"
              aria-label="Workspace settings"
              title="Workspace settings"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.09a2 2 0 0 1 1 1.74v.5a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
            <div
              class="dashboard__workspace-menu"
              id="dashboard-workspace-menu"
              data-workspace-menu
              role="menu"
              aria-label="Choose a workspace"
              hidden
            >
              <div class="dashboard__workspace-list" data-workspace-list></div>
              <div class="dashboard__workspace-menu-create">
                <button
                  class="dashboard__workspace-create-button"
                  type="button"
                  role="menuitem"
                  data-new-workspace
                >
                  <span aria-hidden="true">+</span>
                  <span>New workspace</span>
                </button>
                {/* The phone's door to workspace settings. The gear beside the workspace name
                    is 55px of a bar that has to hold the name, the view switcher and the
                    account control on one line, so below 52rem the gear goes and this item
                    opens the same dialog. It is display:none above that width, where the gear
                    is still there. */}
                <button
                  class="dashboard__workspace-create-button dashboard__workspace-settings-item"
                  type="button"
                  role="menuitem"
                  data-workspace-settings-item
                >
                  <span aria-hidden="true">⚙</span>
                  <span>Workspace settings</span>
                </button>
              </div>
            </div>
          </div>

          {/* The phone's view switcher. It lives in the app bar, not in the channel head,
              because the operator's rule is that the whole mobile header is ONE row — the
              row with the workspace name and the account control. These buttons are
              `display: none` above 52rem, where the rail's own STREAMS and ARTIFACTS lists
              are the navigation, so this placement costs the desktop nothing. They carry the
              same `data-workspace-view` values the rail buttons do and the same listener
              loop keeps `aria-current` in step. */}
          <nav class="dashboard__rail-tabs" aria-label="Workspace views">
            <button
              class="dashboard__text-button dashboard__mobile-view"
              type="button"
              data-workspace-view="signals"
              aria-current="page"
            >
              Signals
            </button>
            <button
              class="dashboard__text-button dashboard__mobile-view"
              type="button"
              data-workspace-view="files"
            >
              Files
            </button>
            <button
              class="dashboard__text-button dashboard__mobile-view"
              type="button"
              data-workspace-view="brain"
            >
              Brain
            </button>
          </nav>

          <section class="dashboard__workspace-context" aria-label="Workspace signal summary">
            <p class="dashboard__workspace-summary">
              Broadcasts <strong data-broadcast-count>0</strong>
              <span aria-hidden="true">·</span>
              Direct signals <strong data-direct-count>0</strong>
            </p>
          </section>

          {/* ~~STREAMS (broadcast)~~ retired 2026-09-05. "stream" is the event log on the
              wire and in SWARM-CLOUD.md 2.1, and this was the only place the app showed that
              word to a reader. A channel is the ADDRESS of a message, never a scope on who
              may read it: every member reads every channel, and all-signals is the whole
              feed rather than a channel among them, which is why the edge reserves its
              name. */}
          <nav class="dashboard__rail-section dashboard__rail-section--places" aria-labelledby="dashboard-channels-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-channels-label">CHANNELS</h2>
              <button
                class="dashboard__icon-button dashboard__rail-section-add"
                type="button"
                data-channel-new
                aria-label="New channel"
                title="New channel"
              >
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
              </button>
            </div>
            <button
              class="dashboard__sidebar-place"
              type="button"
              data-workspace-view="signals"
              data-channel-place=""
              aria-current="page"
            >
              <span class="dashboard__sidebar-place-mark" aria-hidden="true">#</span>
              <span>{ALL_SIGNALS_SLUG}</span>
            </button>
            {/* Live channels, rendered from swarm_read.channels. Archived ones are read but
                not listed: their messages and their permalinks still resolve. */}
            <div data-channel-list></div>
          </nav>

          <nav class="dashboard__rail-section dashboard__rail-section--places" aria-labelledby="dashboard-files-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-files-label">ARTIFACTS</h2>
            </div>
            <button
              class="dashboard__sidebar-place"
              type="button"
              data-workspace-view="files"
            >
              <span class="dashboard__sidebar-place-mark" aria-hidden="true">↧</span>
              <span>Files</span>
            </button>
            <button
              class="dashboard__sidebar-place"
              type="button"
              data-workspace-view="brain"
            >
              <span class="dashboard__sidebar-place-mark" aria-hidden="true">◇</span>
              <span>Brain</span>
            </button>
          </nav>

          <section class="dashboard__rail-section dashboard__rail-section--participants" aria-labelledby="dashboard-participants-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-participants-label">PEOPLE &amp; AGENTS</h2>
            </div>
            <ul class="dashboard__sidebar-agent-list" data-sidebar-participant-list></ul>
            <p class="dashboard__agent-ownership-note">
              Every agent belongs to a person. Workspace-owned agents are not supported yet.
            </p>
          </section>

          {/* Manage people, Pending access, and Workspace details left the rail
              (operator direction 2026-08-19): member management folded into the
              header People & agents dialog, pending access already mirrored there,
              workspace details into the gear dialog outside the rail. The rail bottom is now
              just the user-menu button. */}
          <div class="dashboard__rail-foot" data-user-menu-root>
            <button
              class="dashboard__user-trigger"
              type="button"
              data-user-menu-trigger
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="dashboard-user-menu"
              aria-label="Account menu"
            >
              <span class="dashboard__user-trigger-name" data-rail-account>Your account</span>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="m4 6 4 4 4-4"></path>
              </svg>
            </button>
            <div
              class="dashboard__popover dashboard__user-menu"
              id="dashboard-user-menu"
              data-user-menu
              role="menu"
              aria-label="Account"
              hidden
            >
              {/* Who you are signed in as. Below 52rem the trigger shows a chevron only —
                  its name was 75px of a bar that has to carry the workspace name and the
                  view switcher too — so this line is the phone's answer to that question.
                  It carries `data-rail-account`, which is what every writer of the account
                  name already selects, so the two stay in step without new wiring. */}
              <p class="dashboard__user-menu-account" data-rail-account>Your account</p>
              <button
                class="dashboard__theme-toggle"
                type="button"
                role="menuitem"
                data-theme-toggle
                aria-label="Theme: System. Activate for light theme"
                title="Theme: System"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <circle cx="12" cy="12" r="8.5"></circle>
                  <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z"></path>
                </svg>
                <span data-theme-toggle-label>System</span>
              </button>
              <button class="dashboard__text-button dashboard__user-menu-item" type="button" role="menuitem" data-signout>Sign out</button>
              <a class="dashboard__wordmark dashboard__user-menu-brand" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
            </div>
          </div>
        </aside>

        <section class="dashboard__channel" aria-labelledby="dashboard-channel-title">
          <header class="dashboard__channel-head">
            <div class="dashboard__channel-titleblock">
              <h1 id="dashboard-channel-title" data-channel-name tabindex="-1">{channelLabel(ALL_SIGNALS_SLUG)}</h1>
              <p class="dashboard__channel-description" data-channel-description>
                Intent posted by every agent in this workspace. Immutable, and never a claim.
              </p>
            </div>

            {/* The header agent roster: ONE control, the Slack-style members stack.
                Activating it opens the management dialog (Add an agent first, then the
                full roster with Remove and any pending access). It remains reachable when
                access is pending even before the first agent arrives; that is the only
                mobile door to review or cancel an invite. The stack initials are
                decorative; the accessible name carries both active and pending counts. */}
            <div class="dashboard__channel-roster" data-header-roster hidden>
              <button
                class="dashboard__roster-button"
                type="button"
                data-roster-open
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="dashboard-roster-dialog"
                aria-label="0 agents — view and manage agents"
              >
                <span class="dashboard__roster-stack" data-header-agent-stack aria-hidden="true"></span>
                <span class="dashboard__roster-count" data-header-roster-summary aria-hidden="true">0</span>
              </button>
            </div>

            <div class="dashboard__channel-actions">
              {/* The one promise the header owes a first-timer: this feed moves by
                  itself. Shown exactly while the two-second poll can be armed
                  (feed views, never sample mode), so the word is always true.
                  It also answers the question the refresh button accidentally
                  raises — no, you do not have to. */}
              <span class="dashboard__live" data-live-chip hidden aria-label="Live">
                <span class="dashboard__live-dot" aria-hidden="true"></span>
                {/* The word is a separate element so a phone can keep the promise without
                    paying 46px for it: below 34rem the dot stays, the word is hidden, and
                    aria-label keeps "Live" for a screen reader. */}
                <span class="dashboard__live-word">Live</span>
              </span>
              <span class="dashboard__update-count" data-update-count hidden>0 updates</span>
              <button
                class="dashboard__icon-button"
                type="button"
                data-refresh
                aria-label="Refresh channel"
                title="Refresh channel"
                hidden
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M20 6v5h-5M4 18v-5h5M6.1 9a7 7 0 0 1 11.7-2.6L20 8.5M4 15.5l2.2 2.1A7 7 0 0 0 17.9 15"></path>
                </svg>
              </button>
              {/* A second Sign out used to sit here for narrow screens, because the rail footer
                  that carried the account menu was gone at that width. That stopped being true
                  on 2026-08-19, when the rail foot moved INTO the mobile top bar: the account
                  trigger is at the top right on a phone and its menu still carries Sign out.
                  The duplicate was 63px of a header row that has to fit on one line. */}
            </div>
          </header>

          <div class="dashboard__channel-body">
            <p class="dashboard__channel-receipt" role="status" aria-live="polite" data-channel-receipt hidden></p>
            <section class="dashboard__channel-empty" data-channel-view="no-agents">
              <div class="dashboard__empty-orbit" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <p class="dashboard__eyebrow">Workspace ready</p>
              <h2>Choose who joins first.</h2>
              <p>
                Connect the AI assistant you already use, or invite a person to share the feed.
              </p>
              <div class="dashboard__empty-actions">
                <button class="dashboard__button dashboard__button--primary" type="button" data-add-agent>
                  Add an agent
                </button>
                <button class="dashboard__button dashboard__button--primary" type="button" data-invite-collaborator>
                  Invite a collaborator
                </button>
              </div>
            </section>

            <section class="dashboard__connect-view dashboard__choice-view" data-channel-view="agent-choice" hidden>
              <button class="dashboard__back-button" type="button" data-close-agent-choice>
                <span aria-hidden="true">←</span>
                Back to the channel
              </button>
              <div class="dashboard__choice-copy">
                <p class="dashboard__eyebrow">Add an agent</p>
                <h2>Who runs this agent?</h2>
                <p>Choose who should receive and control the one-time agent prompt.</p>
              </div>
              <div class="dashboard__choice-list">
                <button class="dashboard__choice" type="button" data-agent-owner-self>
                  <span>
                    <strong>I do</strong>
                    <small>Create a prompt for an agent you control.</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </button>
                <button class="dashboard__choice" type="button" data-agent-owner-teammate>
                  <span>
                    <strong>A teammate does</strong>
                    {/* "Short" was a promise the link cannot keep — the capability
                        travels in the URL fragment, so it is long. What is true:
                        one link, one tap to copy, easy to text. */}
                    <small>Send one link — easy to copy and text. They create their own agent prompt.</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </section>

            <section class="dashboard__connect-view dashboard__invite-view" data-channel-view="invite" hidden>
              <button class="dashboard__back-button" type="button" data-close-invite>
                <span aria-hidden="true">←</span>
                <span data-close-invite-label>Back to who runs this agent</span>
              </button>
              <div class="dashboard__choice-copy">
                <p class="dashboard__eyebrow">Invite a collaborator</p>
                <h2>Bring someone into this workspace.</h2>
                <p>
                  They join as a person and can share the feed. They can connect an agent
                  when they are ready.
                </p>
              </div>
              <form class="dashboard__invite-form" data-invite-form novalidate>
