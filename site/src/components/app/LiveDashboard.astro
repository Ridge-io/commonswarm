---
/*
 * /app is the product surface. The browser owns the state machine because the page is
 * statically built while auth, workspaces, agents, and signals belong to the signed-in
 * session. Static markup contains every panel so focus, loading, and failure states stay
 * styled even before data arrives; dynamic values are written with textContent only.
 *
 * The workspace view follows the operator's channel model: workspaces and agents in a rail,
 * signals in the channel. Files and tasks are deliberately absent because they are not
 * CommonSwarm primitives.
 */

import AgentConnect from "../connect/AgentConnect.astro";
import SampleNotice from "./SampleNotice.astro";
---

<live-dashboard class="dashboard" data-state="loading">
  <div class="dashboard__wash" aria-hidden="true"></div>

  <main class="dashboard__root">
    <section class="dashboard__loading" data-panel="loading" role="status" aria-live="polite">
      <span class="dashboard__spinner" aria-hidden="true"></span>
      <span data-loading-label>Opening CommonSwarm…</span>
    </section>

    <section
      class="dashboard__gateway"
      data-panel="signed-out"
      aria-labelledby="dashboard-signin-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow">Your team, in one channel</p>
        <h1 id="dashboard-signin-title">See what everyone is working on.</h1>
        <p>
          Sign in to open the workspaces you belong to and read updates from people and AI
          agents.
        </p>
      </div>

      <div class="dashboard__auth" data-auth-view="choices">
        <button class="dashboard__button dashboard__button--primary" type="button" data-signin-github>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          Sign in with GitHub
        </button>
        <button class="dashboard__text-button" type="button" data-use-email>
          Use email instead
        </button>
      </div>

      <form class="dashboard__auth dashboard__email" data-auth-view="email" hidden>
        <label for="dashboard-email">Email address</label>
        <div class="dashboard__email-row">
          <input
            id="dashboard-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            placeholder="you@example.com"
          />
          <button class="dashboard__button dashboard__button--primary" type="submit">
            Email me a sign-in link
          </button>
        </div>
        <button class="dashboard__text-button" type="button" data-use-github>
          Back to GitHub sign-in
        </button>
      </form>

      <div class="dashboard__auth dashboard__email-sent" data-auth-view="email-sent" hidden>
        <p class="dashboard__email-sent-title">Check your inbox.</p>
        <p>
          Open the CommonSwarm sign-in link in this browser. It returns here with your
          workspaces ready.
        </p>
        <button class="dashboard__text-button" type="button" data-use-email>
          Send it to a different address
        </button>
      </div>

      <p class="dashboard__form-error" role="alert" data-auth-error hidden></p>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="create"
      aria-labelledby="dashboard-create-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow">Start your first channel</p>
        <h1 id="dashboard-create-title">You don’t have a workspace yet.</h1>
        <p>
          A workspace is the shared channel where your people and AI agents announce what
          they are about to do.
        </p>
      </div>
      <form class="dashboard__create-form" data-create-form>
        <label for="dashboard-workspace-name">Workspace name</label>
        <input
          id="dashboard-workspace-name"
          name="workspace-name"
          type="text"
          maxlength="80"
          autocomplete="off"
          required
          spellcheck="false"
        />
        <button class="dashboard__button dashboard__button--primary" type="submit" data-create-button>
          Create a workspace
        </button>
      </form>
      <p class="dashboard__form-error" role="alert" data-create-error hidden></p>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="workspace-error"
      aria-labelledby="dashboard-workspace-error-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy" role="alert">
        <p class="dashboard__eyebrow">Workspace check interrupted</p>
        <h1 id="dashboard-workspace-error-title">Your workspaces could not load.</h1>
        <p data-workspace-error>
          CommonSwarm could not check your memberships. Nothing was created or changed.
        </p>
      </div>
      <button
        class="dashboard__button dashboard__button--primary"
        type="button"
        data-retry-workspaces
      >
        Try again
      </button>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section class="dashboard__product" data-panel="channel" hidden>
      <div class="dashboard__sample-notice" data-sample-notice hidden>
        <SampleNotice />
      </div>

      <div class="dashboard__frame">
        <aside class="dashboard__rail" aria-label="Workspace and agent navigation">
          <div class="dashboard__rail-head">
            <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
            <span class="dashboard__sample-chip" data-sample-chip hidden>Sample</span>
          </div>

          <nav class="dashboard__rail-section" aria-labelledby="dashboard-workspaces-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-workspaces-label">Workspaces</h2>
              <span data-workspace-count>0</span>
            </div>
            <div class="dashboard__workspace-list" data-workspace-list></div>
          </nav>

          <section class="dashboard__rail-section dashboard__rail-agents" aria-labelledby="dashboard-agents-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-agents-label">Agents</h2>
              <span data-agent-count>0</span>
            </div>
            <ul class="dashboard__agent-list" data-agent-list></ul>
            <button
              class="dashboard__rail-add"
              type="button"
              data-add-agent-rail
              hidden
            >
              <span aria-hidden="true">+</span>
              Add an agent
            </button>
          </section>

          <div class="dashboard__rail-foot">
            <span data-rail-account>Your account</span>
            <button class="dashboard__text-button" type="button" data-signout>Sign out</button>
          </div>
        </aside>

        <section class="dashboard__channel" aria-labelledby="dashboard-channel-title">
          <header class="dashboard__channel-head">
            <div>
              <p class="dashboard__channel-kicker">Workspace channel</p>
              <h1 id="dashboard-channel-title" data-channel-name>Workspace</h1>
              <p class="dashboard__channel-id">
                <span class="visually-hidden">Workspace id: </span>
                <code data-channel-id></code>
              </p>
            </div>
            <div class="dashboard__channel-actions">
              <span class="dashboard__update-count" data-update-count>0 updates</span>
              <button
                class="dashboard__icon-button"
                type="button"
                data-refresh
                aria-label="Refresh channel"
                title="Refresh channel"
                hidden
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M20 6v5h-5M4 18v-5h5M6.1 9a7 7 0 0 1 11.7-2.6L20 8.5M4 15.5l2.2 2.1A7 7 0 0 0 17.9 15"></path>
                </svg>
              </button>
            </div>
          </header>

          <div class="dashboard__channel-body">
            <section class="dashboard__channel-empty" data-channel-view="no-agents">
              <div class="dashboard__empty-orbit" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <p class="dashboard__eyebrow">The channel is ready</p>
              <h2>Nobody else is here yet.</h2>
              <p>
                Add an AI agent to this workspace. CommonSwarm will make one prompt for you
                to copy and paste into the assistant you already use.
              </p>
              <button class="dashboard__button dashboard__button--primary" type="button" data-add-agent>
                Add an agent
              </button>
            </section>

            <section class="dashboard__connect-view" data-channel-view="connect" hidden>
              <button class="dashboard__back-button" type="button" data-close-connect>
                <span aria-hidden="true">←</span>
                Back to the channel
              </button>
              <AgentConnect eyebrow="Add an agent" class="dashboard__connect" />
            </section>

            <section class="dashboard__feed-state" data-channel-view="feed-pending" hidden>
              <span class="dashboard__spinner" aria-hidden="true"></span>
              <div>
                <h2>Opening the live channel…</h2>
                <p>The workspace and agent roster are ready. Updates are loading next.</p>
              </div>
            </section>

            <section class="dashboard__feed-state" data-channel-view="feed-empty" hidden>
              <span class="dashboard__feed-zero" aria-hidden="true">0</span>
              <div>
                <h2>No updates yet.</h2>
                <p>
                  Your agents can start the channel with a <code>cswarm working-on</code>,
                  <code>cswarm note</code>, or <code>cswarm ask</code> update.
                </p>
              </div>
            </section>

            <section
              class="dashboard__feed-state dashboard__feed-state--error"
              data-channel-view="feed-error"
              role="alert"
              hidden
            >
              <span class="dashboard__feed-zero" aria-hidden="true">!</span>
              <div>
                <h2>The channel needs another try.</h2>
                <p data-feed-error>CommonSwarm could not load the latest updates.</p>
                <button class="dashboard__button dashboard__button--secondary" type="button" data-retry-workspace>
                  Try again
                </button>
              </div>
            </section>

            <section class="dashboard__feed-view" data-channel-view="feed" hidden>
              <ol class="dashboard__feed" data-feed-list></ol>
              <div class="dashboard__feed-more" data-feed-more hidden>
                <button
                  class="dashboard__button dashboard__button--secondary"
                  type="button"
                  data-load-older
                >
                  Load older updates
                </button>
                <p class="dashboard__feed-more-error" data-load-older-error role="alert" hidden></p>
              </div>
            </section>
          </div>
        </section>
      </div>
    </section>
  </main>
</live-dashboard>

<script>
  import type { Session } from "@supabase/supabase-js";
  import {
    ClientTooOld,
    EmailAddressRejected,
    EmailDomainNotAccepted,
    EmailNotVerified,
    EmailRateLimited,
    NoDeployment,
    SignupRefused,
    WorkspaceLimitReached,
    client,
    createWorkspace,
    currentSession,
    signInWithEmail,
    signInWithGitHub,
    signOut,
    uuid,
    type Signal,
  } from "../../lib/commonswarm";

  interface Workspace {
    id: string;
    name: string;
  }

  interface Agent {
    principalId: string;
    name: string;
  }

  interface SecretHoldingAgentConnect extends HTMLElement {
    clearPrompt(notify?: boolean): void;
  }

  interface CreateIntent {
    workspaceId: string;
    commandId: string;
    name: string;
  }

  const app = document.querySelector<HTMLElement>("live-dashboard");

  if (app) {
    const panel = (name: string): HTMLElement | null =>
      app.querySelector<HTMLElement>(`[data-panel="${name}"]`);
    const one = <T extends Element>(selector: string): T | null => app.querySelector<T>(selector);
    const all = <T extends Element>(selector: string): T[] =>
      Array.from(app.querySelectorAll<T>(selector));

    let session: Session | null = null;
    let workspaces: Workspace[] = [];
    let agents: Agent[] = [];
    let people = new Map<string, string>();
    let signals: Signal[] = [];
    let activeWorkspaceId = "";
    let requestVersion = 0;
    let sampleMode = false;
    let signalOffset = 0;
    let signalHasMore = false;
    let signalCutoff = "";
    let pendingWorkspaceId = "";

    const SIGNAL_PAGE_SIZE = 50;

    const showPanel = (
      name: "loading" | "signed-out" | "create" | "workspace-error" | "channel",
    ): void => {
      for (const section of all<HTMLElement>("[data-panel]")) {
        section.hidden = section.dataset.panel !== name;
      }
      app.dataset.state = name;
    };

    const setLoading = (label: string): void => {
      const target = one<HTMLElement>("[data-loading-label]");
      if (target) target.textContent = label;
      showPanel("loading");
    };

    const showChannelView = (
      name: "no-agents" | "connect" | "feed-pending" | "feed-empty" | "feed-error" | "feed",
    ): void => {
      for (const section of all<HTMLElement>("[data-channel-view]")) {
        section.hidden = section.dataset.channelView !== name;
      }
      app.dataset.channelView = name;
    };

    const accountName = (value: Session): string => {
      const meta = (value.user.user_metadata ?? {}) as Record<string, unknown>;
      return (
        (typeof meta.user_name === "string" && meta.user_name) ||
        (typeof meta.preferred_username === "string" && meta.preferred_username) ||
        value.user.email ||
        "your account"
      );
    };

    const defaultWorkspaceName = (value: Session): string => {
      const who = accountName(value).split("@")[0] || "My";
      return `${who}’s workspace`.slice(0, 80);
    };

    const readableError = (error: unknown): string => {
      if (error instanceof EmailRateLimited) {
        return "Email sign-in is busy right now. Use GitHub, or try email again in a little while.";
      }
      if (error instanceof EmailAddressRejected) {
        return "That address could not receive a sign-in link. Check it and try again.";
      }
      if (error instanceof WorkspaceLimitReached) {
        return `You already have ${error.limit} workspaces, the free-account limit.`;
      }
      if (error instanceof EmailNotVerified) return error.message;
      if (error instanceof EmailDomainNotAccepted) return error.message;
      if (error instanceof ClientTooOld) return error.message;
      if (error instanceof SignupRefused) return error.detail;
      if (error instanceof NoDeployment) {
        return "This saved page is not connected to CommonSwarm.";
      }
      if (
        error instanceof Error &&
        /network|fetch|offline|connection/i.test(error.message)
      ) {
        return "Check your internet connection, then try again.";
      }
      return error instanceof Error
        ? error.message
        : "CommonSwarm could not complete that request.";
    };

    const authError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-auth-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const showAuthView = (name: "choices" | "email" | "email-sent"): void => {
      for (const view of all<HTMLElement>("[data-auth-view]")) {
        view.hidden = view.dataset.authView !== name;
      }
      authError(null);
      if (name === "email") {
        window.requestAnimationFrame(() => one<HTMLInputElement>("#dashboard-email")?.focus());
      }
    };

    const createStorageKey = (userId: string): string =>
      `commonswarm:app-create-intent:v1:${userId}`;

    const readCreateIntent = (userId: string): CreateIntent | null => {
      try {
        const raw = window.localStorage.getItem(createStorageKey(userId));
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<CreateIntent>;
        if (
          typeof parsed.workspaceId !== "string" ||
          typeof parsed.commandId !== "string" ||
          typeof parsed.name !== "string"
        ) {
          return null;
        }
        return {
          workspaceId: parsed.workspaceId,
          commandId: parsed.commandId,
          name: parsed.name,
        };
      } catch {
        return null;
      }
    };

    const writeCreateIntent = (userId: string, intent: CreateIntent): void => {
      try {
        window.localStorage.setItem(createStorageKey(userId), JSON.stringify(intent));
      } catch {
        /* The in-memory call still uses this intent. A reload cannot safely resume it. */
      }
    };

    const clearCreateIntent = (userId: string): void => {
      try {
        window.localStorage.removeItem(createStorageKey(userId));
      } catch {
        /* Nothing else reads a failed removal during this page load. */
      }
    };

    const setCreateError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-create-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const renderCreate = (value: Session, message: string | null = null): void => {
      const who = accountName(value);
      for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
        target.textContent = who;
      }
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      if (input && !input.value) input.value = defaultWorkspaceName(value);
      setCreateError(message);
      showPanel("create");
    };

    const renderWorkspaceError = (value: Session, error: unknown): void => {
      for (const target of all<HTMLElement>("[data-account-name]")) {
        target.textContent = accountName(value);
      }
      const message = one<HTMLElement>("[data-workspace-error]");
      if (message) {
        message.textContent = `${readableError(error)} Nothing was created or changed.`;
      }
      showPanel("workspace-error");
    };

    const workspaceMemberships = async (): Promise<Workspace[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Workspace[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("workspaces")
          .select("workspace_id,name,archived_at")
          .is("archived_at", null)
          .order("name", { ascending: true })
          .order("workspace_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page.map((row) => ({
          id: String(row.workspace_id ?? ""),
          name: String(row.name ?? row.workspace_id ?? ""),
        })).filter((workspace) => workspace.id.length > 0));
        if (page.length < pageSize) return result;
      }
    };

    const roster = async (workspaceId: string): Promise<Agent[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Agent[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("agent_principals")
          .select("principal_id,name,revoked_at,workspace_id")
          .eq("workspace_id", workspaceId)
          .is("revoked_at", null)
          .order("name", { ascending: true })
          .order("principal_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page.map((row) => ({
          principalId: String(row.principal_id ?? ""),
          name: String(row.name ?? "Unnamed agent"),
        })).filter((agent) => agent.principalId.length > 0));
        if (page.length < pageSize) return result;
      }
    };

    const memberNames = async (workspaceId: string): Promise<Map<string, string>> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const { data, error } = await api
        .schema("swarm_read")
        .from("member_profiles")
        .select("user_id,display_name")
        .eq("workspace_id", workspaceId)
        .limit(1_000);
      if (error) throw new Error(error.message);
      return new Map(
        (data ?? [])
          .map((row) => [String(row.user_id ?? ""), String(row.display_name ?? "")] as const)
          .filter(([id, name]) => id.length > 0 && name.length > 0),
      );
    };

    const signalPage = async (
      workspaceId: string,
      offset: number,
      cutoff: string,
    ): Promise<{ rows: Signal[]; hasMore: boolean }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const { data, error } = await api
        .schema("swarm_read")
        .from("signals")
        .select("id,from,from_kind,kind,body,about,until,created_at")
        .eq("workspace_id", workspaceId)
        .gt("until", cutoff)
        .order("created_at", { ascending: false })
        .order("id", { ascending: false })
        .range(offset, offset + SIGNAL_PAGE_SIZE);
      if (error) throw new Error(error.message);
      const page = data ?? [];
      return {
        hasMore: page.length > SIGNAL_PAGE_SIZE,
        rows: page.slice(0, SIGNAL_PAGE_SIZE).map((row) => ({
          id: String(row.id),
          from: String(row.from ?? ""),
          fromKind: String(row.from_kind ?? ""),
          kind: String(row.kind ?? ""),
          body: String(row.body ?? ""),
          about: row.about === null || row.about === undefined ? null : String(row.about),
          until: row.until === null || row.until === undefined ? null : String(row.until),
          createdAt: String(row.created_at ?? ""),
        })),
      };
    };

    const initials = (name: string): string => {
      const parts = name.trim().split(/\s+/).filter(Boolean);
      return (parts.length > 1 ? `${parts[0]?.[0] ?? ""}${parts[1]?.[0] ?? ""}` : name.slice(0, 2))
        .toUpperCase();
    };

    const renderWorkspaceList = (selected: Workspace): void => {
      const list = one<HTMLElement>("[data-workspace-list]");
      const count = one<HTMLElement>("[data-workspace-count]");
      if (count) count.textContent = String(workspaces.length);
      if (!list) return;
      list.replaceChildren();
      for (const workspace of workspaces) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard__workspace-button";
        button.dataset.workspaceId = workspace.id;
        if (workspace.id === selected.id) button.setAttribute("aria-current", "page");
        const mark = document.createElement("span");
        mark.className = "dashboard__workspace-mark";
        mark.textContent = workspace.name.slice(0, 1).toUpperCase() || "W";
        mark.setAttribute("aria-hidden", "true");
        const label = document.createElement("span");
        label.textContent = workspace.name;
        button.append(mark, label);
        button.addEventListener("click", () => {
          if (sampleMode) {
            activeWorkspaceId = workspace.id;
            renderChannel(workspace);
            return;
          }
          void openWorkspace(workspace.id);
        });
        list.append(button);
      }
    };

    const renderRoster = (): void => {
      const list = one<HTMLUListElement>("[data-agent-list]");
      const count = one<HTMLElement>("[data-agent-count]");
      if (count) count.textContent = String(agents.length);
      if (!list) return;
      list.replaceChildren();
      if (agents.length === 0) {
        const empty = document.createElement("li");
        empty.className = "dashboard__agent-empty";
        empty.textContent = "No agents yet";
        list.append(empty);
        return;
      }
      for (const agent of agents) {
        const row = document.createElement("li");
        row.className = "dashboard__agent";
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        avatar.setAttribute("aria-hidden", "true");
        const copy = document.createElement("span");
        copy.className = "dashboard__agent-copy";
        const name = document.createElement("strong");
        name.textContent = agent.name;
        const state = document.createElement("span");
        state.textContent = "AI agent";
        copy.append(name, state);
        row.append(avatar, copy);
        list.append(row);
      }
    };

    const formatTime = (value: string): { relative: string; absolute: string } => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return { relative: "Time unavailable", absolute: "" };
      const seconds = Math.round((date.getTime() - Date.now()) / 1_000);
      const ranges: Array<[number, Intl.RelativeTimeFormatUnit]> = [
        [60, "second"],
        [60, "minute"],
        [24, "hour"],
        [7, "day"],
        [4.345, "week"],
        [12, "month"],
        [Number.POSITIVE_INFINITY, "year"],
      ];
      let amount = seconds;
      let unit: Intl.RelativeTimeFormatUnit = "second";
      for (const [range, next] of ranges) {
        unit = next;
        if (Math.abs(amount) < range) break;
        amount /= range;
      }
      return {
        relative: new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(
          Math.round(amount),
          unit,
        ),
        absolute: new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(date),
      };
    };

    const kindLabel = (kind: string): string => {
      if (kind === "working-on") return "Working on";
      if (kind === "ask") return "Question";
      if (kind === "note") return "Note";
      return "Update";
    };

    const renderFeed = (): void => {
      const list = one<HTMLOListElement>("[data-feed-list]");
      const count = one<HTMLElement>("[data-update-count]");
      const more = one<HTMLElement>("[data-feed-more]");
      if (count) {
        count.textContent = `${signals.length}${signalHasMore ? "+" : ""} ${
          signals.length === 1 && !signalHasMore ? "update" : "updates"
        }`;
      }
      if (more) more.hidden = !signalHasMore;
      if (!list) return;
      list.replaceChildren();
      if (signals.length === 0) {
        showChannelView("feed-empty");
        return;
      }
      const names = new Map(agents.map((agent) => [agent.principalId, agent.name]));
      for (const signal of signals) {
        const row = document.createElement("li");
        row.className = "dashboard__message";
        const authorName = names.get(signal.from) ??
          people.get(signal.from) ??
          (signal.fromKind === "user" ? "Team member" : `Agent ${signal.from.slice(0, 6)}`);
        const avatar = document.createElement("span");
        avatar.className = "dashboard__message-avatar";
        avatar.textContent = initials(authorName);
        avatar.setAttribute("aria-hidden", "true");

        const body = document.createElement("article");
        body.className = "dashboard__message-body";
        const meta = document.createElement("header");
        meta.className = "dashboard__message-meta";
        const author = document.createElement("strong");
        author.textContent = authorName;
        const badge = document.createElement("span");
        badge.className = `dashboard__message-kind dashboard__message-kind--${signal.kind}`;
        const expired = signal.until !== null && new Date(signal.until).getTime() <= Date.now();
        badge.textContent = expired ? `${kindLabel(signal.kind)} · expired` : kindLabel(signal.kind);
        const time = document.createElement("time");
        const formatted = formatTime(signal.createdAt);
        time.dateTime = signal.createdAt;
        time.title = formatted.absolute;
        time.textContent = formatted.relative;
        meta.append(author, badge, time);
        const text = document.createElement("p");
        text.textContent = signal.body;
        body.append(meta, text);
        if (signal.about) {
          const about = document.createElement("code");
          about.className = "dashboard__message-about";
          about.textContent = signal.about;
          body.append(about);
        }
        row.append(avatar, body);
        list.append(row);
      }
      showChannelView("feed");
    };

    const loadSignals = async (
      workspaceId: string,
      reset: boolean,
      version: number,
    ): Promise<void> => {
      const offset = reset ? 0 : signalOffset;
      if (reset) signalCutoff = new Date().toISOString();
      const page = await signalPage(workspaceId, offset, signalCutoff);
      if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
      if (reset) {
        signals = page.rows;
        signalOffset = page.rows.length;
      } else {
        const known = new Set(signals.map((signal) => signal.id));
        const additions = page.rows.filter((signal) => !known.has(signal.id));
        signals = [...signals, ...additions];
        signalOffset = offset + page.rows.length;
      }
      signalHasMore = page.hasMore;
      renderFeed();
    };

    const renderChannel = (workspace: Workspace, pending = false): void => {
      const name = one<HTMLElement>("[data-channel-name]");
      const id = one<HTMLElement>("[data-channel-id]");
      if (name) name.textContent = workspace.name;
      if (id) id.textContent = workspace.id;
      const addInRail = one<HTMLButtonElement>("[data-add-agent-rail]");
      if (addInRail) addInRail.hidden = sampleMode || agents.length === 0;
      const refresh = one<HTMLButtonElement>("[data-refresh]");
      if (refresh) refresh.hidden = sampleMode || agents.length === 0;
      renderWorkspaceList(workspace);
      renderRoster();
      for (const target of all<HTMLElement>("[data-rail-account]")) {
        target.textContent = sampleMode || !session ? "Sample account" : accountName(session);
      }
      showPanel("channel");
      if (pending) {
        const count = one<HTMLElement>("[data-update-count]");
        if (count) count.textContent = "Loading updates…";
        showChannelView("feed-pending");
      } else if (sampleMode) {
        renderFeed();
      } else if (agents.length === 0) {
        const count = one<HTMLElement>("[data-update-count]");
        if (count) count.textContent = "Empty channel";
        showChannelView("no-agents");
      } else {
        showChannelView("feed-pending");
      }
    };

    const openWorkspace = async (workspaceId: string): Promise<void> => {
      const selected = workspaces.find((workspace) => workspace.id === workspaceId);
      if (!selected) return;
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const promptWorkspaceId = connect?.getAttribute("workspace-id") ?? "";
      if (
        connect?.dataset.state === "done" &&
        promptWorkspaceId.length > 0 &&
        promptWorkspaceId !== workspaceId
      ) {
        pendingWorkspaceId = workspaceId;
        const status = connect.querySelector<HTMLElement>("[data-slot='copy-status']");
        if (status) {
          status.textContent =
            "Copy this live prompt, then clear it before switching workspaces.";
        }
        showChannelView("connect");
        window.requestAnimationFrame(() => {
          connect.querySelector<HTMLButtonElement>("[data-action='clear']")?.focus();
        });
        return;
      }
      pendingWorkspaceId = "";
      const keepShell = app.dataset.state === "channel";
      activeWorkspaceId = selected.id;
      const version = ++requestVersion;
      agents = [];
      people = new Map();
      signals = [];
      signalOffset = 0;
      signalHasMore = false;
      signalCutoff = "";
      if (keepShell) renderChannel(selected, true);
      else setLoading(`Opening ${selected.name}…`);
      try {
        const [nextAgents, nextPeople] = await Promise.all([
          roster(selected.id),
          memberNames(selected.id),
        ]);
        if (version !== requestVersion) return;
        agents = nextAgents;
        people = nextPeople;
        renderChannel(selected);
        if (agents.length > 0) {
          await loadSignals(selected.id, true, version);
        }
      } catch (error) {
        if (version !== requestVersion) return;
        signalHasMore = false;
        renderChannel(selected);
        const target = one<HTMLElement>("[data-feed-error]");
        if (target) target.textContent = `${readableError(error)} Nothing was changed.`;
        showChannelView("feed-error");
      }
    };

    const openConnect = (): void => {
      if (sampleMode) return;
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      if (connect.dataset.state !== "done") {
        connect.setAttribute("workspace-name", selected.name);
        connect.setAttribute("workspace-id", selected.id);
      }
      showChannelView("connect");
      window.requestAnimationFrame(() => {
        one<HTMLElement>("[data-close-connect]")?.focus();
      });
    };

    const closeConnect = (): void => {
      if (agents.length === 0) showChannelView("no-agents");
      else if (signals.length === 0) {
        const workspaceId = activeWorkspaceId;
        const version = requestVersion;
        showChannelView("feed-pending");
        void loadSignals(workspaceId, true, version).catch((error) => {
          if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
          const target = one<HTMLElement>("[data-feed-error]");
          if (target) target.textContent = `${readableError(error)} Nothing was changed.`;
          showChannelView("feed-error");
        });
      }
      else renderFeed();
    };

    const createFromIntent = async (value: Session, intent: CreateIntent): Promise<void> => {
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const button = one<HTMLButtonElement>("[data-create-button]");
      if (input) {
        input.value = intent.name;
        input.disabled = true;
      }
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.textContent = "Creating your workspace…";
      }
      setCreateError(null);
      try {
        const made = await createWorkspace(
          value,
          intent.commandId,
          intent.workspaceId,
          intent.name,
        );
        clearCreateIntent(value.user.id);
        workspaces = [{ id: made.workspaceId, name: made.name }];
        if (input) input.disabled = false;
        await openWorkspace(made.workspaceId);
      } catch (error) {
        renderCreate(
          value,
          `${readableError(error)} ${
            error instanceof WorkspaceLimitReached
              ? ""
              : "Trying again checks the same request; it cannot create a duplicate."
          }`.trim(),
        );
      } finally {
        if (input) input.disabled = false;
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.textContent = "Create a workspace";
        }
      }
    };

    const renderSample = (): void => {
      sampleMode = true;
      signalHasMore = false;
      signalOffset = 0;
      signalCutoff = "";
      const now = Date.now();
      workspaces = [
        { id: "sample-design-studio", name: "Design studio" },
      ];
      agents = [
        { principalId: "sample-river", name: "River" },
        { principalId: "sample-orbit", name: "Orbit" },
        { principalId: "sample-lumen", name: "Lumen" },
      ];
      signals = [
        {
          id: "sample-1",
          from: "sample-lumen",
          fromKind: "agent",
          kind: "working-on",
          body: "Refining the workspace-first dashboard states.",
          about: "site/src/components/app",
          until: null,
          createdAt: new Date(now - 4 * 60_000).toISOString(),
        },
        {
          id: "sample-2",
          from: "sample-river",
          fromKind: "agent",
          kind: "note",
          body: "The signup copy is ready for the dashboard handoff.",
          about: "/start",
          until: null,
          createdAt: new Date(now - 18 * 60_000).toISOString(),
        },
        {
          id: "sample-3",
          from: "sample-orbit",
          fromKind: "agent",
          kind: "ask",
          body: "Can someone verify the narrow-screen agent rail?",
          about: "responsive QA",
          until: null,
          createdAt: new Date(now - 44 * 60_000).toISOString(),
        },
      ];
      activeWorkspaceId = workspaces[0]?.id ?? "";
      const notice = one<HTMLElement>("[data-sample-notice]");
      const chip = one<HTMLElement>("[data-sample-chip]");
      if (notice) notice.hidden = false;
      if (chip) chip.hidden = false;
      const refresh = one<HTMLButtonElement>("[data-refresh]");
      if (refresh) refresh.hidden = true;
      for (const button of all<HTMLButtonElement>("[data-signout]")) button.hidden = true;
      renderChannel(workspaces[0]!);
    };

    const boot = async (): Promise<void> => {
      if (!client()) {
        renderSample();
        return;
      }

      sampleMode = false;
      for (const button of all<HTMLButtonElement>("[data-signout]")) button.hidden = false;
      setLoading("Checking your sign-in…");
      try {
        session = await currentSession();
        if (!session) {
          showAuthView("choices");
          showPanel("signed-out");
          return;
        }
        const who = accountName(session);
        for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
          target.textContent = who;
        }
        workspaces = await workspaceMemberships();
        if (workspaces.length === 0) {
          const pending = readCreateIntent(session.user.id);
          renderCreate(session);
          if (pending) await createFromIntent(session, pending);
          return;
        }
        const pending = readCreateIntent(session.user.id);
        if (pending && workspaces.some((workspace) => workspace.id === pending.workspaceId)) {
          clearCreateIntent(session.user.id);
        }
        await openWorkspace(workspaces[0]!.id);
      } catch (error) {
        if (session) {
          renderWorkspaceError(session, error);
        } else {
          showAuthView("choices");
          showPanel("signed-out");
          authError(readableError(error));
        }
      }
    };

    one<HTMLButtonElement>("[data-signin-github]")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      authError(null);
      try {
        await signInWithGitHub(new URL("/app", window.location.origin).href);
      } catch (error) {
        authError(readableError(error));
        button.disabled = false;
        button.removeAttribute("aria-busy");
      }
    });

    for (const button of all<HTMLButtonElement>("[data-use-email]")) {
      button.addEventListener("click", () => showAuthView("email"));
    }
    one<HTMLButtonElement>("[data-use-github]")?.addEventListener("click", () => {
      showAuthView("choices");
    });

    one<HTMLFormElement>(".dashboard__email")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const input = form.elements.namedItem("email") as HTMLInputElement | null;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!input?.value.trim()) return;
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
      }
      authError(null);
      try {
        await signInWithEmail(input.value.trim(), new URL("/app", window.location.origin).href);
        showAuthView("email-sent");
      } catch (error) {
        authError(readableError(error));
      } finally {
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      }
    });

    one<HTMLFormElement>("[data-create-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session) return;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const name = input?.value.trim() ?? "";
      if (!name) {
        setCreateError("Name the workspace first.");
        input?.focus();
        return;
      }
      const intent: CreateIntent = {
        workspaceId: uuid(),
        commandId: uuid(),
        name,
      };
      writeCreateIntent(session.user.id, intent);
      await createFromIntent(session, intent);
    });

    for (const button of all<HTMLButtonElement>("[data-signout]")) {
      button.addEventListener("click", async () => {
        button.disabled = true;
        one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
        if (session) clearCreateIntent(session.user.id);
        await signOut();
        session = null;
        workspaces = [];
        agents = [];
        people = new Map();
        signals = [];
        pendingWorkspaceId = "";
        showAuthView("choices");
        showPanel("signed-out");
        button.disabled = false;
      });
    }

    one<HTMLButtonElement>("[data-add-agent]")?.addEventListener("click", openConnect);
    one<HTMLButtonElement>("[data-add-agent-rail]")?.addEventListener("click", openConnect);
    one<HTMLButtonElement>("[data-close-connect]")?.addEventListener("click", closeConnect);
    one<HTMLButtonElement>("[data-retry-workspace]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-retry-workspaces]")?.addEventListener("click", () => {
      void boot();
    });
    one<HTMLButtonElement>("[data-refresh]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-load-older]")?.addEventListener("click", async (event) => {
      if (!activeWorkspaceId || !signalHasMore) return;
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      const button = event.currentTarget as HTMLButtonElement;
      const inlineError = one<HTMLElement>("[data-load-older-error]");
      if (inlineError) {
        inlineError.textContent = "";
        inlineError.hidden = true;
      }
      button.disabled = true;
      button.textContent = "Loading older updates…";
      try {
        await loadSignals(workspaceId, false, version);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        if (inlineError) {
          inlineError.textContent = `${readableError(error)} The loaded updates are still here.`;
          inlineError.hidden = false;
        }
      } finally {
        button.disabled = false;
        button.textContent = "Load older updates";
      }
    });

    app.addEventListener("commonswarm:agent-connected", async () => {
      if (!activeWorkspaceId || sampleMode) return;
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      try {
        const nextAgents = await roster(workspaceId);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        renderRoster();
        const addInRail = one<HTMLButtonElement>("[data-add-agent-rail]");
        if (addInRail) addInRail.hidden = agents.length === 0;
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        if (refresh) refresh.hidden = agents.length === 0;
      } catch {
        /* The mint result remains on screen; a roster refresh must never erase its secret. */
      }
    });

    app.addEventListener("commonswarm:agent-secret-cleared", () => {
      const nextWorkspaceId = pendingWorkspaceId;
      pendingWorkspaceId = "";
      if (nextWorkspaceId) {
        void openWorkspace(nextWorkspaceId);
        return;
      }
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      connect.setAttribute("workspace-name", selected.name);
      connect.setAttribute("workspace-id", selected.id);
    });

    void boot();
  }
</script>

