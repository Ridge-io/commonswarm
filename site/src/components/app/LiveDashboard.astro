---
/*
 * /app is the product surface. The browser owns the state machine because the page is
 * statically built while auth, workspaces, agents, and signals belong to the signed-in
 * session. Static markup contains every panel so focus, loading, and failure states stay
 * styled even before data arrives; dynamic values are written with textContent only.
 *
 * The workspace view follows the operator's channel model: workspaces in a rail, signals
 * in the channel, and agents in a header roster — a stack button that opens the management
 * dialog. (The earlier model put the agent roster in the rail. That is DEAD: a long rail
 * pushed the only Add door below the fold, and the collapsed mobile rail left no agent
 * control at all. The rail now carries workspaces, account, and details only, and never
 * grows with agent count.) Files and tasks are deliberately absent because they are not
 * CommonSwarm primitives.
 */

import AgentConnect from "../connect/AgentConnect.astro";
import SampleNotice from "./SampleNotice.astro";
---

<live-dashboard class="dashboard" data-state="loading">
  <div class="dashboard__wash" aria-hidden="true"></div>

  <div class="dashboard__root">
    <section class="dashboard__loading" data-panel="loading" role="status" aria-live="polite">
      <span class="dashboard__spinner" aria-hidden="true"></span>
      <span data-loading-label>Opening CommonSwarm…</span>
    </section>

    <section
      class="dashboard__gateway"
      data-panel="signed-out"
      data-signed-out-onramp
      aria-labelledby="dashboard-signin-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow">CommonSwarm</p>
        <h1 id="dashboard-signin-title">See what your agents are doing.</h1>
        <p>
          One feed where your people and AI agents announce what they’re about to do. Sign in
          to open yours. New here? Signing in starts your free account — up to three
          workspaces, no card.
        </p>
      </div>

      <form class="dashboard__auth dashboard__email" data-auth-view="choices">
        <label for="dashboard-email">Email address</label>
        <div class="dashboard__email-row">
          <input
            id="dashboard-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            placeholder="you@example.com"
          />
          <button class="dashboard__button dashboard__button--primary" type="submit">
            Email me a sign-in link
          </button>
        </div>
        <p class="dashboard__auth-note">No password. The link returns you to this page.</p>
        <div class="dashboard__auth-divider" aria-hidden="true"><span>or</span></div>
        <button
          class="dashboard__button dashboard__button--secondary"
          type="button"
          data-signin-github
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          Sign in with GitHub
        </button>
      </form>

      <div class="dashboard__auth dashboard__email-sent" data-auth-view="email-sent" hidden>
        <p class="dashboard__email-sent-title">Check your inbox.</p>
        <p>
          We sent a sign-in link to <strong data-auth-email>your email</strong>. Open it in this
          browser — it brings you straight back here.
        </p>
        <button class="dashboard__text-button" type="button" data-use-email>
          Use a different address
        </button>
      </div>

      <p class="dashboard__form-error" role="alert" data-auth-error hidden></p>
      <p class="dashboard__legal-note">
        By continuing you acknowledge the
        <a href="/terms">Terms of Service</a>
        and
        <a href="/privacy">Privacy Policy</a>
        drafts published for review (not yet in force).
      </p>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="create"
      aria-labelledby="dashboard-create-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow">Your first workspace</p>
        <h1 id="dashboard-create-title">Name your workspace.</h1>
        <p>
          A workspace is one shared feed. Your people and AI agents post what they’re about
          to do, so work does not collide.
        </p>
      </div>
      <form class="dashboard__create-form" data-create-form>
        <label for="dashboard-workspace-name">Workspace name</label>
        <input
          id="dashboard-workspace-name"
          name="workspace-name"
          type="text"
          maxlength="80"
          autocomplete="off"
          required
          spellcheck="false"
        />
        <button class="dashboard__button dashboard__button--primary" type="submit" data-create-button>
          Create workspace
        </button>
      </form>
      <p class="dashboard__form-error" role="alert" data-create-error hidden></p>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="workspace-error"
      aria-labelledby="dashboard-workspace-error-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy" role="alert">
        <p class="dashboard__eyebrow">Workspace check interrupted</p>
        <h1 id="dashboard-workspace-error-title">Your workspaces could not load.</h1>
        <p data-workspace-error>
          CommonSwarm could not check your memberships. Nothing was created or changed.
        </p>
      </div>
      <button
        class="dashboard__button dashboard__button--primary"
        type="button"
        data-retry-workspaces
      >
        Try again
      </button>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section class="dashboard__product" data-panel="channel" hidden>
      <div class="dashboard__sample-notice" data-sample-notice hidden>
        <SampleNotice />
      </div>

      <div class="dashboard__frame">
        <aside class="dashboard__rail" aria-label="Workspace navigation and details">
          <div class="dashboard__rail-head">
            <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
            <span class="dashboard__sample-chip" data-sample-chip hidden>Sample</span>
          </div>

          <nav class="dashboard__rail-section" aria-labelledby="dashboard-workspaces-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-workspaces-label">Workspaces</h2>
              <span data-workspace-count>0</span>
            </div>
            <div class="dashboard__workspace-list" data-workspace-list></div>
          </nav>

          <details class="dashboard__rail-details" data-member-details hidden>
            <summary>
              <span>Members</span>
              <span data-member-count>0</span>
            </summary>
            <div class="dashboard__rail-details-body">
              <ul class="dashboard__agent-list" data-member-list></ul>
              <p class="dashboard__form-error" data-member-error role="alert" hidden></p>
              <div data-member-reauth hidden>
                <button class="dashboard__rail-add" type="button" data-member-reauth-github>
                  Sign in again with GitHub
                </button>
                <button class="dashboard__rail-add" type="button" data-member-reauth-email>
                  Email a fresh sign-in link
                </button>
              </div>
            </div>
          </details>

          <details class="dashboard__rail-details" data-access-details hidden>
            <summary>
              <span>Pending access</span>
              <span data-access-count>0</span>
            </summary>
            <div class="dashboard__rail-details-body">
              <ul class="dashboard__agent-list" data-access-list></ul>
              <p class="dashboard__form-error" data-access-error role="alert" hidden></p>
            </div>
          </details>

          <details class="dashboard__rail-details" data-workspace-details>
            <summary>Workspace details</summary>
            <div class="dashboard__rail-details-body">
              <code class="dashboard__workspace-id" data-channel-id></code>
              <button class="dashboard__text-button" type="button" data-copy-workspace-id>
                Copy workspace ID
              </button>
              <span class="dashboard__copy-status" role="status" aria-live="polite" data-workspace-id-status></span>
            </div>
          </details>

          <div class="dashboard__rail-foot">
            <span data-rail-account>Your account</span>
            <button class="dashboard__text-button" type="button" data-signout>Sign out</button>
          </div>
        </aside>

        <section class="dashboard__channel" aria-labelledby="dashboard-channel-title">
          <header class="dashboard__channel-head">
            <div class="dashboard__channel-titleblock">
              <p class="dashboard__channel-kicker">Workspace channel</p>
              <h1 id="dashboard-channel-title" data-channel-name>Workspace</h1>
            </div>

            {/* The header agent roster: ONE control, the Slack-style members stack.
                Activating it opens the management dialog (Add an agent first, then the
                full roster with Remove). Hidden whenever there are no agents — the empty
                channel carries that CTA, and two doors to the same flow would be the same
                news twice. The stack initials are decorative; the accessible name carries
                the count and the action. */}
            <div class="dashboard__channel-roster" data-header-roster hidden>
              <button
                class="dashboard__roster-button"
                type="button"
                data-roster-open
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="dashboard-roster-dialog"
                aria-label="0 agents — view and manage agents"
              >
                <span class="dashboard__roster-stack" data-header-agent-stack aria-hidden="true"></span>
                <span class="dashboard__roster-count" data-agent-count aria-hidden="true">0</span>
              </button>
            </div>

            <div class="dashboard__channel-actions">
              {/* The one promise the header owes a first-timer: this feed moves by
                  itself. Shown exactly while the two-second poll can be armed
                  (feed views, never sample mode), so the word is always true.
                  It also answers the question the refresh button accidentally
                  raises — no, you do not have to. */}
              <span class="dashboard__live" data-live-chip hidden>
                <span class="dashboard__live-dot" aria-hidden="true"></span>Live
              </span>
              <span class="dashboard__update-count" data-update-count hidden>0 updates</span>
              <button
                class="dashboard__icon-button"
                type="button"
                data-refresh
                aria-label="Refresh channel"
                title="Refresh channel"
                hidden
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M20 6v5h-5M4 18v-5h5M6.1 9a7 7 0 0 1 11.7-2.6L20 8.5M4 15.5l2.2 2.1A7 7 0 0 0 17.9 15"></path>
                </svg>
              </button>
              <button
                class="dashboard__text-button dashboard__mobile-signout"
                type="button"
                data-signout
              >
                Sign out
              </button>
            </div>
          </header>

          <div class="dashboard__channel-body">
            <p class="dashboard__channel-receipt" role="status" aria-live="polite" data-channel-receipt hidden></p>
            <section class="dashboard__channel-empty" data-channel-view="no-agents">
              <div class="dashboard__empty-orbit" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <p class="dashboard__eyebrow">Workspace ready</p>
              <h2>Add your first agent.</h2>
              <p>
                CommonSwarm writes one prompt for you. Paste it into the AI assistant you
                already use, and the agent joins this feed.
              </p>
              <button class="dashboard__button dashboard__button--primary" type="button" data-add-agent>
                Add an agent
              </button>
            </section>

            <section class="dashboard__connect-view dashboard__choice-view" data-channel-view="agent-choice" hidden>
              <button class="dashboard__back-button" type="button" data-close-agent-choice>
                <span aria-hidden="true">←</span>
                Back to the channel
              </button>
              <div class="dashboard__choice-copy">
                <p class="dashboard__eyebrow">Add an agent</p>
                <h2>Who runs this agent?</h2>
                <p>Choose who should receive and control the one-time agent prompt.</p>
              </div>
              <div class="dashboard__choice-list">
                <button class="dashboard__choice" type="button" data-agent-owner-self>
                  <span>
                    <strong>I do</strong>
                    <small>Create a prompt for an agent you control.</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </button>
                <button class="dashboard__choice" type="button" data-agent-owner-teammate>
                  <span>
                    <strong>A teammate does</strong>
                    {/* "Short" was a promise the link cannot keep — the capability
                        travels in the URL fragment, so it is long. What is true:
                        one link, one tap to copy, easy to text. */}
                    <small>Send one link — easy to copy and text. They create their own agent prompt.</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </section>

            <section class="dashboard__connect-view dashboard__invite-view" data-channel-view="invite" hidden>
              <button class="dashboard__back-button" type="button" data-close-invite>
                <span aria-hidden="true">←</span>
                Back to who runs this agent
              </button>
              <div class="dashboard__choice-copy">
                <p class="dashboard__eyebrow">Invite a teammate</p>
                <h2>Send one link. They connect their agent.</h2>
                <p>
                  Your teammate sees the workspace, signs in, and gets the prompt for an
                  agent they control. You never need to text them a live agent key.
                </p>
              </div>
              <form class="dashboard__invite-form" data-invite-form>
                <label for="dashboard-invite-email">Their email</label>
                <input
                  id="dashboard-invite-email"
                  type="email"
                  autocomplete="email"
                  required
                  placeholder="calvin@example.com"
                  data-invite-email
                />
                <button class="dashboard__button dashboard__button--primary" type="submit" data-invite-submit>
                  Create invite link
                </button>
              </form>
              <div class="dashboard__invite-result" data-invite-result hidden>
                <p class="dashboard__invite-receipt">
                  Private one-use link · expires in 7 days
                </p>
                <pre class="dashboard__invite-link" data-invite-link tabindex="0"></pre>
                <button class="dashboard__button dashboard__button--primary" type="button" data-copy-invite>
                  Copy invite link
                </button>
                <p class="dashboard__copy-status" role="status" aria-live="polite" data-invite-status></p>
                <button class="dashboard__text-button" type="button" data-invite-done>
                  Done
                </button>
              </div>
              <p class="dashboard__form-error" role="alert" data-invite-error hidden></p>
            </section>

            <section class="dashboard__connect-view" data-channel-view="connect" hidden>
              <button class="dashboard__back-button" type="button" data-close-connect>
                <span aria-hidden="true">←</span>
                Back to the channel
              </button>
              <p
                class="dashboard__form-error dashboard__connect-exit-status"
                role="status"
                aria-live="polite"
                data-connect-exit-status
                hidden
              ></p>
              <AgentConnect eyebrow="Add an agent" class="dashboard__connect" />
            </section>

            <section class="dashboard__feed-state" data-channel-view="feed-pending" hidden>
              <span class="dashboard__spinner" aria-hidden="true"></span>
              <div>
                <h2>Opening the live channel…</h2>
                <p>The workspace and agent roster are ready. Updates are loading next.</p>
              </div>
            </section>

            <section class="dashboard__feed-state" data-channel-view="feed-empty" hidden>
              <span class="dashboard__feed-zero" aria-hidden="true">0</span>
              <div>
                <h2 data-feed-empty-title>Waiting for your agent’s first update.</h2>
                <p>
                  As soon as an agent starts something, asks a question, or leaves a note, it
                  lands here. Nothing for you to do meanwhile.
                </p>
              </div>
            </section>

            <section
              class="dashboard__feed-state dashboard__feed-state--error"
              data-channel-view="feed-error"
              role="alert"
              hidden
            >
              <span class="dashboard__feed-zero" aria-hidden="true">!</span>
              <div>
                <h2>The channel needs another try.</h2>
                <p data-feed-error>CommonSwarm could not load the latest updates.</p>
                <button class="dashboard__button dashboard__button--secondary" type="button" data-retry-workspace>
                  Try again
                </button>
              </div>
            </section>

            <section class="dashboard__feed-view" data-channel-view="feed" hidden>
              <ol class="dashboard__feed" data-feed-list></ol>
              <div class="dashboard__feed-more" data-feed-more hidden>
                <button
                  class="dashboard__button dashboard__button--secondary"
                  type="button"
                  data-load-older
                >
                  Load older updates
                </button>
                <p class="dashboard__feed-more-error" data-load-older-error role="alert" hidden></p>
              </div>
            </section>
          </div>
        </section>
      </div>
    </section>
  </div>

  {/* The agent management dialog. A native <dialog>: Escape, modal focus containment,
      and focus restore to the stack button are the platform's, not ours. It lives outside
      every panel so a panel switch can never display:none it out from under an open
      session; openWorkspace and sign-out close it explicitly instead. Add an agent is the
      first visible primary action; the filter and the roster follow. At ≤52rem it is a
      bottom sheet (see the media query), not a second component. */}
  <dialog
    class="dashboard__roster-dialog"
    id="dashboard-roster-dialog"
    data-roster-dialog
    aria-labelledby="dashboard-roster-title"
  >
    <div class="dashboard__roster-dialog-head">
      <h2 id="dashboard-roster-title">
        Agents
        <span class="dashboard__roster-dialog-count" data-agent-count>0</span>
      </h2>
      <button
        class="dashboard__icon-button"
        type="button"
        data-roster-close
        aria-label="Close agents panel"
        title="Close agents panel"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div class="dashboard__roster-dialog-body">
      <button
        class="dashboard__button dashboard__button--primary dashboard__roster-dialog-add"
        type="button"
        data-add-agent-dialog
      >
        Add an agent
      </button>

      <input
        class="dashboard__roster-dialog-search"
        type="search"
        data-roster-search
        aria-label="Filter agents"
        placeholder="Filter agents…"
        autocomplete="off"
        spellcheck="false"
      />

      <ul
        class="dashboard__agent-list dashboard__roster-dialog-list"
        data-dialog-agent-list
      ></ul>
      <p class="dashboard__form-error" data-agent-error role="alert" hidden></p>
    </div>
  </dialog>
</live-dashboard>

<script>
  import type { Session } from "@supabase/supabase-js";
  import {
    ClientTooOld,
    CommandOutcomeUnknown,
    EmailAddressRejected,
    EmailDomainNotAccepted,
    EmailNotVerified,
    EmailRateLimited,
    NoDeployment,
    FreshLoginRequired,
    SignupRefused,
    WorkspaceOutcomeUnknown,
    WorkspaceLimitReached,
    agentAccessStatuses,
    client,
    createWorkspace,
    currentSession,
    deployment,
    inviteWorkspaceMember,
    pendingMemberInvites,
    revokeAgentToken,
    revokeWorkspaceInvitation,
    signInWithEmail,
    signInWithGitHub,
    signOut,
    removeWorkspaceMember,
    revokeAgentPrincipal,
    uuid,
    type Signal,
    type AgentAccessStatus,
    type PendingMemberInvite,
  } from "../../lib/commonswarm";
  import { memberInviteUrl } from "../../lib/member-invite";
  import { PendingRefreshGate } from "../../lib/pending-refresh";
  import { BootFocusGate } from "../../lib/boot-focus";

  interface Workspace {
    id: string;
    name: string;
  }

  interface Agent {
    principalId: string;
    name: string;
    model: string | null;
    ownerUserId: string;
  }

  interface Member {
    userId: string;
    name: string;
    role: "owner" | "admin" | "member";
  }

  interface SecretHoldingAgentConnect extends HTMLElement {
    clearPrompt(notify?: boolean): void;
    finishPrompt(reason: "done" | "back" | "consumed", notify?: boolean): void;
  }

  interface CreateIntent {
    workspaceId: string;
    commandId: string;
    name: string;
  }

  interface SignalCursor {
    createdAt: string;
    id: string;
  }

  const app = document.querySelector<HTMLElement>("live-dashboard");

  if (app) {
    /*
     * Top-level dashboard panels only. AgentConnect reuses data-panel=… for its own
     * loading/form/result surfaces inside <agent-connect>. A broad [data-panel] walk
     * would stamp hidden on those children whenever showPanel("channel") ran, and the
     * UA's [hidden] { display:none !important } permanently hides the name field and
     * mint button even after AgentConnect sets data-state=ready. Scope to the root's
     * direct panel sections so nested connect markup keeps its own visibility model.
     */
    const panel = (name: string): HTMLElement | null =>
      app.querySelector<HTMLElement>(`.dashboard__root > [data-panel="${name}"]`);
    const one = <T extends Element>(selector: string): T | null => app.querySelector<T>(selector);
    const all = <T extends Element>(selector: string): T[] =>
      Array.from(app.querySelectorAll<T>(selector));

    let session: Session | null = null;
    let workspaces: Workspace[] = [];
    let agents: Agent[] = [];
    let members: Member[] = [];
    let pendingInvites: PendingMemberInvite[] = [];
    let accessStatuses: AgentAccessStatus[] = [];
    let people = new Map<string, string>();
    let signals: Signal[] = [];
    let activeWorkspaceId = "";
    let requestVersion = 0;
    let sampleMode = false;
    let signalCursor: SignalCursor | null = null;
    let signalHasMore = false;
    let signalCutoff = "";
    let pendingWorkspaceId = "";
    let renderedAuthUserId = "";
    let authReloadQueued = false;
    let bootInFlight: Promise<void> | null = null;
    let bootAgain = false;
    let signalExpiryTimer: number | undefined;
    let liveFeedTimer: number | undefined;
    let liveFeedInFlight = false;
    let rosterRefreshInFlight = false;
    let rosterRefreshAttemptedAt = 0;
    /* Ownership of the pending-access refresh lives in the gate, not in flags:
       (workspaceId, version) pairs, so a slow request from the workspace the
       user just left can neither block nor clear the fresh one. */
    const PENDING_REFRESH_COOLDOWN_MS = 12_000;
    const pendingRefreshGate = new PendingRefreshGate(PENDING_REFRESH_COOLDOWN_MS);
    let rosterFilter = "";
    /* Catch-up queues UNKNOWN principals here and settles CONFIRMED-absent ones there.
       Both are per workspace session; openWorkspace clears them. */
    const unknownAgentCandidates = new Set<string>();
    const settledUnknownAgents = new Set<string>();
    let armLiveFeed = (): void => {};
    let connectFocusObserver: MutationObserver | null = null;
    let previousSignalIds = new Set<string>();
    let feedWasEmpty = false;
    let channelLoadError = "";
    let activeCreate: { version: number; userId: string } | null = null;
    /** Principal whose live Copy-prompt secret is still on screen, if any. */
    let livePromptPrincipalId = "";
    let freshInviteLink = "";
    let inviteIntent: { email: string; commandId: string } | null = null;

    const SIGNAL_PAGE_SIZE = 50;
    const SIGNAL_FETCH_SIZE = SIGNAL_PAGE_SIZE + 1;

    /* The very first content presentation of the page's life takes no scripted
       focus: it is not a response to anything the reader did, so moving focus
       would paint a ring around something they never asked for, raise the
       on-screen keyboard on a phone before any orientation, and pull assistive
       technology past the page's own opening. Every LATER transition is a
       response to something the user did — the gate says move, a plain focus()
       runs, and the platform heuristic decides the ring. One gate per surface:
       panels and the auth form present independently. */
    const panelBootFocus = new BootFocusGate();
    const authBootFocus = new BootFocusGate();

    const showPanel = (
      name: "loading" | "signed-out" | "create" | "workspace-error" | "channel",
    ): void => {
      const previous = app.dataset.state;
      for (const section of all<HTMLElement>(".dashboard__root > [data-panel]")) {
        section.hidden = section.dataset.panel !== name;
      }
      app.dataset.state = name;
      const root = one<HTMLElement>(".dashboard__root");
      root?.setAttribute("aria-busy", name === "loading" ? "true" : "false");
      if (previous !== name && name !== "loading") {
        if (!panelBootFocus.allowsFocus()) return;
        window.requestAnimationFrame(() => {
          const visible = panel(name);
          const heading = visible?.querySelector<HTMLElement>("h1, h2");
          if (!heading) return;
          heading.tabIndex = -1;
          heading.focus({ preventScroll: true });
        });
      }
    };

    const setLoading = (label: string): void => {
      const target = one<HTMLElement>("[data-loading-label]");
      if (target) target.textContent = label;
      showPanel("loading");
    };

    const showChannelView = (
      name:
        | "no-agents"
        | "agent-choice"
        | "invite"
        | "connect"
        | "feed-pending"
        | "feed-empty"
        | "feed-error"
        | "feed",
    ): void => {
      if (name !== "feed") {
        window.clearTimeout(signalExpiryTimer);
        signalExpiryTimer = undefined;
      }
      if (name !== "feed" && name !== "feed-empty") {
        window.clearInterval(liveFeedTimer);
        liveFeedTimer = undefined;
      }
      for (const section of all<HTMLElement>("[data-channel-view]")) {
        section.hidden = section.dataset.channelView !== name;
      }
      app.dataset.channelView = name;
      /* The Live chip is true exactly while armLiveFeed is allowed to run. */
      const liveChip = one<HTMLElement>("[data-live-chip]");
      if (liveChip) {
        liveChip.hidden = sampleMode || !(name === "feed" || name === "feed-empty");
      }
      if (name === "feed" || name === "feed-empty") {
        queueMicrotask(() => armLiveFeed());
      }
    };

    const addAgentViewOpen = (): boolean =>
      ["agent-choice", "invite", "connect"].includes(app.dataset.channelView ?? "");

    const accountName = (value: Session): string => {
      const meta = (value.user.user_metadata ?? {}) as Record<string, unknown>;
      return (
        (typeof meta.user_name === "string" && meta.user_name) ||
        (typeof meta.preferred_username === "string" && meta.preferred_username) ||
        value.user.email ||
        "your account"
      );
    };

    const defaultWorkspaceName = (value: Session): string => {
      const who = accountName(value).split("@")[0] || "My";
      return `${who}’s workspace`.slice(0, 80);
    };

    const readableError = (error: unknown): string => {
      if (error instanceof EmailRateLimited) {
        return "Email sign-in is busy right now. Use GitHub, or try email again in a little while.";
      }
      if (error instanceof EmailAddressRejected) {
        return "That address could not receive a sign-in link. Check it and try again.";
      }
      if (error instanceof WorkspaceLimitReached) {
        return `You already have ${error.limit} workspaces, the free-account limit.`;
      }
      if (error instanceof EmailNotVerified) return error.message;
      if (error instanceof EmailDomainNotAccepted) return error.message;
      if (error instanceof ClientTooOld) return error.message;
      if (error instanceof SignupRefused) return error.detail;
      if (error instanceof NoDeployment) {
        return "This saved page is not connected to CommonSwarm.";
      }
      if (
        error instanceof Error &&
        /network|fetch|offline|connection/i.test(error.message)
      ) {
        return "Check your internet connection, then try again.";
      }
      return error instanceof Error
        ? error.message
        : "CommonSwarm could not complete that request.";
    };

    const authError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-auth-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const showAuthView = (name: "choices" | "email-sent"): void => {
      for (const view of all<HTMLElement>("[data-auth-view]")) {
        view.hidden = view.dataset.authView !== name;
      }
      authError(null);
      /* The gate consumes only on choices presentations, so boot skips the email
         focus (no keyboard raise on mobile, AT reads the page's opening first)
         while "use a different address" and sign-out still land on the field. */
      if (name === "choices" && authBootFocus.allowsFocus()) {
        window.requestAnimationFrame(() => one<HTMLInputElement>("#dashboard-email")?.focus());
      }
    };

    const createStorageKey = (userId: string): string =>
      `commonswarm:app-create-intent:v1:${userId}`;

    const readCreateIntent = (userId: string): CreateIntent | null => {
      try {
        const raw = window.localStorage.getItem(createStorageKey(userId));
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<CreateIntent>;
        if (
          typeof parsed.workspaceId !== "string" ||
          typeof parsed.commandId !== "string" ||
          typeof parsed.name !== "string"
        ) {
          return null;
        }
        return {
          workspaceId: parsed.workspaceId,
          commandId: parsed.commandId,
          name: parsed.name,
        };
      } catch {
        return null;
      }
    };

    const writeCreateIntent = (userId: string, intent: CreateIntent): void => {
      try {
        window.localStorage.setItem(createStorageKey(userId), JSON.stringify(intent));
      } catch {
        /* The in-memory call still uses this intent. A reload cannot safely resume it. */
      }
    };

    const clearCreateIntent = (userId: string): void => {
      try {
        window.localStorage.removeItem(createStorageKey(userId));
      } catch {
        /* Nothing else reads a failed removal during this page load. */
      }
    };

    const setCreateError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-create-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const renderCreate = (value: Session, message: string | null = null): void => {
      const who = accountName(value);
      for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
        target.textContent = who;
      }
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      if (input && !input.value) input.value = defaultWorkspaceName(value);
      setCreateError(message);
      showPanel("create");
      window.requestAnimationFrame(() => {
        input?.focus({ preventScroll: true });
        input?.select();
      });
    };

    const renderWorkspaceError = (value: Session, error: unknown): void => {
      for (const target of all<HTMLElement>("[data-account-name]")) {
        target.textContent = accountName(value);
      }
      const message = one<HTMLElement>("[data-workspace-error]");
      if (message) {
        message.textContent = `${readableError(error)} Nothing was created or changed.`;
      }
      showPanel("workspace-error");
    };

    const workspaceMemberships = async (): Promise<Workspace[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Workspace[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("workspaces")
          .select("workspace_id,name,archived_at")
          .is("archived_at", null)
          .order("name", { ascending: true })
          .order("workspace_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page.map((row) => ({
          id: String(row.workspace_id ?? ""),
          name: String(row.name ?? row.workspace_id ?? ""),
        })).filter((workspace) => workspace.id.length > 0));
        if (page.length < pageSize) return result;
      }
    };

    const roster = async (workspaceId: string): Promise<Agent[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Agent[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("agent_principals")
          .select("principal_id,name,model,owner_user_id,revoked_at,workspace_id")
          .eq("workspace_id", workspaceId)
          .is("revoked_at", null)
          .order("name", { ascending: true })
          .order("principal_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page.map((row) => ({
          principalId: String(row.principal_id ?? ""),
          name: String(row.name ?? "Unnamed agent"),
          model: row.model === null ? null : String(row.model),
          ownerUserId: String(row.owner_user_id ?? ""),
        })).filter((agent) =>
          agent.principalId.length > 0 && agent.ownerUserId.length > 0
        ));
        if (page.length < pageSize) return result;
      }
    };

    const memberRoster = async (
      workspaceId: string,
    ): Promise<{ names: Map<string, string>; members: Member[] }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const { data, error } = await api
        .schema("swarm_read")
        .from("member_profiles")
        .select("user_id,display_name,role")
        .eq("workspace_id", workspaceId)
        .limit(1_000);
      if (error) throw new Error(error.message);
      const members = (data ?? []).map((row) => ({
        userId: String(row.user_id ?? ""),
        name: String(row.display_name ?? ""),
        role: String(row.role ?? "") as Member["role"],
      })).filter((member) =>
        member.userId.length > 0 &&
        member.name.length > 0 &&
        ["owner", "admin", "member"].includes(member.role)
      );
      return {
        members,
        names: new Map(members.map((member) => [member.userId, member.name])),
      };
    };

    const renderMembers = (): void => {
      const list = one<HTMLUListElement>("[data-member-list]");
      const count = one<HTMLElement>("[data-member-count]");
      const details = one<HTMLDetailsElement>("[data-member-details]");
      if (count) count.textContent = String(members.length);
      const me = members.find((member) => member.userId === session?.user.id);
      if (details) {
        details.hidden =
          sampleMode || (me?.role !== "owner" && me?.role !== "admin");
        if (details.hidden) details.open = false;
      }
      if (!list) return;
      list.replaceChildren();
      for (const member of members) {
        const item = document.createElement("li");
        item.className = "dashboard__agent";
        const label = document.createElement("span");
        label.textContent = `${member.name} · ${member.role}`;
        item.append(label);
        const mayRemove = me?.role === "owner" ||
          (me?.role === "admin" && member.role !== "owner");
        if (mayRemove && member.userId !== session?.user.id) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Remove";
          button.dataset.removeMember = member.userId;
          button.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (
              !window.confirm(
                `Remove ${member.name} from this workspace? This does not affect their other workspaces.`,
              )
            ) return;
            const errorTarget = one<HTMLElement>("[data-member-error]");
            const reauth = one<HTMLElement>("[data-member-reauth]");
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            if (reauth) reauth.hidden = true;
            button.disabled = true;
            try {
              await removeWorkspaceMember(
                session,
                uuid(),
                activeWorkspaceId,
                member.userId,
              );
              await openWorkspace(activeWorkspaceId);
            } catch (error) {
              if (error instanceof FreshLoginRequired) {
                sessionStorage.setItem(
                  "commonswarm.pending-member-selection",
                  JSON.stringify({
                    workspaceId: activeWorkspaceId,
                    userId: member.userId,
                  }),
                );
                if (reauth) reauth.hidden = false;
              }
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          item.append(button);
        }
        list.append(item);
      }
    };

    const renderPendingAccess = (): void => {
      const list = one<HTMLUListElement>("[data-access-list]");
      const count = one<HTMLElement>("[data-access-count]");
      const details = one<HTMLDetailsElement>("[data-access-details]");
      const now = Date.now();
      const pendingAgents = accessStatuses.filter((access) =>
        access.firstUsedAt === null &&
        access.revokedAt === null &&
        new Date(access.expiresAt).getTime() > now
      );
      const total = pendingInvites.length + pendingAgents.length;
      if (count) count.textContent = String(total);
      if (details) {
        details.hidden = sampleMode || total === 0;
        if (details.hidden) details.open = false;
      }
      if (!list) return;
      list.replaceChildren();

      const cancelButton = (
        label: string,
        cancel: (button: HTMLButtonElement) => Promise<void>,
      ): HTMLButtonElement => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard__text-button";
        button.textContent = "Cancel";
        button.setAttribute("aria-label", `Cancel ${label}`);
        button.addEventListener("click", () => void cancel(button));
        return button;
      };

      for (const invitation of pendingInvites) {
        const row = document.createElement("li");
        row.className = "dashboard__agent";
        const copy = document.createElement("span");
        copy.className = "dashboard__agent-copy";
        const title = document.createElement("strong");
        title.textContent = invitation.email;
        const state = document.createElement("span");
        state.textContent = `Teammate invite · expires ${formatTime(invitation.expiresAt).relative}`;
        copy.append(title, state);
        row.append(
          copy,
          cancelButton(`invite for ${invitation.email}`, async (button) => {
            if (!session) return;
            button.disabled = true;
            try {
              await revokeWorkspaceInvitation(
                session,
                uuid(),
                invitation.workspaceId,
                invitation.invitationId,
              );
              await openWorkspace(invitation.workspaceId);
            } catch (error) {
              const target = one<HTMLElement>("[data-access-error]");
              if (target) {
                target.textContent = readableError(error);
                target.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          }),
        );
        list.append(row);
      }

      for (const access of pendingAgents) {
        const row = document.createElement("li");
        row.className = "dashboard__agent";
        const copy = document.createElement("span");
        copy.className = "dashboard__agent-copy";
        const title = document.createElement("strong");
        title.textContent = access.agentName;
        const state = document.createElement("span");
        const owner = people.get(access.ownerUserId) ?? "Workspace member";
        state.textContent =
          `${access.model ?? "Model not specified"} · owned by ${owner} · expires ${
            formatTime(access.expiresAt).relative
          }`;
        copy.append(title, state);
        row.append(
          copy,
          cancelButton(`access for ${access.agentName}`, async (button) => {
            if (!session) return;
            button.disabled = true;
            try {
              await revokeAgentToken(
                session,
                uuid(),
                access.workspaceId,
                access.tokenId,
              );
              await openWorkspace(access.workspaceId);
            } catch (error) {
              const target = one<HTMLElement>("[data-access-error]");
              if (target) {
                target.textContent = readableError(error);
                target.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          }),
        );
        list.append(row);
      }
    };

    const signalPage = async (
      workspaceId: string,
      cursor: SignalCursor | null,
      cutoff: string,
    ): Promise<{ rows: Signal[]; hasMore: boolean }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      let query = api
        .schema("swarm_read")
        .from("signals")
        .select("id,from,from_kind,to,kind,body,about,until,created_at")
        .eq("workspace_id", workspaceId)
        .or(`until.is.null,until.gt.${cutoff}`);
      if (cursor) {
        query = query.or(
          `created_at.lt.${cursor.createdAt},and(created_at.eq.${cursor.createdAt},id.lt.${cursor.id})`,
        );
      }
      const { data, error } = await query
        .order("created_at", { ascending: false })
        .order("id", { ascending: false })
        .limit(SIGNAL_FETCH_SIZE);
      if (error) throw new Error(error.message);
      const page = data ?? [];
      return {
        hasMore: page.length === SIGNAL_FETCH_SIZE,
        rows: page.slice(0, SIGNAL_PAGE_SIZE).map((row) => ({
          id: String(row.id),
          from: String(row.from ?? ""),
          fromKind: String(row.from_kind ?? ""),
          to: row.to === null || row.to === undefined ? null : String(row.to),
          kind: String(row.kind ?? ""),
          body: String(row.body ?? ""),
          about: row.about === null || row.about === undefined ? null : String(row.about),
          until: row.until === null || row.until === undefined ? null : String(row.until),
          createdAt: String(row.created_at ?? ""),
        })),
      };
    };

    const initials = (name: string): string => {
      const parts = name.trim().split(/\s+/).filter(Boolean);
      return (parts.length > 1 ? `${parts[0]?.[0] ?? ""}${parts[1]?.[0] ?? ""}` : name.slice(0, 2))
        .toUpperCase();
    };

    /* One shape, one tint. The avatar set once mixed three border-radii (a circle, a
       rounded square, and an asymmetric blob) across identical 32px initial tiles, which
       read as inconsistency rather than identity — most visibly where the tiles now sit
       shoulder to shoulder in the header strip. The hue keeps the per-agent distinction;
       the shape is always the circle. */
    const markAgentAvatar = (node: HTMLElement, principalId: string): void => {
      let hash = 2_166_136_261;
      for (const char of principalId) {
        hash ^= char.charCodeAt(0);
        hash = Math.imul(hash, 16_777_619);
      }
      const unsigned = hash >>> 0;
      node.style.setProperty("--avatar-hue", String(unsigned % 360));
      node.classList.add("dashboard__avatar--tinted");
    };

    const renderWorkspaceList = (selected: Workspace): void => {
      const list = one<HTMLElement>("[data-workspace-list]");
      const count = one<HTMLElement>("[data-workspace-count]");
      if (count) count.textContent = String(workspaces.length);
      if (!list) return;
      list.replaceChildren();
      for (const workspace of workspaces) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard__workspace-button";
        button.dataset.workspaceId = workspace.id;
        if (workspace.id === selected.id) button.setAttribute("aria-current", "page");
        const mark = document.createElement("span");
        mark.className = "dashboard__workspace-mark";
        mark.textContent = workspace.name.slice(0, 1).toUpperCase() || "W";
        mark.setAttribute("aria-hidden", "true");
        const label = document.createElement("span");
        label.textContent = workspace.name;
        button.append(mark, label);
        button.addEventListener("click", () => {
          if (sampleMode) {
            activeWorkspaceId = workspace.id;
            renderChannel(workspace);
            return;
          }
          void openWorkspace(workspace.id);
        });
        list.append(button);
      }
    };

    /*
     * One roster in memory, two surfaces: the header stack (summary) and the dialog list
     * (management). Both render here from `agents` — never re-counted per surface — so
     * stack, dialog, and feed cannot disagree about who is in the workspace.
     */
    const renderRoster = (): void => {
      renderHeaderRoster();
      renderDialogRoster();
    };

    /*
     * The header stack is a summary, not a second management surface: up to three uniform
     * circular initials and the live count. The count spans (stack button + dialog title)
     * share one data-hook and one loop, so they cannot drift apart.
     */
    const HEADER_STACK_LIMIT = 3;

    const renderHeaderRoster = (): void => {
      const wrap = one<HTMLElement>("[data-header-roster]");
      const stack = one<HTMLElement>("[data-header-agent-stack]");
      const button = one<HTMLButtonElement>("[data-roster-open]");
      const show = agents.length > 0;
      if (wrap) wrap.hidden = !show;
      one<HTMLElement>(".dashboard__channel")?.classList.toggle(
        "dashboard__channel--roster",
        show,
      );
      for (const count of all<HTMLElement>("[data-agent-count]")) {
        count.textContent = String(agents.length);
      }
      if (button) {
        button.setAttribute(
          "aria-label",
          `${agents.length} ${agents.length === 1 ? "agent" : "agents"} — view and manage agents`,
        );
      }
      if (!stack) return;
      stack.replaceChildren();
      for (const agent of agents.slice(0, HEADER_STACK_LIMIT)) {
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        markAgentAvatar(avatar, agent.principalId);
        stack.append(avatar);
      }
    };

    /*
     * The dialog roster is the management list: model, owner, and a permission-aware
     * Remove per row — the same rules the rail roster enforced, unchanged. When a
     * background roster refresh re-renders while the dialog is open, focus parked inside
     * the list is handed back to the same agent's row rather than dropped out of the
     * dialog (a replaced node cannot keep focus, and losing it would strand a keyboard
     * user on <body> behind the modal).
     */
    const renderDialogRoster = (): void => {
      const add = one<HTMLButtonElement>("[data-add-agent-dialog]");
      if (add) add.hidden = sampleMode;
      const list = one<HTMLUListElement>("[data-dialog-agent-list]");
      if (!list) return;
      let refocusPrincipal = "";
      if (
        document.activeElement instanceof HTMLElement &&
        list.contains(document.activeElement)
      ) {
        refocusPrincipal =
          document.activeElement.closest<HTMLElement>("[data-agent-row]")?.dataset
            .agentRow ?? "";
      }
      list.replaceChildren();
      const query = rosterFilter.trim().toLowerCase();
      const visible = query
        ? agents.filter((agent) => agent.name.toLowerCase().includes(query))
        : agents;
      if (visible.length === 0) {
        const empty = document.createElement("li");
        empty.className = "dashboard__agent-empty";
        empty.textContent = query
          ? `No agents match “${rosterFilter.trim()}”.`
          : "No agents yet";
        list.append(empty);
        return;
      }
      const me = members.find((member) => member.userId === session?.user.id);
      for (const agent of visible) {
        const row = document.createElement("li");
        row.className = "dashboard__agent";
        row.dataset.agentRow = agent.principalId;
        row.tabIndex = -1;
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        avatar.setAttribute("aria-hidden", "true");
        markAgentAvatar(avatar, agent.principalId);
        const copy = document.createElement("span");
        copy.className = "dashboard__agent-copy";
        const name = document.createElement("strong");
        name.textContent = agent.name;
        const state = document.createElement("span");
        state.textContent =
          `${agent.model ?? "Model not specified"} · owned by ${
            people.get(agent.ownerUserId) ?? "Workspace member"
          }`;
        copy.append(name, state);
        row.append(avatar, copy);
        // Owner/admin any principal; member only own. Clear on the connect
        // prompt only hides the secret — it never revokes.
        const mayRemove = Boolean(
          me &&
          (
            me.role === "owner" ||
            me.role === "admin" ||
            agent.ownerUserId === me.userId
          ),
        );
        if (mayRemove && !sampleMode) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Remove";
          button.dataset.removeAgent = agent.principalId;
          button.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (
              !window.confirm(
                `Remove ${agent.name}? This ends its identity and every live credential in this workspace. Clearing a Copy prompt only hides the secret — it does not remove the agent.`,
              )
            ) return;
            const errorTarget = one<HTMLElement>("[data-agent-error]");
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            button.disabled = true;
            try {
              await revokeAgentPrincipal(
                session,
                uuid(),
                activeWorkspaceId,
                agent.principalId,
              );
              if (livePromptPrincipalId === agent.principalId) {
                one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
                livePromptPrincipalId = "";
              }
              await openWorkspace(activeWorkspaceId);
              /* The reload closed the dialog; hand focus to the control that reopens
                 it, or to the empty channel's Add door when that was the last agent. */
              const door = agents.length > 0
                ? one<HTMLButtonElement>("[data-roster-open]")
                : one<HTMLButtonElement>("[data-add-agent]");
              door?.focus({ preventScroll: true });
            } catch (error) {
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          row.append(button);
        }
        list.append(row);
      }
      if (refocusPrincipal) {
        const row = list.querySelector<HTMLElement>(
          `[data-agent-row="${refocusPrincipal}"]`,
        );
        const target = row?.querySelector<HTMLButtonElement>("button") ?? row;
        target?.focus({ preventScroll: true });
      }
    };

    /*
     * Opening resets the filter so every session starts from the full roster. Initial
     * focus goes to Add an agent — the first visible primary action — or, when sample
     * mode hides that door, to the filter. Escape, modal focus containment, and focus
     * restore on close are the native <dialog>'s; the close event re-syncs the stack
     * button's aria-expanded no matter which path closed it.
     */
    const openRosterDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      if (!dialog || dialog.open) return;
      rosterFilter = "";
      const search = one<HTMLInputElement>("[data-roster-search]");
      if (search) search.value = "";
      renderDialogRoster();
      dialog.showModal();
      const add = one<HTMLButtonElement>("[data-add-agent-dialog]");
      const firstStop = add && !add.hidden ? add : search;
      window.requestAnimationFrame(() => firstStop?.focus({ preventScroll: true }));
      one<HTMLButtonElement>("[data-roster-open]")?.setAttribute("aria-expanded", "true");
    };

    const closeRosterDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      if (dialog?.open) dialog.close();
    };

    const formatTime = (value: string): { relative: string; absolute: string } => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return { relative: "Time unavailable", absolute: "" };
      const seconds = Math.round((date.getTime() - Date.now()) / 1_000);
      const ranges: Array<[number, Intl.RelativeTimeFormatUnit]> = [
        [60, "second"],
        [60, "minute"],
        [24, "hour"],
        [7, "day"],
        [4.345, "week"],
        [12, "month"],
        [Number.POSITIVE_INFINITY, "year"],
      ];
      let amount = seconds;
      let unit: Intl.RelativeTimeFormatUnit = "second";
      for (const [range, next] of ranges) {
        unit = next;
        if (Math.abs(amount) < range) break;
        amount /= range;
      }
      return {
        relative: new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(
          Math.round(amount),
          unit,
        ),
        absolute: new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(date),
      };
    };

    const kindLabel = (kind: string): string => {
      if (kind === "working-on") return "Working on";
      if (kind === "ask") return "Question";
      if (kind === "note") return "Note";
      return "Update";
    };

    const renderFeed = (): void => {
      window.clearTimeout(signalExpiryTimer);
      signalExpiryTimer = undefined;
      if (addAgentViewOpen()) return;
      const now = Date.now();
      signals = signals.filter(
        (signal) => signal.until === null || new Date(signal.until).getTime() > now,
      );
      const nextExpiry = signals.reduce<number | null>((nearest, signal) => {
        if (signal.until === null) return nearest;
        const expiresAt = new Date(signal.until).getTime();
        if (!Number.isFinite(expiresAt) || expiresAt <= now) return nearest;
        return nearest === null || expiresAt < nearest ? expiresAt : nearest;
      }, null);
      if (nextExpiry !== null) {
        signalExpiryTimer = window.setTimeout(
          renderFeed,
          Math.min(Math.max(nextExpiry - now + 25, 25), 2_147_483_647),
        );
      }
      const list = one<HTMLOListElement>("[data-feed-list]");
      const count = one<HTMLElement>("[data-update-count]");
      const more = one<HTMLElement>("[data-feed-more]");
      if (count) {
        count.textContent = `${signals.length}${signalHasMore ? "+" : ""} ${
          signals.length === 1 && !signalHasMore ? "update" : "updates"
        }`;
        count.hidden = signals.length === 0;
      }
      if (more) more.hidden = !signalHasMore;
      if (!list) return;
      list.replaceChildren();
      if (signals.length === 0) {
        const emptyTitle = one<HTMLElement>("[data-feed-empty-title]");
        if (emptyTitle) {
          emptyTitle.textContent = agents.length === 1
            ? `Waiting for ${agents[0]!.name}’s first update.`
            : "Waiting for your agents’ first updates.";
        }
        previousSignalIds.clear();
        feedWasEmpty = true;
        showChannelView("feed-empty");
        return;
      }
      const agentById = new Map(agents.map((agent) => [agent.principalId, agent]));
      for (const signal of signals) {
        const row = document.createElement("li");
        row.className = "dashboard__message";
        if ((feedWasEmpty || previousSignalIds.size > 0) && !previousSignalIds.has(signal.id)) {
          row.classList.add("dashboard__message--fresh");
        }
        const authorAgent = agentById.get(signal.from);
        const authorName = authorAgent?.name ??
          people.get(signal.from) ??
          (signal.fromKind === "user" ? "Team member" : `Agent ${signal.from.slice(0, 6)}`);
        const avatar = document.createElement("span");
        avatar.className = "dashboard__message-avatar";
        avatar.textContent = initials(authorName);
        avatar.setAttribute("aria-hidden", "true");
        if (authorAgent) markAgentAvatar(avatar, authorAgent.principalId);

        const body = document.createElement("article");
        body.className = "dashboard__message-body";
        const meta = document.createElement("header");
        meta.className = "dashboard__message-meta";
        const author = document.createElement("strong");
        author.textContent = authorName;
        const identity = document.createElement("span");
        identity.className = "dashboard__message-identity";
        if (authorAgent) {
          identity.textContent =
            `${authorAgent.model ?? "Model not specified"} · owned by ${
              people.get(authorAgent.ownerUserId) ?? "Workspace member"
            }`;
        } else {
          identity.textContent = signal.fromKind === "user" ? "Workspace member" : "AI agent";
        }
        if (signal.to) {
          identity.textContent += ` · to ${people.get(signal.to) ?? "workspace member"}`;
        }
        const badge = document.createElement("span");
        badge.className = `dashboard__message-kind dashboard__message-kind--${signal.kind}`;
        badge.textContent = kindLabel(signal.kind);
        const time = document.createElement("time");
        const formatted = formatTime(signal.createdAt);
        time.dateTime = signal.createdAt;
        time.title = formatted.absolute;
        time.textContent = formatted.relative;
        meta.append(author, identity, badge, time);
        const text = document.createElement("p");
        text.textContent = signal.body;
        body.append(meta, text);
        if (signal.about) {
          const about = document.createElement("code");
          about.className = "dashboard__message-about";
          about.textContent = signal.about;
          body.append(about);
        }
        row.append(avatar, body);
        list.append(row);
      }
      previousSignalIds = new Set(signals.map((signal) => signal.id));
      feedWasEmpty = false;
      showChannelView("feed");
    };

    const syncConnectWorkspace = (workspace: Workspace): void => {
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!connect) return;
      connect.setAttribute("workspace-name", workspace.name);
      connect.setAttribute("workspace-id", workspace.id);
    };

    const loadSignals = async (
      workspaceId: string,
      reset: boolean,
      version: number,
    ): Promise<void> => {
      const cursor = reset ? null : signalCursor;
      if (reset) {
        signalCursor = null;
        signalCutoff = new Date().toISOString();
      }
      const page = await signalPage(workspaceId, cursor, signalCutoff);
      if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
      if (reset) {
        signals = page.rows;
      } else {
        const known = new Set(signals.map((signal) => signal.id));
        const additions = page.rows.filter((signal) => !known.has(signal.id));
        signals = [...signals, ...additions];
      }
      const last = page.rows.at(-1);
      signalCursor = last ? { createdAt: last.createdAt, id: last.id } : cursor;
      signalHasMore = page.hasMore;
      renderFeed();
    };

    const refreshLatestSignals = async (): Promise<void> => {
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      if (
        liveFeedInFlight ||
        sampleMode ||
        !workspaceId ||
        document.visibilityState !== "visible" ||
        !["feed", "feed-empty"].includes(app.dataset.channelView ?? "")
      ) return;
      liveFeedInFlight = true;
      try {
        const page = await signalPage(workspaceId, null, new Date().toISOString());
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        /* A signal from a principal the roster does not know is how a join first shows
           up here: queue it for one bounded catch-up. Settled principals (confirmed
           revoked/historical by a previous successful fetch) never re-queue, so their
           immutable old signals cannot keep the queue alive forever. */
        const knownAgents = new Set(agents.map((agent) => agent.principalId));
        for (const signal of page.rows) {
          if (
            signal.fromKind === "agent" &&
            !knownAgents.has(signal.from) &&
            !settledUnknownAgents.has(signal.from)
          ) {
            unknownAgentCandidates.add(signal.from);
          }
        }
        if (unknownAgentCandidates.size > 0) {
          void refreshRosterForUnknownAgents(workspaceId, version);
        }
        const known = new Set(page.rows.map((signal) => signal.id));
        const next = [...page.rows, ...signals.filter((signal) => !known.has(signal.id))];
        const changed =
          next.length !== signals.length ||
          next.some((signal, index) => signal.id !== signals[index]?.id);
        signalHasMore = signalHasMore || page.hasMore;
        if (changed) {
          signals = next;
          renderFeed();
        }
        /* Consumption of a pending invite or agent key arrives with no signal of
           its own; the slow pending refresh rides the same healthy poll. */
        void refreshPendingAccess(workspaceId, version);
      } catch {
        // A live refresh never replaces a readable channel with an error. The
        // next tick retries, and the explicit refresh control remains available.
      } finally {
        liveFeedInFlight = false;
      }
    };

    /*
     * Pending access is where the inviter WAITS: a teammate invite or an agent key sits
     * there until it is consumed or cancelled. The two-second signal poll already runs
     * while the feed is visible, so consumption should show up without a full workspace
     * reopen — a teammate redeeming their invite in another browser is exactly the moment
     * the inviter is watching this list. The refresh piggybacks on that poll at a slower
     * cooldown, only while something is actually pending, and only re-renders the rail
     * list; it never touches the feed, the dialog, or an open add-agent view. A failure
     * retries at the next cooldown, silently — same doctrine as the signal refresh.
     *
     * Ownership is the gate's, and it is (workspaceId, version)-scoped: a slow request
     * started under the previous workspace holds no slot here, applies nothing when it
     * settles, and its finally cannot free the fresh workspace's ownership.
     */
    const hasPendingAccess = (): boolean =>
      pendingInvites.length > 0 ||
      accessStatuses.some(
        (access) =>
          access.firstUsedAt === null &&
          access.revokedAt === null &&
          new Date(access.expiresAt).getTime() > Date.now(),
      );

    const refreshPendingAccess = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      if (sampleMode) return;
      /* Acquiring also records the attempt. A stale owner — another workspace, or
         an older generation of this one — is replaced here rather than waited on. */
      if (
        !pendingRefreshGate.tryAcquire(
          workspaceId,
          version,
          Date.now(),
          hasPendingAccess(),
        )
      ) {
        return;
      }
      try {
        const [nextInvites, nextStatuses] = await Promise.all([
          pendingMemberInvites(workspaceId),
          agentAccessStatuses(workspaceId),
        ]);
        /* A request that settles after the user moved on applies nothing: its
           generation and workspace no longer match the live ones. */
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        pendingInvites = nextInvites;
        accessStatuses = nextStatuses;
        renderPendingAccess();
      } catch {
        // Stay silent and retryable; the last good list remains on screen.
      } finally {
        pendingRefreshGate.release(workspaceId, version);
      }
    };

    armLiveFeed = (): void => {
      if (
        sampleMode ||
        !activeWorkspaceId ||
        document.visibilityState !== "visible" ||
        !["feed", "feed-empty"].includes(app.dataset.channelView ?? "")
      ) return;
      if (liveFeedTimer !== undefined) return;
      liveFeedTimer = window.setInterval(() => void refreshLatestSignals(), 2_000);
    };

    /*
     * The feed polls every two seconds; the roster does not. When a poll brings in a
     * signal from an agent principal we do not know, that first signal IS the join event:
     * refresh the roster once so the header stack, the dialog, and the feed's author
     * names stop showing the "Agent a1b2c3" fallback.
     *
     * The catch-up is principal-aware because signals are immutable. A revoked agent's
     * old signals keep arriving in every latest page forever; settling is how that stops
     * costing fetches. Only a SUCCESSFUL fetch may settle, and only a candidate still
     * absent from that fetch — a failed fetch settles and drains nothing, so it stays
     * retryable after the cooldown. Concurrent candidates coalesce: the attempt drains
     * a snapshot of the queue while detection keeps filling it, and whatever arrives
     * during the flight is covered by the next bounded attempt.
     */
    const refreshRosterForUnknownAgents = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      if (rosterRefreshInFlight || sampleMode) return;
      if (unknownAgentCandidates.size === 0) return;
      if (Date.now() - rosterRefreshAttemptedAt < 10_000) return;
      rosterRefreshInFlight = true;
      rosterRefreshAttemptedAt = Date.now();
      const candidates = [...unknownAgentCandidates];
      try {
        const [nextAgents, nextRoster] = await Promise.all([
          roster(workspaceId),
          memberRoster(workspaceId),
        ]);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        people = nextRoster.names;
        members = nextRoster.members;
        const rosterIds = new Set(nextAgents.map((agent) => agent.principalId));
        /* A principal queued DURING the flight is not in the captured snapshot, but the
           fresh roster may already know it: prune those from the queue so they cannot
           cause a redundant fetch after the cooldown. Settling stays snapshot-only. */
        for (const principalId of [...unknownAgentCandidates]) {
          if (rosterIds.has(principalId)) unknownAgentCandidates.delete(principalId);
        }
        for (const principalId of candidates) {
          unknownAgentCandidates.delete(principalId);
          if (!rosterIds.has(principalId)) settledUnknownAgents.add(principalId);
        }
        renderRoster();
        renderMembers();
        renderFeed();
      } catch {
        // A roster refresh never replaces a readable channel with an error. Nothing is
        // settled or drained here, so the same candidates retry after the cooldown.
      } finally {
        rosterRefreshInFlight = false;
      }
    };

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState !== "visible") {
        window.clearInterval(liveFeedTimer);
        liveFeedTimer = undefined;
        return;
      }
      void refreshLatestSignals();
      armLiveFeed();
    });

    const renderChannel = (workspace: Workspace, pending = false): void => {
      const name = one<HTMLElement>("[data-channel-name]");
      const id = one<HTMLElement>("[data-channel-id]");
      if (name) name.textContent = workspace.name;
      if (id) id.textContent = workspace.id;
      const refresh = one<HTMLButtonElement>("[data-refresh]");
      if (refresh) refresh.hidden = sampleMode || agents.length === 0;
      const count = one<HTMLElement>("[data-update-count]");
      if (count) count.hidden = pending || agents.length === 0 || signals.length === 0;
      renderWorkspaceList(workspace);
      renderRoster();
      for (const target of all<HTMLElement>("[data-rail-account]")) {
        target.textContent = sampleMode || !session ? "Sample account" : accountName(session);
      }
      showPanel("channel");
      if (pending) {
        if (count) count.textContent = "Loading updates…";
        showChannelView("feed-pending");
      } else if (sampleMode) {
        renderFeed();
      } else if (agents.length === 0) {
        if (count) count.textContent = "Empty channel";
        showChannelView("no-agents");
      } else {
        showChannelView("feed-pending");
      }
    };

    const openWorkspace = async (workspaceId: string): Promise<void> => {
      const selected = workspaces.find((workspace) => workspace.id === workspaceId);
      if (!selected) return;
      if (activeWorkspaceId !== selected.id) {
        previousSignalIds.clear();
        feedWasEmpty = false;
      }
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const promptWorkspaceId = connect?.getAttribute("workspace-id") ?? "";
      const connectState = connect?.dataset.state ?? "";
      const mintBusy = connect?.hasAttribute("data-mint-busy") ?? false;
      if (connectState === "done") {
        pendingWorkspaceId = workspaceId;
        connect?.finishPrompt("back");
        return;
      }
      if (mintBusy || connectState === "working") {
        const changesWorkspace =
          promptWorkspaceId.length > 0 && promptWorkspaceId !== workspaceId;
        pendingWorkspaceId = changesWorkspace ? workspaceId : "";
        showChannelView("connect");
        window.requestAnimationFrame(() => {
          one<HTMLElement>("[data-close-connect]")?.focus();
        });
        return;
      }
      pendingWorkspaceId = "";
      /* The dialog shows the OLD workspace's roster from here on; close it rather than
         let it outlive its data. The refresh cooldown resets with the workspace. */
      closeRosterDialog();
      rosterRefreshAttemptedAt = 0;
      pendingRefreshGate.resetCooldown();
      unknownAgentCandidates.clear();
      settledUnknownAgents.clear();
      const keepShell = app.dataset.state === "channel";
      activeWorkspaceId = selected.id;
      syncConnectWorkspace(selected);
      const version = ++requestVersion;
      agents = [];
      members = [];
      pendingInvites = [];
      accessStatuses = [];
      people = new Map();
      signals = [];
      signalCursor = null;
      signalHasMore = false;
      signalCutoff = "";
      channelLoadError = "";
      if (keepShell) renderChannel(selected, true);
      else setLoading(`Opening ${selected.name}…`);
      try {
        const [nextAgents, nextRoster, nextInvites, nextAccessStatuses] = await Promise.all([
          roster(selected.id),
          memberRoster(selected.id),
          pendingMemberInvites(selected.id),
          agentAccessStatuses(selected.id),
        ]);
        if (version !== requestVersion) return;
        agents = nextAgents;
        people = nextRoster.names;
        members = nextRoster.members;
        pendingInvites = nextInvites;
        accessStatuses = nextAccessStatuses;
        if (!addAgentViewOpen()) renderChannel(selected);
        renderMembers();
        renderPendingAccess();
        if (agents.length > 0) {
          await loadSignals(selected.id, true, version);
        }
      } catch (error) {
        if (version !== requestVersion) return;
        signalHasMore = false;
        channelLoadError = `${readableError(error)} Nothing was changed.`;
        const target = one<HTMLElement>("[data-feed-error]");
        if (target) target.textContent = channelLoadError;
        if (addAgentViewOpen()) return;
        renderChannel(selected);
        showChannelView("feed-error");
      }
    };

    const openAgentChoice = (): void => {
      if (sampleMode) return;
      showChannelView("agent-choice");
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-agent-owner-self]")?.focus({ preventScroll: true });
      });
    };

    const openInvite = (): void => {
      if (sampleMode) return;
      freshInviteLink = "";
      const result = one<HTMLElement>("[data-invite-result]");
      const form = one<HTMLFormElement>("[data-invite-form]");
      const error = one<HTMLElement>("[data-invite-error]");
      if (result) result.hidden = true;
      if (form) form.hidden = false;
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
      showChannelView("invite");
      window.requestAnimationFrame(() => {
        one<HTMLInputElement>("[data-invite-email]")?.focus({ preventScroll: true });
      });
    };

    const openConnect = (): void => {
      if (sampleMode) return;
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      syncConnectWorkspace(selected);
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) exitStatus.hidden = true;
      showChannelView("connect");
      connectFocusObserver?.disconnect();
      const focusField = (): boolean => {
        if (connect.dataset.state !== "ready") return false;
        const form = connect.querySelector<HTMLFormElement>("[data-panel='form']");
        const target = form?.dataset.hasAgents === "yes"
          ? connect.querySelector<HTMLSelectElement>("[data-field='identity']")
          : connect.querySelector<HTMLInputElement>("[data-field='name']");
        target?.focus({ preventScroll: true });
        return Boolean(target);
      };
      window.requestAnimationFrame(() => {
        if (focusField()) return;
        connectFocusObserver = new MutationObserver(() => {
          if (!focusField()) return;
          connectFocusObserver?.disconnect();
          connectFocusObserver = null;
        });
        connectFocusObserver.observe(connect, {
          attributes: true,
          attributeFilter: ["data-state"],
        });
      });
    };

    const keepConnectCredentialVisible = (): boolean => {
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const connectState = connect?.dataset.state ?? "";
      const mintBusy = connect?.hasAttribute("data-mint-busy") ?? false;
      if (!mintBusy && connectState !== "working") return false;
      showChannelView("connect");
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) {
        exitStatus.textContent =
          "Wait for CommonSwarm to finish creating the key before leaving this screen.";
        exitStatus.hidden = false;
      }
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-close-connect]")?.focus();
      });
      return true;
    };

    const returnToChannel = (): void => {
      pendingWorkspaceId = "";
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) exitStatus.hidden = true;
      if (channelLoadError) showChannelView("feed-error");
      else if (agents.length === 0) showChannelView("no-agents");
      else if (signals.length === 0) {
        const workspaceId = activeWorkspaceId;
        const version = requestVersion;
        showChannelView("feed-pending");
        void loadSignals(workspaceId, true, version).catch((error) => {
          if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
          channelLoadError = `${readableError(error)} Nothing was changed.`;
          const target = one<HTMLElement>("[data-feed-error]");
          if (target) target.textContent = channelLoadError;
          if (addAgentViewOpen()) return;
          showChannelView("feed-error");
        });
      }
      else {
        // This is an explicit exit from an add-agent view. Mark the feed active
        // before rendering so renderFeed's background-refresh guard does not
        // mistake the requested return for an unsolicited view change.
        showChannelView("feed");
        renderFeed();
      }
    };

    const closeConnect = (): void => {
      if (keepConnectCredentialVisible()) return;
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (connect?.dataset.state === "done") {
        connect.finishPrompt("back");
        return;
      }
      returnToChannel();
    };

    const createFromIntent = async (value: Session, intent: CreateIntent): Promise<void> => {
      const version = requestVersion;
      const userId = value.user.id;
      if (activeCreate?.version === version && activeCreate.userId === userId) return;
      const marker = { version, userId };
      activeCreate = marker;
      const isCurrent = (): boolean =>
        version === requestVersion && session?.user.id === userId;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const button = one<HTMLButtonElement>("[data-create-button]");
      if (input) {
        input.value = intent.name;
        input.disabled = true;
      }
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.textContent = "Creating your workspace…";
      }
      setCreateError(null);
      try {
        const made = await createWorkspace(
          value,
          intent.commandId,
          intent.workspaceId,
          intent.name,
        );
        if (!isCurrent()) return;
        clearCreateIntent(value.user.id);
        workspaces = [{ id: made.workspaceId, name: made.name }];
        if (input) input.disabled = false;
        await openWorkspace(made.workspaceId);
      } catch (error) {
        if (!isCurrent()) return;
        renderCreate(
          value,
          `${readableError(error)} ${
            error instanceof WorkspaceLimitReached || error instanceof WorkspaceOutcomeUnknown
              ? ""
              : "Trying again checks the same request; it cannot create a duplicate."
          }`.trim(),
        );
      } finally {
        if (activeCreate === marker) activeCreate = null;
        if (!isCurrent()) return;
        if (input) input.disabled = false;
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.textContent = "Create workspace";
        }
      }
    };

    const renderSample = (): void => {
      sampleMode = true;
      signalHasMore = false;
      signalCursor = null;
      signalCutoff = "";
      const now = Date.now();
      workspaces = [
        { id: "sample-design-studio", name: "Design studio" },
      ];
      agents = [
        { principalId: "sample-river", name: "River", ownerUserId: "sample-owner" },
        { principalId: "sample-orbit", name: "Orbit", ownerUserId: "sample-owner" },
        { principalId: "sample-lumen", name: "Lumen", ownerUserId: "sample-owner" },
      ];
      signals = [
        {
          id: "sample-1",
          from: "sample-lumen",
          fromKind: "agent",
          kind: "working-on",
          body: "Refining the workspace-first dashboard states.",
          about: "site/src/components/app",
          until: null,
          createdAt: new Date(now - 4 * 60_000).toISOString(),
        },
        {
          id: "sample-2",
          from: "sample-river",
          fromKind: "agent",
          kind: "note",
          body: "The signup copy is ready for the dashboard handoff.",
          about: "/app",
          until: null,
          createdAt: new Date(now - 18 * 60_000).toISOString(),
        },
        {
          id: "sample-3",
          from: "sample-orbit",
          fromKind: "agent",
          kind: "ask",
          body: "Can someone verify the narrow-screen agent rail?",
          about: "responsive QA",
          until: null,
          createdAt: new Date(now - 44 * 60_000).toISOString(),
        },
      ];
      activeWorkspaceId = workspaces[0]?.id ?? "";
      const notice = one<HTMLElement>("[data-sample-notice]");
      const chip = one<HTMLElement>("[data-sample-chip]");
      if (notice) notice.hidden = false;
      if (chip) chip.hidden = false;
      const refresh = one<HTMLButtonElement>("[data-refresh]");
      if (refresh) refresh.hidden = true;
      for (const button of all<HTMLButtonElement>("[data-signout]")) button.hidden = true;
      renderChannel(workspaces[0]!);
    };

    const boot = async (): Promise<void> => {
      const version = ++requestVersion;
      if (!client()) {
        renderSample();
        return;
      }

      sampleMode = false;
      for (const button of all<HTMLButtonElement>("[data-signout]")) button.hidden = false;
      setLoading("Checking your sign-in…");
      try {
        session = await currentSession();
        if (version !== requestVersion) return;
        renderedAuthUserId = session?.user.id ?? "";
        if (!session) {
          showAuthView("choices");
          showPanel("signed-out");
          return;
        }
        const who = accountName(session);
        for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
          target.textContent = who;
        }
        workspaces = await workspaceMemberships();
        if (version !== requestVersion) return;
        if (workspaces.length === 0) {
          const pending = readCreateIntent(session.user.id);
          renderCreate(session);
          if (pending) await createFromIntent(session, pending);
          return;
        }
        const pending = readCreateIntent(session.user.id);
        if (pending && workspaces.some((workspace) => workspace.id === pending.workspaceId)) {
          clearCreateIntent(session.user.id);
        }
        await openWorkspace(workspaces[0]!.id);
      } catch (error) {
        if (version !== requestVersion) return;
        if (session) {
          renderWorkspaceError(session, error);
        } else {
          showAuthView("choices");
          showPanel("signed-out");
          authError(readableError(error));
        }
      }
    };

    const runBoot = (): void => {
      if (bootInFlight) {
        bootAgain = true;
        return;
      }
      bootInFlight = (async () => {
        do {
          bootAgain = false;
          await boot();
        } while (bootAgain);
      })().finally(() => {
        bootInFlight = null;
        if (bootAgain) runBoot();
      });
    };

    one<HTMLButtonElement>("[data-signin-github]")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      authError(null);
      try {
        await signInWithGitHub(new URL("/app", window.location.origin).href);
      } catch (error) {
        authError(readableError(error));
        button.disabled = false;
        button.removeAttribute("aria-busy");
      }
    });

    one<HTMLButtonElement>("[data-member-reauth-github]")?.addEventListener(
      "click",
      async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        try {
          await signInWithGitHub(new URL("/app", window.location.origin).href);
        } catch (error) {
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent = readableError(error);
            target.hidden = false;
          }
          button.disabled = false;
        }
      },
    );
    one<HTMLButtonElement>("[data-member-reauth-email]")?.addEventListener(
      "click",
      async (event) => {
        const email = window.prompt("Email address for a fresh sign-in link:");
        if (!email?.trim()) return;
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        try {
          await signInWithEmail(
            email.trim(),
            new URL("/app", window.location.origin).href,
          );
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent =
              "Check your email. After signing in, return here and press Remove again.";
            target.hidden = false;
          }
        } catch (error) {
          const target = one<HTMLElement>("[data-member-error]");
          if (target) {
            target.textContent = readableError(error);
            target.hidden = false;
          }
        } finally {
          button.disabled = false;
        }
      },
    );

    for (const button of all<HTMLButtonElement>("[data-use-email]")) {
      button.addEventListener("click", () => showAuthView("choices"));
    }

    one<HTMLFormElement>(".dashboard__email")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const input = form.elements.namedItem("email") as HTMLInputElement | null;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!input?.value.trim()) return;
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
      }
      authError(null);
      try {
        await signInWithEmail(input.value.trim(), new URL("/app", window.location.origin).href);
        const email = one<HTMLElement>("[data-auth-email]");
        if (email) email.textContent = input.value.trim();
        showAuthView("email-sent");
      } catch (error) {
        authError(readableError(error));
      } finally {
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      }
    });

    one<HTMLFormElement>("[data-create-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session) return;
      if (
        activeCreate?.version === requestVersion &&
        activeCreate.userId === session.user.id
      ) return;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const name = input?.value.trim() ?? "";
      if (!name) {
        setCreateError("Name the workspace first.");
        input?.focus();
        return;
      }
      const savedIntent = readCreateIntent(session.user.id);
      const intent: CreateIntent = savedIntent?.name === name
        ? savedIntent
        : {
            workspaceId: uuid(),
            commandId: uuid(),
            name,
          };
      writeCreateIntent(session.user.id, intent);
      await createFromIntent(session, intent);
    });

    for (const button of all<HTMLButtonElement>("[data-signout]")) {
      button.addEventListener("click", async () => {
        if (keepConnectCredentialVisible()) return;
        button.disabled = true;
        closeRosterDialog();
        one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
        if (session) clearCreateIntent(session.user.id);
        requestVersion += 1;
        activeWorkspaceId = "";
        renderedAuthUserId = "";
        window.clearTimeout(signalExpiryTimer);
        signalExpiryTimer = undefined;
        await signOut();
        session = null;
        workspaces = [];
        agents = [];
        people = new Map();
        signals = [];
        pendingWorkspaceId = "";
        showAuthView("choices");
        showPanel("signed-out");
        button.disabled = false;
      });
    }

    one<HTMLFormElement>("[data-invite-form]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!session || !activeWorkspaceId) return;
      const emailInput = one<HTMLInputElement>("[data-invite-email]");
      const submit = one<HTMLButtonElement>("[data-invite-submit]");
      const error = one<HTMLElement>("[data-invite-error]");
      const email = emailInput?.value.trim() ?? "";
      if (!email) {
        if (error) {
          error.textContent = "Enter the teammate’s email first.";
          error.hidden = false;
        }
        emailInput?.focus();
        return;
      }
      if (!inviteIntent || inviteIntent.email !== email) {
        inviteIntent = { email, commandId: uuid() };
      }
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Creating a private link…";
      }
      try {
        const target = deployment();
        const workspace = workspaces.find((entry) => entry.id === activeWorkspaceId);
        if (!target || !workspace) throw new NoDeployment();
        const created = await inviteWorkspaceMember(
          session,
          inviteIntent.commandId,
          activeWorkspaceId,
          email,
        );
        freshInviteLink = memberInviteUrl(window.location.origin, {
          v: 1,
          url: target.url,
          anon_key: target.anonKey,
          workspace_id: created.workspaceId,
          invitation_token: created.invitationToken,
          workspace_name: created.workspaceName || workspace.name,
          inviter_display_name: created.inviterDisplayName || accountName(session),
          inviter_user_id: created.inviterUserId ?? session.user.id,
        });
        inviteIntent = null;
        const link = one<HTMLElement>("[data-invite-link]");
        const result = one<HTMLElement>("[data-invite-result]");
        const form = one<HTMLFormElement>("[data-invite-form]");
        if (link) link.textContent = freshInviteLink;
        if (result) result.hidden = false;
        if (form) form.hidden = true;
        pendingInvites = await pendingMemberInvites(activeWorkspaceId);
        renderPendingAccess();
        window.requestAnimationFrame(() => {
          one<HTMLButtonElement>("[data-copy-invite]")?.focus({ preventScroll: true });
        });
      } catch (caught) {
        if (!(caught instanceof CommandOutcomeUnknown)) inviteIntent = null;
        if (error) {
          error.textContent = readableError(caught);
          error.hidden = false;
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = "Create invite link";
        }
      }
    });

    one<HTMLButtonElement>("[data-copy-invite]")?.addEventListener("click", async () => {
      const status = one<HTMLElement>("[data-invite-status]");
      if (!freshInviteLink) return;
      try {
        await navigator.clipboard.writeText(freshInviteLink);
        if (status) status.textContent = "Copied. Send this link to your teammate.";
      } catch {
        const link = one<HTMLElement>("[data-invite-link]");
        if (link) {
          const range = document.createRange();
          range.selectNodeContents(link);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        if (status) status.textContent = "The link is selected. Press ⌘C or Ctrl+C.";
      }
    });

    one<HTMLButtonElement>("[data-add-agent]")?.addEventListener("click", openAgentChoice);
    one<HTMLButtonElement>("[data-roster-open]")?.addEventListener("click", openRosterDialog);
    one<HTMLButtonElement>("[data-roster-close]")?.addEventListener("click", closeRosterDialog);
    one<HTMLButtonElement>("[data-add-agent-dialog]")?.addEventListener("click", () => {
      closeRosterDialog();
      openAgentChoice();
    });
    one<HTMLInputElement>("[data-roster-search]")?.addEventListener("input", (event) => {
      rosterFilter = (event.currentTarget as HTMLInputElement).value;
      renderDialogRoster();
    });
    {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      /* A click landing on the dialog element itself is a click on the backdrop — the
         dialog's box did not catch it. */
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener("close", () => {
        one<HTMLButtonElement>("[data-roster-open]")?.setAttribute("aria-expanded", "false");
      });
    }
    one<HTMLButtonElement>("[data-close-agent-choice]")?.addEventListener("click", returnToChannel);
    one<HTMLButtonElement>("[data-agent-owner-self]")?.addEventListener("click", openConnect);
    one<HTMLButtonElement>("[data-agent-owner-teammate]")?.addEventListener("click", openInvite);
    one<HTMLButtonElement>("[data-close-invite]")?.addEventListener("click", openAgentChoice);
    one<HTMLButtonElement>("[data-invite-done]")?.addEventListener("click", () => {
      freshInviteLink = "";
      returnToChannel();
    });
    one<HTMLButtonElement>("[data-close-connect]")?.addEventListener("click", closeConnect);
    one<HTMLButtonElement>("[data-copy-workspace-id]")?.addEventListener("click", async () => {
      const status = one<HTMLElement>("[data-workspace-id-status]");
      try {
        await navigator.clipboard.writeText(activeWorkspaceId);
        if (status) status.textContent = "Copied";
      } catch {
        if (status) status.textContent = "Could not copy";
      }
    });
    one<HTMLButtonElement>("[data-retry-workspace]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-retry-workspaces]")?.addEventListener("click", () => {
      runBoot();
    });
    one<HTMLButtonElement>("[data-refresh]")?.addEventListener("click", () => {
      if (activeWorkspaceId) void openWorkspace(activeWorkspaceId);
    });
    one<HTMLButtonElement>("[data-load-older]")?.addEventListener("click", async (event) => {
      if (!activeWorkspaceId || !signalHasMore) return;
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      const button = event.currentTarget as HTMLButtonElement;
      const inlineError = one<HTMLElement>("[data-load-older-error]");
      if (inlineError) {
        inlineError.textContent = "";
        inlineError.hidden = true;
      }
      button.disabled = true;
      button.textContent = "Loading older updates…";
      try {
        await loadSignals(workspaceId, false, version);
      } catch (error) {
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        if (inlineError) {
          inlineError.textContent = `${readableError(error)} The loaded updates are still here.`;
          inlineError.hidden = false;
        }
      } finally {
        button.disabled = false;
        button.textContent = "Load older updates";
      }
    });

    app.addEventListener("commonswarm:agent-prompt-ready", async (event) => {
      const detail = (event as CustomEvent<{
        workspaceId?: unknown;
        principalId?: unknown;
      }>).detail;
      const workspaceId = detail?.workspaceId;
      if (
        typeof workspaceId !== "string" ||
        workspaceId !== activeWorkspaceId ||
        sampleMode
      ) return;
      if (typeof detail?.principalId === "string") {
        livePromptPrincipalId = detail.principalId;
      }
      const version = requestVersion;
      try {
        const [nextAgents, nextStatuses] = await Promise.all([
          roster(workspaceId),
          agentAccessStatuses(workspaceId),
        ]);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        accessStatuses = nextStatuses;
        renderRoster();
        renderPendingAccess();
        const refresh = one<HTMLButtonElement>("[data-refresh]");
        if (refresh) refresh.hidden = agents.length === 0;
      } catch {
        /* The mint result remains on screen; a roster refresh must never erase its secret. */
      }
    });

    app.addEventListener("commonswarm:agent-secret-cleared", (event) => {
      const detail = (event as CustomEvent<{ reason?: unknown }>).detail;
      livePromptPrincipalId = "";
      const nextWorkspaceId = pendingWorkspaceId;
      pendingWorkspaceId = "";
      if (nextWorkspaceId) {
        void openWorkspace(nextWorkspaceId);
        return;
      }
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      syncConnectWorkspace(selected);
      returnToChannel();
      const receipt = one<HTMLElement>("[data-channel-receipt]");
      if (receipt && detail?.reason === "consumed") {
        receipt.textContent = "Agent connected. Its one-time prompt has been cleared.";
        receipt.hidden = false;
        window.setTimeout(() => {
          receipt.hidden = true;
        }, 6_000);
      }
      void agentAccessStatuses(activeWorkspaceId).then((next) => {
        if (selected.id !== activeWorkspaceId) return;
        accessStatuses = next;
        renderPendingAccess();
      });
      window.requestAnimationFrame(() => {
        /* A plain focus(): the platform's heuristic decides the ring — this runs
           after the prompt completes, so a keyboard user following the flow sees
           where focus landed and a pointer user is not decorated. */
        one<HTMLElement>("[data-channel-name]")?.focus({ preventScroll: true });
      });
    });

    const queueAuthReload = (nextSession: Session | null): void => {
      const nextUserId = nextSession?.user.id ?? "";
      if (nextUserId === renderedAuthUserId || authReloadQueued) return;
      renderedAuthUserId = nextUserId;
      requestVersion += 1;
      authReloadQueued = true;
      queueMicrotask(() => {
        authReloadQueued = false;
        runBoot();
      });
    };

    /* /start now preserves its query and hash while handing old callbacks to /app, so this
       listener is the one auth-return controller for both current and compatibility links. */
    client()?.auth.onAuthStateChange((event, nextSession) => {
      if (nextSession?.user.id === renderedAuthUserId) session = nextSession;
      if (
        event === "INITIAL_SESSION" ||
        event === "SIGNED_IN" ||
        event === "SIGNED_OUT"
      ) {
        queueAuthReload(nextSession);
      }
    });

    runBoot();
  }
</script>

