          ownerUserId: "sample-owner",
          agentName: "Orbit",
          model: "Claude",
          tokenId: "sample-token-orbit-745a329f",
          issuedAt: new Date(now - 90 * 60_000).toISOString(),
          expiresAt: new Date(now + 6 * 60 * 60_000).toISOString(),
          firstUsedAt: new Date(now - 82 * 60_000).toISOString(),
          revokedAt: new Date(now - 12 * 60_000).toISOString(),
        },
        {
          workspaceId: "sample-design-studio",
          principalId: "sample-lumen",
          ownerUserId: "sample-member",
          agentName: "Lumen",
          model: "Gemini",
          tokenId: "sample-token-lumen-33a97cd1",
          issuedAt: new Date(now - 70 * 60_000).toISOString(),
          expiresAt: new Date(now + 6 * 60 * 60_000).toISOString(),
