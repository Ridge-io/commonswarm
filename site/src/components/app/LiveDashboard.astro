---
/*
 * /app is the product surface. The browser owns the state machine because the page is
 * statically built while auth, workspaces, agents, and signals belong to the signed-in
 * session. Static markup contains every panel so focus, loading, and failure states stay
 * styled even before data arrives; dynamic values are written with textContent only.
 *
 * The workspace view follows the operator's Slack-shaped room model: a rail groups streams,
 * people, and agent presence while the signal feed remains the primary surface. Agent
 * management stays in the header dialog. The rail presence list is deliberately bounded and
 * scrolls inside a fixed maximum height, so three agents and fifty agents occupy the same
 * amount of layout. Files and tasks are absent because they are not CommonSwarm primitives.
 */

import AgentConnect from "../connect/AgentConnect.astro";
import SampleNotice from "./SampleNotice.astro";
import "../../styles/tokens.css";
---

<live-dashboard class="dashboard" data-state="loading">
  <div class="dashboard__wash" aria-hidden="true"></div>

  <div class="dashboard__root">
    <section class="dashboard__loading" data-panel="loading" role="status" aria-live="polite">
      <span class="dashboard__spinner" aria-hidden="true"></span>
      <span data-loading-label>Opening CommonSwarm…</span>
    </section>

    <section
      class="dashboard__gateway"
      data-panel="signed-out"
      data-signed-out-onramp
      aria-labelledby="dashboard-signin-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow">CommonSwarm</p>
        <h1 id="dashboard-signin-title">See what your agents are doing.</h1>
        <p>
          One feed where your people and AI agents announce what they’re about to do. Sign in
          to open yours. New here? Signing in starts your free account — up to three
          workspaces, no card.
        </p>
      </div>

      <form class="dashboard__auth dashboard__email" data-auth-view="choices">
        <label for="dashboard-email">Email address</label>
        <div class="dashboard__email-row">
          <input
            id="dashboard-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            placeholder="you@example.com"
          />
          <button class="dashboard__button dashboard__button--primary" type="submit">
            Email me a sign-in link
          </button>
        </div>
        <p class="dashboard__auth-note">No password. The link returns you to this page.</p>
        <div class="dashboard__auth-divider" aria-hidden="true"><span>or</span></div>
        <button
          class="dashboard__button dashboard__button--secondary"
          type="button"
          data-signin-github
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          Sign in with GitHub
        </button>
      </form>

      <div class="dashboard__auth dashboard__email-sent" data-auth-view="email-sent" hidden>
        <p class="dashboard__email-sent-title">Check your inbox.</p>
        <p>
          We sent a sign-in link to <strong data-auth-email>your email</strong>. Open it in this
          browser — it brings you straight back here.
        </p>
        <button class="dashboard__text-button" type="button" data-use-email>
          Use a different address
        </button>
      </div>

      <p class="dashboard__form-error" role="alert" data-auth-error hidden></p>
      <p class="dashboard__legal-note">
        By continuing you acknowledge the
        <a href="/terms">Terms of Service</a>
        and
        <a href="/privacy">Privacy Policy</a>
        drafts published for review (not yet in force).
      </p>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="create"
      aria-labelledby="dashboard-create-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy">
        <p class="dashboard__eyebrow" data-create-eyebrow>Your first workspace</p>
        <h1 id="dashboard-create-title" data-create-title>Name your workspace.</h1>
        <p data-create-description>
          A workspace is one shared feed. Your people and AI agents post what they’re about
          to do, so work does not collide.
        </p>
      </div>
      <form class="dashboard__create-form" data-create-form>
        <label for="dashboard-workspace-name">Workspace name</label>
        <input
          id="dashboard-workspace-name"
          name="workspace-name"
          type="text"
          maxlength="80"
          autocomplete="off"
          required
          spellcheck="false"
        />
        <button class="dashboard__button dashboard__button--primary" type="submit" data-create-button>
          Create workspace
        </button>
      </form>
      <p class="dashboard__form-error" role="alert" data-create-error hidden></p>
      <button class="dashboard__text-button" type="button" data-create-cancel hidden>
        Back to workspace
      </button>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section
      class="dashboard__gateway dashboard__gateway--create"
      data-panel="workspace-error"
      aria-labelledby="dashboard-workspace-error-title"
      hidden
    >
      <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
      <div class="dashboard__account-line">
        <span class="dashboard__account-dot" aria-hidden="true"></span>
        <span>Signed in as <strong data-account-name>your account</strong></span>
      </div>
      <div class="dashboard__gateway-copy" role="alert">
        <p class="dashboard__eyebrow">Workspace check interrupted</p>
        <h1 id="dashboard-workspace-error-title">Your workspaces could not load.</h1>
        <p data-workspace-error>
          CommonSwarm could not check your memberships. Nothing was created or changed.
        </p>
      </div>
      <button
        class="dashboard__button dashboard__button--primary"
        type="button"
        data-retry-workspaces
      >
        Try again
      </button>
      <button class="dashboard__text-button dashboard__signout-link" type="button" data-signout>
        Sign out
      </button>
    </section>

    <section class="dashboard__product" data-panel="channel" hidden>
      <div class="dashboard__sample-notice" data-sample-notice hidden>
        <SampleNotice />
      </div>

      <div class="dashboard__frame">
        <aside class="dashboard__rail" aria-label="Workspace navigation and details">
          <div class="dashboard__workspace-control" data-workspace-menu-root>
            <button
              class="dashboard__workspace-trigger"
              type="button"
              data-workspace-menu-trigger
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="dashboard-workspace-menu"
              aria-label="Current workspace: Workspace. Choose workspace"
            >
              <span class="dashboard__workspace-trigger-name" data-sidebar-workspace-name>Workspace</span>
              <span class="dashboard__sample-chip" data-sample-chip hidden>Sample</span>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="m4 6 4 4 4-4"></path>
              </svg>
            </button>
            <div
              class="dashboard__workspace-menu"
              id="dashboard-workspace-menu"
              data-workspace-menu
              role="menu"
              aria-label="Choose a workspace"
              hidden
            >
              <div class="dashboard__workspace-list" data-workspace-list></div>
              <div class="dashboard__workspace-menu-create">
                <button
                  class="dashboard__workspace-create-button"
                  type="button"
                  role="menuitem"
                  data-new-workspace
                >
                  <span aria-hidden="true">+</span>
                  <span>New workspace</span>
                </button>
              </div>
            </div>
          </div>

          <section class="dashboard__workspace-context" aria-label="Workspace signal summary">
            <p class="dashboard__workspace-summary">
              Broadcasts <strong data-broadcast-count>0</strong>
              <span aria-hidden="true">·</span>
              Direct signals <strong data-direct-count>0</strong>
            </p>
          </section>

          <nav class="dashboard__rail-section dashboard__rail-section--places" aria-labelledby="dashboard-streams-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-streams-label">STREAMS <span>(broadcast)</span></h2>
            </div>
            <div class="dashboard__sidebar-place" aria-current="page">
              <span class="dashboard__sidebar-place-mark" aria-hidden="true">#</span>
              <span>all-signals</span>
            </div>
          </nav>

          <section class="dashboard__rail-section dashboard__rail-section--participants" aria-labelledby="dashboard-participants-label">
            <div class="dashboard__rail-label-row">
              <h2 id="dashboard-participants-label">PEOPLE &amp; AGENTS</h2>
            </div>
            <ul class="dashboard__sidebar-agent-list" data-sidebar-participant-list></ul>
            <p class="dashboard__agent-ownership-note">
              Every agent belongs to a person. Workspace-owned agents are not supported yet.
            </p>
          </section>

          <details class="dashboard__rail-details" data-member-details hidden>
            <summary>
              <span>Members</span>
              <span data-member-count>0</span>
            </summary>
            <div class="dashboard__rail-details-body">
              <ul class="dashboard__agent-list" data-member-list></ul>
              <p class="dashboard__form-error" data-member-error role="alert" hidden></p>
              <div data-member-reauth hidden>
                <button class="dashboard__rail-add" type="button" data-member-reauth-github>
                  Sign in again with GitHub
                </button>
                <button class="dashboard__rail-add" type="button" data-member-reauth-email>
                  Email a fresh sign-in link
                </button>
              </div>
            </div>
          </details>

          <details class="dashboard__rail-details" data-access-details hidden>
            <summary>
              <span>Pending access</span>
              <span data-access-count>0</span>
            </summary>
            <div class="dashboard__rail-details-body">
              <ul class="dashboard__agent-list" data-access-list></ul>
              <p class="dashboard__form-error" data-access-error role="alert" hidden></p>
            </div>
          </details>

          <details class="dashboard__rail-details" data-workspace-details>
            <summary>Workspace details</summary>
            <div class="dashboard__rail-details-body">
              <code class="dashboard__workspace-id" data-channel-id></code>
              <button class="dashboard__text-button" type="button" data-copy-workspace-id>
                Copy workspace ID
              </button>
              <span class="dashboard__copy-status" role="status" aria-live="polite" data-workspace-id-status></span>
            </div>
          </details>

          <div class="dashboard__rail-foot">
            <a class="dashboard__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
            <button
              class="dashboard__theme-toggle"
              type="button"
              data-theme-toggle
              aria-label="Theme: System. Activate for light theme"
              title="Theme: System"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <circle cx="12" cy="12" r="8.5"></circle>
                <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z"></path>
              </svg>
              <span data-theme-toggle-label>System</span>
            </button>
            <div class="dashboard__rail-account">
              <span data-rail-account>Your account</span>
              <button class="dashboard__text-button" type="button" data-signout>Sign out</button>
            </div>
          </div>
        </aside>

        <section class="dashboard__channel" aria-labelledby="dashboard-channel-title">
          <header class="dashboard__channel-head">
            <div class="dashboard__channel-titleblock">
              <h1 id="dashboard-channel-title" data-channel-name tabindex="-1"># all-signals</h1>
              <p class="dashboard__channel-description">
                Intent posted by every agent in this workspace. Immutable, and never a claim.
              </p>
            </div>

            {/* The header agent roster: ONE control, the Slack-style members stack.
                Activating it opens the management dialog (Add an agent first, then the
                full roster with Remove and any pending access). It remains reachable when
                access is pending even before the first agent arrives; that is the only
                mobile door to review or cancel an invite. The stack initials are
                decorative; the accessible name carries both active and pending counts. */}
            <div class="dashboard__channel-roster" data-header-roster hidden>
              <button
                class="dashboard__roster-button"
                type="button"
                data-roster-open
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="dashboard-roster-dialog"
                aria-label="0 agents — view and manage agents"
              >
                <span class="dashboard__roster-stack" data-header-agent-stack aria-hidden="true"></span>
                <span class="dashboard__roster-count" data-header-roster-summary aria-hidden="true">0</span>
              </button>
            </div>

            <div class="dashboard__channel-actions">
              {/* The one promise the header owes a first-timer: this feed moves by
                  itself. Shown exactly while the two-second poll can be armed
                  (feed views, never sample mode), so the word is always true.
                  It also answers the question the refresh button accidentally
                  raises — no, you do not have to. */}
              <span class="dashboard__live" data-live-chip hidden>
                <span class="dashboard__live-dot" aria-hidden="true"></span>Live
              </span>
              <span class="dashboard__update-count" data-update-count hidden>0 updates</span>
              <button
                class="dashboard__icon-button"
                type="button"
                data-refresh
                aria-label="Refresh channel"
                title="Refresh channel"
                hidden
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M20 6v5h-5M4 18v-5h5M6.1 9a7 7 0 0 1 11.7-2.6L20 8.5M4 15.5l2.2 2.1A7 7 0 0 0 17.9 15"></path>
                </svg>
              </button>
              <button
                class="dashboard__text-button dashboard__mobile-signout"
                type="button"
                data-signout
              >
                Sign out
              </button>
            </div>
          </header>

          <div class="dashboard__channel-body">
            <p class="dashboard__channel-receipt" role="status" aria-live="polite" data-channel-receipt hidden></p>
            <section class="dashboard__channel-empty" data-channel-view="no-agents">
              <div class="dashboard__empty-orbit" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <p class="dashboard__eyebrow">Workspace ready</p>
              <h2>Add your first agent.</h2>
              <p>
                CommonSwarm writes one prompt for you. Paste it into the AI assistant you
                already use, and the agent joins this feed.
              </p>
              <button class="dashboard__button dashboard__button--primary" type="button" data-add-agent>
                Add an agent
              </button>
            </section>

            <section class="dashboard__connect-view dashboard__choice-view" data-channel-view="agent-choice" hidden>
              <button class="dashboard__back-button" type="button" data-close-agent-choice>
                <span aria-hidden="true">←</span>
                Back to the channel
              </button>
              <div class="dashboard__choice-copy">
                <p class="dashboard__eyebrow">Add an agent</p>
                <h2>Who runs this agent?</h2>
                <p>Choose who should receive and control the one-time agent prompt.</p>
              </div>
              <div class="dashboard__choice-list">
                <button class="dashboard__choice" type="button" data-agent-owner-self>
                  <span>
                    <strong>I do</strong>
                    <small>Create a prompt for an agent you control.</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </button>
                <button class="dashboard__choice" type="button" data-agent-owner-teammate>
                  <span>
                    <strong>A teammate does</strong>
                    {/* "Short" was a promise the link cannot keep — the capability
                        travels in the URL fragment, so it is long. What is true:
                        one link, one tap to copy, easy to text. */}
                    <small>Send one link — easy to copy and text. They create their own agent prompt.</small>
                  </span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </section>

            <section class="dashboard__connect-view dashboard__invite-view" data-channel-view="invite" hidden>
              <button class="dashboard__back-button" type="button" data-close-invite>
                <span aria-hidden="true">←</span>
                Back to who runs this agent
              </button>
              <div class="dashboard__choice-copy">
                <p class="dashboard__eyebrow">Invite a teammate</p>
                <h2>Send one link. They connect their agent.</h2>
                <p>
                  Your teammate sees the workspace, signs in, and gets the prompt for an
                  agent they control. You never need to text them a live agent key.
                </p>
              </div>
              <form class="dashboard__invite-form" data-invite-form novalidate>
                <label for="dashboard-invite-email">Their email</label>
                <input
                  id="dashboard-invite-email"
                  type="email"
                  autocomplete="email"
                  required
                  placeholder="calvin@example.com"
                  data-invite-email
                />
                <button class="dashboard__button dashboard__button--primary" type="submit" data-invite-submit>
                  Create invite link
                </button>
              </form>
              <div class="dashboard__invite-result" data-invite-result hidden>
                <p class="dashboard__invite-receipt" data-invite-receipt>
                  Private one-use link · expires in 7 days
                </p>
                <pre class="dashboard__invite-link" data-invite-link tabindex="0"></pre>
                <button class="dashboard__button dashboard__button--primary" type="button" data-copy-invite>
                  Copy invite link
                </button>
                <p class="dashboard__copy-status" role="status" aria-live="polite" data-invite-status></p>
                <button class="dashboard__text-button" type="button" data-invite-done>
                  Done
                </button>
              </div>
              <p class="dashboard__form-error" role="alert" data-invite-error hidden></p>
            </section>

            <section class="dashboard__connect-view" data-channel-view="connect" hidden>
              <button class="dashboard__back-button" type="button" data-close-connect>
                <span aria-hidden="true">←</span>
                Back to the channel
              </button>
              <p
                class="dashboard__form-error dashboard__connect-exit-status"
                role="status"
                aria-live="polite"
                data-connect-exit-status
                hidden
              ></p>
              <AgentConnect eyebrow="Add an agent" class="dashboard__connect" />
            </section>

            <section class="dashboard__feed-state" data-channel-view="feed-pending" hidden>
              <span class="dashboard__spinner" aria-hidden="true"></span>
              <div>
                <h2>Opening the live channel…</h2>
                <p>The workspace and agent roster are ready. Updates are loading next.</p>
              </div>
            </section>

            <section class="dashboard__feed-state" data-channel-view="feed-empty" hidden>
              <span class="dashboard__feed-zero" aria-hidden="true">0</span>
              <div>
                <h2 data-feed-empty-title>Waiting for your agent’s first update.</h2>
                <p>
                  As soon as an agent starts something, asks a question, or leaves a note, it
                  lands here. Nothing for you to do meanwhile.
                </p>
              </div>
            </section>

            <section
              class="dashboard__feed-state dashboard__feed-state--error"
              data-channel-view="feed-error"
              role="alert"
              hidden
            >
              <span class="dashboard__feed-zero" aria-hidden="true">!</span>
              <div>
                <h2>The channel needs another try.</h2>
                <p data-feed-error>CommonSwarm could not load the latest updates.</p>
                <button class="dashboard__button dashboard__button--secondary" type="button" data-retry-workspace>
                  Try again
                </button>
              </div>
            </section>

            <section class="dashboard__feed-view" data-channel-view="feed" hidden>
              <div class="dashboard__feed-toolbar">
                <div class="dashboard__feed-filters" role="group" aria-label="Filter signals">
                  <button type="button" data-feed-filter="all" aria-pressed="true">All</button>
                  <button type="button" data-feed-filter="broadcast" aria-pressed="false">Broadcast</button>
                  <button type="button" data-feed-filter="direct-to-you" aria-pressed="false">Direct to you</button>
                </div>
              </div>
              <ol class="dashboard__feed" data-feed-list></ol>
              <div class="dashboard__feed-more" data-feed-more hidden>
                <button
                  class="dashboard__button dashboard__button--secondary"
                  type="button"
                  data-load-older
                >
                  Load older updates
                </button>
                <p class="dashboard__feed-more-error" data-load-older-error role="alert" hidden></p>
              </div>
            </section>

            <form class="dashboard__composer" data-composer hidden>
              <div class="dashboard__composer-audience">
                <label for="dashboard-composer-audience">TO</label>
                <select id="dashboard-composer-audience" data-composer-audience></select>
                <span data-composer-audience-count>0 agents · 0 people in workspace</span>
              </div>
              <div class="dashboard__composer-box">
                <div
                  class="dashboard__mention-picker"
                  data-mention-picker
                  role="listbox"
                  aria-label="Mention a person or agent"
                  hidden
                ></div>
                <div class="dashboard__composer-input">
                  <div class="dashboard__composer-mentions" data-composer-mentions></div>
                  <textarea
                    rows="1"
                    maxlength="2000"
                    placeholder="What are you about to do?"
                    aria-label="Signal"
                    data-composer-input
                    required
                  ></textarea>
                  <button
                    class="dashboard__composer-send"
                    type="submit"
                    data-composer-send
                    aria-label="Post signal"
                    title="Post signal"
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path d="m5 12 7-7 7 7M12 5v14"></path>
                    </svg>
                  </button>
                </div>
              </div>
              <p class="dashboard__composer-status" data-composer-status role="status" aria-live="polite"></p>
            </form>
          </div>
        </section>

        <aside
          class="dashboard__entity-panel"
          data-entity-panel
          aria-labelledby="dashboard-entity-panel-title"
          hidden
        >
          <header class="dashboard__entity-panel-head">
            <p>Profile</p>
            <button
              class="dashboard__icon-button"
              type="button"
              data-entity-panel-close
              aria-label="Close profile panel"
              title="Close profile panel"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </button>
          </header>
          <div class="dashboard__entity-panel-body" data-entity-panel-body></div>
        </aside>
      </div>
    </section>
  </div>

  {/* The agent management dialog. A native <dialog>: Escape, modal focus containment,
      and focus restore to the stack button are the platform's, not ours. It lives outside
      every panel so a panel switch can never display:none it out from under an open
      session; openWorkspace and sign-out close it explicitly instead. Add an agent is the
      first visible primary action; the filter and the roster follow. At ≤52rem it is a
      bottom sheet (see the media query), not a second component. */}
  <dialog
    class="dashboard__roster-dialog"
    id="dashboard-roster-dialog"
    data-roster-dialog
    aria-labelledby="dashboard-roster-title"
  >
    <div class="dashboard__roster-dialog-head">
      <h2 id="dashboard-roster-title">
        Agents
        <span class="dashboard__roster-dialog-count" data-agent-count>0</span>
      </h2>
      <button
        class="dashboard__icon-button"
        type="button"
        data-roster-close
        aria-label="Close agents panel"
        title="Close agents panel"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div class="dashboard__roster-dialog-body">
      <button
        class="dashboard__button dashboard__button--primary dashboard__roster-dialog-add"
        type="button"
        data-add-agent-dialog
      >
        Add an agent
      </button>

      <input
        class="dashboard__roster-dialog-search"
        type="search"
        data-roster-search
        aria-label="Filter agents"
        placeholder="Filter agents…"
        autocomplete="off"
        spellcheck="false"
      />

      <ul
        class="dashboard__agent-list dashboard__roster-dialog-list"
        data-dialog-agent-list
      ></ul>
      <p class="dashboard__form-error" data-agent-error role="alert" hidden></p>

      {/* Pending access lives here only where the rail's own details are hidden:
          at ≤52rem this dialog is the ONLY reachable pending surface, so the
          section must exist — and at desktop the rail keeps it and the dialog
          stays quiet, so there is never a second, competing control. Both lists
          render from the same pendingAccessRows call, so they cannot disagree. */}
      <section
        class="dashboard__roster-dialog-pending"
        data-dialog-access-section
        aria-labelledby="dashboard-roster-pending-title"
        hidden
      >
        <h3
          class="dashboard__roster-dialog-pending-title"
          id="dashboard-roster-pending-title"
        >
          Pending access
          <span class="dashboard__roster-dialog-pending-count" data-dialog-access-count>0</span>
        </h3>
        <ul
          class="dashboard__agent-list dashboard__roster-dialog-pending-list"
          data-dialog-access-list
        ></ul>
        <p class="dashboard__form-error" data-dialog-access-error role="alert" hidden></p>
      </section>
    </div>
  </dialog>
</live-dashboard>

<script>
  import type { Session } from "@supabase/supabase-js";
  import {
    ClientTooOld,
    CommandOutcomeUnknown,
    EmailAddressRejected,
    EmailDomainNotAccepted,
    EmailNotVerified,
    EmailRateLimited,
    NoDeployment,
    FreshLoginRequired,
    SessionExpired,
    SignupRefused,
    WorkspaceOutcomeUnknown,
    WorkspaceLimitReached,
    agentAccessStatuses,
    client,
    createWorkspace,
    currentSession,
    deployment,
    inviteWorkspaceMember,
    inviteEmailValidationMessage,
    pendingMemberInvites,
    postBrowserSignal,
    revokeAgentToken,
    revokeWorkspaceInvitation,
    signInWithEmail,
    signInWithGitHub,
    signOut,
    removeWorkspaceMember,
    revokeAgentPrincipal,
    uuid,
    type Signal,
    type AgentAccessStatus,
    type PendingMemberInvite,
  } from "../../lib/commonswarm";
  import { memberInviteUrl } from "../../lib/member-invite";
  import { isInviteSubmitCurrent } from "../../lib/invite-submit";
  import { PendingRefreshGate } from "../../lib/pending-refresh";
  import { BootFocusGate } from "../../lib/boot-focus";
  import { agentEntityView, truncateEntityId } from "../../lib/entity-panel";
  import {
    filterSignals,
    signalCounts,
    signalIsDirectToViewer,
    type SignalFilter,
  } from "../../lib/signal-feed";
  import {
    pendingAccessRows,
    shouldPollPendingAccess,
    shouldRetireFreshInvite,
  } from "../../lib/pending-access";
  import { groupParticipantsByOwner } from "../../lib/participant-rail";

  interface Workspace {
    id: string;
    name: string;
  }

  interface Agent {
    principalId: string;
    name: string;
    model: string | null;
    ownerUserId: string;
  }

  interface Member {
    userId: string;
    name: string;
    role: "owner" | "admin" | "member";
  }

  interface SecretHoldingAgentConnect extends HTMLElement {
    clearPrompt(notify?: boolean): void;
    finishPrompt(reason: "done" | "back" | "consumed", notify?: boolean): void;
  }

  interface CreateIntent {
    workspaceId: string;
    commandId: string;
    name: string;
  }

  interface SignalCursor {
    createdAt: string;
    id: string;
  }

  type EntityRef =
    | { kind: "agent"; id: string }
    | { kind: "person"; id: string };

  type ComposerAudience = { kind: "everyone" } | EntityRef;

  const app = document.querySelector<HTMLElement>("live-dashboard");

  if (app) {
    /*
     * Top-level dashboard panels only. AgentConnect reuses data-panel=… for its own
     * loading/form/result surfaces inside <agent-connect>. A broad [data-panel] walk
     * would stamp hidden on those children whenever showPanel("channel") ran, and the
     * UA's [hidden] { display:none !important } permanently hides the name field and
     * mint button even after AgentConnect sets data-state=ready. Scope to the root's
     * direct panel sections so nested connect markup keeps its own visibility model.
     */
    const panel = (name: string): HTMLElement | null =>
      app.querySelector<HTMLElement>(`.dashboard__root > [data-panel="${name}"]`);
    const one = <T extends Element>(selector: string): T | null => app.querySelector<T>(selector);
    const all = <T extends Element>(selector: string): T[] =>
      Array.from(app.querySelectorAll<T>(selector));

    let session: Session | null = null;
    let workspaces: Workspace[] = [];
    let agents: Agent[] = [];
    let members: Member[] = [];
    let pendingInvites: PendingMemberInvite[] = [];
    let accessStatuses: AgentAccessStatus[] = [];
    let renderedPendingAccessKey = "";
    let people = new Map<string, string>();
    let signals: Signal[] = [];
    let signalFilter: SignalFilter = "all";
    let activeWorkspaceId = "";
    let requestVersion = 0;
    let sampleMode = false;
    let signalCursor: SignalCursor | null = null;
    let signalHasMore = false;
    let signalCutoff = "";
    let pendingWorkspaceId = "";
    let pendingWorkspaceCreate = false;
    let renderedAuthUserId = "";
    let authReloadQueued = false;
    let bootInFlight: Promise<void> | null = null;
    let bootAgain = false;
    let signalExpiryTimer: number | undefined;
    let liveFeedTimer: number | undefined;
    let liveFeedInFlight = false;
    let rosterRefreshInFlight = false;
    let rosterRefreshAttemptedAt = 0;
    /* Ownership of the pending-access refresh lives in the gate, not in flags:
       (workspaceId, version) pairs, so a slow request from the workspace the
       user just left can neither block nor clear the fresh one. */
    const PENDING_REFRESH_ACTIVE_COOLDOWN_MS = 12_000;
    const PENDING_REFRESH_DISCOVERY_COOLDOWN_MS = 30_000;
    const pendingRefreshGate = new PendingRefreshGate(
      PENDING_REFRESH_ACTIVE_COOLDOWN_MS,
      PENDING_REFRESH_DISCOVERY_COOLDOWN_MS,
    );
    let rosterFilter = "";
    /* Catch-up queues UNKNOWN principals here and settles CONFIRMED-absent ones there.
       Both are per workspace session; openWorkspace clears them. */
    const unknownAgentCandidates = new Set<string>();
    const settledUnknownAgents = new Set<string>();
    let armLiveFeed = (): void => {};
    let connectFocusObserver: MutationObserver | null = null;
    let previousSignalIds = new Set<string>();
    let feedWasEmpty = false;
    let channelLoadError = "";
    let activeCreate: { version: number; userId: string } | null = null;
    /** Principal whose live Copy-prompt secret is still on screen, if any. */
    let livePromptPrincipalId = "";
    let freshInviteLink = "";
    let freshInviteId = "";
    let freshInviteWorkspaceId = "";
    let inviteIntent: { email: string; commandId: string } | null = null;
    let entityPanelOrigin: HTMLElement | null = null;
    let selectedEntity: EntityRef | null = null;
    let composerAudience: ComposerAudience = { kind: "everyone" };
    let composerMentions: EntityRef[] = [];
    let mentionPickerIndex = 0;
    let composerIntent: { commandId: string; body: string; audienceKey: string } | null = null;
    const visualMentions = new Map<string, EntityRef[]>();

    const SIGNAL_PAGE_SIZE = 50;
    const SIGNAL_FETCH_SIZE = SIGNAL_PAGE_SIZE + 1;

    /* The first presentation of EACH independently gated surface takes no scripted
       focus: it is not necessarily a response to anything the reader did, so moving focus
       would paint a ring around something they never asked for, raise the
       on-screen keyboard on a phone before any orientation, and pull assistive
       technology past the surrounding context. Later presentations of that same
       surface move focus. One gate per surface: panels and the auth form present
       independently, so a signed-in boot does not pre-consume the auth form's skip. */
    const panelBootFocus = new BootFocusGate();
    const authBootFocus = new BootFocusGate();

    const showPanel = (
      name: "loading" | "signed-out" | "create" | "workspace-error" | "channel",
    ): void => {
      const previous = app.dataset.state;
      for (const section of all<HTMLElement>(".dashboard__root > [data-panel]")) {
        section.hidden = section.dataset.panel !== name;
      }
      app.dataset.state = name;
      const root = one<HTMLElement>(".dashboard__root");
      root?.setAttribute("aria-busy", name === "loading" ? "true" : "false");
      if (previous !== name && name !== "loading") {
        if (!panelBootFocus.allowsFocus()) return;
        window.requestAnimationFrame(() => {
          const visible = panel(name);
          const heading = visible?.querySelector<HTMLElement>("h1, h2");
          if (!heading) return;
          heading.tabIndex = -1;
          heading.focus({ preventScroll: true });
        });
      }
    };

    const setLoading = (label: string): void => {
      const target = one<HTMLElement>("[data-loading-label]");
      if (target) target.textContent = label;
      showPanel("loading");
    };

    const showChannelView = (
      name:
        | "no-agents"
        | "agent-choice"
        | "invite"
        | "connect"
        | "feed-pending"
        | "feed-empty"
        | "feed-error"
        | "feed",
    ): void => {
      if (name !== "feed") {
        window.clearTimeout(signalExpiryTimer);
        signalExpiryTimer = undefined;
      }
      if (name !== "feed" && name !== "feed-empty") {
        window.clearInterval(liveFeedTimer);
        liveFeedTimer = undefined;
      }
      for (const section of all<HTMLElement>("[data-channel-view]")) {
        section.hidden = section.dataset.channelView !== name;
      }
      const composer = one<HTMLFormElement>("[data-composer]");
      if (composer) composer.hidden = name !== "feed" && name !== "feed-empty";
      if (composer?.hidden) {
        const picker = one<HTMLElement>("[data-mention-picker]");
        if (picker) picker.hidden = true;
      }
      app.dataset.channelView = name;
      /* The Live chip is true exactly while armLiveFeed is allowed to run. */
      const liveChip = one<HTMLElement>("[data-live-chip]");
      if (liveChip) {
        liveChip.hidden = sampleMode || !(name === "feed" || name === "feed-empty");
      }
      if (name === "feed" || name === "feed-empty") {
        queueMicrotask(() => armLiveFeed());
      }
    };

    const addAgentViewOpen = (): boolean =>
      ["agent-choice", "invite", "connect"].includes(app.dataset.channelView ?? "");

    const accountName = (value: Session): string => {
      const meta = (value.user.user_metadata ?? {}) as Record<string, unknown>;
      return (
        (typeof meta.user_name === "string" && meta.user_name) ||
        (typeof meta.preferred_username === "string" && meta.preferred_username) ||
        value.user.email ||
        "your account"
      );
    };

    const defaultWorkspaceName = (value: Session): string => {
      const who = accountName(value).split("@")[0] || "My";
      return `${who}’s workspace`.slice(0, 80);
    };

    const readableError = (error: unknown): string => {
      if (error instanceof EmailRateLimited) {
        return "Email sign-in is busy right now. Use GitHub, or try email again in a little while.";
      }
      if (error instanceof EmailAddressRejected) {
        return "That address could not receive a sign-in link. Check it and try again.";
      }
      if (error instanceof WorkspaceLimitReached) {
        return `You already have ${error.limit} workspaces, the free-account limit.`;
      }
      if (error instanceof EmailNotVerified) return error.message;
      if (error instanceof EmailDomainNotAccepted) return error.message;
      if (error instanceof ClientTooOld) return error.message;
      if (error instanceof SignupRefused) return error.detail;
      if (error instanceof NoDeployment) {
        return "This saved page is not connected to CommonSwarm.";
      }
      if (
        error instanceof Error &&
        /network|fetch|offline|connection/i.test(error.message)
      ) {
        return "Check your internet connection, then try again.";
      }
      return error instanceof Error
        ? error.message
        : "CommonSwarm could not complete that request.";
    };

    const authError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-auth-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const showAuthView = (name: "choices" | "email-sent"): void => {
      for (const view of all<HTMLElement>("[data-auth-view]")) {
        view.hidden = view.dataset.authView !== name;
      }
      authError(null);
      /* The gate consumes only on choices presentations. Its first presentation
         skips the email move; on a signed-in boot that can be the first explicit
         sign-out, where showPanel already moves context to the signed-out heading.
         Later choices presentations (such as "use a different address") focus it. */
      if (name === "choices" && authBootFocus.allowsFocus()) {
        window.requestAnimationFrame(() => one<HTMLInputElement>("#dashboard-email")?.focus());
      }
    };

    const createStorageKey = (userId: string): string =>
      `commonswarm:app-create-intent:v1:${userId}`;

    const readCreateIntent = (userId: string): CreateIntent | null => {
      try {
        const raw = window.localStorage.getItem(createStorageKey(userId));
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<CreateIntent>;
        if (
          typeof parsed.workspaceId !== "string" ||
          typeof parsed.commandId !== "string" ||
          typeof parsed.name !== "string"
        ) {
          return null;
        }
        return {
          workspaceId: parsed.workspaceId,
          commandId: parsed.commandId,
          name: parsed.name,
        };
      } catch {
        return null;
      }
    };

    const writeCreateIntent = (userId: string, intent: CreateIntent): void => {
      try {
        window.localStorage.setItem(createStorageKey(userId), JSON.stringify(intent));
      } catch {
        /* The in-memory call still uses this intent. A reload cannot safely resume it. */
      }
    };

    const clearCreateIntent = (userId: string): void => {
      try {
        window.localStorage.removeItem(createStorageKey(userId));
      } catch {
        /* Nothing else reads a failed removal during this page load. */
      }
    };

    const setCreateError = (message: string | null): void => {
      const target = one<HTMLElement>("[data-create-error]");
      if (!target) return;
      target.textContent = message ?? "";
      target.hidden = message === null;
    };

    const renderCreate = (value: Session, message: string | null = null): void => {
      const who = accountName(value);
      for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
        target.textContent = who;
      }
      const hasWorkspace = Boolean(
        activeWorkspaceId && workspaces.some((workspace) => workspace.id === activeWorkspaceId),
      );
      const eyebrow = one<HTMLElement>("[data-create-eyebrow]");
      const title = one<HTMLElement>("[data-create-title]");
      const description = one<HTMLElement>("[data-create-description]");
      const cancel = one<HTMLButtonElement>("[data-create-cancel]");
      const button = one<HTMLButtonElement>("[data-create-button]");
      if (eyebrow) eyebrow.textContent = hasWorkspace ? "New workspace" : "Your first workspace";
      if (title) title.textContent = hasWorkspace ? "Name the new workspace." : "Name your workspace.";
      if (description) {
        description.textContent = hasWorkspace
          ? "Create another shared feed for the people and AI agents working together."
          : "A workspace is one shared feed. Your people and AI agents post what they’re about to do, so work does not collide.";
      }
      if (cancel) cancel.hidden = !hasWorkspace;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      if (input) {
        input.disabled = false;
        if (hasWorkspace && message === null) input.value = "";
        else if (!input.value) input.value = defaultWorkspaceName(value);
      }
      if (button) {
        button.disabled = false;
        button.removeAttribute("aria-busy");
        button.textContent = "Create workspace";
      }
      setCreateError(message);
      showPanel("create");
      window.requestAnimationFrame(() => {
        input?.focus({ preventScroll: true });
        input?.select();
      });
    };

    const renderWorkspaceError = (value: Session, error: unknown): void => {
      for (const target of all<HTMLElement>("[data-account-name]")) {
        target.textContent = accountName(value);
      }
      const message = one<HTMLElement>("[data-workspace-error]");
      if (message) {
        message.textContent = `${readableError(error)} Nothing was created or changed.`;
      }
      showPanel("workspace-error");
    };

    const workspaceMemberships = async (): Promise<Workspace[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Workspace[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("workspaces")
          .select("workspace_id,name,archived_at")
          .is("archived_at", null)
          .order("name", { ascending: true })
          .order("workspace_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page.map((row) => ({
          id: String(row.workspace_id ?? ""),
          name: String(row.name ?? row.workspace_id ?? ""),
        })).filter((workspace) => workspace.id.length > 0));
        if (page.length < pageSize) return result;
      }
    };

    const roster = async (workspaceId: string): Promise<Agent[]> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const pageSize = 200;
      const result: Agent[] = [];
      for (let offset = 0; ; offset += pageSize) {
        const { data, error } = await api
          .schema("swarm_read")
          .from("agent_principals")
          .select("principal_id,name,model,owner_user_id,revoked_at,workspace_id")
          .eq("workspace_id", workspaceId)
          .is("revoked_at", null)
          .order("name", { ascending: true })
          .order("principal_id", { ascending: true })
          .range(offset, offset + pageSize - 1);
        if (error) throw new Error(error.message);
        const page = data ?? [];
        result.push(...page.map((row) => ({
          principalId: String(row.principal_id ?? ""),
          name: String(row.name ?? "Unnamed agent"),
          model: row.model === null ? null : String(row.model),
          ownerUserId: String(row.owner_user_id ?? ""),
        })).filter((agent) =>
          agent.principalId.length > 0 && agent.ownerUserId.length > 0
        ));
        if (page.length < pageSize) return result;
      }
    };

    const memberRoster = async (
      workspaceId: string,
    ): Promise<{ names: Map<string, string>; members: Member[] }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      const { data, error } = await api
        .schema("swarm_read")
        .from("member_profiles")
        .select("user_id,display_name,role")
        .eq("workspace_id", workspaceId)
        .limit(1_000);
      if (error) throw new Error(error.message);
      const members = (data ?? []).map((row) => ({
        userId: String(row.user_id ?? ""),
        name: String(row.display_name ?? ""),
        role: String(row.role ?? "") as Member["role"],
      })).filter((member) =>
        member.userId.length > 0 &&
        member.name.length > 0 &&
        ["owner", "admin", "member"].includes(member.role)
      );
      return {
        members,
        names: new Map(members.map((member) => [member.userId, member.name])),
      };
    };

    const renderMembers = (): void => {
      const list = one<HTMLUListElement>("[data-member-list]");
      const count = one<HTMLElement>("[data-member-count]");
      const details = one<HTMLDetailsElement>("[data-member-details]");
      if (count) count.textContent = String(members.length);
      const me = members.find((member) => member.userId === session?.user.id);
      if (details) {
        details.hidden =
          sampleMode || (me?.role !== "owner" && me?.role !== "admin");
        if (details.hidden) details.open = false;
      }
      if (!list) return;
      list.replaceChildren();
      for (const member of members) {
        const item = document.createElement("li");
        item.className = "dashboard__agent";
        const label = document.createElement("span");
        label.textContent = `${member.name} · ${member.role}`;
        item.append(label);
        const mayRemove = me?.role === "owner" ||
          (me?.role === "admin" && member.role !== "owner");
        if (mayRemove && member.userId !== session?.user.id) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Remove";
          button.dataset.removeMember = member.userId;
          button.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (
              !window.confirm(
                `Remove ${member.name} from this workspace? This does not affect their other workspaces.`,
              )
            ) return;
            const errorTarget = one<HTMLElement>("[data-member-error]");
            const reauth = one<HTMLElement>("[data-member-reauth]");
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            if (reauth) reauth.hidden = true;
            button.disabled = true;
            try {
              await removeWorkspaceMember(
                session,
                uuid(),
                activeWorkspaceId,
                member.userId,
              );
              await openWorkspace(activeWorkspaceId);
            } catch (error) {
              if (error instanceof FreshLoginRequired) {
                sessionStorage.setItem(
                  "commonswarm.pending-member-selection",
                  JSON.stringify({
                    workspaceId: activeWorkspaceId,
                    userId: member.userId,
                  }),
                );
                if (reauth) reauth.hidden = false;
              }
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          item.append(button);
        }
        list.append(item);
      }
    };

    /*
     * ONE row model, TWO lists. The rail's Pending access details (desktop) and the
     * Agents dialog section (the only reachable surface at ≤52rem) both render from
     * a single pendingAccessRows call, so they can never disagree about content,
     * order, or wording — the lists are mirrors of one state, never two states.
     * Each list's Cancel closures capture that list's own error slot, and each row
     * carries the exact id its cancel command needs, so a Cancel always reaches the
     * right revoke with the right invitation/token id.
     */
    const currentPendingAccessRows = () =>
      pendingAccessRows(
        pendingInvites,
        accessStatuses,
        (userId) => people.get(userId) ?? "Workspace member",
        Date.now(),
        (iso) => formatTime(iso).relative,
      );

    const pendingAccessKey = (rows = currentPendingAccessRows()): string =>
      rows.map((row) => `${row.kind}:${row.id}`).join("\n");

    const renderPendingAccess = (): void => {
      const rows = currentPendingAccessRows();
      renderedPendingAccessKey = pendingAccessKey(rows);
      const total = rows.length;
      const railList = one<HTMLUListElement>("[data-access-list]");
      const dialogList = one<HTMLUListElement>("[data-dialog-access-list]");
      const active = document.activeElement;
      const focusedPending =
        active instanceof HTMLButtonElement &&
          (railList?.contains(active) || dialogList?.contains(active)) &&
          active.dataset.pendingKind && active.dataset.pendingId
          ? {
              surface: dialogList?.contains(active) ? "dialog" as const : "rail" as const,
              kind: active.dataset.pendingKind,
              id: active.dataset.pendingId,
            }
          : null;

      const count = one<HTMLElement>("[data-access-count]");
      const details = one<HTMLDetailsElement>("[data-access-details]");
      if (count) count.textContent = String(total);
      if (details) {
        details.hidden = sampleMode || total === 0;
        if (details.hidden) details.open = false;
      }

      const dialogSection = one<HTMLElement>("[data-dialog-access-section]");
      const dialogCount = one<HTMLElement>("[data-dialog-access-count]");
      if (dialogCount) dialogCount.textContent = String(total);
      if (dialogSection) dialogSection.hidden = sampleMode || total === 0;

      const buildRows = (errorTarget: HTMLElement | null): DocumentFragment => {
        const fragment = document.createDocumentFragment();
        for (const row of rows) {
          const item = document.createElement("li");
          item.className = "dashboard__agent dashboard__pending-access-row";
          const copy = document.createElement("span");
          copy.className = "dashboard__agent-copy";
          const title = document.createElement("strong");
          title.textContent = row.title;
          const state = document.createElement("span");
          state.textContent = row.state;
          copy.append(title, state);
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Cancel";
          button.dataset.pendingKind = row.kind;
          button.dataset.pendingId = row.id;
          button.setAttribute("aria-label", row.cancelLabel);
          button.addEventListener("click", async () => {
            if (!session) return;
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            button.disabled = true;
            try {
              if (row.kind === "invite") {
                await revokeWorkspaceInvitation(session, uuid(), row.workspaceId, row.id);
              } else {
                await revokeAgentToken(session, uuid(), row.workspaceId, row.id);
              }
              /* The reload closes the dialog and re-renders both lists from the
                 fresh state. The row that held focus is gone, so hand focus to
                 the door that reopens the roster — or to the empty channel's
                 Add door when no agents remain — instead of dropping it on
                 <body>. Same pattern as the roster Remove path. */
              await openWorkspace(row.workspaceId);
              const door = agents.length > 0
                ? one<HTMLButtonElement>("[data-roster-open]")
                : one<HTMLButtonElement>("[data-add-agent]");
              door?.focus({ preventScroll: true });
            } catch (error) {
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          item.append(copy, button);
          fragment.append(item);
        }
        return fragment;
      };

      railList?.replaceChildren(buildRows(one("[data-access-error]")));
      dialogList?.replaceChildren(buildRows(one("[data-dialog-access-error]")));

      /* Pending access is itself a reason to expose the header management door,
         including in a brand-new zero-agent workspace on mobile. Resync before
         focus repair so a newly-valid fallback door is already visible. */
      renderHeaderRoster(total);

      /* A background refresh replaces DOM nodes even when the rows are unchanged.
         Preserve the focused Cancel by semantic identity. If that row genuinely
         disappeared, move focus to a stable control instead of dropping it behind
         a modal or onto <body>. */
      if (focusedPending) {
        const focusList = focusedPending.surface === "dialog" ? dialogList : railList;
        const replacement = Array.from(
          focusList?.querySelectorAll<HTMLButtonElement>(
            "[data-pending-kind][data-pending-id]",
          ) ?? [],
        ).find((candidate) =>
          candidate.dataset.pendingKind === focusedPending.kind &&
          candidate.dataset.pendingId === focusedPending.id
        );
        if (replacement) {
          replacement.focus({ preventScroll: true });
        } else if (focusedPending.surface === "dialog") {
          one<HTMLButtonElement>("[data-add-agent-dialog]")?.focus({ preventScroll: true });
        } else if (total > 0) {
          one<HTMLDetailsElement>("[data-access-details]")
            ?.querySelector<HTMLElement>("summary")
            ?.focus({ preventScroll: true });
        } else {
          /* The title is present in every channel subview. Unlike Add an agent it
             stays visible while invite/connect is open, so it is the only safe
             zero-row rail fallback across the complete flow. */
          one<HTMLElement>("[data-channel-name]")?.focus({ preventScroll: true });
        }
      }
      syncPendingPoll();
    };

    const signalPage = async (
      workspaceId: string,
      cursor: SignalCursor | null,
      cutoff: string,
    ): Promise<{ rows: Signal[]; hasMore: boolean }> => {
      const api = client();
      if (!api) throw new NoDeployment();
      let query = api
        .schema("swarm_read")
        .from("signals")
        .select("id,from,from_kind,to,to_agent,kind,body,about,until,created_at")
        .eq("workspace_id", workspaceId)
        .or(`until.is.null,until.gt.${cutoff}`);
      if (cursor) {
        query = query.or(
          `created_at.lt.${cursor.createdAt},and(created_at.eq.${cursor.createdAt},id.lt.${cursor.id})`,
        );
      }
      const { data, error } = await query
        .order("created_at", { ascending: false })
        .order("id", { ascending: false })
        .limit(SIGNAL_FETCH_SIZE);
      if (error) throw new Error(error.message);
      const page = data ?? [];
      return {
        hasMore: page.length === SIGNAL_FETCH_SIZE,
        rows: page.slice(0, SIGNAL_PAGE_SIZE).map((row) => ({
          id: String(row.id),
          from: String(row.from ?? ""),
          fromKind: String(row.from_kind ?? ""),
          to: row.to === null || row.to === undefined ? null : String(row.to),
          toAgent: row.to_agent === null || row.to_agent === undefined
            ? null
            : String(row.to_agent),
          kind: String(row.kind ?? ""),
          body: String(row.body ?? ""),
          about: row.about === null || row.about === undefined ? null : String(row.about),
          until: row.until === null || row.until === undefined ? null : String(row.until),
          createdAt: String(row.created_at ?? ""),
        })),
      };
    };

    const initials = (name: string): string => {
      const parts = name.trim().split(/\s+/).filter(Boolean);
      return (parts.length > 1 ? `${parts[0]?.[0] ?? ""}${parts[1]?.[0] ?? ""}` : name.slice(0, 2))
        .toUpperCase();
    };

    /* One shape, one tint. The avatar set once mixed three border-radii (a circle, a
       rounded square, and an asymmetric blob) across identical 32px initial tiles, which
       read as inconsistency rather than identity — most visibly where the tiles now sit
       shoulder to shoulder in the header strip. The hue keeps the per-agent distinction;
       the shape is always the circle. */
    const markAgentAvatar = (node: HTMLElement, principalId: string): void => {
      let hash = 2_166_136_261;
      for (const char of principalId) {
        hash ^= char.charCodeAt(0);
        hash = Math.imul(hash, 16_777_619);
      }
      const unsigned = hash >>> 0;
      node.style.setProperty("--avatar-hue", String(unsigned % 360));
      node.classList.add("dashboard__avatar--tinted");
    };

    const entityDate = (value: string): string => {
      const date = new Date(value);
      return Number.isNaN(date.getTime())
        ? value
        : new Intl.DateTimeFormat(undefined, {
            dateStyle: "medium",
            timeStyle: "short",
          }).format(date);
    };

    function closeEntityPanel(restoreFocus = true): void {
      const panel = one<HTMLElement>("[data-entity-panel]");
      if (!panel || panel.hidden) return;
      panel.hidden = true;
      one<HTMLElement>(".dashboard__frame")?.classList.remove(
        "dashboard__frame--entity-panel",
      );
      selectedEntity = null;
      if (restoreFocus && entityPanelOrigin?.isConnected) {
        entityPanelOrigin.focus({ preventScroll: true });
      }
      entityPanelOrigin = null;
    }

    function entityControl(
      label: string,
      entity: EntityRef,
      className: string,
    ): HTMLButtonElement {
      const button = document.createElement("button");
      button.type = "button";
      button.className = className;
      button.textContent = label;
      button.dataset.entityKind = entity.kind;
      button.dataset.entityId = entity.id;
      button.addEventListener("click", () => openEntityPanel(entity, button));
      return button;
    }

    const appendEntityField = (
      list: HTMLDListElement,
      term: string,
      value: string,
    ): void => {
      const label = document.createElement("dt");
      label.textContent = term;
      const detail = document.createElement("dd");
      detail.textContent = value;
      list.append(label, detail);
    };

    const appendEntityId = (
      list: HTMLDListElement,
      term: string,
      value: string,
    ): void => {
      const label = document.createElement("dt");
      label.textContent = term;
      const detail = document.createElement("dd");
      if (value === "Not available") {
        detail.textContent = value;
      } else {
        const disclosure = document.createElement("details");
        disclosure.className = "dashboard__entity-id";
        const summary = document.createElement("summary");
        summary.textContent = truncateEntityId(value);
        summary.title = value;
        const full = document.createElement("code");
        full.textContent = value;
        disclosure.append(summary, full);
        detail.append(disclosure);
      }
      list.append(label, detail);
    };

    function renderEntityPanel(): void {
      const body = one<HTMLElement>("[data-entity-panel-body]");
      if (!body || !selectedEntity) return;
      body.replaceChildren();

      const identity = document.createElement("div");
      identity.className = "dashboard__entity-identity";
      const avatar = document.createElement("span");
      avatar.className = "dashboard__entity-avatar";
      avatar.setAttribute("aria-hidden", "true");
      const headingWrap = document.createElement("div");
      const heading = document.createElement("h2");
      heading.id = "dashboard-entity-panel-title";
      const identityBadge = document.createElement("span");
      identityBadge.className = "dashboard__entity-badge";

      if (selectedEntity.kind === "agent") {
        const agent = agents.find((candidate) => candidate.principalId === selectedEntity?.id);
        if (!agent) {
          closeEntityPanel(false);
          return;
        }
        const status = accessStatuses.find(
          (candidate) => candidate.principalId === agent.principalId,
        );
        const details = agentEntityView(
          agent,
          status,
          people.get(agent.ownerUserId) ?? "Workspace member",
          entityDate,
        );
        avatar.textContent = initials(details.name);
        markAgentAvatar(avatar, details.principalId);
        heading.textContent = details.name;
        identityBadge.textContent = "AGENT";
        headingWrap.append(heading, identityBadge);
        identity.append(avatar, headingWrap);
        body.append(identity);

        if (details.revoked) {
          const revoked = document.createElement("p");
          revoked.className = "dashboard__entity-revoked";
          revoked.textContent = `Access revoked · ${details.revokedAt}`;
          body.append(revoked);
        }

        const info = document.createElement("section");
        info.className = "dashboard__entity-section";
        const infoTitle = document.createElement("h3");
        infoTitle.textContent = "Info";
        const ownerLine = document.createElement("p");
        ownerLine.append(
          "operated by ",
          entityControl(
            details.ownerName,
            { kind: "person", id: details.ownerUserId },
            "dashboard__entity-link",
          ),
        );
        const infoList = document.createElement("dl");
        appendEntityField(infoList, "Model", details.model);
        appendEntityId(infoList, "Principal ID", details.principalId);
        info.append(infoTitle, ownerLine, infoList);

        const runtime = document.createElement("section");
        runtime.className = "dashboard__entity-section";
        const runtimeTitle = document.createElement("h3");
        runtimeTitle.textContent = "Runtime";
        const runtimeList = document.createElement("dl");
        appendEntityId(runtimeList, "Token ID", details.tokenId);
        appendEntityField(runtimeList, "Issued", details.issuedAt);
        appendEntityField(runtimeList, "Expires", details.expiresAt);
        appendEntityField(runtimeList, "First used", details.firstUsedAt);
        appendEntityField(runtimeList, "Revoked", details.revokedAt);
        runtime.append(runtimeTitle, runtimeList);
        body.append(info, runtime);
      } else {
        const member = members.find((candidate) => candidate.userId === selectedEntity?.id);
        if (!member) {
          closeEntityPanel(false);
          return;
        }
        avatar.textContent = initials(member.name);
        heading.textContent = member.name;
        identityBadge.textContent = "PERSON";
        headingWrap.append(heading, identityBadge);
        identity.append(avatar, headingWrap);

        const related = document.createElement("section");
        related.className = "dashboard__entity-section";
        const relatedTitle = document.createElement("h3");
        relatedTitle.textContent = "Agents";
        const relatedList = document.createElement("ul");
        relatedList.className = "dashboard__entity-agent-list";
        const operatedAgents = agents.filter((agent) => agent.ownerUserId === member.userId);
        if (operatedAgents.length === 0) {
          const empty = document.createElement("li");
          empty.textContent = "No agents";
          relatedList.append(empty);
        } else {
          for (const agent of operatedAgents) {
            const item = document.createElement("li");
            item.append(entityControl(
              agent.name,
              { kind: "agent", id: agent.principalId },
              "dashboard__entity-agent-link",
            ));
            relatedList.append(item);
          }
        }
        related.append(relatedTitle, relatedList);
        body.append(identity, related);
      }
    }

    function openEntityPanel(entity: EntityRef, trigger: HTMLElement): void {
      const panel = one<HTMLElement>("[data-entity-panel]");
      if (!panel) return;
      if (!panel.contains(trigger)) entityPanelOrigin = trigger;
      selectedEntity = entity;
      panel.hidden = false;
      one<HTMLElement>(".dashboard__frame")?.classList.add(
        "dashboard__frame--entity-panel",
      );
      renderEntityPanel();
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-entity-panel-close]")
          ?.focus({ preventScroll: true });
      });
    }

    const entityName = (entity: EntityRef): string => entity.kind === "agent"
      ? agents.find((agent) => agent.principalId === entity.id)?.name ?? "Unknown agent"
      : members.find((member) => member.userId === entity.id)?.name ?? "Workspace member";

    const composerAudienceKey = (audience: ComposerAudience): string =>
      audience.kind === "everyone" ? "everyone" : `${audience.kind}:${audience.id}`;

    const closeMentionPicker = (): void => {
      const picker = one<HTMLElement>("[data-mention-picker]");
      if (picker) picker.hidden = true;
      mentionPickerIndex = 0;
    };

    const renderComposerAudience = (): void => {
      const select = one<HTMLSelectElement>("[data-composer-audience]");
      const count = one<HTMLElement>("[data-composer-audience-count]");
      if (!select || !count) return;
      const selectedKey = composerAudienceKey(composerAudience);
      select.replaceChildren();
      const everyone = document.createElement("option");
      everyone.value = "everyone";
      everyone.textContent = "Everyone in # all-signals";
      select.append(everyone);
      for (const member of members) {
        const option = document.createElement("option");
        option.value = `person:${member.userId}`;
        option.textContent = member.name;
        select.append(option);
      }
      for (const agent of agents) {
        const option = document.createElement("option");
        option.value = `agent:${agent.principalId}`;
        option.textContent = `${agent.name} · agent`;
        select.append(option);
      }
      const selectedExists = Array.from(select.options).some(
        (option) => option.value === selectedKey,
      );
      if (!selectedExists) composerAudience = { kind: "everyone" };
      select.value = composerAudienceKey(composerAudience);
      count.textContent = composerAudience.kind === "everyone"
        ? `${agents.length} ${agents.length === 1 ? "agent" : "agents"} · ${members.length} ${
            members.length === 1 ? "person" : "people"
          } in workspace`
        : composerAudience.kind === "agent"
        ? "1 agent addressed"
        : "1 person addressed";
    };

    const renderComposerMentions = (): void => {
      const wrap = one<HTMLElement>("[data-composer-mentions]");
      if (!wrap) return;
      wrap.replaceChildren();
      composerMentions.forEach((mention, index) => {
        const chip = document.createElement("span");
        chip.className = "dashboard__mention-chip";
        chip.append(entityControl(
          `@${entityName(mention)}`,
          mention,
          "dashboard__mention-entity",
        ));
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "dashboard__mention-remove";
        remove.textContent = "×";
        remove.setAttribute("aria-label", `Remove mention of ${entityName(mention)}`);
        remove.addEventListener("click", () => {
          composerMentions.splice(index, 1);
          renderComposerMentions();
          one<HTMLTextAreaElement>("[data-composer-input]")?.focus({ preventScroll: true });
        });
        chip.append(remove);
        wrap.append(chip);
      });
    };

    const mentionSearch = (): { query: string; start: number } | null => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      if (!input) return null;
      const beforeCursor = input.value.slice(0, input.selectionStart ?? input.value.length);
      const match = beforeCursor.match(/(?:^|\s)@([^@\s]*)$/);
      if (!match || match.index === undefined) return null;
      return {
        query: match[1]?.toLocaleLowerCase() ?? "",
        start: match.index + (match[0].startsWith(" ") ? 1 : 0),
      };
    };

    const mentionCandidates = (query: string): EntityRef[] => {
      const selected = new Set(composerMentions.map((mention) => `${mention.kind}:${mention.id}`));
      const candidates: EntityRef[] = [
        ...members.map((member) => ({ kind: "person" as const, id: member.userId })),
        ...agents.map((agent) => ({ kind: "agent" as const, id: agent.principalId })),
      ];
      return candidates.filter((candidate) =>
        !selected.has(`${candidate.kind}:${candidate.id}`) &&
        entityName(candidate).toLocaleLowerCase().includes(query)
      );
    };

    const selectMention = (mention: EntityRef): void => {
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      const search = mentionSearch();
      if (!input || !search) return;
      const cursor = input.selectionStart ?? input.value.length;
      input.value = `${input.value.slice(0, search.start)}${input.value.slice(cursor)}`;
      input.setSelectionRange(search.start, search.start);
      composerMentions.push(mention);
      renderComposerMentions();
      closeMentionPicker();
      input.focus({ preventScroll: true });
      input.dispatchEvent(new Event("input"));
    };

    const renderMentionPicker = (): void => {
      const picker = one<HTMLElement>("[data-mention-picker]");
      const search = mentionSearch();
      if (!picker || !search) {
        closeMentionPicker();
        return;
      }
      const candidates = mentionCandidates(search.query);
      picker.replaceChildren();
      if (candidates.length === 0) {
        closeMentionPicker();
        return;
      }
      mentionPickerIndex = Math.min(mentionPickerIndex, candidates.length - 1);
      candidates.forEach((candidate, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.setAttribute("role", "option");
        button.setAttribute("aria-selected", String(index === mentionPickerIndex));
        const avatar = document.createElement("span");
        avatar.className = "dashboard__mention-picker-avatar";
        avatar.textContent = initials(entityName(candidate));
        avatar.setAttribute("aria-hidden", "true");
        if (candidate.kind === "agent") markAgentAvatar(avatar, candidate.id);
        const copy = document.createElement("span");
        copy.className = "dashboard__mention-picker-copy";
        const name = document.createElement("strong");
        name.textContent = entityName(candidate);
        copy.append(name);
        if (candidate.kind === "agent") {
          const agent = agents.find((entry) => entry.principalId === candidate.id);
          const detail = document.createElement("span");
          detail.textContent = `agent · managed by ${
            agent ? people.get(agent.ownerUserId) ?? "Workspace member" : "Workspace member"
          }`;
          copy.append(detail);
        }
        button.append(avatar, copy);
        button.addEventListener("pointerdown", (event) => event.preventDefault());
        button.addEventListener("click", () => selectMention(candidate));
        picker.append(button);
      });
      picker.hidden = false;
    };

    const resetComposer = (): void => {
      composerAudience = { kind: "everyone" };
      composerMentions = [];
      composerIntent = null;
      visualMentions.clear();
      const input = one<HTMLTextAreaElement>("[data-composer-input]");
      if (input) {
        input.value = "";
        input.style.blockSize = "auto";
      }
      const status = one<HTMLElement>("[data-composer-status]");
      if (status) status.textContent = "";
      renderComposerAudience();
      renderComposerMentions();
      closeMentionPicker();
    };

    /* The rail mirrors participants as presence/navigation only. People and agents share
       one aligned list; the agent row names its operator instead of asking indentation to
       carry ownership. Agents whose owner is outside the current member roster stay visible
       with an honest fallback label. The scrolling list owns participant-count growth. */
    const renderSidebarParticipants = (): void => {
      const participantList = one<HTMLUListElement>("[data-sidebar-participant-list]");
      if (!participantList) return;
      participantList.replaceChildren();

      const buildAgentRow = (agent: Agent, ownerName: string): HTMLLIElement => {
        const row = document.createElement("li");
        row.className = "dashboard__sidebar-agent";
        const avatarWrap = document.createElement("span");
        avatarWrap.className = "dashboard__sidebar-avatar-wrap";
        const avatar = document.createElement("span");
        avatar.className = "dashboard__sidebar-agent-avatar";
        avatar.textContent = initials(agent.name);
        avatar.setAttribute("aria-hidden", "true");
        markAgentAvatar(avatar, agent.principalId);
        const presence = document.createElement("span");
        presence.className = "dashboard__presence-dot";
        presence.setAttribute("aria-hidden", "true");
        avatarWrap.append(avatar, presence);
        const copy = document.createElement("span");
        copy.className = "dashboard__sidebar-participant-copy";
        const name = document.createElement("strong");
        name.textContent = agent.name;
        name.title = agent.name;
        const meta = document.createElement("span");
        meta.textContent = `operated by ${ownerName}`;
        copy.append(name, meta);
        row.append(avatarWrap, copy);
        return row;
      };

      for (const group of groupParticipantsByOwner(members, agents)) {
        if (group.kind === "member") {
          const personRow = document.createElement("li");
          personRow.className = "dashboard__sidebar-person";
          const avatar = document.createElement("span");
          avatar.className = "dashboard__sidebar-person-avatar";
          avatar.textContent = initials(group.member.name);
          avatar.setAttribute("aria-hidden", "true");
          const copy = document.createElement("span");
          copy.className = "dashboard__sidebar-participant-copy";
          const name = document.createElement("strong");
          name.textContent = group.member.name;
          name.title = group.member.name;
          const meta = document.createElement("span");
          meta.textContent = group.member.role;
          copy.append(name, meta);
          personRow.append(avatar, copy);
          participantList.append(personRow);
        }
        const ownerName = group.kind === "member" ? group.member.name : group.label;
        for (const agent of group.agents) {
          participantList.append(buildAgentRow(agent, ownerName));
        }
      }
    };

    const workspaceMenuItems = (): HTMLButtonElement[] =>
      all<HTMLButtonElement>("[data-workspace-menu] [role='menuitemradio'], [data-workspace-menu] [role='menuitem']")
        .filter((item) => !item.hidden);

    const closeWorkspaceMenu = (restoreFocus = false): void => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      const trigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      if (!menu || menu.hidden) return;
      menu.hidden = true;
      trigger?.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger?.focus({ preventScroll: true });
    };

    const openWorkspaceMenu = (edge: "current" | "first" | "last" = "current"): void => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      const trigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      if (!menu || !trigger || !menu.hidden) return;
      menu.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      const items = workspaceMenuItems();
      const current = items.find((item) => item.getAttribute("aria-checked") === "true");
      const target = edge === "last"
        ? items.at(-1)
        : edge === "first"
        ? items[0]
        : current ?? items[0];
      window.requestAnimationFrame(() => target?.focus({ preventScroll: true }));
    };

    const toggleWorkspaceMenu = (): void => {
      const menu = one<HTMLElement>("[data-workspace-menu]");
      if (!menu) return;
      if (menu.hidden) openWorkspaceMenu();
      else closeWorkspaceMenu(true);
    };

    const openNewWorkspace = (): void => {
      if (!session || sampleMode) return;
      closeWorkspaceMenu();
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (connect?.dataset.state === "done") {
        pendingWorkspaceCreate = true;
        connect.finishPrompt("back");
        return;
      }
      if (keepConnectCredentialVisible()) return;
      renderCreate(session);
    };

    const renderWorkspaceList = (selected: Workspace): void => {
      const list = one<HTMLElement>("[data-workspace-list]");
      const trigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      const create = one<HTMLButtonElement>("[data-new-workspace]");
      if (trigger) {
        trigger.setAttribute(
          "aria-label",
          `Current workspace: ${selected.name}. Choose workspace`,
        );
        trigger.title = selected.name;
      }
      if (create) create.hidden = sampleMode;
      if (!list) return;
      list.replaceChildren();
      for (const workspace of workspaces) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard__workspace-button";
        button.dataset.workspaceId = workspace.id;
        button.setAttribute("role", "menuitemradio");
        button.setAttribute("aria-checked", String(workspace.id === selected.id));
        const label = document.createElement("span");
        label.textContent = workspace.name;
        const check = document.createElement("span");
        check.className = "dashboard__workspace-check";
        check.textContent = "✓";
        check.setAttribute("aria-hidden", "true");
        button.append(label, check);
        button.addEventListener("click", () => {
          closeWorkspaceMenu(true);
          if (sampleMode) {
            activeWorkspaceId = workspace.id;
            renderChannel(workspace);
            return;
          }
          void openWorkspace(workspace.id);
        });
        list.append(button);
      }
    };

    /*
     * One roster in memory, three surfaces: rail presence, the header stack summary, and the
     * management dialog. All render here from `agents`, so the surfaces cannot disagree.
     */
    const renderRoster = (): void => {
      renderSidebarParticipants();
      renderHeaderRoster();
      renderDialogRoster();
      renderComposerAudience();
    };

    /*
     * The header stack is a summary, not a second management surface: up to three uniform
     * circular initials and the live count. The count spans (stack button + dialog title)
     * share one data-hook and one loop, so they cannot drift apart.
     */
    const HEADER_STACK_LIMIT = 3;

    const renderHeaderRoster = (pendingTotal = currentPendingAccessRows().length): void => {
      const wrap = one<HTMLElement>("[data-header-roster]");
      const stack = one<HTMLElement>("[data-header-agent-stack]");
      const button = one<HTMLButtonElement>("[data-roster-open]");
      const summary = one<HTMLElement>("[data-header-roster-summary]");
      const show = agents.length > 0 || pendingTotal > 0;
      if (wrap) wrap.hidden = !show;
      one<HTMLElement>(".dashboard__channel")?.classList.toggle(
        "dashboard__channel--roster",
        show,
      );
      for (const count of all<HTMLElement>("[data-agent-count]")) {
        count.textContent = String(agents.length);
      }
      if (summary) summary.textContent = pendingTotal > 0
        ? `${agents.length} · ${pendingTotal} pending`
        : String(agents.length);
      if (button) {
        button.classList.toggle("dashboard__roster-button--pending", pendingTotal > 0);
        const agentLabel = `${agents.length} ${agents.length === 1 ? "agent" : "agents"}`;
        const pendingLabel = pendingTotal > 0
          ? ` and ${pendingTotal} pending access ${pendingTotal === 1 ? "item" : "items"}`
          : "";
        button.setAttribute(
          "aria-label",
          `${agentLabel}${pendingLabel} — view and manage agents`,
        );
      }
      if (!stack) return;
      stack.replaceChildren();
      for (const agent of agents.slice(0, HEADER_STACK_LIMIT)) {
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        markAgentAvatar(avatar, agent.principalId);
        stack.append(avatar);
      }
    };

    /*
     * The dialog roster is the management list: model, owner, and a permission-aware
     * Remove per row — the same rules the rail roster enforced, unchanged. When a
     * background roster refresh re-renders while the dialog is open, focus parked inside
     * the list is handed back to the same agent's row rather than dropped out of the
     * dialog (a replaced node cannot keep focus, and losing it would strand a keyboard
     * user on <body> behind the modal).
     */
    const renderDialogRoster = (): void => {
      const add = one<HTMLButtonElement>("[data-add-agent-dialog]");
      if (add) add.hidden = sampleMode;
      const list = one<HTMLUListElement>("[data-dialog-agent-list]");
      if (!list) return;
      let refocusPrincipal = "";
      if (
        document.activeElement instanceof HTMLElement &&
        list.contains(document.activeElement)
      ) {
        refocusPrincipal =
          document.activeElement.closest<HTMLElement>("[data-agent-row]")?.dataset
            .agentRow ?? "";
      }
      list.replaceChildren();
      const query = rosterFilter.trim().toLowerCase();
      const visible = query
        ? agents.filter((agent) => agent.name.toLowerCase().includes(query))
        : agents;
      if (visible.length === 0) {
        const empty = document.createElement("li");
        empty.className = "dashboard__agent-empty";
        empty.textContent = query
          ? `No agents match “${rosterFilter.trim()}”.`
          : "No agents yet";
        list.append(empty);
        return;
      }
      const me = members.find((member) => member.userId === session?.user.id);
      for (const agent of visible) {
        const row = document.createElement("li");
        row.className = "dashboard__agent";
        row.dataset.agentRow = agent.principalId;
        row.tabIndex = -1;
        const avatar = document.createElement("span");
        avatar.className = "dashboard__agent-avatar";
        avatar.textContent = initials(agent.name);
        avatar.setAttribute("aria-hidden", "true");
        markAgentAvatar(avatar, agent.principalId);
        const copy = document.createElement("span");
        copy.className = "dashboard__agent-copy";
        const name = document.createElement("strong");
        name.textContent = agent.name;
        const state = document.createElement("span");
        state.textContent =
          `${agent.model ?? "Model not specified"} · owned by ${
            people.get(agent.ownerUserId) ?? "Workspace member"
          }`;
        copy.append(name, state);
        row.append(avatar, copy);
        // Owner/admin any principal; member only own. Clear on the connect
        // prompt only hides the secret — it never revokes.
        const mayRemove = Boolean(
          me &&
          (
            me.role === "owner" ||
            me.role === "admin" ||
            agent.ownerUserId === me.userId
          ),
        );
        if (mayRemove && !sampleMode) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "dashboard__text-button";
          button.textContent = "Remove";
          button.dataset.removeAgent = agent.principalId;
          button.addEventListener("click", async () => {
            if (!session || !activeWorkspaceId) return;
            if (
              !window.confirm(
                `Remove ${agent.name}? This ends its identity and every live credential in this workspace. Clearing a Copy prompt only hides the secret — it does not remove the agent.`,
              )
            ) return;
            const errorTarget = one<HTMLElement>("[data-agent-error]");
            if (errorTarget) {
              errorTarget.hidden = true;
              errorTarget.textContent = "";
            }
            button.disabled = true;
            try {
              await revokeAgentPrincipal(
                session,
                uuid(),
                activeWorkspaceId,
                agent.principalId,
              );
              if (livePromptPrincipalId === agent.principalId) {
                one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
                livePromptPrincipalId = "";
              }
              await openWorkspace(activeWorkspaceId);
              /* The reload closed the dialog; hand focus to the control that reopens
                 it, or to the empty channel's Add door when that was the last agent. */
              const door = agents.length > 0
                ? one<HTMLButtonElement>("[data-roster-open]")
                : one<HTMLButtonElement>("[data-add-agent]");
              door?.focus({ preventScroll: true });
            } catch (error) {
              if (errorTarget) {
                errorTarget.textContent = readableError(error);
                errorTarget.hidden = false;
              }
            } finally {
              button.disabled = false;
            }
          });
          row.append(button);
        }
        list.append(row);
      }
      if (refocusPrincipal) {
        const row = list.querySelector<HTMLElement>(
          `[data-agent-row="${refocusPrincipal}"]`,
        );
        const target = row?.querySelector<HTMLButtonElement>("button") ?? row;
        target?.focus({ preventScroll: true });
      }
    };

    /*
     * Opening resets the filter so every session starts from the full roster. Initial
     * focus goes to Add an agent — the first visible primary action — or, when sample
     * mode hides that door, to the filter. Escape, modal focus containment, and focus
     * restore on close are the native <dialog>'s; the close event re-syncs the stack
     * button's aria-expanded no matter which path closed it.
     */
    const openRosterDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      if (!dialog || dialog.open) return;
      rosterFilter = "";
      const search = one<HTMLInputElement>("[data-roster-search]");
      if (search) search.value = "";
      renderDialogRoster();
      dialog.showModal();
      const add = one<HTMLButtonElement>("[data-add-agent-dialog]");
      const firstStop = add && !add.hidden ? add : search;
      window.requestAnimationFrame(() => firstStop?.focus({ preventScroll: true }));
      one<HTMLButtonElement>("[data-roster-open]")?.setAttribute("aria-expanded", "true");
    };

    const closeRosterDialog = (): void => {
      const dialog = one<HTMLDialogElement>("[data-roster-dialog]");
      if (dialog?.open) dialog.close();
    };

    const formatTime = (value: string): { relative: string; absolute: string } => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return { relative: "Time unavailable", absolute: "" };
      const seconds = Math.round((date.getTime() - Date.now()) / 1_000);
      const ranges: Array<[number, Intl.RelativeTimeFormatUnit]> = [
        [60, "second"],
        [60, "minute"],
        [24, "hour"],
        [7, "day"],
        [4.345, "week"],
        [12, "month"],
        [Number.POSITIVE_INFINITY, "year"],
      ];
      let amount = seconds;
      let unit: Intl.RelativeTimeFormatUnit = "second";
      for (const [range, next] of ranges) {
        unit = next;
        if (Math.abs(amount) < range) break;
        amount /= range;
      }
      return {
        relative: new Intl.RelativeTimeFormat(undefined, { numeric: "auto" }).format(
          Math.round(amount),
          unit,
        ),
        absolute: new Intl.DateTimeFormat(undefined, {
          dateStyle: "medium",
          timeStyle: "short",
        }).format(date),
      };
    };

    const kindLabel = (kind: string): string => {
      if (kind === "working-on") return "Working on";
      if (kind === "ask") return "Question";
      if (kind === "note") return "Note";
      return "Update";
    };

    const renderSignalCounts = (): void => {
      const { broadcastCount, directCount } = signalCounts(signals);
      const broadcastTarget = one<HTMLElement>("[data-broadcast-count]");
      const directTarget = one<HTMLElement>("[data-direct-count]");
      if (broadcastTarget) broadcastTarget.textContent = String(broadcastCount);
      if (directTarget) directTarget.textContent = String(directCount);
    };

    const renderFeed = (): void => {
      window.clearTimeout(signalExpiryTimer);
      signalExpiryTimer = undefined;
      if (addAgentViewOpen()) return;
      const now = Date.now();
      signals = signals.filter(
        (signal) => signal.until === null || new Date(signal.until).getTime() > now,
      );
      const nextExpiry = signals.reduce<number | null>((nearest, signal) => {
        if (signal.until === null) return nearest;
        const expiresAt = new Date(signal.until).getTime();
        if (!Number.isFinite(expiresAt) || expiresAt <= now) return nearest;
        return nearest === null || expiresAt < nearest ? expiresAt : nearest;
      }, null);
      if (nextExpiry !== null) {
        signalExpiryTimer = window.setTimeout(
          renderFeed,
          Math.min(Math.max(nextExpiry - now + 25, 25), 2_147_483_647),
        );
      }
      const list = one<HTMLOListElement>("[data-feed-list]");
      const count = one<HTMLElement>("[data-update-count]");
      const more = one<HTMLElement>("[data-feed-more]");
      renderSignalCounts();
      if (count) {
        count.textContent = `${signals.length}${signalHasMore ? "+" : ""} ${
          signals.length === 1 && !signalHasMore ? "update" : "updates"
        }`;
        count.hidden = signals.length === 0;
      }
      if (more) more.hidden = !signalHasMore;
      if (!list) return;
      list.replaceChildren();
      if (signals.length === 0) {
        const emptyTitle = one<HTMLElement>("[data-feed-empty-title]");
        if (emptyTitle) {
          emptyTitle.textContent = agents.length === 1
            ? `Waiting for ${agents[0]!.name}’s first update.`
            : "Waiting for your agents’ first updates.";
        }
        previousSignalIds.clear();
        feedWasEmpty = true;
        showChannelView("feed-empty");
        return;
      }
      const agentById = new Map(agents.map((agent) => [agent.principalId, agent]));
      const viewerId = session?.user.id ?? (sampleMode ? "sample-owner" : "");
      const visibleSignals = filterSignals(signals, signalFilter, viewerId, agentById);
      for (const button of all<HTMLButtonElement>("[data-feed-filter]")) {
        const active = button.dataset.feedFilter === signalFilter;
        button.setAttribute("aria-pressed", String(active));
      }
      if (visibleSignals.length === 0) {
        const empty = document.createElement("li");
        empty.className = "dashboard__filter-empty";
        empty.textContent = signalFilter === "broadcast"
          ? "No broadcasts in the loaded signals."
          : "No loaded signals are directed to you.";
        list.append(empty);
      }
      for (const signal of visibleSignals) {
        const row = document.createElement("li");
        row.className = "dashboard__message";
        if ((feedWasEmpty || previousSignalIds.size > 0) && !previousSignalIds.has(signal.id)) {
          row.classList.add("dashboard__message--fresh");
        }
        const authorAgent = agentById.get(signal.from);
        const targetAgent = signal.toAgent === null
          ? undefined
          : agentById.get(signal.toAgent);
        if (
          (session && (
            signal.to === session?.user.id ||
            targetAgent?.ownerUserId === session?.user.id
          )) ||
          signalIsDirectToViewer(signal, viewerId, agentById)
        ) {
          row.classList.add("dashboard__message--direct-to-viewer");
        }
        const authorName = authorAgent?.name ??
          people.get(signal.from) ??
          (signal.fromKind === "user" ? "Team member" : "Unknown agent");
        const avatar = document.createElement("span");
        avatar.className = "dashboard__message-avatar";
        avatar.textContent = initials(authorName);
        avatar.setAttribute("aria-hidden", "true");
        if (authorAgent) markAgentAvatar(avatar, authorAgent.principalId);

        const body = document.createElement("article");
        body.className = "dashboard__message-body";
        const meta = document.createElement("header");
        meta.className = "dashboard__message-meta";
        const author = document.createElement("strong");
        const authorEntity = authorAgent
          ? { kind: "agent" as const, id: authorAgent.principalId }
          : signal.fromKind === "user" && people.has(signal.from)
          ? { kind: "person" as const, id: signal.from }
          : null;
        if (authorEntity) {
          author.append(entityControl(
            authorName,
            authorEntity,
            "dashboard__message-entity dashboard__message-author",
          ));
        } else {
          author.textContent = authorName;
        }
        const identityBadge = document.createElement("span");
        identityBadge.className = "dashboard__message-identity-badge";
        identityBadge.textContent = signal.fromKind === "user" ? "PERSON" : "AGENT";
        const target = document.createElement("span");
        target.className = "dashboard__message-target";
        target.append("→ ");
        if (signal.toAgent !== null && targetAgent) {
          target.append(entityControl(
            targetAgent.name,
            { kind: "agent", id: targetAgent.principalId },
            "dashboard__message-entity",
          ));
        } else if (signal.to !== null && people.has(signal.to)) {
          target.append(entityControl(
            people.get(signal.to)!,
            { kind: "person", id: signal.to },
            "dashboard__message-entity",
          ));
        } else {
          target.append(
            signal.toAgent !== null
              ? "an agent"
              : signal.to !== null
              ? "a workspace member"
              : "everyone",
          );
        }
        const operator = document.createElement("span");
        operator.className = "dashboard__message-operator";
        if (authorAgent) {
          operator.append(`${authorAgent.model ?? "Model not specified"} · operated by `);
          const ownerName = people.get(authorAgent.ownerUserId);
          if (ownerName) {
            operator.append(entityControl(
              ownerName,
              { kind: "person", id: authorAgent.ownerUserId },
              "dashboard__message-entity",
            ));
          } else {
            operator.append("Workspace member");
          }
        } else {
          operator.textContent = signal.fromKind === "user" ? "Workspace member" : "AI agent";
        }
        const badge = document.createElement("span");
        badge.className = `dashboard__message-kind dashboard__message-kind--${signal.kind}`;
        badge.textContent = kindLabel(signal.kind);
        const time = document.createElement("time");
        const formatted = formatTime(signal.createdAt);
        time.dateTime = signal.createdAt;
        time.title = formatted.absolute;
        time.textContent = formatted.relative;
        meta.append(author, identityBadge, target, operator, badge, time);
        const text = document.createElement("p");
        for (const mention of visualMentions.get(signal.id) ?? []) {
          text.append(entityControl(
            `@${entityName(mention)}`,
            mention,
            "dashboard__mention-chip dashboard__message-mention",
          ), " ");
        }
        text.append(signal.body);
        body.append(meta, text);
        if (signal.about) {
          const about = document.createElement("code");
          about.className = "dashboard__message-about";
          about.textContent = signal.about;
          body.append(about);
        }
        row.append(avatar, body);
        list.append(row);
      }
      previousSignalIds = new Set(signals.map((signal) => signal.id));
      feedWasEmpty = false;
      showChannelView("feed");
    };

    const syncConnectWorkspace = (workspace: Workspace): void => {
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!connect) return;
      connect.setAttribute("workspace-name", workspace.name);
      connect.setAttribute("workspace-id", workspace.id);
    };

    const loadSignals = async (
      workspaceId: string,
      reset: boolean,
      version: number,
    ): Promise<void> => {
      const cursor = reset ? null : signalCursor;
      if (reset) {
        signalCursor = null;
        signalCutoff = new Date().toISOString();
      }
      const page = await signalPage(workspaceId, cursor, signalCutoff);
      if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
      if (reset) {
        signals = page.rows;
      } else {
        const known = new Set(signals.map((signal) => signal.id));
        const additions = page.rows.filter((signal) => !known.has(signal.id));
        signals = [...signals, ...additions];
      }
      const last = page.rows.at(-1);
      signalCursor = last ? { createdAt: last.createdAt, id: last.id } : cursor;
      signalHasMore = page.hasMore;
      renderFeed();
    };

    const refreshLatestSignals = async (): Promise<void> => {
      const workspaceId = activeWorkspaceId;
      const version = requestVersion;
      if (
        liveFeedInFlight ||
        sampleMode ||
        !workspaceId ||
        document.visibilityState !== "visible" ||
        !["feed", "feed-empty"].includes(app.dataset.channelView ?? "")
      ) return;
      liveFeedInFlight = true;
      try {
        const page = await signalPage(workspaceId, null, new Date().toISOString());
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        /* A signal from a principal the roster does not know is how a join first shows
           up here: queue it for one bounded catch-up. Settled principals (confirmed
           revoked/historical by a previous successful fetch) never re-queue, so their
           immutable old signals cannot keep the queue alive forever. */
        const knownAgents = new Set(agents.map((agent) => agent.principalId));
        for (const signal of page.rows) {
          if (
            signal.fromKind === "agent" &&
            !knownAgents.has(signal.from) &&
            !settledUnknownAgents.has(signal.from)
          ) {
            unknownAgentCandidates.add(signal.from);
          }
        }
        if (unknownAgentCandidates.size > 0) {
          void refreshRosterForUnknownAgents(workspaceId, version);
        }
        const known = new Set(page.rows.map((signal) => signal.id));
        const next = [...page.rows, ...signals.filter((signal) => !known.has(signal.id))];
        const changed =
          next.length !== signals.length ||
          next.some((signal, index) => signal.id !== signals[index]?.id);
        signalHasMore = signalHasMore || page.hasMore;
        if (changed) {
          signals = next;
          renderFeed();
        }
        /* The dedicated access cadence owns discovery; a healthy feed tick also
           offers a catch-up, and the shared gate keeps the requests bounded. */
        void refreshPendingAccess(workspaceId, version);
      } catch {
        // A live refresh never replaces a readable channel with an error. The
        // next tick retries, and the explicit refresh control remains available.
      } finally {
        liveFeedInFlight = false;
      }
    };

    /*
     * Pending access is where the inviter WAITS: a teammate invite or an agent key sits
     * there until it is consumed or cancelled. The dedicated workspace poll owns the
     * cadence in every view and also discovers access another browser created while this
     * one knew zero rows. Known pending access uses a prompt cadence; local zero uses a
     * slower discovery cadence. Feed refreshes may request the same catch-up, but the gate
     * bounds both triggers. A successful refresh updates access and membership without
     * touching the feed or closing an open add-agent view; failure stays silent and retries.
     *
     * Ownership is the gate's, and it is (workspaceId, version)-scoped: a slow request
     * started under the previous workspace holds no slot here, applies nothing when it
     * settles, and its finally cannot free the fresh workspace's ownership.
     */
    const hasPendingAccess = (): boolean =>
      pendingInvites.length > 0 ||
      accessStatuses.some(
        (access) =>
          access.firstUsedAt === null &&
          access.revokedAt === null &&
          new Date(access.expiresAt).getTime() > Date.now(),
      );

    const refreshPendingAccess = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      if (sampleMode) return;
      /* Acquiring also records the attempt. A stale owner — another workspace, or
         an older generation of this one — is replaced here rather than waited on. */
      if (
        !pendingRefreshGate.tryAcquire(
          workspaceId,
          version,
          Date.now(),
          hasPendingAccess(),
        )
      ) {
        return;
      }
      try {
        const [nextInvites, nextStatuses, nextRoster] = await Promise.all([
          pendingMemberInvites(workspaceId),
          agentAccessStatuses(workspaceId),
          memberRoster(workspaceId).catch(() => null),
        ]);
        /* A request that settles after the user moved on applies nothing: its
           generation and workspace no longer match the live ones. */
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        pendingInvites = nextInvites;
        accessStatuses = nextStatuses;
        if (nextRoster) {
          people = nextRoster.names;
          members = nextRoster.members;
          renderMembers();
          renderRoster();
        }
        if (
          freshInviteWorkspaceId === workspaceId &&
          shouldRetireFreshInvite(freshInviteId, nextInvites)
        ) {
          retireFreshInviteResult();
        }
        renderPendingAccess();
      } catch {
        // Stay silent and retryable; the last good list remains on screen.
      } finally {
        pendingRefreshGate.release(workspaceId, version);
      }
    };

    /*
     * The pending-access poll owes nothing to the channel view or locally-known rows.
     * That fixes both stale removal in a no-agents view and remote zero-to-one creation:
     * a visible live workspace keeps one cheap timer, while the gate permits actual
     * network work every 12 seconds with pending access and every 30 seconds at local
     * zero. The Live chip stays out of this: liveness of the FEED is a different claim.
     */
    const PENDING_POLL_TICK_MS = 4_000;
    let pendingPollTimer: number | undefined;

    const stopPendingPoll = (): void => {
      window.clearInterval(pendingPollTimer);
      pendingPollTimer = undefined;
    };

    const syncPendingPoll = (): void => {
      const should = shouldPollPendingAccess({
        sampleMode,
        activeWorkspaceId,
        visible: document.visibilityState === "visible",
      });
      if (should && pendingPollTimer === undefined) {
        pendingPollTimer = window.setInterval(() => {
          /* Time alone can retire an unused key. Re-render that local transition,
             then continue the slower discovery cadence rather than treating zero
             as proof that another browser cannot add access. */
          if (pendingAccessKey() !== renderedPendingAccessKey) renderPendingAccess();
          void refreshPendingAccess(activeWorkspaceId, requestVersion);
        }, PENDING_POLL_TICK_MS);
      } else if (!should && pendingPollTimer !== undefined) {
        stopPendingPoll();
      }
    };

    /** Clear every workspace-scoped value when auth identity or availability changes. */
    const resetWorkspaceSessionState = (): void => {
      closeEntityPanel(false);
      closeWorkspaceMenu();
      closeRosterDialog();
      one<SecretHoldingAgentConnect>("agent-connect")?.clearPrompt(false);
      connectFocusObserver?.disconnect();
      connectFocusObserver = null;
      activeWorkspaceId = "";
      pendingWorkspaceId = "";
      pendingWorkspaceCreate = false;
      workspaces = [];
      agents = [];
      members = [];
      pendingInvites = [];
      accessStatuses = [];
      renderedPendingAccessKey = "";
      people = new Map();
      signals = [];
      signalCursor = null;
      signalHasMore = false;
      signalCutoff = "";
      channelLoadError = "";
      livePromptPrincipalId = "";
      freshInviteLink = "";
      freshInviteId = "";
      freshInviteWorkspaceId = "";
      inviteIntent = null;
      resetInviteSubmitControl();
      activeCreate = null;
      rosterFilter = "";
      signalFilter = "all";
      unknownAgentCandidates.clear();
      settledUnknownAgents.clear();
      previousSignalIds = new Set();
      feedWasEmpty = false;
      liveFeedInFlight = false;
      rosterRefreshInFlight = false;
      rosterRefreshAttemptedAt = 0;
      resetComposer();
      window.clearTimeout(signalExpiryTimer);
      signalExpiryTimer = undefined;
      window.clearInterval(liveFeedTimer);
      liveFeedTimer = undefined;
      pendingRefreshGate.resetCooldown();
      syncPendingPoll();

      /* Auth changes are a privacy boundary, not merely a panel change. Remove the
         prior account's names, invite emails, agent rows, and signal bodies from
         the DOM before the signed-out/create surface is presented. */
      renderMembers();
      renderRoster();
      for (const list of all<HTMLElement>(
        "[data-workspace-list], [data-access-list], [data-dialog-access-list], [data-feed-list], " +
          "[data-sidebar-participant-list]",
      )) {
        list.replaceChildren();
      }
      for (const target of all<HTMLElement>(
        "[data-channel-name], [data-channel-id], [data-invite-link], [data-channel-receipt], " +
          "[data-sidebar-workspace-name]",
      )) {
        target.textContent = "";
      }
      for (const count of all<HTMLElement>("[data-broadcast-count], [data-direct-count]")) {
        count.textContent = "0";
      }
      for (const target of all<HTMLElement>("[data-account-name], [data-rail-account]")) {
        target.textContent = "Your account";
      }
      const workspaceTrigger = one<HTMLButtonElement>("[data-workspace-menu-trigger]");
      if (workspaceTrigger) {
        workspaceTrigger.setAttribute("aria-label", "Choose workspace");
        workspaceTrigger.removeAttribute("title");
      }
      const emptyTitle = one<HTMLElement>("[data-feed-empty-title]");
      if (emptyTitle) emptyTitle.textContent = "Waiting for your agents’ first updates.";
      const rosterSearch = one<HTMLInputElement>("[data-roster-search]");
      if (rosterSearch) rosterSearch.value = "";
      const inviteEmail = one<HTMLInputElement>("[data-invite-email]");
      if (inviteEmail) inviteEmail.value = "";
      const workspaceName = one<HTMLInputElement>("#dashboard-workspace-name");
      if (workspaceName) workspaceName.value = "";
      const inviteResult = one<HTMLElement>("[data-invite-result]");
      if (inviteResult) inviteResult.hidden = true;
      const receipt = one<HTMLElement>("[data-channel-receipt]");
      if (receipt) receipt.hidden = true;
      const accessDetails = one<HTMLDetailsElement>("[data-access-details]");
      if (accessDetails) {
        accessDetails.open = false;
        accessDetails.hidden = true;
      }
      const dialogAccess = one<HTMLElement>("[data-dialog-access-section]");
      if (dialogAccess) dialogAccess.hidden = true;
      for (const count of all<HTMLElement>("[data-access-count], [data-dialog-access-count]")) {
        count.textContent = "0";
      }
      for (const error of all<HTMLElement>(
        "[data-access-error], [data-dialog-access-error], [data-agent-error], " +
          "[data-member-error], [data-feed-error]",
      )) {
        error.textContent = "";
        error.hidden = true;
      }
    };

    armLiveFeed = (): void => {
      if (
        sampleMode ||
        !activeWorkspaceId ||
        document.visibilityState !== "visible" ||
        !["feed", "feed-empty"].includes(app.dataset.channelView ?? "")
      ) return;
      if (liveFeedTimer !== undefined) return;
      liveFeedTimer = window.setInterval(() => void refreshLatestSignals(), 2_000);
    };

    /*
     * The feed polls every two seconds; the roster does not. When a poll brings in a
     * signal from an agent principal we do not know, that first signal IS the join event:
     * refresh the roster once so the header stack, the dialog, and the feed's author
     * names stop showing the "Agent a1b2c3" fallback.
     *
     * The catch-up is principal-aware because signals are immutable. A revoked agent's
     * old signals keep arriving in every latest page forever; settling is how that stops
     * costing fetches. Only a SUCCESSFUL fetch may settle, and only a candidate still
     * absent from that fetch — a failed fetch settles and drains nothing, so it stays
     * retryable after the cooldown. Concurrent candidates coalesce: the attempt drains
     * a snapshot of the queue while detection keeps filling it, and whatever arrives
     * during the flight is covered by the next bounded attempt.
     */
    const refreshRosterForUnknownAgents = async (
      workspaceId: string,
      version: number,
    ): Promise<void> => {
      if (rosterRefreshInFlight || sampleMode) return;
      if (unknownAgentCandidates.size === 0) return;
      if (Date.now() - rosterRefreshAttemptedAt < 10_000) return;
      rosterRefreshInFlight = true;
      rosterRefreshAttemptedAt = Date.now();
      const candidates = [...unknownAgentCandidates];
      try {
        const [nextAgents, nextRoster] = await Promise.all([
          roster(workspaceId),
          memberRoster(workspaceId),
        ]);
        if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
        agents = nextAgents;
        people = nextRoster.names;
        members = nextRoster.members;
        const rosterIds = new Set(nextAgents.map((agent) => agent.principalId));
        /* A principal queued DURING the flight is not in the captured snapshot, but the
           fresh roster may already know it: prune those from the queue so they cannot
           cause a redundant fetch after the cooldown. Settling stays snapshot-only. */
        for (const principalId of [...unknownAgentCandidates]) {
          if (rosterIds.has(principalId)) unknownAgentCandidates.delete(principalId);
        }
        for (const principalId of candidates) {
          unknownAgentCandidates.delete(principalId);
          if (!rosterIds.has(principalId)) settledUnknownAgents.add(principalId);
        }
        renderRoster();
        renderMembers();
        renderFeed();
      } catch {
        // A roster refresh never replaces a readable channel with an error. Nothing is
        // settled or drained here, so the same candidates retry after the cooldown.
      } finally {
        rosterRefreshInFlight = false;
      }
    };

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState !== "visible") {
        window.clearInterval(liveFeedTimer);
        liveFeedTimer = undefined;
        syncPendingPoll();
        return;
      }
      void refreshLatestSignals();
      armLiveFeed();
      /* Coming back to the tab is exactly when a redemption has likely happened;
         catch up now rather than a tick later. */
      void refreshPendingAccess(activeWorkspaceId, requestVersion);
      syncPendingPoll();
    });

    const renderChannel = (workspace: Workspace, pending = false): void => {
      const name = one<HTMLElement>("[data-channel-name]");
      const id = one<HTMLElement>("[data-channel-id]");
      if (name) name.textContent = "# all-signals";
      for (const target of all<HTMLElement>("[data-sidebar-workspace-name]")) {
        target.textContent = workspace.name;
      }
      if (id) id.textContent = workspace.id;
      renderSignalCounts();
      const refresh = one<HTMLButtonElement>("[data-refresh]");
      if (refresh) refresh.hidden = sampleMode || agents.length === 0;
      const count = one<HTMLElement>("[data-update-count]");
      if (count) count.hidden = pending || agents.length === 0 || signals.length === 0;
      renderWorkspaceList(workspace);
      renderRoster();
      for (const target of all<HTMLElement>("[data-rail-account]")) {
        target.textContent = sampleMode || !session ? "Sample account" : accountName(session);
      }
      showPanel("channel");
      if (pending) {
        if (count) count.textContent = "Loading updates…";
        showChannelView("feed-pending");
      } else if (sampleMode) {
        renderFeed();
      } else if (agents.length === 0) {
        if (count) count.textContent = "Empty channel";
        showChannelView("no-agents");
      } else {
        showChannelView("feed-pending");
      }
    };

    const resetInviteSubmitControl = (): void => {
      const submit = one<HTMLButtonElement>("[data-invite-submit]");
      if (!submit) return;
      submit.disabled = false;
      submit.textContent = "Create invite link";
    };

    const openWorkspace = async (workspaceId: string): Promise<void> => {
      const selected = workspaces.find((workspace) => workspace.id === workspaceId);
      if (!selected) return;
      closeEntityPanel(false);
      closeWorkspaceMenu();
      const changesWorkspace = activeWorkspaceId !== selected.id;
      if (changesWorkspace) {
        previousSignalIds.clear();
        feedWasEmpty = false;
      }
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const promptWorkspaceId = connect?.getAttribute("workspace-id") ?? "";
      const connectState = connect?.dataset.state ?? "";
      const mintBusy = connect?.hasAttribute("data-mint-busy") ?? false;
      if (connectState === "done") {
        pendingWorkspaceId = workspaceId;
        connect?.finishPrompt("back");
        return;
      }
      if (mintBusy || connectState === "working") {
        const changesWorkspace =
          promptWorkspaceId.length > 0 && promptWorkspaceId !== workspaceId;
        pendingWorkspaceId = changesWorkspace ? workspaceId : "";
        showChannelView("connect");
        window.requestAnimationFrame(() => {
          one<HTMLElement>("[data-close-connect]")?.focus();
        });
        return;
      }
      pendingWorkspaceId = "";
      /* Every real workspace open advances requestVersion, so an invite submission
         from the prior generation no longer owns this shared form. Reset its busy
         affordance here; the stale async handler is forbidden from touching it. */
      resetInviteSubmitControl();
      if (changesWorkspace) {
        resetComposer();
        resetFreshInviteResult();
        inviteIntent = null;
        const email = one<HTMLInputElement>("[data-invite-email]");
        const error = one<HTMLElement>("[data-invite-error]");
        if (email) email.value = "";
        if (error) {
          error.textContent = "";
          error.hidden = true;
        }
      }
      /* The dialog shows the OLD workspace's roster from here on; close it rather than
         let it outlive its data. The refresh cooldown resets with the workspace. */
      closeRosterDialog();
      rosterRefreshAttemptedAt = 0;
      pendingRefreshGate.resetCooldown();
      unknownAgentCandidates.clear();
      settledUnknownAgents.clear();
      const keepShell = app.dataset.state === "channel";
      stopPendingPoll();
      activeWorkspaceId = selected.id;
      syncConnectWorkspace(selected);
      const version = ++requestVersion;
      agents = [];
      members = [];
      pendingInvites = [];
      accessStatuses = [];
      renderedPendingAccessKey = "";
      /* Restart one timer under the new workspace/version. The callbacks read the
         guarded live identity, and a failed initial load remains retryable. */
      syncPendingPoll();
      people = new Map();
      signals = [];
      signalFilter = "all";
      signalCursor = null;
      signalHasMore = false;
      signalCutoff = "";
      channelLoadError = "";
      if (keepShell) renderChannel(selected, true);
      else setLoading(`Opening ${selected.name}…`);
      try {
        const [nextAgents, nextRoster, nextInvites, nextAccessStatuses] = await Promise.all([
          roster(selected.id),
          memberRoster(selected.id),
          pendingMemberInvites(selected.id),
          agentAccessStatuses(selected.id),
        ]);
        if (version !== requestVersion) return;
        agents = nextAgents;
        people = nextRoster.names;
        members = nextRoster.members;
        pendingInvites = nextInvites;
        accessStatuses = nextAccessStatuses;
        if (
          freshInviteWorkspaceId === selected.id &&
          shouldRetireFreshInvite(freshInviteId, nextInvites)
        ) {
          retireFreshInviteResult();
        }
        if (!addAgentViewOpen()) renderChannel(selected);
        renderMembers();
        renderPendingAccess();
        if (agents.length > 0) {
          await loadSignals(selected.id, true, version);
        }
      } catch (error) {
        if (version !== requestVersion) return;
        signalHasMore = false;
        channelLoadError = `${readableError(error)} Nothing was changed.`;
        const target = one<HTMLElement>("[data-feed-error]");
        if (target) target.textContent = channelLoadError;
        if (addAgentViewOpen()) return;
        renderChannel(selected);
        showChannelView("feed-error");
      }
    };

    const openAgentChoice = (): void => {
      if (sampleMode) return;
      showChannelView("agent-choice");
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-agent-owner-self]")?.focus({ preventScroll: true });
      });
    };

    const resetFreshInviteResult = (): void => {
      freshInviteLink = "";
      freshInviteId = "";
      freshInviteWorkspaceId = "";
      const result = one<HTMLElement>("[data-invite-result]");
      const form = one<HTMLFormElement>("[data-invite-form]");
      const receipt = one<HTMLElement>("[data-invite-receipt]");
      const link = one<HTMLElement>("[data-invite-link]");
      const copy = one<HTMLButtonElement>("[data-copy-invite]");
      const done = one<HTMLButtonElement>("[data-invite-done]");
      const status = one<HTMLElement>("[data-invite-status]");
      if (result) result.hidden = true;
      if (form) form.hidden = false;
      if (receipt) receipt.textContent = "Private one-use link · expires in 7 days";
      if (link) {
        link.textContent = "";
        link.hidden = false;
      }
      if (copy) {
        copy.textContent = "Copy invite link";
        delete copy.dataset.inviteComplete;
      }
      if (done) done.textContent = "Done";
      if (status) status.textContent = "";
    };

    /* Remote acceptance, cancellation, and expiry are indistinguishable from the
       pending endpoint, but all make the one-use URL dead. Clear the credential
       and turn the existing controls into truthful exits without moving focus.
       If the link itself holds focus, keep that node visible with safe text. */
    const retireFreshInviteResult = (): void => {
      freshInviteLink = "";
      freshInviteId = "";
      freshInviteWorkspaceId = "";
      const result = one<HTMLElement>("[data-invite-result]");
      const form = one<HTMLFormElement>("[data-invite-form]");
      const receipt = one<HTMLElement>("[data-invite-receipt]");
      const link = one<HTMLElement>("[data-invite-link]");
      const copy = one<HTMLButtonElement>("[data-copy-invite]");
      const done = one<HTMLButtonElement>("[data-invite-done]");
      const status = one<HTMLElement>("[data-invite-status]");
      if (result) result.hidden = false;
      if (form) form.hidden = true;
      if (receipt) receipt.textContent = "This invite is no longer pending.";
      if (link) {
        link.textContent = "The one-use link has been cleared.";
        link.hidden = document.activeElement !== link;
      }
      if (copy) {
        copy.textContent = "Back to channel";
        copy.dataset.inviteComplete = "true";
      }
      if (done) done.textContent = "Invite someone else";
      if (status) status.textContent = "The one-use link has been cleared.";
    };

    const openInvite = (): void => {
      if (sampleMode) return;
      resetFreshInviteResult();
      const error = one<HTMLElement>("[data-invite-error]");
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
      showChannelView("invite");
      window.requestAnimationFrame(() => {
        one<HTMLInputElement>("[data-invite-email]")?.focus({ preventScroll: true });
      });
    };

    const openConnect = (): void => {
      if (sampleMode) return;
      const selected = workspaces.find((workspace) => workspace.id === activeWorkspaceId);
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (!selected || !connect) return;
      syncConnectWorkspace(selected);
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) exitStatus.hidden = true;
      showChannelView("connect");
      connectFocusObserver?.disconnect();
      const focusField = (): boolean => {
        if (connect.dataset.state !== "ready") return false;
        const form = connect.querySelector<HTMLFormElement>("[data-panel='form']");
        const target = form?.dataset.hasAgents === "yes"
          ? connect.querySelector<HTMLSelectElement>("[data-field='identity']")
          : connect.querySelector<HTMLInputElement>("[data-field='name']");
        target?.focus({ preventScroll: true });
        return Boolean(target);
      };
      window.requestAnimationFrame(() => {
        if (focusField()) return;
        connectFocusObserver = new MutationObserver(() => {
          if (!focusField()) return;
          connectFocusObserver?.disconnect();
          connectFocusObserver = null;
        });
        connectFocusObserver.observe(connect, {
          attributes: true,
          attributeFilter: ["data-state"],
        });
      });
    };

    const keepConnectCredentialVisible = (): boolean => {
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      const connectState = connect?.dataset.state ?? "";
      const mintBusy = connect?.hasAttribute("data-mint-busy") ?? false;
      if (!mintBusy && connectState !== "working") return false;
      showChannelView("connect");
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) {
        exitStatus.textContent =
          "Wait for CommonSwarm to finish creating the key before leaving this screen.";
        exitStatus.hidden = false;
      }
      window.requestAnimationFrame(() => {
        one<HTMLButtonElement>("[data-close-connect]")?.focus();
      });
      return true;
    };

    const returnToChannel = (): void => {
      pendingWorkspaceId = "";
      const exitStatus = one<HTMLElement>("[data-connect-exit-status]");
      if (exitStatus) exitStatus.hidden = true;
      if (channelLoadError) showChannelView("feed-error");
      else if (agents.length === 0) showChannelView("no-agents");
      else if (signals.length === 0) {
        const workspaceId = activeWorkspaceId;
        const version = requestVersion;
        showChannelView("feed-pending");
        void loadSignals(workspaceId, true, version).catch((error) => {
          if (version !== requestVersion || workspaceId !== activeWorkspaceId) return;
          channelLoadError = `${readableError(error)} Nothing was changed.`;
          const target = one<HTMLElement>("[data-feed-error]");
          if (target) target.textContent = channelLoadError;
          if (addAgentViewOpen()) return;
          showChannelView("feed-error");
        });
      }
      else {
        // This is an explicit exit from an add-agent view. Mark the feed active
        // before rendering so renderFeed's background-refresh guard does not
        // mistake the requested return for an unsolicited view change.
        showChannelView("feed");
        renderFeed();
      }
    };

    const closeConnect = (): void => {
      if (keepConnectCredentialVisible()) return;
      const connect = one<SecretHoldingAgentConnect>("agent-connect");
      if (connect?.dataset.state === "done") {
        connect.finishPrompt("back");
        return;
      }
      returnToChannel();
    };

    const createFromIntent = async (value: Session, intent: CreateIntent): Promise<void> => {
      const version = requestVersion;
      const userId = value.user.id;
      if (activeCreate?.version === version && activeCreate.userId === userId) return;
      const marker = { version, userId };
      activeCreate = marker;
      const isCurrent = (): boolean =>
        version === requestVersion && session?.user.id === userId;
      const input = one<HTMLInputElement>("#dashboard-workspace-name");
      const button = one<HTMLButtonElement>("[data-create-button]");
      if (input) {
        input.value = intent.name;
        input.disabled = true;
      }
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        button.textContent = "Creating your workspace…";
      }
      setCreateError(null);
      try {
        const made = await createWorkspace(
          value,
          intent.commandId,
          intent.workspaceId,
          intent.name,
        );
        if (!isCurrent()) return;
        clearCreateIntent(value.user.id);
        const madeWorkspace = { id: made.workspaceId, name: made.name };
        workspaces = [
          madeWorkspace,
          ...workspaces.filter((workspace) => workspace.id !== made.workspaceId),
        ];
        if (input) input.disabled = false;
        await openWorkspace(made.workspaceId);
      } catch (error) {
        if (!isCurrent()) return;
        renderCreate(
          value,
          `${readableError(error)} ${
            error instanceof WorkspaceLimitReached || error instanceof WorkspaceOutcomeUnknown
              ? ""
              : "Trying again checks the same request; it cannot create a duplicate."
          }`.trim(),
        );
      } finally {
        if (activeCreate === marker) activeCreate = null;
        if (!isCurrent()) return;
        if (input) input.disabled = false;
        if (button) {
          button.disabled = false;
          button.removeAttribute("aria-busy");
          button.textContent = "Create workspace";
        }
      }
    };

    const renderSample = (): void => {
      sampleMode = true;
      signalHasMore = false;
      signalCursor = null;
      signalCutoff = "";
      syncPendingPoll();
      const now = Date.now();
