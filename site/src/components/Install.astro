---
/**
 * Install — requirements and the real install path.
 *
 * EVERY claim here is read directly out of install.sh (repo root on `main`; the file is
 * not present on this feature branch — retrieved with `git show main:install.sh`).
 * Line references are to that file:
 *
 *  - Node >= 24 checked FIRST, before any download        -> NODE_MAJOR -ge 24 check
 *  - Installs to $HOME/.local/bin, overridable with
 *    COSWARM_INSTALL_DIR; COSWARM_VERSION pins a version  -> INSTALL_DIR / VERSION vars
 *  - No sudo, no node_modules, a single file              -> header comment + mv
 *  - Downloads coswarm + coswarm.sha256; refuses to
 *    install if the checksum file is missing; compares
 *    with shasum or sha256sum; dies on mismatch; dies if
 *    NEITHER tool exists. There is no skip flag.          -> "Verify before installing"
 *  - Walks every parent of the install dir and refuses if
 *    any package.json declares "type":"module", because
 *    the bundle is CommonJS and node would load it as ESM -> "_d" while-loop
 *  - Prints PATH guidance when the dir is not on PATH     -> case ":$PATH:" block
 *  - Ends by telling you to run `coswarm accept <invite-link>`
 *
 * The `<host>` placeholder is install.sh's own documented placeholder. Not invented.
 */

const installCmd = "curl -fsSL https://<host>/install.sh | sh";

const reqs = [
  {
    k: "Node.js 24 or newer",
    v: "Checked before anything is downloaded, so a wrong version is one clear sentence rather than a stack trace later.",
  },
  {
    k: "curl, and shasum or sha256sum",
    v: "If neither checksum tool is present the installer stops rather than install something it cannot verify.",
  },
  {
    k: "macOS or Linux",
    v: "POSIX sh on purpose — it runs before we know anything about the machine.",
  },
];

const guarantees = [
  {
    t: "One file, no sudo",
    d: "A single executable lands in ~/.local/bin. Nothing is written outside your home directory, and there is no node_modules tree. Set COSWARM_INSTALL_DIR to put it somewhere else, or COSWARM_VERSION to pin a release.",
  },
  {
    t: "Checksum verified, with no way to skip",
    d: "The installer fetches the release and its published SHA-256 alongside it. If the checksum file is missing, if the hashes disagree, or if your machine has no tool to compute one, it stops and installs nothing. There is no skip flag, and no environment variable that turns this off.",
  },
  {
    t: "It refuses a trap it can see coming",
    d: "coswarm ships as a CommonJS bundle in an extensionless file, and Node picks CJS or ESM from the nearest package.json. So the installer walks every parent of your install directory, and if one declares \"type\": \"module\" it stops and says so — rather than letting you meet “require is not defined in ES module scope” after an install that otherwise looked fine.",
  },
  {
    t: "It tells you when PATH is wrong",
    d: "Installing somewhere your shell cannot see is the most common way a working install looks broken. If the directory is not on your PATH, the installer prints the exact line to add for your shell.",
  },
];
---

<section class="inst" id="install" aria-labelledby="inst-title">
  <div class="page">
    <p class="eyebrow">Installing</p>
    <h2 class="h-section" id="inst-title">
      A <span class="inst__hl">curl | sh</span> you can<br class="brk" /> actually read.
    </h2>
    <p class="lede">
      Piping a script into a shell deserves the suspicion it gets. So this one
      checks your Node version before it downloads anything, verifies what it
      downloaded against a published checksum, and refuses to continue if it
      cannot.
    </p>

    <div class="inst__grid">
      <!-- left: the command + requirements -->
      <div>
        <div class="term" role="group" aria-label="Install command">
          <div class="term__bar">
            <span class="term__label mono">install</span>
            <button
              class="copy"
              type="button"
              data-copy={installCmd}
              data-label="Copy"
              aria-label="Copy the install command"
            >
              <span class="copy__txt">Copy</span>
            </button>
          </div>
          <div class="term__body">
            <div class="term__line mono">
              <span class="term__prompt" aria-hidden="true">$</span>
              <span class="term__text">{installCmd}</span>
            </div>
          </div>
        </div>

        <p class="inst__note">
          <span class="inst__flag mono">&lt;host&gt;</span> is a placeholder —
          the public install host is not live yet. Your invite carries the
          address it needs.
        </p>

        <h3 class="inst__subhead">Requirements</h3>
        <dl class="reqs">
          {
            reqs.map((r) => (
              <div class="req">
                <dt class="req__k">{r.k}</dt>
                <dd class="req__v">{r.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- right: what it guarantees -->
      <ul class="guars">
        {
          guarantees.map((g) => (
            <li class="guar">
              <span class="guar__tick" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
                  <path
                    d="M2.5 8.5l3.5 3.5 7.5-8"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <div>
                <h3 class="guar__t">{g.t}</h3>
                <p class="guar__d">{g.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="inst__foot">
      When it finishes it prints the version it actually read back off disk, and
      points you at one command: <span class="mono">coswarm accept</span> with
      the link you were sent.
    </p>
  </div>
</section>

<style>
  .inst {
    padding-block: var(--s-24);
  }

  .brk {
    display: none;
  }

  .inst__hl {
    font-family: var(--font-mono);
    font-size: 0.82em;
    color: var(--accent-bright);
    background: var(--accent-dim);
    border-radius: var(--radius-sm);
    padding: 0.08em 0.3em;
    letter-spacing: 0;
  }

  .inst__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-16);
    align-items: start;
    margin-top: var(--s-12);
  }

  /* ---------- terminal ---------- */
  .term {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--ring-top), var(--shadow-lg);
    overflow: hidden;
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .term__label {
    font-size: var(--t-xs);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-inline-end: auto;
  }

  .term__body {
    padding: var(--s-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .term__line {
    display: flex;
    gap: var(--s-3);
    white-space: pre;
    font-size: var(--t-sm);
    line-height: 1.8;
    color: var(--text);
    width: max-content;
    min-width: 100%;
  }

  .term__line > span {
    flex: none;
  }

  .term__prompt {
    color: var(--accent);
    user-select: none;
    flex: none;
  }

  .copy {
    flex: none;
    font: inherit;
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--text-muted);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--s-1) var(--s-3);
    min-height: 28px;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .copy:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--surface-2);
  }

  .copy:focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 2px;
  }

  .copy.is-done {
    color: var(--verified);
    border-color: color-mix(in oklab, var(--verified) 45%, transparent);
    background: var(--verified-dim);
  }
  .copy.is-fail {
    color: var(--warn);
    border-color: color-mix(in oklab, var(--warn) 45%, transparent);
  }

  .inst__note {
    margin: var(--s-4) 0 0;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .inst__flag {
    color: var(--warn);
    background: color-mix(in oklab, var(--warn) 12%, transparent);
    border-radius: 4px;
    padding: 1px 5px;
  }

  /* ---------- requirements ---------- */
  .inst__subhead {
    margin: var(--s-12) 0 var(--s-4);
    font-size: var(--t-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-eyebrow);
    color: var(--text-muted);
  }

  .reqs {
    margin: 0;
  }

  .req {
    padding: var(--s-4) 0;
    border-top: 1px solid var(--border);
  }
  .req:last-child {
    border-bottom: 1px solid var(--border);
  }

  .req__k {
    font-size: var(--t-base);
    font-weight: 600;
    color: var(--text);
    letter-spacing: var(--track-head);
  }

  .req__v {
    margin: var(--s-2) 0 0;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  /* ---------- guarantees ---------- */
  .guars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .guar {
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
    padding: var(--s-6);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--ring-top);
  }

  .guar__tick {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--verified);
    background: var(--verified-dim);
    box-shadow: inset 0 0 0 1px
      color-mix(in oklab, var(--verified) 35%, transparent);
  }

  .guar__t {
    margin: 0 0 var(--s-2);
    font-size: var(--t-base);
    font-weight: 600;
    letter-spacing: var(--track-head);
    color: var(--text);
  }

  .guar__d {
    margin: 0;
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--text-muted);
  }

  .inst__foot {
    margin: var(--s-12) 0 0;
    font-size: var(--t-base);
    line-height: var(--lh-body);
    color: var(--text-muted);
    max-width: 62ch;
  }

  /* ---------- responsive ---------- */
  @media (min-width: 60rem) {
    .brk {
      display: inline;
    }
  }

  @media (max-width: 60rem) {
    .inst__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-12);
    }
  }

  @media (max-width: 30rem) {
    .inst {
      padding-block: var(--s-16);
    }
    .term__body {
      padding: var(--s-3);
    }
    .term__line {
      font-size: 0.78rem;
    }
    .guar {
      padding: var(--s-4);
      gap: var(--s-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy {
      transition: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Same copy behaviour as the onboarding section. Buttons are bound exactly once
  // via the data-copy-bound guard, so having both sections on the page is safe.
  function legacyCopy(text: string): boolean {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.top = "-1000px";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    document.body.removeChild(ta);
    return ok;
  }

  async function writeClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        /* fall through to the legacy path */
      }
    }
    return legacyCopy(text);
  }

  function statusRegion(): HTMLElement {
    let el = document.getElementById("copy-status");
    if (!el) {
      el = document.createElement("p");
      el.id = "copy-status";
      el.className = "sr-only";
      el.setAttribute("role", "status");
      el.setAttribute("aria-live", "polite");
      document.body.appendChild(el);
    }
    return el;
  }

  const status = statusRegion();

  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((btn) => {
    if (btn.dataset.copyBound) return;
    btn.dataset.copyBound = "1";

    const label = btn.dataset.label ?? "Copy";
    const txt = btn.querySelector<HTMLElement>(".copy__txt");
    let timer: number | undefined;

    btn.addEventListener("click", async () => {
      const ok = await writeClipboard(btn.dataset.copy ?? "");

      window.clearTimeout(timer);
      btn.classList.remove("is-done", "is-fail");
      btn.classList.add(ok ? "is-done" : "is-fail");
      if (txt) txt.textContent = ok ? "Copied" : "Select + ⌘C";
      status.textContent = ok
        ? "Copied to clipboard"
        : "Copy failed — select the command and press Command-C";

      timer = window.setTimeout(() => {
        btn.classList.remove("is-done", "is-fail");
        if (txt) txt.textContent = label;
        status.textContent = "";
      }, 2000);
    });
  });
</script>
