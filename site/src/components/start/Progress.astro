---
/*
 * The two steps of signup, drawn once at the top of /start.
 *
 * IT IS A LABEL, NOT A CONTROL. Nothing here is clickable and nothing here navigates. A
 * stepper whose numerals are buttons invites a reader to jump ahead before sign-in has
 * happened, and this flow has a server refusal sitting in the middle of it — there is no
 * state where "skip ahead" is a truthful offer.
 *
 * NO STEP IS MARKED CURRENT IN THE SHIPPED HTML. The page's script sets data-state on each
 * item once it knows which state the reader is actually in. Marking step 1 current at build
 * time would be a claim about a session the static file cannot have read, and a returning
 * user would briefly see sign-in as unfinished. Without JavaScript the strip
 * renders as two plain, unmarked labels, which is the honest rendering of "unknown".
 *
 * The <ol> carries the ordering for assistive tech, so the numerals are decoration and are
 * aria-hidden. aria-current="step" is set by the script on the one that is live — that, not
 * the colour, is what a screen reader reads.
 */

const STEPS = [
  { n: 1, label: "Sign in" },
  { n: 2, label: "Create your workspace" },
];
---

<ol class="pg" data-progress aria-label="Getting started">
  {
    STEPS.map((s) => (
      <li class="pg__i" data-step={s.n}>
        <span class="pg__n" aria-hidden="true">
          {s.n}
        </span>
        <span class="pg__l">{s.label}</span>
      </li>
    ))
  }
</ol>

<style>
  .pg {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .pg__i {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    letter-spacing: var(--track-xs);
    color: var(--text-muted);
  }

  /* Same 1.5rem ring /download's badge uses. Repeated UI should keep one visual scale. */
  .pg__n {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--elev-1);
    color: var(--text-muted);
    font-size: var(--t-2xs);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition:
      background var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard),
      color var(--dur-2) var(--ease-standard);
  }

  .pg__i[data-state="current"] {
    color: var(--text);
  }

  .pg__i[data-state="current"] .pg__n {
    background: var(--accent-dim);
    border-color: color-mix(in oklab, var(--accent) 30%, transparent);
    color: var(--accent-bright);
  }

  /* A finished step is stated in the ink as well as in the tick, because "done" carried by
     colour alone disappears in greyscale and under prefers-contrast. The digit is collapsed
     to font-size: 0 rather than removed, so the marker keeps its box while the ::after tick
     supplies the whole of its visible content. */
  .pg__i[data-state="done"] {
    color: var(--text);
  }

  .pg__i[data-state="done"] .pg__n {
    background: var(--success-dim);
    border-color: color-mix(in oklab, var(--success) 30%, transparent);
    color: var(--success);
    font-size: 0;
  }

  .pg__i[data-state="done"] .pg__n::after {
    content: "✓";
    font-size: var(--t-xs);
    line-height: 1;
  }

  @media (max-width: 30rem) {
    .pg {
      gap: var(--s-2) var(--s-4);
    }

    .pg__l {
      font-size: var(--t-2xs);
      line-height: var(--lh-2xs);
    }
  }
</style>
