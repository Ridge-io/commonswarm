---
/*
 * Step 2 — name the workspace.
 *
 * WHY THE ERROR IS A SIBLING OF <Input> AND NOT ITS `error` PROP. Input.astro renders its
 * error paragraph only when the prop is set at BUILD time, which is right for a
 * server-rendered error and useless for one that appears when someone presses Enter on an
 * empty field. So the message element is rendered here, always present and hidden, and the
 * control is pointed at it with an explicit aria-describedby.
 *
 * That wiring works because Input spreads `...rest` LAST onto the control, so an
 * aria-describedby passed in wins over the one it computes. The ids are not guessed: they are
 * written here. Nothing points at an id that does not exist — a dangling reference silently
 * drops the whole description in several screen readers.
 *
 * The skin is the primitive's: .ui-field__msg and .ui-field__msg--error are ui.css's own
 * message styles, reused rather than re-derived, so these cannot drift from the ones Input
 * renders for a build-time error.
 *
 * ---------------------------------------------------------------------------------------
 * WHY THE HINT IS RENDERED HERE TOO, INSTEAD OF BEING PASSED TO <Input hint="...">
 * ---------------------------------------------------------------------------------------
 * Because the hint and the error are the SAME LINE, and a field can only have one.
 *
 * Measured on the built page at 1440 before this changed: submitting an empty name inserted
 * the error as a new paragraph BELOW the hint, and the Back / Create row dropped from a
 * button centre of y=536 to y=561. Twenty-five pixels is enough to make the second click
 * miss the button the reader was already aiming at — which happened during review. The
 * ordering was wrong as well: the neutral hint read first and the correction second.
 *
 * So both messages live in one grid cell, .st-msgs, stacked on top of each other. The cell is
 * as tall as the taller of the two at all times, whichever is showing, so hint → error is a
 * swap and nothing below it moves — ever, at any width, for any message length. Neither is
 * removed from the flow; the one that is not current is hidden with `visibility`, which also
 * takes it out of the accessibility tree.
 *
 * That last part is why the script at the bottom exists. A node referenced DIRECTLY by
 * aria-describedby is read out even when it is hidden (accname §4.1 step 2A makes an explicit
 * exception for it), so "point at both and let CSS decide" would announce the hint and the
 * error together. The control points at exactly one id, and that id follows the swap.
 *
 * VALIDATION IS ONLY WHAT IS TRUE. swarm.workspaces declares `name text NOT NULL` with no
 * length limit and no uniqueness constraint, so this screen must not claim a name is taken or
 * invent a server rule. It checks two things it can actually know — that something was typed,
 * and that it is more than a single character — and leaves the rest to maxlength.
 *
 * `required` is not passed to Input on purpose: the prop draws a red asterisk, which on a
 * one-field form is noise. aria-required carries the same semantics without the glyph.
 */

import Button from "../ui/Button.astro";
import Input from "../ui/Input.astro";
import StepShell from "./StepShell.astro";
---

<StepShell
  step={2}
  titleId="st-2-title"
  title="Name your workspace."
  lede="This is what your team and their agents will see. Something you already say out loud works best."
  hidden
>
  <form class="st-form" data-ws-form novalidate>
    <Input
      label="Workspace name"
      id="ws-name"
      name="workspace"
      placeholder="Acme Web"
      maxlength="48"
      autocomplete="off"
      autocapitalize="words"
      spellcheck="false"
      aria-required="true"
      aria-describedby="ws-name-hint"
      data-autofocus
      data-ws-input
    />

    {/* One row, two messages, one of them showing. See the header note. */}
    <div class="st-msgs">
      <p class="ui-field__msg st-hint" id="ws-name-hint" data-ws-hint>
        Agents pick it by this exact name, so keep it distinct from your other workspaces.
      </p>

      <p
        class="ui-field__msg ui-field__msg--error st-err"
        id="ws-name-error"
        data-ws-error
        aria-live="polite"
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 7.5v5"></path>
          <path d="M12 16.2v.2"></path>
        </svg>
        <span data-ws-error-text></span>
      </p>
    </div>

    <div class="st-row">
      <Button variant="secondary" data-back="1">
        <svg slot="start" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M19 12H6"></path>
          <path d="m11.5 5.8-6.2 6.2 6.2 6.2"></path>
        </svg>
        Back
      </Button>
      <Button type="submit" variant="primary" class="st-grow" data-ws-submit>
        Create workspace
        <svg slot="end" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 12h13"></path>
          <path d="m12.5 5.8 6.2 6.2-6.2 6.2"></path>
        </svg>
      </Button>
    </div>
  </form>
</StepShell>

<script>
  /*
   * The description follows the swap.
   *
   * start.astro's flow controller owns WHEN the error appears — it is the thing that knows
   * whether the name is valid — and it says so the only way a component can read from the
   * outside: by toggling the `hidden` attribute on [data-ws-error]. This component owns how
   * its message row PRESENTS that, which includes which of the two messages the control is
   * described by. Observing the attribute keeps the two responsibilities where they belong
   * instead of teaching the flow controller about this field's internals.
   *
   * Without it the control would announce the hint and the error together (a directly
   * referenced node is read out even while hidden), which is the audible version of the
   * stacking bug this row was rebuilt to fix.
   */
  const wsInput = document.querySelector<HTMLInputElement>("[data-ws-input]");
  const wsError = document.querySelector<HTMLElement>("[data-ws-error]");

  if (wsInput && wsError) {
    const syncDescription = () => {
      wsInput.setAttribute(
        "aria-describedby",
        wsError.hidden ? "ws-name-hint" : "ws-name-error"
      );
    };

    new MutationObserver(syncDescription).observe(wsError, {
      attributeFilter: ["hidden"],
    });
    syncDescription();
  }
</script>

<style>
  .st-form {
    margin-block-start: var(--s-8);
  }

  /*
   * THE MESSAGE ROW. One grid cell, both messages in it, so the row is always as tall as the
   * taller message and the Back / Create row underneath cannot move when one replaces the
   * other. min-block-size is the floor for the case where neither is showing.
   *
   * The row sits inside the field's own vertical rhythm rather than the form's, so it reads
   * as part of the control it belongs to. .ui-field’s gap is --stack-xs; this matches it.
   */
  .st-msgs {
    display: grid;
    min-block-size: 1.25rem;
    margin-block-start: var(--stack-xs);
  }

  .st-msgs > * {
    grid-area: 1 / 1;
  }

  /*
   * visibility, NOT display, on both sides of the swap: display:none would collapse the cell
   * to the height of whichever message is showing and hand back the 25px jump this row was
   * built to remove. visibility also drops the hidden message out of the accessibility tree,
   * which is what makes the aria-describedby swap in the script above honest.
   *
   * The rule has to exist at all because .ui-field__msg--error declares display:flex at
   * author level, which beats the UA's [hidden] rule — [hidden] alone does not hide it.
   */
  .st-err[hidden] {
    display: flex;
    visibility: hidden;
  }

  .st-msgs:has(.st-err:not([hidden])) .st-hint {
    visibility: hidden;
  }

  /*
   * ONE RING, NOT TWO. In the error state the box border goes to --danger while the focus
   * ring stayed --focus, so the field wore a red edge inside an indigo band — two rings in
   * two colours saying one thing. The ring takes the danger colour instead. The near-black
   * halo underneath it is unchanged: tokens.css measures --focus-halo at 7.32:1 on --danger,
   * so the band still reads on the red.
   */
  .st-form :global(.ui-field--error .ui-field__box:focus-within) {
    outline-color: var(--danger);
  }

  .st-row {
    display: flex;
    align-items: center;
    gap: var(--gap-inline);
    margin-block-start: var(--s-6);
  }

  /* The primary takes the remaining width, which also fixes its box: the loading spinner
     appears inside a button that does not change size, so the row never twitches mid-submit. */
  .st-grow {
    flex: 1 1 auto;
  }

  /* Under ~26rem two buttons side by side leave the primary too narrow to read. Reversed so
     the primary is the one under the thumb, and the secondary sits below it. */
  @media (max-width: 26rem) {
    .st-row {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .st-row > :global(.btn) {
      inline-size: 100%;
    }
  }
</style>
