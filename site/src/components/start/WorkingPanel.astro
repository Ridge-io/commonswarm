---
/*
 * The one panel that says "wait".
 *
 * aria-live="polite" is on this element and on no other, because it is the only panel whose
 * TEXT changes without the reader doing anything — "Checking your session", then "Creating
 * your workspace". The panels it hands off to are announced by focus instead, which is the
 * right instrument for a state a press produced.
 *
 * ITS LABEL IS FILLED BY THE SCRIPT AND SHIPS EMPTY. A default of "Loading…" in the HTML
 * would be visible for the few frames before the script runs — and permanently, to a reader
 * with no JavaScript, if this panel were ever shown without one. An empty live region says
 * nothing, which is the truth until the script has something to report.
 *
 * NO PROGRESS BAR AND NO PERCENTAGE. There is one HTTP request behind this and no way to
 * know how far through it is; a bar that fills on a timer is a drawing of progress rather
 * than a report of it.
 */

import "./panel.css";
---

<section
  class="st-pn"
  data-panel="working"
  tabindex="-1"
  aria-live="polite"
  aria-busy="true"
  hidden
>
  <p class="st-pn__busy">
    <span class="st-pn__spin" aria-hidden="true"></span>
    <span data-working-text></span>
  </p>
</section>
