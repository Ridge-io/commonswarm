---
/*
 * One component, the flow's stopping points. The flow uses it wherever it cannot go on.
 *
 * ---------------------------------------------------------------------------------------
 * WHY THESE ARE PANELS AND NOT ERRORS
 * ---------------------------------------------------------------------------------------
 * Some are server decisions, some are fixable account states, and one is a fact about the
 * build. None is a reason to blame the reader:
 *
 *   no-deployment  this static bundle was built without a backend to talk to.
 *   refused        workspace creation is paused on this deployment.
 *   email-*        confirm the address or choose another provider, then continue.
 *   client-too-old reload the current page; nothing was created.
 *   error          something the client could not classify. This one stops and says so.
 *
 * So none of them uses --danger, none says "Error", none uses the word "failed", and none
 * has an exclamation mark or a warning triangle. A red box tells a reader they broke
 * something they did not touch, and the next thing they do is stop trusting the screen.
 * Informational states use --info; ambiguous stops use --warning.
 *
 * ---------------------------------------------------------------------------------------
 * EVERY ONE OF THEM HAS SOMETHING TO DO NEXT
 * ---------------------------------------------------------------------------------------
 * A stop with no exit is a dead end, and /start was already the site's dead end once. The
 * body of each is written by the page, and every one of them ends in a real destination or a
 * real press.
 *
 * ---------------------------------------------------------------------------------------
 * `detail` IS THE CLIENT'S OWN WORDS, NOT OURS
 * ---------------------------------------------------------------------------------------
 * When the page passes detail=true it renders an empty <p> that the script fills with the
 * message off the thrown error — ClientTooOld's own sentence, or whatever the client said.
 * It is boxed and set apart from the copy so a reader can see which words came from the
 * server and which are the page's. It ships EMPTY: a placeholder sentence in the HTML would
 * be a sentence nobody wrote, sitting in the built file, ready to be read as a real message.
 */

import "./panel.css";

interface Props {
  /** The state name the page's script switches on, e.g. "refused". */
  state: string;
  /** --info for "this is how it is", --warning for "this needs something from you". */
  tone: "info" | "warn";
  /** Small uppercase label above the heading, e.g. "Not open yet". */
  eyebrow: string;
  /** The heading. State the situation, never the reader's mistake. */
  title: string;
  /** Render an empty <p data-halt-detail> for the script to fill from the thrown error. */
  detail?: boolean;
}

const { state, tone, eyebrow, title, detail = false } = Astro.props;
const id = `pn-halt-${state}`;
---

<section
  class:list={["st-pn", tone === "info" ? "st-pn--info" : "st-pn--warn"]}
  data-panel={state}
  tabindex="-1"
  aria-labelledby={id}
  hidden
>
  <span class="st-pn__eyebrow">{eyebrow}</span>
  <h2 class="st-pn__t" id={id}>{title}</h2>
  <slot />
  {detail && <p class="st-pn__detail" data-halt-detail hidden />}
</section>
