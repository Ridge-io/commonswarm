---
/*
 * The workspace exists, so /start is finished. start.astro reveals this one-line fallback,
 * then replaces the current history entry with /app. The link remains if navigation is
 * interrupted; /app owns the durable accessible state after the handoff.
 */

import "./panel.css";
---

<section class="st-pn" data-panel="done" hidden>
  <p class="st-pn__p" role="status">
    Your workspace is ready. Opening your dashboard… <a href="/app">Open it now</a>.
  </p>
</section>
