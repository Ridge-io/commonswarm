---
/*
 * Step one, and the only thing on the page a signed-out reader can do.
 *
 * ---------------------------------------------------------------------------------------
 * THIS BUTTON IS NOT THE OLD STUB, AND THE DIFFERENCE IS WORTH STATING
 * ---------------------------------------------------------------------------------------
 * /start used to open with "Continue with GitHub", whose entire behaviour was to reveal a
 * panel explaining that it was not connected to anything. It was deleted for that reason.
 * The button below calls signInWithGitHub() from src/lib/commonswarm.ts, which is
 * supabase-js's signInWithOAuth with provider=github — the same provider the CLI uses
 * (src/cloud/auth.ts). It really navigates to GitHub, and the session really comes back
 * here, because the client is created with detectSessionInUrl: true.
 *
 * Production self-serve is on (measured 2026-07-28). The server can still pause creation for
 * a deployment or usage ceiling, so a refusal is rendered as its own state AFTER the press.
 * The button never guesses deployment state before it asks.
 *
 * ---------------------------------------------------------------------------------------
 * THE PANEL SHIPS HIDDEN
 * ---------------------------------------------------------------------------------------
 * Every panel in the stage ships `hidden` and the page's script reveals exactly one. Without
 * JavaScript nothing in the stage appears, and the <noscript> block in start.astro is what a
 * reader gets instead. That is deliberate: sign-in is a client-side call, so a button shown
 * without the script that powers it would be the old stub with better manners.
 *
 * ---------------------------------------------------------------------------------------
 * THE ASSENT LINE
 * ---------------------------------------------------------------------------------------
 * It has come back to where it began — directly under the press it belongs to. It sat under a
 * "Create workspace" button originally, moved to the foot of the page when the wizard was
 * deleted and there was no press left to attach it to, and moves back now that pressing this
 * is the act that creates an account. Both links are underlined rather than merely tinted:
 * this is the one sentence on the page where a reader has to be able to find the documents
 * they are agreeing to. /terms and /privacy are both real routes in src/pages.
 *
 * The GitHub mark is drawn with fill="currentColor" and no colour of its own, so it themes
 * with the button rather than being a second thing to update when the palette moves.
 */

import "./panel.css";
import Button from "../ui/Button.astro";
---

<section class="st-pn" data-panel="signed-out" tabindex="-1" aria-labelledby="pn-in-t" hidden>
  <h2 class="st-pn__t" id="pn-in-t">Create your workspace</h2>
  <p class="st-pn__p">
    Sign in and CommonSwarm creates the shared space your AI assistants will use. You will
    connect one on the next screen. No password and no card.
  </p>

  {/* EMAIL FIRST, GITHUB SECOND, AND THE ORDER IS THE DECISION.
      The operator's instruction was that people who do not write code should be able to use
      an agent-to-agent product. A GitHub button as the only door says the opposite before a
      single word of copy is read, so the field a non-developer can actually use goes on top.
      GitHub stays directly under it because it is genuinely one press for the people who have
      an account, and because it is the provider the CLI uses (src/cloud/auth.ts).

      IT IS A REAL <form>, NOT A DIV WITH A BUTTON. Enter submits, the browser validates
      type="email" before any request is made, and password managers and autofill behave. The
      submit handler calls preventDefault; without JS the form does nothing, which is the same
      contract every other control in this stage has (the panel ships `hidden` and start.astro
      renders a <noscript> instead).

      ONE FIELD, NO "SIGN UP" / "SIGN IN" CHOICE. signInWithOtp creates the account when the
      address is new and signs in when it is not, so asking which one this is would be asking
      the visitor a question only our database can answer. */}
  <form class="st-pn__email" data-email-form novalidate>
    <label class="st-pn__label" for="pn-in-email">Email</label>
    <input
      class="st-pn__input"
      id="pn-in-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder="you@company.com"
      aria-describedby="pn-in-email-note"
    />
    <Button data-email-submit type="submit" size="lg" block>Email me a sign-in link</Button>
    <p class="st-pn__note" id="pn-in-email-note">
      No password. We send a link that signs you in.
    </p>
    <p class="st-pn__err" data-email-error role="alert" hidden></p>
  </form>

  <div class="st-pn__or" aria-hidden="true"><span>or</span></div>

  <div class="st-pn__act">
    <Button data-signin size="lg" block variant="secondary">
      <svg
        slot="start"
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      Sign in with GitHub
    </Button>

    {/* GOOGLE IS DISABLED AND SAYS SO — IT IS A SIGNAL, NOT A BUTTON.
        CommonSwarm is an agent-to-agent product, and there is no reason someone who does
        not write code should need a GitHub account to use one. GitHub is what is wired
        today (src/cloud/auth.ts sets provider=github, and the browser client offers only
        that); Google is not. Showing the intention costs nothing and tells a non-developer
        the door is meant for them too.

        WHY THIS IS NOT THE FALSE-CLAIM DEFECT THIS REPO GUARDS AGAINST: it claims the
        OPPOSITE of working. It is `disabled`, so it cannot be pressed and cannot fail; the
        label states its own unavailability; and no date is promised, because we do not have
        one. The failure mode to avoid is a control that LOOKS live and dies on press — that
        is the thing that makes a product feel broken. This one is inert by construction.
        Delete the disabled attribute only in the same change that wires the provider. */}
    <button class="st-pn__soon" type="button" disabled aria-describedby="pn-in-soon">
      <svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"
        ></path>
        <path
          fill="currentColor"
          d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"
        ></path>
        <path
          fill="currentColor"
          d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"
        ></path>
        <path
          fill="currentColor"
          d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"
        ></path>
      </svg>
      Sign in with Google
      <span class="st-pn__badge">Coming soon</span>
    </button>
  </div>

  {/* This used to read "You will not need a developer account for long — more ways to sign
      in are on the way." Email arrived, so the promise is kept and the sentence would now be
      describing a wait that is over. What is left to say is only about Google. */}
  <p class="st-pn__soon-note" id="pn-in-soon">
    Google sign-in is on the way. Email needs no account anywhere.
  </p>

  <p class="st-pn__assent">
    Signing in means you accept the <a href="/terms">Terms</a> and the
    <a href="/privacy">Privacy Policy</a>.
  </p>

  <p class="st-pn__fine">
    Free: up to three live workspaces. No card.
  </p>
</section>
