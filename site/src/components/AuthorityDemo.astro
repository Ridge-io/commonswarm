---
/**
 * DEAD FILE — NOT IMPORTED BY ANY PAGE OR COMPONENT, AND NOT REBRANDED.
 *
 * Enumerated during the CommonSwarm rename: nothing under site/src imports this file, so
 * nothing below it reaches a browser. It was left at the OLD name on purpose. Two reasons,
 * and the second is the real one:
 *
 *   1. Rebranding copy that renders nowhere spends risk for no reader.
 *   2. Several of these files carry the retired "authority / on the record" framing that the
 *      operator explicitly killed (see AGENTS.md, "Writing for users"). Giving that copy the
 *      new name would make dead, superseded positioning look current and maintained — which
 *      is exactly how it gets re-imported by someone skimming for a section to reuse.
 *
 * So a grep of site/src for "coswarm" still hits this file, BY DESIGN. That is not an unfinished
 * rename; it is a file that should be deleted rather than renamed. The live equivalents are
 * the components/landing/ and components/download/ directories,, SiteHeader.astro and SiteFooter.astro.
 *
 * Deletion is the Lead's call, not this pass's.
 */

/**
 * AuthorityDemo.astro — the interactive centrepiece.
 *
 * Workbench.md's demo shows a markdown pane rendering live to a board. That is a
 * demo of *convenience*. This is a demo of the thing they structurally cannot show:
 * that an agent's authority is minted, scoped and expiring, and that every outcome —
 * including every refusal — is written down.
 *
 * It is an ILLUSTRATION, not a client. No network, no framework, no external assets.
 * But the rules it enforces are the real ones, lifted from the shipped protocol core:
 *
 *   src/protocol/commands.ts            acquire / renew / handoff / takeover / submit
 *                                       and the exact rejection strings below
 *   src/protocol/workspace-commands.ts  principals, mint_agent_token, scope checks
 *   src/protocol/events.ts              the canonical event envelope + event names
 *   supabase/functions/command/index.ts scope gate (403), connect-command gate (403),
 *                                       swarm.audit_log rows for authz outcomes
 *   supabase/migrations/…_p1_schema.sql "Append-only audit and security signals"
 *
 * Two things are deliberately modelled, because they are the honest shape of the
 * system and a vaguer demo would be a lie:
 *   1. A DOMAIN refusal commits a CommandRejected event to the same append-only
 *      stream as the successes ("A domain rejection is itself a committed event
 *      (visible history, §2.1)" — commands.ts).
 *   2. An AUTHZ refusal never reaches the stream. It lands in swarm.audit_log.
 *      Nothing is dropped, but the two records are not the same record.
 */

import "../styles/hero.css";
---

<section class="ad" id="authority-demo" aria-labelledby="ad-title">
  <div class="page">
    <div class="ad__head">
      <p class="eyebrow">Try it &middot; the record is the product</p>
      <h2 class="ad__title" id="ad-title">
        Ask the agent to do something it was never granted. <em>Watch the refusal get
        written down.</em>
      </h2>
      <p class="lede ad__sub">
        One agent run, holding one minted token with a set of scopes and a TTL.
        Press anything on the left. Allowed work appends a sequenced event. Refused work
        appends a record of the refusal — because "it was denied" is the fact you will
        actually need at 2am.
      </p>
    </div>

    <div class="card ad__frame">
      <header class="ad__bar">
        <span class="ad__live">
          <span class="ad__live-dot" aria-hidden="true"></span>
          live
        </span>
        <span class="ad__bar-name">workspace payments &middot; append-only record</span>
        <span class="ad__note">illustrative &mdash; no network calls</span>
      </header>

      <noscript>
        <p class="ad__noscript">
          This demo needs JavaScript to run. Nothing is fetched either way &mdash; the whole
          thing is a few hundred lines of local state. The record below shows its opening
          position.
        </p>
      </noscript>

      <div class="ad__grid">
        <div class="ad__left">
          <div class="ad__token">
            <div class="ad__token-head">
              <span class="ad__token-label">Presented credential</span>
              <span class="ad__pill" id="ad-token-state" data-state="live">live 60:00</span>
            </div>
            <dl class="ad__kv">
              <dt>principal</dt>
              <dd>builder-2</dd>
              <dt>run</dt>
              <dd>4f1c&hellip;9a2b</dd>
              <dt>task</dt>
              <dd>pay-webhook</dd>
              <dt>epoch</dt>
              <dd id="ad-token-epoch">0</dd>
              <dt>scopes</dt>
              <dd id="ad-token-scopes">
                <span class="ad__scope">acquire</span><span class="ad__scope">submit</span><span
                  class="ad__scope">post_signal</span>
              </dd>
            </dl>
          </div>

          <div class="ad__group">
            <p class="ad__group-label">builder-2 acts on that token</p>
            <button class="ad__act" type="button" data-act="signal">
              <span class="ad__act-kind">post_signal</span>
              <span class="ad__act-what">say what it is working on</span>
            </button>
            <button class="ad__act" type="button" data-act="acquire">
              <span class="ad__act-kind">acquire</span>
              <span class="ad__act-what">claim the lease on pay-webhook</span>
            </button>
            <button class="ad__act" type="button" data-act="submit">
              <span class="ad__act-kind">submit</span>
              <span class="ad__act-what">submit a branch with evidence</span>
            </button>
            <button class="ad__act" type="button" data-act="takeover">
              <span class="ad__act-kind">takeover</span>
              <span class="ad__act-what">take a lease it does not hold</span>
            </button>
            <button class="ad__act" type="button" data-act="invite">
              <span class="ad__act-kind">invite_member</span>
              <span class="ad__act-what">invite a human to the workspace</span>
            </button>
          </div>

          <div class="ad__group">
            <p class="ad__group-label">Meanwhile, elsewhere</p>
            <button class="ad__act" type="button" data-act="scout-takeover" data-actor="human">
              <span class="ad__act-kind">scout</span>
              <span class="ad__act-what">another agent takes the task</span>
            </button>
            <button class="ad__act" type="button" data-act="scout-handoff" data-actor="human">
              <span class="ad__act-kind">scout</span>
              <span class="ad__act-what">hands the lease back to builder-2</span>
            </button>
            <button class="ad__act" type="button" data-act="expire" data-actor="human">
              <span class="ad__act-kind">clock</span>
              <span class="ad__act-what">fast-forward past the token's TTL</span>
            </button>
            <button class="ad__act" type="button" data-act="mint" data-actor="human">
              <span class="ad__act-kind">tom</span>
              <span class="ad__act-what">a human mints a fresh token</span>
            </button>
          </div>
        </div>

        <div class="ad__right">
          <div class="ad__feed-head">
            <p class="ad__feed-title">The record &mdash; append only</p>
            <span class="ad__count" id="ad-count">3 entries</span>
          </div>
          <!-- The scroll box is sized by the action column beside it, never by its own
               contents — otherwise the frame would grow without bound as entries append. -->
          <div class="ad__feed-scroll">
            <ol
              class="ad__feed"
              id="ad-feed"
              tabindex="0"
              aria-live="polite"
              aria-label="Append-only record of every attempted action"
            >
            </ol>
          </div>
        </div>
      </div>

      <footer class="ad__legend">
        <p class="ad__legend-item" data-kind="ok">
          <span class="ad__legend-swatch" aria-hidden="true"></span>
          <span
            ><b>Verified</b>The command was authorised. A sequenced event is appended to the
            stream.</span
          >
        </p>
        <p class="ad__legend-item" data-kind="rejected">
          <span class="ad__legend-swatch" aria-hidden="true"></span>
          <span
            ><b>Refused &mdash; on the stream</b>A domain refusal is itself a committed
            <code class="mono">CommandRejected</code> event, sitting in the same history as the
            successes.</span
          >
        </p>
        <p class="ad__legend-item" data-kind="authz">
          <span class="ad__legend-swatch" aria-hidden="true"></span>
          <span
            ><b>Refused &mdash; on the audit log</b>An authorisation failure never enters the
            stream. It is written to <code class="mono">swarm.audit_log</code>, which is also
            append-only.</span
          >
        </p>
      </footer>
    </div>

    <div class="ad__foot">
      <p class="ad__caption">
        Illustrative. This runs entirely in your browser with no network calls and no live
        backend behind it &mdash; but the rules, the event names, the scope gate and the
        refusal strings are the ones the shipped protocol core actually enforces.
      </p>
      <button class="ad__reset" type="button" id="ad-reset">Restart the illustration</button>
    </div>
  </div>
</section>

<script>
  type Kind = "ok" | "rejected" | "authz" | "authn";

  interface Entry {
    kind: Kind;
    type: string;
    lane: string;
    detail: string;
    meta: [string, string][];
  }

  const root = document.getElementById("authority-demo");
  const feed = document.getElementById("ad-feed");
  const count = document.getElementById("ad-count");
  const tokenState = document.getElementById("ad-token-state");
  const tokenEpoch = document.getElementById("ad-token-epoch");

  if (root && feed && count && tokenState && tokenEpoch) {
    const TTL_MS = 60 * 60 * 1000; // AGENT_TOKEN_DEFAULT_TTL_MS — 1h (max is 8h)
    const LEASE_MS = 30 * 60 * 1000;
    const RUN = "4f1c…9a2b";
    const SCOPES = ["acquire", "submit", "post_signal"];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    interface State {
      wsSeq: number;
      taskSeq: number;
      epoch: number;
      owner: string | null;
      leaseLive: boolean;
      submitted: boolean;
      presented: number; // the epoch builder-2's token is bound to
      expiresAt: number;
      entries: number;
    }

    let state: State;
    let ticker: ReturnType<typeof setInterval> | undefined;

    const clock = () =>
      new Date().toLocaleTimeString("en-GB", { hour12: false });

    const el = (tag: string, cls?: string, text?: string) => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    function append(entry: Entry) {
      const li = el("li", "ad__entry");
      li.dataset.kind = entry.kind;

      const body = el("div", "ad__entry-body");
      const top = el("div", "ad__entry-top");

      const verdict =
        entry.kind === "ok"
          ? "verified"
          : entry.kind === "authn"
            ? "no actor"
            : "refused";
      top.append(el("span", "ad__verdict", verdict));
      top.append(el("span", "ad__type", entry.type));
      top.append(el("span", "ad__lane", entry.lane));
      top.append(el("span", "ad__time", clock()));
      body.append(top);

      body.append(el("div", "ad__detail", entry.detail));

      if (entry.meta.length) {
        const meta = el("div", "ad__meta");
        for (const [key, value] of entry.meta) {
          const span = el("span");
          span.append(el("b", undefined, key + " "));
          span.append(document.createTextNode(value));
          meta.append(span);
        }
        body.append(meta);
      }

      li.append(body);
      feed!.append(li);

      state.entries += 1;
      count!.textContent = `${state.entries} ${state.entries === 1 ? "entry" : "entries"}`;
      feed!.scrollTo({ top: feed!.scrollHeight, behavior: reduceMotion ? "auto" : "smooth" });
    }

    /* --- the three record destinations ------------------------------------- */

    // Accepted task command → a sequenced event on the task stream.
    const taskEvent = (type: string, detail: string, meta: [string, string][] = []) =>
      append({
        kind: "ok",
        type,
        lane: `task:pay-webhook · seq ${++state.taskSeq}`,
        detail,
        meta,
      });

    // Accepted workspace command → a sequenced event on the workspace stream.
    const wsEvent = (type: string, detail: string, meta: [string, string][] = []) =>
      append({
        kind: "ok",
        type,
        lane: `workspace · seq ${++state.wsSeq}`,
        detail,
        meta,
      });

    // Domain refusal → CommandRejected, committed to the very same stream.
    const rejected = (
      command: string,
      reason: string,
      detail: string,
      actor = "builder-2",
    ) =>
      append({
        kind: "rejected",
        type: `CommandRejected · ${reason}`,
        lane: `task:pay-webhook · seq ${++state.taskSeq}`,
        detail,
        meta: [
          ["command", command],
          ["principal", actor],
          ["reason", reason],
        ],
      });

    // Authz refusal → 403, audit_log only. Never a stream event.
    const forbidden = (command: string, detail: string) =>
      append({
        kind: "authz",
        type: "403 forbidden",
        lane: "swarm.audit_log",
        detail,
        meta: [
          ["command", command],
          ["outcome", "authz"],
          ["reason", "forbidden"],
          ["principal", "builder-2"],
        ],
      });

    // Expired/unknown credential → 401 before any principal is resolved.
    const unauthenticated = (command: string) =>
      append({
        kind: "authn",
        type: "401 unauthenticated",
        lane: "server log only",
        detail:
          "The token's TTL has passed, so the request never resolved to a principal. There is no actor to attribute it to, so nothing is written to the workspace record at all — the request is refused at the door.",
        meta: [
          ["command", command],
          ["credential", "expired"],
        ],
      });

    /* --- the token card ---------------------------------------------------- */

    function paintToken() {
      const remaining = Math.max(0, state.expiresAt - Date.now());
      const expired = remaining === 0;
      const mm = String(Math.floor(remaining / 60000)).padStart(2, "0");
      const ss = String(Math.floor((remaining % 60000) / 1000)).padStart(2, "0");
      tokenState!.dataset.state = expired ? "expired" : "live";
      tokenState!.textContent = expired ? "expired" : `live ${mm}:${ss}`;
      tokenEpoch!.textContent = String(state.presented);
    }

    const expired = () => Date.now() >= state.expiresAt;

    /* --- actions ----------------------------------------------------------- */

    // Every branch below mirrors a real check, in the real order.
    const actions: Record<string, () => void> = {
      // post_signal: in scope, always available to a live token.
      signal() {
        if (expired()) return unauthenticated("post_signal");
        append({
          kind: "ok",
          type: "post_signal",
          lane: "signals",
          detail: 'working-on — "wiring the payments webhook"',
          meta: [
            ["principal", "builder-2"],
            ["about", "pay-webhook"],
            ["until", "+8h"],
            ["outcome", "accepted"],
          ],
        });
      },

      // acquire: scope holds; the state machine decides the rest.
      acquire() {
        if (expired()) return unauthenticated("acquire");
        if (state.leaseLive && state.owner === "builder-2") {
          return rejected(
            "acquire",
            "not_acquirable",
            "It already holds a live lease. Re-claiming is refused: lease is live; use takeover.",
          );
        }
        if (state.leaseLive) {
          return rejected(
            "acquire",
            "not_acquirable",
            `The lease is live and held by ${state.owner}. Refused: lease is live; use takeover.`,
          );
        }
        state.epoch += 1;
        state.owner = "builder-2";
        state.leaseLive = true;
        state.presented = state.epoch;
        paintToken();
        taskEvent(
          "LeaseAcquired",
          `builder-2 holds the lease on pay-webhook at epoch ${state.epoch}.`,
          [
            ["principal", "builder-2"],
            ["run", RUN],
            ["epoch", String(state.epoch)],
            ["lease", `+${LEASE_MS / 60000}m`],
          ],
        );
      },

      // submit: owner first, then epoch, then liveness — the real order in decide().
      submit() {
        if (expired()) return unauthenticated("submit");
        if (state.owner !== "builder-2") {
          return rejected(
            "submit",
            "not_owner",
            state.owner === null
              ? "Nobody holds the lease on pay-webhook. Refused: only the lease owner may submit."
              : `${state.owner} holds the lease. Refused: only the lease owner may submit.`,
          );
        }
        if (state.presented !== state.epoch) {
          return rejected(
            "submit",
            "stale_epoch",
            `Refused: presented epoch ${state.presented} != current ${state.epoch}. The token was minted against an older lease — mint a fresh one bound to the current epoch.`,
          );
        }
        if (!state.leaseLive) {
          return rejected(
            "submit",
            "lease_expired",
            "Refused: lease expired; re-acquire before submitting.",
          );
        }
        state.submitted = true;
        taskEvent(
          "TaskSubmitted",
          "branch fix/pay-webhook-retry at 9f2ad1c, with the evidence bundle frozen against that SHA.",
          [
            ["principal", "builder-2"],
            ["epoch", String(state.epoch)],
            ["evidence", "e2e, typecheck"],
          ],
        );
      },

      // takeover: NOT one of the token's scopes. The edge refuses before the
      // task state machine is ever consulted, so this never reaches the stream.
      takeover() {
        if (expired()) return unauthenticated("takeover");
        forbidden(
          "takeover",
          `The presented token carries ${SCOPES.join(", ")}. takeover is not among them, so the command is refused at the edge and the task's state machine is never asked.`,
        );
      },

      // invite_member: a connect command. No agent credential may ever carry it,
      // at any scope — this one is categorical, not configuration.
      invite() {
        if (expired()) return unauthenticated("invite_member");
        forbidden(
          "invite_member",
          "invite_member is a connect command: membership and credential authority require an interactive human credential. No agent token can be minted with this scope, at any privilege level.",
        );
      },

      // Another agent takes the task. With a live lease this needs a takeover
      // grant bound to the current epoch and issued to that agent.
      "scout-takeover"() {
        const granted = state.leaseLive;
        state.epoch += 1;
        state.owner = "scout";
        state.leaseLive = true;
        taskEvent(
          "LeaseTakenOver",
          granted
            ? `scout took the live lease at epoch ${state.epoch}, presenting a takeover grant bound to the previous epoch and issued to scout.`
            : `The lease was not live, so scout simply claimed it at epoch ${state.epoch}.`,
          [
            ["principal", "scout"],
            ["epoch", String(state.epoch)],
            ["grant", granted ? "g_2b7e" : "none"],
          ],
        );
        paintToken();
      },

      // Handing the lease back advances the epoch again — which is exactly how a
      // still-valid token becomes stale without anyone doing anything wrong.
      "scout-handoff"() {
        if (state.owner !== "scout" || !state.leaseLive) {
          return rejected(
            "handoff",
            "not_owner",
            "scout does not hold a live lease on pay-webhook. Refused: only the lease owner may hand off.",
            "scout",
          );
        }
        state.epoch += 1;
        state.owner = "builder-2";
        taskEvent(
          "LeaseHandedOff",
          `scout handed the lease to builder-2 at epoch ${state.epoch}. builder-2's token is still bound to epoch ${state.presented}.`,
          [
            ["from", "scout"],
            ["to", "builder-2"],
            ["epoch", String(state.epoch)],
          ],
        );
        paintToken();
      },

      expire() {
        state.expiresAt = Date.now();
        paintToken();
        append({
          kind: "authn",
          type: "token TTL reached",
          lane: "no entry",
          detail:
            "The token simply stops working. Nothing is revoked, nothing is written — expiry is the absence of an event, which is why the TTL is short and the mint is cheap.",
          meta: [
            ["principal", "builder-2"],
            ["ttl", "1h"],
          ],
        });
      },

      // Minting requires a human credential, and binds the new token to the
      // current run, task and epoch.
      mint() {
        state.expiresAt = Date.now() + TTL_MS;
        state.presented = state.epoch;
        paintToken();
        wsEvent(
          "AgentTokenMinted",
          `tom minted a token for builder-2, bound to run ${RUN}, task pay-webhook and epoch ${state.epoch}.`,
          [
            ["minted_by", "tom (human)"],
            ["scopes", SCOPES.join(" ")],
            ["ttl", "1h"],
            ["expires_at", "+60:00"],
          ],
        );
      },
    };

    /* --- boot / reset ------------------------------------------------------ */

    function reset() {
      state = {
        wsSeq: 87,
        taskSeq: 11,
        epoch: 0,
        owner: null,
        leaseLive: false,
        submitted: false,
        presented: 0,
        expiresAt: Date.now() + TTL_MS,
        entries: 0,
      };
      feed!.replaceChildren();

      wsEvent("AgentPrincipalCreated", "tom created the agent principal builder-2.", [
        ["owner", "tom (human)"],
        ["principal", "builder-2"],
      ]);
      wsEvent(
        "AgentTokenMinted",
        `tom minted a token for builder-2, bound to run ${RUN}, task pay-webhook and epoch 0.`,
        [
          ["scopes", SCOPES.join(" ")],
          ["ttl", "1h"],
        ],
      );
      taskEvent("TaskCreated", 'pay-webhook — "wire the payments webhook".', [
        ["created_by", "tom (human)"],
        ["slug", "pay-webhook"],
      ]);

      paintToken();
    }

    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>(".ad__act");
      if (!button || !root.contains(button)) return;
      const act = button.dataset.act;
      if (act && actions[act]) actions[act]();
    });

    document.getElementById("ad-reset")?.addEventListener("click", reset);

    reset();
    ticker = setInterval(paintToken, 1000);
    window.addEventListener("pagehide", () => {
      if (ticker) clearInterval(ticker);
    });
  }
</script>
