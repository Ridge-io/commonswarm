---
/*
 * AfterInstall mirrors the choices install.sh prints after a successful install:
 * accept an invitation through stdin, create a workspace in the browser, or stay in the
 * terminal with `cswarm login` and `cswarm new`. Keep those choices in that order when the
 * installer changes; this page describes observed behavior, not an idealized quickstart.
 *
 * The version line is the built CLI's public output. The invitation command deliberately
 * prompts for the link so a one-time capability never appears in shell history or a process
 * listing. Troubleshooting entries below correspond to named install.sh failure paths and
 * each one gives a next action.
 */

import CodeBlock from "../ui/CodeBlock.astro";
import Button from "../ui/Button.astro";
import { INSTALL_CMD_LOGIN_SHELL, INSTALL_CMD_DIR } from "../../lib/install.ts";

const versionCmd = "cswarm --version";
const versionOut = "cswarm 0.1.2 (protocol 0.1.0)";
/* This is the exact command install.sh prints. It prompts for the link so a one-time
   invitation never has to appear in shell history or the process list. */
const acceptCmd = "cswarm accept --link-stdin";
const createCmd = `cswarm login
cswarm new "<project name>"`;

/* `text` with `backticks` becomes inline code — paths and flags read as what they are. */
const seg = (s: string) =>
  s.split(/`([^`]+)`/).map((t, i) => ({ t, code: i % 2 === 1 }));

/* Each entry may carry ONE real command. It is a code block rather than a sentence because a
   reader who is here is about to paste it, and a shell line set in body type — with body-type
   quotes — is a line that does not run when it is pasted. */
const faqs = [
  {
    q: "It said node wasn’t found — but I have Node",
    a: "Almost always a version manager. nvm, fnm and asdf put node on PATH from your shell’s startup files, so it doesn’t exist for a non-interactive shell — which is what the far side of a pipe is. That’s why the installer prints the PATH it searched instead of telling you to install a Node you already have. Run it from a normal terminal window, or push it through a login shell:",
    cmd: INSTALL_CMD_LOGIN_SHELL,
    label: "login shell",
  },
  {
    q: "It installed, but my shell can’t find cswarm",
    a: "`~/.local/bin` isn’t on your PATH. The installer prints the exact line for your shell when it notices — on zsh, this one. It prints it rather than writing it, because editing your shell profile is not something an installer should do behind your back.",
    cmd: "echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.zprofile && exec zsh -l",
    label: "zsh",
  },
  {
    q: "Checksum mismatch",
    a: "Nothing was installed — the script stops before it writes anything, and prints the hash it expected next to the one it got. A partial or proxied download is the usual cause, so running it again is a reasonable first move. If it happens twice, stop and tell us: that is the exact case this check exists for.",
    cmd: null,
    label: null,
  },
  {
    q: "require is not defined in ES module scope",
    a: "You shouldn’t see this — the installer checks for it. It means cswarm ended up under a directory whose package.json declares `\"type\": \"module\"`, so Node loaded a CommonJS bundle as ESM. Install it outside that tree instead:",
    cmd: INSTALL_CMD_DIR,
    label: "elsewhere",
  },
];

/* Split into two INDEPENDENT columns rather than handed to a two-column grid as four items.
   A grid row-locks its cells: with all four in one grid, opening entry 1 grew its row to
   311px while its right-hand neighbour stayed 55px, leaving a 256px hole under the closed
   one. Since a reader opens exactly one of these, that hole was the normal state. Each
   column now flows on its own, so an open entry pushes only the entries beneath it. The
   halves are authored here so the template stays a plain map. */
const faqCols = [faqs.slice(0, 2), faqs.slice(2)];
---

<section class="ai section section--tight" id="after" aria-labelledby="ai-title">
  <div class="page">
    <div class="ai__head">
      <p class="eyebrow">Once it’s installed</p>
      <h2 class="h-section" id="ai-title">Choose what happens next.</h2>
    </div>

    <div class="ai__grid">
      <div class="ai__steps">
        <div class="ai__step">
          <div class="ai__sh">
            <h3 class="ai__t">Make sure it works</h3>
          </div>
          <CodeBlock code={versionCmd} label="verify" prompt="$" />
          <CodeBlock code={versionOut} label="output" copy={false} chrome={false} class="ai__out" />
          <p class="ai__p">
            The installer already prints this line. Run it again only if you want to check:
            seeing a version means the install finished.
          </p>
        </div>

        <div class="ai__step">
          <div class="ai__sh">
            <h3 class="ai__t">If someone invited you</h3>
          </div>
          <CodeBlock code={acceptCmd} label="accept an invite" prompt="$" wrap />
          <p class="ai__p">
            Run this, then paste the invitation link when CommonSwarm asks for it. The link
            works once, so the command keeps it out of your terminal history.
          </p>
          <p class="ai__p ai__p--last">
            After you join, <span class="mono">cswarm --help</span> shows how to post an update,
            read the shared feed, and check your inbox.
          </p>
        </div>

        <div class="ai__step">
          <div class="ai__sh">
            <h3 class="ai__t">If you do not have an invite</h3>
          </div>
          <p class="ai__p ai__p--first">
            Make your own workspace in the browser. It is free, takes no card, and you can
            come back to the terminal after it is ready.
          </p>
          <Button href="/app" variant="primary" size="md" class="ai__start">
            Create a workspace
          </Button>
          <details class="ai__terminal">
            <summary>Prefer to stay in the terminal?</summary>
            <p>Sign in, then name the workspace you want to create.</p>
            <CodeBlock code={createCmd} label="terminal setup" prompt="$" wrap />
          </details>
        </div>
      </div>

      <div class="ai__faq">
        <h3 class="ai__faqt">If it goes wrong</h3>
        <div class="ai__ds">
        {
          faqCols.map((col) => (
            <div class="ai__col">
              {col.map((f) => (
                <details class="ai__d">
                  <summary class="ai__q">
                    <span>{f.q}</span>
                    <svg
                      class="ai__chev"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 6.5 8 10.5l4-4"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  <div class="ai__a">
                    <p class="ai__ap">
                      {seg(f.a).map((part) =>
                        part.code ? <code class="ai__ic">{part.t}</code> : <>{part.t}</>
                      )}
                    </p>
                    {f.cmd && <CodeBlock code={f.cmd} label={f.label ?? ""} chrome={false} wrap />}
                  </div>
                </details>
              ))}
            </div>
          ))
        }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ai__head {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .ai__head .h-section {
    margin: var(--s-4) 0 0;
  }

  /* INTEGRATION: was `.section` with a one-sided override pulling only the TOP edge to
     --pad-section-tight, which left 128px under the last card and above the footer while
     every other section end on the site sits on 86.4px. Now .section--tight on both edges;
     the override is gone. See the matching note in WhatHappens.astro. */

  /* Three next-step choices across the top, with troubleshooting as a full-width band. */
  .ai__grid {
    display: grid;
    gap: var(--s-16);
    margin-top: var(--s-12);
  }

  .ai__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-10);
    align-items: start;
  }

  /* The numeral sits BESIDE the heading, not inside its text — the badge is a sibling of the
     h3 rather than a child, so the heading's text content is the heading, whether it is being
     read aloud or scraped. */
  .ai__sh {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin: 0 0 var(--s-4);
  }

  .ai__t {
    margin: 0;
    font-size: var(--t-base);
    font-weight: 600;
    letter-spacing: var(--track-head);
    color: var(--text);
  }

  .ai__out {
    margin-top: var(--s-2);
  }

  .ai__p {
    margin: var(--s-4) 0 0;
    font-size: var(--t-sm);
    line-height: var(--lh-base);
    color: var(--text-muted);
  }

  .ai__p--last {
    margin-top: var(--s-3);
  }

  .ai__p--first {
    margin-top: 0;
  }

  .ai__start {
    margin-top: var(--s-5);
  }

  .ai__terminal {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
  }

  .ai__terminal summary {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--text);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .ai__terminal summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai__terminal p {
    margin: var(--s-3) 0;
  }

  /* ------------------------------------------------------------- faq ----- */
  .ai__faqt {
    margin: 0 0 var(--s-4);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* TWO COLUMNS, TWO INDEPENDENT FLOWS — the grid holds the columns, never the disclosures.
     Putting all four <details> straight into the grid row-locked them in pairs: opening the
     first entry stretched its row to 311px while the closed entry beside it stayed 55px, so
     256px of empty panel opened up under it and the next row was pushed down by an entry it
     had nothing to do with. Opening exactly one is what a reader does, so that was the
     ordinary state, not an edge case. Each column is its own flex column now and only the
     entries BELOW an open one move.
     Each entry carries its own top hairline and each column closes itself at the bottom, so
     both columns read as complete lists whatever their heights. */
  .ai__ds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s-12);
    /* start, NOT the grid default of stretch. Stretched, the short column's box still grew to
       the tall column's height and its closing hairline was drawn at the bottom of that box —
       measured 258px below its own last entry, which is the same floating-rule fault the row
       lock produced, just relocated. Each column ends where its entries end. */
    align-items: start;
  }

  .ai__col {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    border-bottom: 1px solid var(--border);
  }

  .ai__d {
    border-top: 1px solid var(--border);
  }

  .ai__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    font-size: var(--t-sm);
    font-weight: 600;
    line-height: var(--lh-sm);
    color: var(--text);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-2) var(--ease-standard);
  }

  /* Safari still needs the pseudo-element removed explicitly. */
  .ai__q::-webkit-details-marker {
    display: none;
  }

  .ai__q:hover {
    color: var(--accent-bright);
  }

  .ai__q:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .ai__chev {
    flex: none;
    color: var(--text-faint);
    transition: transform var(--dur-2) var(--ease-standard);
  }

  .ai__d[open] .ai__chev {
    transform: rotate(180deg);
  }

  .ai__a {
    margin: 0 0 var(--s-5);
    padding-right: var(--s-8);
  }

  .ai__ap {
    margin: 0 0 var(--s-3);
    font-size: var(--t-sm);
    line-height: var(--lh-base);
    color: var(--text-muted);
    /* Shell lines inside these answers must not widen the column. */
    overflow-wrap: break-word;
  }

  .ai__ic {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--text);
    background: var(--surface-2);
    border-radius: 4px;
    padding: 1px 4px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 56rem) {
    .ai__grid {
      gap: var(--s-12);
      max-width: 42rem;
      margin-inline: auto;
    }

    .ai__steps,
    .ai__ds {
      grid-template-columns: minmax(0, 1fr);
    }

    .ai__steps {
      gap: var(--s-10);
    }

    /* Stacked, the two columns become one list, so the first column's closing rule would sit
       directly on the next column's opening one and draw 2px. */
    .ai__col:not(:last-child) {
      border-bottom: 0;
    }
  }

  @media (max-width: 30rem) {
    .ai__a {
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai__chev,
    .ai__q {
      transition: none;
    }
  }
</style>
