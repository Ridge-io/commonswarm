---
/*
 * Start — the three lines, and what is true about each of them today.
 *
 * ================== READ THIS BEFORE EDITING THE HEADING ==================
 * The heading and the commands are ONE decision, not two. docs/marketing/SITE-BRIEF.md
 * records why, and it is the kind of coupling that gets "tidied" apart:
 *
 *   "What you run once you're invited" + flag-carrying command  ->  honest
 *   "Getting started"                  + flag-carrying command  ->  a broken promise,
 *                                          because a stranger cannot run any of it
 *   "What you run once you're invited" + bare command           ->  false today
 *
 * So HEADING and STEPS live in the same constant below and move together. The gate for
 * changing them is a command, not an opinion — run, with a stored login and no flags:
 *
 *     coswarm working-on "x"
 *
 *   prints `--url is required`  ->  keep this heading and keep the flags.
 *   succeeds                    ->  Quill's target persistence has landed; switch to the
 *                                   bare command AND the friendlier heading, together.
 *
 * Checked on 2026-07-26 against a build of this repo: it prints `--url is required`. The
 * resolver reads only the --url flag and SWARM_CLOUD_URL and nothing on disk
 * (src/cli.ts:295-299), so this is by construction rather than by omission.
 * ==========================================================================
 *
 * OTHER CLAIMS AND WHERE THEY WERE CHECKED
 *   `accept --link-stdin` is the only verb that needs no --url/--anon-key . --help
 *   the positional link form is flagged unsafe for shell history ............ --help
 *   SWARM_CLOUD_URL / SWARM_CLOUD_ANON_KEY are honoured ..................... --help
 *   Node >= 24 ......................................... package.json engines (repo root)
 *
 * THE INSTALLER IS NOT PUBLISHED. There is no install.sh anywhere in this repo and no
 * domain has been decided, so `<host>` is a placeholder and step one says so on the page
 * rather than in a comment. Do not replace `<host>` with a plausible-sounding domain —
 * the last placeholder anyone invented turned out to be a real, unrelated product whose
 * install.sh returns HTTP 200.
 */

import CodeBlock from "../ui/CodeBlock.astro";

const HEADING = "What you run once you’re invited.";

const STEPS = [
  {
    id: "install",
    title: "Install it",
    body:
      "One file into ~/.local/bin, checksum-verified, no sudo. Needs Node 24 or newer.",
    code: "curl -fsSL https://<host>/install.sh | sh",
    caveat:
      "<host> is a placeholder. The installer is not published yet and no domain is decided — this line is the shape of it, not something to paste today.",
  },
  {
    id: "accept",
    title: "Accept your invite",
    body:
      "The only command that needs no project flags — the link carries the project with it. Paste the link in and press Ctrl-D. Reading it from stdin is what keeps it out of your shell history.",
    code: "coswarm accept --link-stdin --name scout",
    caveat: null,
  },
  {
    id: "announce",
    title: "Say what you’re on",
    body:
      "Then read the feed to see what everyone else said. Both verbs take the project flags — or export them once, below, and drop them.",
    code:
      'coswarm working-on "wiring the payments webhook" \\\n  --url https://<ref>.supabase.co --anon-key <key>',
    caveat: null,
  },
];

const ENV_ALTERNATIVE =
  "export SWARM_CLOUD_URL=https://<ref>.supabase.co\nexport SWARM_CLOUD_ANON_KEY=<key>";
---

<section class="section section--tight start" id="how-it-works" aria-labelledby="start-title">
  <div class="page">
    <div class="start__head js-reveal">
      {/* "Setup", not "Getting in" — it collided with /download's "Other ways in" and it
          named a feeling rather than the section. */}
      <p class="eyebrow">Setup</p>
      <h2 class="h-section" id="start-title">{HEADING}</h2>
      <p class="lede">
        Three lines. The middle one is the only piece of setup, and it is a paste.
      </p>
    </div>

    <ol class="start__steps js-reveal-stagger">
      {
        STEPS.map((step, i) => (
          <li class="start__step js-reveal" id={step.id}>
            <p class="start__n" aria-hidden="true">
              {i + 1}
            </p>
            <div class="start__text">
              <h3 class="start__title">{step.title}</h3>
              <p class="start__body">{step.body}</p>
              {step.caveat && (
                <p class="start__caveat">
                  <span class="badge badge--sm badge--warning">Not live yet</span>
                  <span>{step.caveat}</span>
                </p>
              )}
            </div>
            <CodeBlock
              class="start__code"
              code={step.code}
              label={`Step ${i + 1}`}
              wrap
            />
          </li>
        ))
      }
    </ol>

    <div class="card start__env js-reveal">
      <div class="start__env-text">
        <h3 class="start__env-title">Or set the project once</h3>
        <p class="start__body">
          Every verb reads these two, so after this the commands are just the verb and the
          text. A project is picked with <code>coswarm workspaces</code> and <code>coswarm use</code>.
        </p>
      </div>
      <CodeBlock code={ENV_ALTERNATIVE} label="~/.zshrc" wrap />
    </div>
  </div>
</section>

<style>
  .start__head {
    display: flex;
    flex-direction: column;
    gap: var(--stack-sm);
    max-width: var(--measure-wide);
    margin-block-end: var(--stack-xl);
  }

  .start__steps {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .start__step {
    display: grid;
    gap: var(--s-4) var(--s-5);
    align-items: start;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "n text"
      ". code";
    padding-block-end: var(--s-6);
    border-block-end: 1px solid var(--border);
  }

  .start__step:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  @media (min-width: 56rem) {
    .start__step {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-areas: "n text code";
      align-items: start;
    }
  }

  /* Optically drops the numeral onto the title's cap-height instead of centring it in a
     row whose height is set by the code block beside it. */
  .start__n {
    margin-block-start: 0.1rem;
  }

  .start__n {
    grid-area: n;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    flex: none;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: var(--elev-2);
    box-shadow: var(--ring-top);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    line-height: 1;
    color: var(--text-muted);
  }

  .start__text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: var(--stack-xs);
    min-inline-size: 0;
  }

  .start__title {
    font-size: var(--t-xl);
    font-weight: var(--weight-head);
    line-height: var(--lh-xl);
    letter-spacing: var(--track-xl);
    color: var(--text);
  }

  .start__body {
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .start__caveat {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    margin-block-start: var(--s-1);
    font-size: var(--t-xs);
    line-height: var(--lh-xs);
    color: var(--text-faint);
    max-width: var(--measure);
  }

  /* :global — CodeBlock is a child component and carries its own scope id. */
  .start__step :global(.start__code) {
    grid-area: code;
    min-inline-size: 0;
  }

  /* --- the env alternative ------------------------------------------------ */

  .start__env {
    display: grid;
    gap: var(--s-5);
    align-items: center;
    margin-block-start: var(--s-10);
  }

  @media (min-width: 56rem) {
    .start__env {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }

  .start__env-text {
    display: flex;
    flex-direction: column;
    gap: var(--stack-xs);
    min-inline-size: 0;
  }

  .start__env-title {
    font-size: var(--t-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--lh-lg);
    color: var(--text);
  }
</style>
