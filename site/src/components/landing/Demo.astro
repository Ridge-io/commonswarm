---
/*
 * Demo — the one interactive thing on the page.
 *
 * IT TEACHES ONE IDEA: you say what you are about to touch, and you immediately find out
 * whether a teammate is already there. Everything else in the widget is in service of that.
 *
 * IT IS ALSO WHERE THE PAGE'S ONE FRAMING SENTENCE STOPS BEING A CLAIM AND BECOMES A DEMO.
 * Hero says "A signal announces. It never locks."; here the reader picks the file someone is
 * already on, presses the button, and WATCHES IT GO THROUGH. That is the whole reason outcome
 * A is not an error state and has no red in it. The foot of that outcome says it in words —
 * "Nothing stopped you" — because the thing being proved is a negative, and a negative has to
 * be pointed at or a reader will not notice it did not happen.
 *
 * THE WORD "claim" IS GONE FROM THIS FILE. It read as a thing held against someone, which is
 * the retired framing (docs/marketing/SITE-BRIEF.md's vocabulary table) creeping back in a
 * friendlier word. A signal is said, not held. Hero.astro's header carries the full note.
 *
 * IT IS AN ILLUSTRATION AND IT SAYS SO — twice: a badge on the panel and a line under the
 * widget. It makes no network calls, it holds no state anywhere, and the three outcomes are
 * server-rendered into the page and toggled. Nothing here pretends to reach a server.
 *
 * WHY NO LOADING STATE. There is no request, so a spinner would be a lie about latency
 * invented purely for texture. The outcome appears immediately, which is also the truth.
 *
 * WHY THE LIVE COMMAND HAS NO COPY BUTTON. ui/CodeBlock puts the exact `code` prop on the
 * clipboard, which is right — but that prop is baked at build time, and this command changes
 * as the reader types. A copy button handing over a stale command is exactly the failure
 * CodeBlock is written to prevent. The canonical, copyable command lives in "How it works".
 *
 * SHELL QUOTING IS REAL. The signal text is rendered into a double-quoted shell word, so
 * `"`, `\`, `$` and a backtick are escaped the way sh actually requires. Type a quote into
 * the field and the command stays something you could paste.
 *
 * VERIFIED against the shipped CLI:
 *   the signature  `working-on "<what>" [--url <url> --anon-key <key>] [--workspace-id <uuid>]
 *                  [--about <ref>] [--until <dur>] [--json]`  — src/cli.ts:257, usage block
 *   `--until` takes a whole number plus m/h/d and is capped at 30d — src/cli.ts:283, :1360
 *
 * ---------------------------------------------------------------------------------------
 * `--url` / `--anon-key` CAME OFF THIS COMMAND, AND THE OLD REASON THEY WERE ON IT IS DEAD.
 * ---------------------------------------------------------------------------------------
 * The superseded note, kept so nobody re-derives it: "--url / --anon-key are ALWAYS required:
 * target() reads only the flag and SWARM_CLOUD_URL (src/cli.ts:295-299), so a flagless command
 * on this page would not run."
 *
 * That was true and is now false. docs/marketing/SITE-BRIEF.md sets the gate for moving to the
 * bare form and Quill's target persistence has landed through it. Four independent lines,
 * because the negative was originally established on one:
 *
 *   1. resolveCloudTarget (src/cloud/current-target.ts:252-283) resolves flag ?? env ??
 *      STORED. `mode === "human" && needsStored` is what reads the stored target — the third
 *      source that did not exist when the note above was written.
 *   2. `cswarm accept` writes it (src/cli.ts:981); so do `login` (:1827) and `target set` (:744).
 *   3. `cswarm --help` states the precedence out loud (src/cli.ts:293-295): "flags take
 *      precedence over environment, which takes precedence over the saved target."
 *   4. tests/p1-cli/current-target.test.ts:225 — "target set/show/clear is explicit and bare
 *      human commands use it" — asserts a BARE `cswarm status` after `target set` fails with
 *      "not logged in" and specifically NOT "no Cloud target is selected". That is the gate
 *      as an executable statement: target resolution succeeded with no flags.
 *
 * NOT ESTABLISHED, STATED PLAINLY: nobody has run `cswarm working-on` bare against a live
 * deployment after a real `accept`. No build was run here and there is no invite link to
 * accept. The evidence is a source trace, the shipped help text, and a passing test — which
 * is strictly more than the source trace alone that established the negative, but it is not
 * an execution. If a bare run ever prints `--url is required`, this block and Start.astro's
 * heading move back TOGETHER; SITE-BRIEF is explicit that they are one decision.
 *
 * WHY IT WAS WORTH MOVING, beyond accuracy: `--url https://<ref>.supabase.co --anon-key <key>`
 * was the most jargon-dense string on the landing page, sitting inside its single most
 * prominent piece of proof. A reader who has never met Supabase met it here, in the command
 * the page is asking them to imagine typing.
 * ---------------------------------------------------------------------------------------
 */

import FeedPanel from "./FeedPanel.astro";
import Input from "../ui/Input.astro";
import EmptyState from "../ui/EmptyState.astro";

/* Sample data — the same project as the hero, so the page tells one story. */
const REFS = [
  { id: "webhook", ref: "src/payments/webhook.ts" },
  { id: "session", ref: "src/auth/session.ts" },
  { id: "orders", ref: "migrations/0042_orders.sql" },
];

const DURATIONS = ["90m", "4h", "24h"];

/* The two signals already in this sample project. One is live, one is a note — and the
 * difference between them is a thing worth teaching, so the outcomes below say so in
 * different words. */
const existing = [
  {
    kind: "working-on" as const,
    from: "scout",
    fromKind: "agent" as const,
    body: "Mapping the Stripe webhook retry paths",
    about: "src/payments/webhook.ts",
    age: "6m ago",
    expiry: "expires in 84m",
  },
  {
    kind: "note" as const,
    from: "codex-1",
    fromKind: "agent" as const,
    body: "Session cookies sign with the new key now. Nothing to do — just don’t cache them.",
    about: "src/auth/session.ts",
    age: "21m ago",
    expiry: "expires in 3h",
  },
];

/* The reader's own signal. Rendered hidden; the script fills its text and reveals it. */
const yours = {
  kind: "working-on" as const,
  from: "you",
  fromKind: "member" as const,
  body: "wiring the payments webhook",
  about: "src/payments/webhook.ts",
  age: "under 1m ago",
  expiry: "expires in 90m",
  fresh: true,
  pending: true,
};

const DEFAULT_TEXT = "wiring the payments webhook";
---

<section class="section section--tight demo" id="demo" aria-labelledby="demo-title">
  <div class="page">
    <div class="demo__head js-reveal">
      <p class="eyebrow">Try it</p>
      <h2 class="h-section" id="demo-title">Find out who’s already there.</h2>
      <p class="lede">
        Say what you’re about to touch, the way an agent would. The command builds as you
        type — it’s the real one — and the panel shows what everyone else sees.
      </p>
    </div>

    <div class="demo__grid js-reveal">
      {/* ------------------------------------------------------------- the form */}
      <div class="demo__col">
      <h3 class="demo__col-title">
        <span class="demo__step" aria-hidden="true">1</span>
        What you run
      </h3>

      <div class="card card--lg demo__form">
        <Input
          id="demo-what"
          label="What are you working on?"
          value={DEFAULT_TEXT}
          maxlength="90"
          autocomplete="off"
          hint="One line. Enough that a teammate knows whether it overlaps with them."
        />
        <p class="demo__err" id="demo-what-err" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7.5v5"></path>
            <path d="M12 16.2v.2"></path>
          </svg>
          <span>Say something, so the signal is worth reading.</span>
        </p>

        <fieldset class="demo__group">
          <legend class="demo__legend">
            Which file? <span class="demo__flag mono">--about</span>
          </legend>
          <div class="demo__chips">
            {
              REFS.map((r, i) => (
                <span class="demo__opt">
                  <input
                    class="ui-sr demo__radio"
                    type="radio"
                    name="demo-ref"
                    id={`demo-ref-${r.id}`}
                    value={r.ref}
                    checked={i === 0}
                    data-outcome={r.id}
                  />
                  <label class="demo__chip demo__chip--mono" for={`demo-ref-${r.id}`}>
                    {r.ref}
                  </label>
                </span>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="demo__group">
          <legend class="demo__legend">
            For how long? <span class="demo__flag mono">--until</span>
          </legend>
          <div class="demo__chips">
            {
              DURATIONS.map((d, i) => (
                <span class="demo__opt">
                  <input
                    class="ui-sr demo__radio"
                    type="radio"
                    name="demo-until"
                    id={`demo-until-${d}`}
                    value={d}
                    checked={i === 0}
                  />
                  <label class="demo__chip demo__chip--mono" for={`demo-until-${d}`}>
                    {d}
                  </label>
                </span>
              ))
            }
          </div>
          <p class="demo__note">
            Your signal expires on its own. Nobody has to remember to take it down. Anything
            up to 30&nbsp;days.
          </p>
        </fieldset>

        <div class="demo__cmd">
          <span class="demo__cmd-label">The command</span>
          <pre class="demo__cmd-body"><code id="demo-command">{
            `cswarm working-on "${DEFAULT_TEXT}" \\\n  --about ${REFS[0].ref} --until ${DURATIONS[0]}`
          }</code></pre>
        </div>

        {/* The tick is rendered here rather than built in the script: a node created at
            runtime carries no scope id, and .btn__icon is the class the button already uses
            to keep its own width while the glyph inside it changes. It is hidden until the
            announce lands. */}
        <button class="btn btn--lg btn--primary btn--block demo__run" type="button" id="demo-run">
          <span class="btn__icon demo__run-tick" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12.5 9.5 18 20 6.5"></path>
            </svg>
          </span>
          <span data-run-label>Announce it</span>
        </button>
      </div>
      </div>

      {/* ----------------------------------------------------------- the result */}
      <div class="demo__col">
      <h3 class="demo__col-title">
        <span class="demo__step" aria-hidden="true">2</span>
        What everyone else sees
      </h3>

      <div class="demo__result">
        {/* Before the first announce. A real empty state, not a blank box. */}
        <div class="card card--lg demo__empty" id="demo-empty">
          <EmptyState
            headingLevel={4}
            title="Nothing from you yet"
            description="Announce it, and this is where your signal lands next to everyone else’s."
          >
            <svg
              slot="icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 6h16M4 12h10M4 18h7"></path>
            </svg>
          </EmptyState>
        </div>

        <div class="demo__out" id="demo-out" hidden>
          {/* The short verdict, and the only thing announced to a screen reader. Swapping
              the whole panel into a live region would read the entire feed aloud again on
              every change; this sentence is the outcome. */}
          <p class="ui-sr" id="demo-verdict" role="status"></p>

          {/* Outcome A — a live claim on the same file. */}
          <div class="callout callout--heads" data-outcome-panel="webhook" hidden>
            <p class="callout__title">
              <span class="callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4.5 21 19H3z"></path>
                  <path d="M12 10v3.5M12 16.3v.2"></path>
                </svg>
              </span>
              Someone’s already there
            </p>
            <p class="callout__body">
              <b>scout</b> announced <code>src/payments/webhook.ts</code> six minutes ago:
              &ldquo;Mapping the Stripe webhook retry paths&rdquo;. That signal has 84 minutes
              left on it.
            </p>
            <p class="callout__foot">
              <b>Nothing stopped you.</b> A signal announces; it never locks — so yours went
              out too, and you both just found out. One of you takes the retries, the other
              takes the tests.
            </p>
          </div>

          {/* Outcome B — free, but there is context worth reading. */}
          <div class="callout callout--clear" data-outcome-panel="session" hidden>
            <p class="callout__title">
              <span class="callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12.5 9.5 18 20 6.5"></path>
                </svg>
              </span>
              Nobody’s on it
            </p>
            <p class="callout__body">
              Nobody has announced <code>src/auth/session.ts</code>. Go ahead.
            </p>
            <p class="callout__foot">
              Worth reading first, though: <b>codex-1</b> left a note on this file 21 minutes
              ago. A note holds nothing and asks nothing of you — it just saves you the hour.
            </p>
          </div>

          {/* Outcome C — free and quiet. */}
          <div class="callout callout--clear" data-outcome-panel="orders" hidden>
            <p class="callout__title">
              <span class="callout__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 12.5 9.5 18 20 6.5"></path>
                </svg>
              </span>
              Nobody’s on it
            </p>
            <p class="callout__body">
              Nothing at all on <code>migrations/0042_orders.sql</code>. Go ahead.
            </p>
            <p class="callout__foot">
              Every agent in the project sees your line the next time it reads the feed —
              including the one that was about to open the same migration.
            </p>
          </div>

          <FeedPanel
            signals={[yours, ...existing]}
            command="cswarm feed"
            label="The shared feed after your signal — sample data"
          />
        </div>

        <p class="demo__disclaimer">
          <b>Illustration.</b> Sample data, and it runs entirely in your browser — this page
          makes no network calls and nothing is stored.
        </p>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* Progressive: without this script the form is still a legible, keyboard-usable
     description of the command, and the empty state explains what the panel is for. The
     page never depends on JS to say something true. */
  const root = document.getElementById("demo");
  const field = document.getElementById("demo-what") as HTMLInputElement | null;
  const err = document.getElementById("demo-what-err");
  const cmdEl = document.getElementById("demo-command");
  const runBtn = document.getElementById("demo-run");
  const emptyEl = document.getElementById("demo-empty");
  const outEl = document.getElementById("demo-out");
  const verdictEl = document.getElementById("demo-verdict");

  if (root && field && err && cmdEl && runBtn && emptyEl && outEl && verdictEl) {
    const refInputs = Array.from(
      root.querySelectorAll<HTMLInputElement>('input[name="demo-ref"]')
    );
    const untilInputs = Array.from(
      root.querySelectorAll<HTMLInputElement>('input[name="demo-until"]')
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-outcome-panel]")
    );
    const yourRow = outEl.querySelector<HTMLElement>("[data-pending]");
    /* The .ui-field wrapper owns the error styling; ui.css declares .ui-field--error
       globally, so adding the class from here is enough. */
    const wrapper = field.closest(".ui-field");

    const checked = (list: HTMLInputElement[]) =>
      list.find((i) => i.checked) ?? list[0];

    /* Escape for a DOUBLE-QUOTED sh word. Inside "…", sh still interprets \ " $ and `,
       and nothing else — so those four are the complete set. Control characters are
       flattened to a space rather than escaped, because a literal newline inside the
       displayed command would be read as a second command line. */
    const shQuote = (raw: string) =>
      `"${raw.replace(/\s+/g, " ").replace(/([\\"$`])/g, "\\$1")}"`;

    const buildCommand = () => {
      const text = field.value.trim() || field.placeholder || "";
      const ref = checked(refInputs).value;
      const until = checked(untilInputs).value;
      /* Must stay character-for-character the same shape as the server-rendered command in
         the template above, or the block changes on the reader's first keystroke. */
      return (
        `cswarm working-on ${shQuote(text)} \\\n` +
        `  --about ${ref} --until ${until}`
      );
    };

    const syncCommand = () => {
      cmdEl.textContent = buildCommand();
    };

    const setError = (on: boolean) => {
      err.hidden = !on;
      field.setAttribute("aria-invalid", on ? "true" : "false");
      /* Point the control at the error only while it exists, and keep the hint first so
         the guidance is heard before the correction. */
      field.setAttribute(
        "aria-describedby",
        on ? "demo-what-hint demo-what-err" : "demo-what-hint"
      );
      wrapper?.classList.toggle("ui-field--error", on);
    };

    let announced = false;

    /*
     * THE BUTTON RESOLVES, THE WAY EVERY OTHER ACTION ON THIS SITE DOES.
     *
     * Copy buttons flip to a green "Copied" for two seconds and back; /start's submit spins
     * and then advances. This was the one action that fired and then sat there in full
     * primary weight still reading "Announce it", with nothing to say whether it had worked
     * and no way back — on the page's single most important piece of proof.
     *
     * So: a tick and "Announced" in the success colour for 1.4s, then the button settles into
     * a secondary "Announce again". Secondary is the honest weight afterwards, because the
     * primary action on this panel has been taken. And "again" rather than "another" is the
     * literal truth about what happens: re-running REPLACES your signal in the feed below
     * — there is exactly one "you" row and it is rewritten in place, never a second one.
     *
     * Only a real press comes through here. Editing the text or changing a chip after the
     * first announce re-renders the panel live, and firing the tick on every keystroke would
     * turn confirmation into decoration.
     */
    const runLabel = runBtn.querySelector<HTMLElement>("[data-run-label]");
    let resolveTimer: number | undefined;

    const resolveButton = () => {
      window.clearTimeout(resolveTimer);
      runBtn.classList.remove("btn--primary");
      runBtn.classList.add("btn--secondary", "is-done");
      if (runLabel) runLabel.textContent = "Announced";

      resolveTimer = window.setTimeout(() => {
        runBtn.classList.remove("is-done");
        if (runLabel) runLabel.textContent = "Announce again";
      }, 1400);
    };

    const render = (confirmed = false) => {
      const text = field.value.trim();
      if (!text) {
        setError(true);
        field.focus();
        return;
      }
      setError(false);

      const ref = checked(refInputs);
      const until = checked(untilInputs).value;
      const outcome = ref.dataset.outcome ?? "";

      for (const p of panels) p.hidden = p.dataset.outcomePanel !== outcome;

      if (yourRow) {
        yourRow.hidden = false;
        /* Astro does not rewrite class names — scoping is a data- attribute — so these
           selectors reach into FeedPanel’s markup exactly as written. Text only: never
           innerHTML, because `text` comes from a field the reader controls. */
        const body = yourRow.querySelector(".sig__body");
        const ref_ = yourRow.querySelector(".sig__ref");
        const exp = yourRow.querySelector(".sig__exp");
        if (body) body.textContent = text;
        if (ref_) ref_.textContent = ref.value;
        if (exp) exp.textContent = `expires in ${until}`;
      }

      emptyEl.hidden = true;
      outEl.hidden = false;

      /* Kept word-for-word in step with the visible callouts above. A screen-reader outcome
         that says something the sighted outcome does not is two different products. */
      verdictEl.textContent =
        outcome === "webhook"
          ? `Someone’s already there. scout announced ${ref.value} six minutes ago, with 84 minutes left on that signal. Nothing stopped you — your signal went out as well.`
          : `Nobody has announced ${ref.value}. Your signal is in the shared feed.`;

      announced = true;
      if (confirmed) resolveButton();
    };

    field.addEventListener("input", () => {
      syncCommand();
      if (field.value.trim()) setError(false);
      if (announced) render();
    });

    for (const input of [...refInputs, ...untilInputs]) {
      input.addEventListener("change", () => {
        syncCommand();
        if (announced) render();
      });
    }

    /* Enter in the text field is the obvious way to run it, and it is as deliberate a press
       as the button, so it gets the same confirmation. */
    field.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        render(true);
      }
    });

    /* Written as an arrow rather than passed straight in: `render` as a listener would take
       the MouseEvent as its `confirmed` argument, which happens to be truthy and would work
       for the wrong reason. */
    runBtn.addEventListener("click", () => render(true));

    syncCommand();
  }
</script>

<style>
  /* [hidden] is `display: none` in the UA sheet at (0,1,0), and an author rule of the same
     specificity BEATS it — so `.demo__out { display: flex }` would keep the results panel on
     screen while the attribute claims it is hidden. Every toggle in this component depends on
     this one rule. */
  [hidden] {
    display: none !important;
  }

  .demo {
    padding-block: clamp(var(--s-8), 3.5vw, var(--s-12));
  }

  .demo__head {
    display: flex;
    flex-direction: column;
    gap: var(--stack-sm);
    max-width: var(--measure-wide);
    margin-block-end: var(--s-6);
  }

  .demo__head .eyebrow {
    margin-block-end: var(--s-1);
  }

  /* stretch, not start: the two columns are a matched pair, and before the first announce
     the result side is only an empty state. Left to size itself it left a card a third the
     height of the form beside it, with a void underneath. */
  .demo__grid {
    display: grid;
    gap: var(--s-6);
    align-items: stretch;
  }

  @media (min-width: 62rem) {
    .demo__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .demo__col {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    min-inline-size: 0;
  }

  .demo__col-title {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-base);
    color: var(--text);
  }

  .demo__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--accent-dim);
    border: 1px solid color-mix(in oklab, var(--accent) 34%, transparent);
    color: var(--accent-bright);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 1;
  }

  /* --- form --------------------------------------------------------------- */

  .demo__form {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    /* A grid item's default min-width is auto, so the horizontally-scrolling command block
       inside would otherwise widen the column past its track and push the page sideways. */
    min-inline-size: 0;
  }

  /* --- the announce button's resolved state ---------------------------------
   * Deliberately the same vocabulary as ui.css's copy button: the glyph swaps in, the WORD
   * changes, and the colour is --success — never the colour alone. The button is a grid item
   * of nothing, so a colour change is all that moves; the box does not resize, because the
   * icon slot is in the markup from the start rather than being inserted on success. */
  .demo__run-tick {
    display: none;
  }

  .demo__run.is-done .demo__run-tick {
    display: inline-flex;
  }

  .demo__run.is-done,
  .demo__run.is-done:hover {
    color: var(--success); /* 10.36:1 on --bg, 8.17:1 on the secondary's --elev-4 */
    border-color: color-mix(in oklab, var(--success) 40%, transparent);
  }

  .demo__err {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
    margin-block-start: calc(var(--s-5) * -1 + var(--s-2));
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--danger);
  }

  .demo__err svg {
    inline-size: 1.05em;
    block-size: 1.05em;
    flex: none;
    margin-block-start: 0.2em;
  }

  .demo__group {
    border: 0;
