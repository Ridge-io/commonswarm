---
/*
 * Verbs — the whole vocabulary, on one screen.
 *
 * The point of this section is that there is not much to learn. Five commands, three that
 * write and two that read. It is the section that earns "your agents know what each other
 * are doing" by showing how little an agent has to be taught to take part.
 *
 * IT REPEATS THE PAGE'S ONE FRAMING SENTENCE, VERBATIM: "Every one of them announces. None of
 * them lock." Hero states it, this section restates it about the verbs specifically, and the
 * demo's outcome copy proves it. See Hero.astro's header for why it is literally true and why
 * the word "claim" is gone from this directory.
 *
 * EVERY VERB AND ITS ARGUMENT IS THE REAL ONE — src/cli.ts:257-261, the usage block. The
 * flags are deliberately NOT here.
 *
 * ---------------------------------------------------------------------------------------
 * WHAT WAS CUT FROM THIS SECTION, AND WHY. It shipped as five cards each carrying a row of
 * flag chips (`--about` `--until` `--to` `--kind` `--since` `--limit`), plus a footnote
 * explaining that the signatures were abbreviated. That was a feature grid wearing a
 * vocabulary's clothes: eleven chips of shell syntax is the densest jargon on the page, and
 * the footnote existed only to apologise for the chips. Both are gone. The argument — five
 * verbs, three speak, two listen — is unharmed and reads faster without them, and anyone who
 * wants the flags gets the whole signature from `cswarm --help`, which is where a flag
 * reference belongs. If chips come back, the footnote has to come back with them.
 * ---------------------------------------------------------------------------------------
 */

const speak = [
  {
    verb: "working-on",
    args: '"<what>"',
    line: "I’m taking this one.",
    body:
      "Says what you have started, and roughly how long for. It expires on its own — nobody has to remember to take it down.",
  },
  {
    verb: "note",
    args: '"<text>"',
    line: "You’ll want to know this.",
    body:
      "Context for whoever comes next. It holds nothing and blocks nobody; it just saves them the hour you already spent.",
  },
  {
    verb: "ask",
    args: '"<text>"',
    line: "I need an answer before I go on.",
    body:
      "A question left where the person or agent who can answer it will see it. Name someone, or leave it for whoever picks it up.",
  },
];

const listen = [
  {
    verb: "feed",
    args: "",
    line: "What has everyone said?",
    body:
      "Everything shared in the project. Narrow it to one file, one kind of signal, or just what has landed since you last looked.",
  },
  {
    verb: "inbox",
    args: "",
    line: "What was said to me?",
    body: "Only the signals addressed to you by name. Nothing else.",
  },
];
---

<section class="section section--tight verbs" id="verbs" aria-labelledby="verbs-title">
  <div class="page">
    <div class="verbs__head js-reveal">
      {/* Was "The vocabulary", which the lede's first words repeat verbatim two lines later.
          An eyebrow's job is to set the section up, not to say the same word first. */}
      <p class="eyebrow">What there is to learn</p>
      <h2 class="h-section" id="verbs-title">
        Three verbs to speak. Two to listen.
      </h2>
      <p class="lede">
        That is the whole vocabulary. <strong>Every one of them announces. None of them
        lock.</strong> Any agent that can run a shell command can take part — no SDK, no
        daemon, nothing to keep running.
      </p>
    </div>

    <div class="verbs__group">
      <h3 class="verbs__label">
        <span class="verbs__label-text">Speak</span>
        <span class="verbs__rule" aria-hidden="true"></span>
      </h3>
      <ul class="verbs__grid verbs__grid--3 js-reveal-stagger">
        {
          speak.map((v) => (
            <li class="card verbs__card js-reveal">
              <p class="verbs__verb">
                <span class="verbs__name">{v.verb}</span>
                {v.args && <span class="verbs__args">{v.args}</span>}
              </p>
              <p class="verbs__line">{v.line}</p>
              <p class="verbs__body">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="verbs__group">
      <h3 class="verbs__label">
        <span class="verbs__label-text">Listen</span>
        <span class="verbs__rule" aria-hidden="true"></span>
      </h3>
      <ul class="verbs__grid verbs__grid--2 js-reveal-stagger">
        {
          listen.map((v) => (
            <li class="card verbs__card js-reveal">
              <p class="verbs__verb">
                <span class="verbs__name">{v.verb}</span>
              </p>
              <p class="verbs__line">{v.line}</p>
              <p class="verbs__body">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .verbs {
    padding-block: clamp(var(--s-8), 3.5vw, var(--s-12));
  }

  /* The break belongs at the full stop, and neither wrapping mode put it there on its own:
     balance dangled "to" at the end of line one, and pretty pulled "Two" up onto it. Both
     were measured, not guessed — at 1440 the two candidate first lines render 525px
     ("Three verbs to speak.") and 638px ("…speak. Two"), which is 15.8ch and 19.2ch of this
     heading’s own 33px ch. A 17ch cap sits between them, so greedy filling can only break
     at the sentence. Because ch scales with the clamped font size, the cap shrinks with the
     type and can never be wider than the column, so it cannot cause an overflow. */
  .verbs .h-section {
    max-width: 17ch;
    text-wrap: pretty;
  }

  .verbs__head {
    display: flex;
    flex-direction: column;
    gap: var(--stack-sm);
    max-width: var(--measure-wide);
    margin-block-end: var(--s-6);
  }

  .verbs__group + .verbs__group {
    margin-block-start: var(--s-6);
  }

  .verbs__label {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-block-end: var(--s-4);
  }

  .verbs__label-text {
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .verbs__rule {
    flex: 1 1 auto;
    block-size: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .verbs__grid {
    display: grid;
    gap: var(--gap-grid);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .verbs__grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .verbs__grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .verbs__card {
    display: flex;
    flex-direction: column;
    gap: var(--stack-xs);
    min-inline-size: 0;
  }

  .verbs__verb {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--t-base);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .verbs__name {
    color: var(--accent-bright);
    font-weight: 600;
  }

  .verbs__args {
    font-size: var(--t-sm);
    color: var(--text-faint);
  }

  .verbs__line {
    font-size: var(--t-base);
    font-weight: var(--weight-medium);
    line-height: var(--lh-base);
    color: var(--text);
  }

  .verbs__body {
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    color: var(--text-muted);
  }

  /* .verbs__flags, .verbs__flag and .verbs__foot were deleted with the markup they dressed —
     see the header for why the chips and their footnote went. The cards used to line up on
     the flag row, which `margin-block-start: auto` pushed to the bottom edge; with the chips
     gone the bodies are one or two lines each and the grid's own stretch is what levels the
     cards, so nothing replaces that rule. A stylesheet still styling markup nobody renders is
     how a file stops being readable. */
</style>
