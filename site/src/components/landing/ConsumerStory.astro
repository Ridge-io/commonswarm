          <text class="preview__eyebrow" x="238" y="29">VER.</text>
          <text class="preview__eyebrow" x="282" y="29">UPLOADER</text>

          <rect class="preview__row" x="14" y="42" width="332" height="76" rx="8" />
          <path class="preview__file-icon" d="M30 60h21l7 7v31H30zM51 60v8h7" />
