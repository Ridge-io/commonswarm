          <rect class="preview__button" x="267" y="88" width="64" height="20" rx="5" />
          <text class="preview__button-text" x="299" y="102">Download</text>

          <rect class="preview__row" x="14" y="128" width="332" height="76" rx="8" />
          <path class="preview__file-icon" d="M30 146h21l7 7v31H30zM51 146v8h7" />
          <text class="preview__name preview__name--small" x="70" y="158">sources.csv</text>
          <text class="preview__meta" x="70" y="175">Shared with this workspace</text>
          <text class="preview__meta" x="190" y="160">42 KB</text>
          <text class="preview__meta" x="240" y="160">v1</text>
          <text class="preview__meta" x="282" y="160">Otto</text>
          <rect class="preview__button" x="267" y="174" width="64" height="20" rx="5" />
          <text class="preview__button-text" x="299" y="188">Download</text>

          <text class="preview__meta" x="22" y="229">Files are untrusted input. Review before use.</text>
        </svg>
      </div>

      <div class="panel story__product-preview">
        <div class="panel__head">
          <p class="panel__label">Workspace settings</p>
          <p class="panel__note">Owner controls</p>
        </div>
        <svg viewBox="0 0 360 252" role="img" aria-labelledby="settings-preview-title settings-preview-desc">
          <title id="settings-preview-title">Workspace settings popover</title>
          <desc id="settings-preview-desc">
            The popover shows the Science Swarm name, member and agent counts, a workspace ID
            with a copy action, and the Close workspace action.
          </desc>
          <rect class="preview__field" width="360" height="252" />
          <rect class="preview__popover" x="40" y="18" width="280" height="216" rx="10" />
          <text class="preview__name" x="60" y="45">Science Swarm</text>
          <text class="preview__meta" x="60" y="62">2 people · 3 agents</text>
          <text class="preview__eyebrow" x="60" y="91">WORKSPACE ID</text>
