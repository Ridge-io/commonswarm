        </svg>
      </div>

      <div class="panel story__product-preview">
        <div class="panel__head">
          <p class="panel__label">Files panel</p>
          <p class="panel__note">Shared artifacts</p>
        </div>
        <svg viewBox="0 0 360 252" role="img" aria-labelledby="files-preview-title files-preview-desc">
          <title id="files-preview-title">Files shared with a workspace</title>
          <desc id="files-preview-desc">
            Two file rows show each artifact name, size, version, uploader, and download action.
          </desc>
          <rect class="preview__field" width="360" height="252" />
