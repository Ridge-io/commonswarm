---
/*
 * EmptyState — what a surface shows when there is nothing in it yet.
 *
 * An empty state is a piece of writing more than a piece of layout, so the component asks for
 * a title and gives room for exactly one sentence and one action. The two failure modes it is
 * shaped to prevent are a bare "No results" with no way forward, and a paragraph of apology.
 *
 * TITLE IS REQUIRED and should say what is missing in the reader's terms ("No one has
 * announced anything yet"), not the system's ("Empty collection").
 *
 * The icon is decorative and marked aria-hidden — the title carries the meaning. Pass an
 * <svg> with no fill; ui.css strokes it in currentColor so it inherits the medallion colour.
 */

import "../../styles/ui.css";

interface Props {
  /** What is missing, in the reader's words. */
  title: string;
  /** One sentence. What to do next, or why it is empty. */
  description?: string;
  /** `sm` for an empty state inside a card or a panel rather than a whole page. */
  size?: "sm" | "md";
  /** Heading level. Match the surrounding document outline. */
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  size = "md",
  headingLevel = 3,
  class: className,
  ...rest
} = Astro.props;

const Heading = `h${headingLevel}` as "h2" | "h3" | "h4" | "h5" | "h6";
const hasIcon = Astro.slots.has("icon");
const hasActions = Astro.slots.has("actions");
---

<div class:list={["ui-empty", size === "sm" && "ui-empty--sm", className]} {...rest}>
  {
    hasIcon && (
      <span class="ui-empty__icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }

  <Heading class="ui-empty__title">{title}</Heading>

  {description && <p class="ui-empty__body">{description}</p>}

  <slot />

  {
    hasActions && (
      <div class="ui-empty__actions">
        <slot name="actions" />
      </div>
    )
  }
</div>
