---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

/*
 * Base.astro — the shell every page renders into.
 *
 * Owns the <head>, the skip link, the <main> landmark, and the header and footer that wrap
 * it. The bar itself lives in SiteHeader.astro and the footer in SiteFooter.astro; this file
 * is the scaffold and the metadata, nothing more.
 *
 * FALLBACK_ORIGIN is a placeholder that needs a real decision before launch. Setting `site:`
 * in astro.config.mjs makes it stop being used at all.
 *
 * THE FOOTER IS A SLOT WITH A DEFAULT, and as of integration NO PAGE OVERRIDES IT. All four
 * routes render SiteFooter. Two pages used to pass their own (landing/SiteFoot,
 * download/PageFoot) because this file's footer linked at a landing-page anchor that had
 * been deleted; that is fixed at the source, in SiteFooter's link list, so the forks are
 * gone. The slot is kept rather than hard-wiring SiteFooter so that a page which one day
 * genuinely needs a different footer can pass one and have it take effect — but before you
 * do, ask whether the shared footer is simply wrong, which is what it was.
 *
 * NOTES GO IN THIS BLOCK, NOT IN THE MARKUP. Astro ships <!-- HTML comments --> to the
 * browser verbatim; this file was doing exactly that with a note about the font preloads,
 * which was visible in dist/index.html. Frontmatter comments like this one are compiled
 * away. The font note it replaced: the preloads are self-hosted, so no preconnect to any
 * third party is needed or wanted, and `crossorigin` is required even same-origin because
 * font fetches are CORS-mode — a preload without it downloads the file a second time.
 */

// DO NOT put a plausible-sounding domain here. "coswarm.dev" was used as a placeholder and
// it is a REAL, UNRELATED SHIPPING PRODUCT (a self-hosted Docker Swarm PaaS) whose
// /install.sh returns HTTP 200 and runs as root. The hero's copy button was handing readers
// a command that would root-install a stranger's software. Verified live before this fix.
// Do NOT put coswarm.dev here -- that warning outlives the rename, because the hazard is
// somebody else's live host, not our old name.
//
// ★ SUPERSEDED, KEPT SO THE REASONING IS STILL READABLE -- do not act on it:
//   "THE DOMAIN IS NOW DECIDED AND STILL NOT USABLE. commonswarm.com is the chosen name; DNS
//    is parked and nothing serves it. So it does NOT go here yet ... Swap this for
//    https://commonswarm.com (or better, set `site:` in astro.config.mjs and delete this) on
//    the day the domain actually serves the site."
// That day came. astro.config.mjs now sets `site: "https://commonswarm.com"`, which means
// Astro.site is always defined and THIS CONSTANT IS UNREACHABLE -- the `??` below never takes
// its right-hand branch. It is left in place as the guard rail the warning above describes,
// not because anything reads it. Checked, not assumed: `site:` is set in astro.config.mjs.
const FALLBACK_ORIGIN = "https://commonswarm.invalid";

/* THEME-COLOR: THE ONE PLACE IN THE SITE A TOKEN VALUE IS WRITTEN TWICE, AND IT CANNOT BE
 * AVOIDED. `content` on a <meta> is an HTML attribute, not CSS, so it cannot hold
 * `var(--elev-0)`; the browser chrome colour has to be a literal. Everything else in this
 * shell resolves through tokens.css.
 *
 * Two entries, each media-gated, because the page is no longer dark-only. A single literal
 * here is the bug the theme work exists to remove: dark browser chrome sitting on top of a
 * light page, so the phone's status bar and URL bar fight the document they frame. The
 * browser picks the FIRST entry whose media matches, so both must carry a media attribute --
 * an unqualified fallback placed first would always match and win, silently disabling the
 * pair.
 *
 * THE SYNC OBLIGATION, stated so the next person does not have to infer it: each value must
 * equal --elev-0 as tokens.css resolves it in that mode, because --elev-0 is the page plane
 * and the chrome is meant to disappear into it.
 *   - DARK (#08090c) is verified: it is --elev-0's current value in tokens.css.
 *   - LIGHT (#ffffff) is NOT verified. The light palette is being written concurrently and
 *     does not exist yet at the time of this edit, so this is the conventional white page
 *     rather than a value read off the token. If the light --elev-0 lands as a tinted
 *     off-white, this line is wrong by exactly that tint and must be updated to match.
 * Check it with `grep -n 'elev-0' src/styles/tokens.css` -- not by eye against a screenshot,
 * which cannot distinguish #ffffff from #fcfcfd. */
const THEME_COLOR_LIGHT = "#ffffff";
const THEME_COLOR_DARK = "#08090c";

/* THIS FILE'S `<meta name="color-scheme" content="light dark">` IS NOT SUFFICIENT ON ITS OWN.
 * The CSS `color-scheme` property beats the meta wherever both are present, and global.css
 * declares `color-scheme: dark` on `html`. Until that line becomes light-first too, this
 * shell advertises support for both modes while the stylesheet pins the UA to dark -- form
 * controls, scrollbars and the canvas would stay dark under a light palette. global.css is
 * not this file's to edit; it is named here so the gap is visible rather than assumed
 * closed. Verified by reading global.css, not by inference. */

interface Props {
  /** Full <title>. Defaults to the site-wide title. */
  title?: string;
  /** Meta + OG description. Keep it under ~160 characters. */
  description?: string;
  /** Site-root-relative path for the canonical URL, e.g. "/docs". */
  path?: string;
  /** Root-relative path to a social card image. */
  ogImage?: string;
  /** Suppress the site header (e.g. a bare error page). */
  bareHeader?: boolean;
  /**
   * Suppress the site footer. For focused flows only — /start passes both this and
   * bareHeader. A signup flow that surrounds itself with six ways out is one people leave,
   * which is the reason it already had bareHeader; integration made the mismatch visible by
   * giving every page the same footer, and /start ended up arguing against exits in its own
   * frontmatter while rendering a 392px block of them.
   */
  bareFooter?: boolean;
  /**
   * Switches the header to the app nav. Nothing sets this yet — there is no auth and no
   * /app/* route. See the note at the top of SiteHeader.astro before wiring it up.
   */
  signedIn?: boolean;
}

const {
  /* Voice: CommonSwarm is agents keeping each other informed. It is not a policing product, so
   * the words that used to sit here — "authority", "provenance", "governed", "append-only" —
   * are gone deliberately. Do not put them back. */
  title = "CommonSwarm — see what every agent is working on",
  description =
    "A coordination cloud for teams running many AI agents. Each agent announces what it’s working on; everyone else sees it in a shared feed. Driven from the CLI.",
  path = "/",
  ogImage = "/og.png",
  bareHeader = false,
  bareFooter = false,
  signedIn = false,
} = Astro.props;

const origin = (Astro.site ?? new URL(FALLBACK_ORIGIN)).origin;
const canonical = new URL(path, origin).href;
const ogImageUrl = new URL(ogImage, origin).href;

/* Alt text describes the CARD, and the card is a picture of a sentence — so this string and
 * public/og.png have to be redrawn together. The card was regenerated from
 * scripts/og-card.mjs; if you change one, run that script and rewrite this.
 *
 * ★ THE STALE-ON-PURPOSE NOTE THAT WAS HERE IS DEAD, AND THE PROCEDURE IT PRESCRIBED WAS
 * FOLLOWED. It read: "og.png is a PNG and it still has the old name and the old command baked
 * into its pixels ... the fix is: rerun scripts/og-card.mjs for CommonSwarm / `cswarm accept
 * --link-stdin`, replace public/og.png, THEN rewrite these two lines to match." Done in that
 * order on 2026-07-28: the generator was updated, re-run, and the card re-rendered at exactly
 * 1200x630 / deviceScaleFactor 1, then public/og.png was replaced (137644 -> 125673 bytes) and
 * the image was OPENED AND READ to confirm it draws "CommonSwarm" and the chip "$ cswarm
 * accept --link-stdin" — not inferred from the byte count changing. Only then were the two
 * lines below rewritten. The rule stands for next time: never edit this string alone, because
 * alt text that describes a picture which does not exist is the one thing alt text must never
 * do.
 *
 * OPEN AND UNFIXED, FLAGGED HERE BECAUSE IT IS NOT THIS FILE'S TO FIX: the card is dark, and
 * the site is going light-first. The word "dark" below is still an accurate description of
 * public/og.png, so it stays — but once the page is light, every link preview shows a dark
 * card for a light site. The fix is scripts/og-card.mjs, then a regenerated PNG, then this
 * string, in that order; none of the three is in this lane. */
const ogImageAlt =
  "CommonSwarm — a dark title card headed “Your agents know what each other are doing.”, " +
  "under the label “Multi-agent coordination”, above the command “cswarm accept " +
  "--link-stdin” and the note “Invited dogfood · CLI only”.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={THEME_COLOR_LIGHT}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={THEME_COLOR_DARK}
      media="(prefers-color-scheme: dark)"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CommonSwarm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {!bareHeader && <SiteHeader signedIn={signedIn} path={path} />}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    {
      !bareFooter && (
        <slot name="footer">
          <SiteFooter />
        </slot>
      )
    }
  </body>
</html>

<style>
  /* main is programmatically focusable for the skip link; it must never show a ring. */
  main:focus {
    outline: none;
  }

  /* The page is a column so the footer sits at the bottom of short pages (a 404, an empty
     state) instead of floating in the middle of the viewport with dead space beneath it. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  main {
    flex: 1 0 auto;
  }
</style>
