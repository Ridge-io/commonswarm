---
/*
 * /download — the install page.
 *
 * ONE CONSTANT, TWO CONSUMERS. INSTALL_CMD is declared here and passed down, because the
 * string that is DISPLAYED and the string that is COPIED must be the same object. SITE-BRIEF
 * calls this out as load-bearing: a command block and the promise around it drift apart the
 * moment they live in two files.
 *
 * THE HOST IS REAL AND THE COMMAND RESOLVES. It did not always: this page shipped showing
 * install.sh's own documentation placeholder, `curl -fsSL https://<host>/install.sh | sh`,
 * which is not a command a stranger can run. The host now comes from src/lib/install.ts and
 * install.sh is copied into public/ by the site build, so the address serves the same file
 * the repo reviews.
 *
 * THE OLD WARNING STILL APPLIES TO ANY FUTURE EDIT: do not hand-write a host here. An earlier
 * draft invented coswarm.dev, which is a REAL, UNRELATED shipping product whose /install.sh
 * answers 200 and installs as root. One constant, one place, verified against the deployed
 * site.
 *
 * FOOTER. This page used to ship its own (PageFoot.astro), written to avoid the then-shared
 * Footer.astro whose nav was a list of landing-page hashes that pointed at nothing from
 * /download. That reason is gone: SiteFooter's Product column is now real routes, so the
 * page passes no footer at all and takes Base's default. PageFoot is deleted — it also
 * claimed the repository is "private during dogfood", which is no longer true.
 *
 * ============================ THE SECTION ORDER IS THE FUNNEL ============================
 * It changed this pass, and the old one is worth naming because it looked reasonable:
 *
 *     install  ->  what happens on your machine  ->  other ways in  ->  once it's installed
 *
 * That put both of the page's reference sections — 6 walkthrough steps and 4 alternative
 * install routes, roughly two screens — BETWEEN the command someone just copied and the
 * command they run next. Someone who has installed the thing and is looking for step two
 * scrolls past the transparency argument they no longer need and a card explaining that
 * there is no npm package. The one section that moves a reader FORWARD was last on the page.
 *
 *     install  ->  once it's installed  ->  what happens on your machine  ->  other ways in
 *
 * The funnel is now complete in the first two sections — copy the command, then the two
 * commands that follow it — and the reference material sits under it for the two readers who
 * want it: the one who has not pasted yet and wants to know what the script does, and the one
 * who does not want a one-liner at all. Neither of them is mid-install.
 *
 * The suspicious reader is not left unserved by the demotion: the "what happens" section is
 * one anchor away — see the link under the copy button in InstallPanel.astro, which is what
 * pays for this order.
 */

import Base from "../layouts/Base.astro";
import InstallPanel from "../components/download/InstallPanel.astro";
import WhatHappens from "../components/download/WhatHappens.astro";
import OtherWays from "../components/download/OtherWays.astro";
import AfterInstall from "../components/download/AfterInstall.astro";
import { INSTALL_CMD } from "../lib/install.ts";

/* The single source of truth for the install command, character for character.
   It lives in src/lib/install.ts because six files used to spell the host out
   themselves and the site shipped with `<host>` in the one command a stranger
   was invited to run. */

const title = "Install CommonSwarm — guided setup";
const description =
  "Install CommonSwarm on macOS, Linux, or Windows with WSL. Check Node.js 24 first, then follow the guided terminal steps.";
---

<Base title={title} description={description} path="/download">
  <InstallPanel cmd={INSTALL_CMD} />
  <AfterInstall />
  <WhatHappens />
  <OtherWays cmd={INSTALL_CMD} />
</Base>
