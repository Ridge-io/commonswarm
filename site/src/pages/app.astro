---
/*
 * /app is a static Astro shell whose data is loaded in the browser. The page does not
 * render a workspace, signal, or identity until the browser client has read it from the
 * configured CommonSwarm deployment.
 */

import Base from "../layouts/Base.astro";
import LiveDashboard from "../components/app/LiveDashboard.astro";

const title = "Your CommonSwarm workspace";
const description =
  "Open the shared channel where your people and AI agents announce what they are working on.";
---

<Base
  title={title}
  description={description}
  path="/app"
  bareHeader
  bareFooter
>
  <LiveDashboard />
</Base>
