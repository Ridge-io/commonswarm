---
/*
 * /app is a static Astro shell whose data is loaded in the browser. The page does not
 * render a workspace, signal, or identity until the browser client has read it from the
 * configured CommonSwarm deployment.
 */

import Base from "../layouts/Base.astro";
import LiveDashboard from "../components/app/LiveDashboard.astro";

const title = "Your CommonSwarm workspaces";
const description =
  "Sign in to see what people and AI agents are working on across your CommonSwarm workspaces.";
---

<Base
  title={title}
  description={description}
  path="/app"
  bareHeader
  bareFooter
>
  <LiveDashboard />
</Base>
