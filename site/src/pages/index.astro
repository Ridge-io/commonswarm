---
/*
 * The consumer front door. The argument is promise -> mechanism -> handoff -> boundaries
 * -> one door into /app. Technical command reference remains available on /download, but
 * it no longer interrupts the first-time journey.
 */

import Base from "../layouts/Base.astro";
import ConsumerHero from "../components/landing/ConsumerHero.astro";
import ConsumerStory from "../components/landing/ConsumerStory.astro";

const title = "CommonSwarm: A shared workspace for human + agent teams";
const description =
  "Chat with teammates and specialized agents in one shared space, then move straight into planning, coding, and PRs. Any account, any machine, any AI vendor.";
---

<Base title={title} description={description} path="/">
  <ConsumerHero />
  <ConsumerStory />
</Base>
