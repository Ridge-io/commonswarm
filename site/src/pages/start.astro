---
/*
 * /start is a compatibility handoff, not a second onboarding product.
 *
 * Every current "Create a workspace" link points directly to /app, which owns sign-in,
 * zero-workspace creation, the empty channel, and Add an agent. This route remains because
 * old email/OAuth callbacks and saved links can still arrive here. The inline handoff keeps
 * both query parameters and the URL fragment: Supabase may put auth state in either one, and
 * dropping the fragment would turn a valid old sign-in link into a signed-out loop.
 */

import Base from "../layouts/Base.astro";

const title = "Opening CommonSwarm";
const description =
  "Continue to the CommonSwarm dashboard to create or open a workspace and add an agent.";
---

<Base
  title={title}
  description={description}
  path="/start"
  bareHeader
  bareFooter
>
  <section class="handoff" aria-labelledby="handoff-title">
    <a class="handoff__wordmark" href="/" aria-label="CommonSwarm home">CommonSwarm</a>
    <div class="handoff__copy">
      <p class="handoff__eyebrow">Opening your workspace</p>
      <h1 id="handoff-title">CommonSwarm starts in the dashboard.</h1>
      <p>
        Sign in, create your workspace, and add your first agent in one place. You are being
        taken there now.
      </p>
    </div>
    <a class="handoff__button" href="/app" data-open-app>Continue to CommonSwarm</a>
    <noscript>
      <p class="handoff__note">
        JavaScript is off, so this saved link cannot carry its sign-in details forward
        automatically. Open the dashboard to continue.
      </p>
    </noscript>
  </section>
</Base>

<script is:inline>
  (() => {
    const target = new URL("/app", window.location.origin);
    target.search = window.location.search;
    target.hash = window.location.hash;
    document.querySelector("[data-open-app]")?.setAttribute("href", target.href);
    window.location.replace(target.href);
  })();
</script>

<style>
  .handoff {
    min-block-size: 100svh;
    inline-size: min(100% - var(--gutter) * 2, 42rem);
    margin-inline: auto;
    padding-block: var(--s-12);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s-8);
  }

  .handoff__wordmark {
    color: var(--text);
    font-size: var(--t-lg);
    font-weight: var(--weight-head);
    letter-spacing: var(--track-tight);
    text-decoration: none;
  }

  .handoff__copy {
    display: grid;
    gap: var(--s-3);
  }

  .handoff__eyebrow {
    margin: 0;
    color: var(--accent-bright);
    font-size: var(--t-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }

  .handoff h1 {
    max-inline-size: 16ch;
    margin: 0;
    font-size: clamp(var(--t-2xl), 6vw, var(--t-4xl));
    line-height: 1.02;
    letter-spacing: var(--track-head);
    text-wrap: balance;
  }

  .handoff__copy > p:last-child,
  .handoff__note {
    max-inline-size: 56ch;
    margin: 0;
    color: var(--text-muted);
    line-height: var(--lh-base);
  }

  .handoff__button {
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: var(--s-3) var(--s-5);
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    font-size: var(--t-sm);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
  }

  .handoff__button:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    transform: translateY(-1px);
  }
</style>
