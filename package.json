{
  "name": "cloud-swarm",
  "version": "0.0.1",
  "private": true,
  "description": "SWARM-CLOUD \u2014 multi-human, multi-agent coordination cloud service (authority core). Forked from swarm (local CLI) to keep the in-use local tool stable.",
  "type": "module",
  "bin": {
    "coswarm": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "build:command-core": "esbuild src/protocol/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:node:crypto --banner:js='// GENERATED from src/protocol/index.ts; do not hand-edit.' --outfile=supabase/functions/_shared/protocol.js",
    "dev": "tsc --watch",
    "test": "node --import tsx --test tests/protocol-next.test.ts tests/protocol-workspace.test.ts tests/protocol-agent-token-binding.test.ts",
    "test:p1-cli": "node --import tsx --test tests/p1-cli/**/*.test.ts",
    "test:uxtest": "node --import tsx --test tests/uxtest-harness.test.ts",
    "pretest:p1-server": "npm run build:command-core",
    "test:p1-server": "node --import tsx --test tests/p1-server/**/*.test.ts",
    "prebuild": "rm -rf dist",
    "postbuild": "chmod 755 dist/cli.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:status": "supabase status",
    "db:diff": "supabase db diff --local",
    "db:migrate": "supabase migration up --local"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@types/node": "^25.5.0",
    "postgres": "^3.4.9",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0"
  }
}
